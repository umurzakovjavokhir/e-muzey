<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-4292220" id="-4292220">Oʻzbekiston Respublikasi Vazirlar Mahkamasining</div></div><div class="ACT_FORM"><div name="-4292221" id="-4292221">qarori</div></div><div class="ACT_TITLE"><div name="-4292222" id="-4292222">Oʻzbekiston Respublikasi Milliy gvardiyasining tegishli boʻlinmalarida shaxsiy tarkibning ovqatlanishini tashkil etish boʻyicha autsorsing xizmatlari koʻrsatish tartibi toʻgʻrisidagi nizomni tasdiqlash haqida</div></div><div class="BY_DEFAULT"><div name="-4292225" id="-4292225"></div></div><div class="ACT_TEXT"><div name="-4292227" id="-4292227">Vazirlar Mahkamasining “Oʻzbekiston Respublikasi Milliy gvardiyasi harbiy xizmatchilarining ovqatlanishini tashkil etish tartibini yanada takomillashtirish chora-tadbirlari toʻgʻrisida” 2018-yil 16-maydagi 366-son <a href="https://lex.uz/uz/docs/-3740032">qaroriga</a> muvofiq, shuningdek, Oʻzbekiston Respublikasi Milliy gvardiyasining tegishli boʻlinmalarida shaxsiy tarkibning ovqatlanish tizimini yanada takomillashtirish maqsadida Vazirlar Mahkamasi qaror qiladi:</div></div><div class="ACT_TEXT"><div name="-4292228" id="-4292228">1. Oʻzbekiston Respublikasi Milliy gvardiyasining tegishli boʻlinmalarida shaxsiy tarkibning ovqatlanishini tashkil etish boʻyicha autsorsing xizmatlari koʻrsatish tartibi toʻgʻrisidagi nizom <a href="https://lex.uz/uz/docs/-4290636#-4292280">ilovaga </a>muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-4292233" id="-4292233">2. Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoniga quyidagi huquqlar berilsin: </div></div><div class="ACT_TEXT"><div name="-4292234" id="-4292234">zarur oziq-ovqat va qishloq xoʻjaligi mahsulotlarini saqlash hamda ularni yangilash maqsadida autsorserlarga, transport xarajatlarini qoplashni hisobga olgan holda, Oʻzbekiston Respublikasi Milliy gvardiyasi shaxsiy tarkibining ovqatlanishini taʼminlash uchun amalda xarid qilgan narxlarda berish (tarqatish) yoʻli bilan sotish;</div></div><div class="ACT_TEXT"><div name="-4292235" id="-4292235">shaxsiy tarkibning uzluksiz ovqatlanishini (shu jumladan doimiy joylashish punktlarida, dala sharoitlarida, tabiiy va texnogen tusdagi favqulodda vaziyatlar yuzaga kelganda hamda boshqa holatlarda) tashkillashtirish maqsadida tegishli zarur lavozimlarni Oʻzbekiston Respublikasi Milliy gvardiyasi boʻlinmalari shtatlariga kiritish yoʻli bilan saqlab turish; </div></div><div class="ACT_TEXT"><div name="-4292237" id="-4292237">shaxsiy tarkibning ovqatlanishi autsorsing shartlarida amalga oshiriladigan Oʻzbekiston Respublikasi Milliy gvardiyasi boʻlinmalarining roʻyxatini belgilash.</div></div><div class="ACT_TEXT"><div name="-4292239" id="-4292239">3. Mazkur qarorning bajarilishini nazorat qilish Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoni B.X. Tashmatov zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-4292240" id="-4292240">Oʻzbekiston Respublikasining Bosh vaziri A. ARIPOV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4292241" id="-4292241">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4292243" id="-4292243">2019-yil 17-aprel,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-4292279" id="-4292279">323-son</div></div><div class="BY_DEFAULT"><div name="-4292280" id="-4292280"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4292281" id="-4292281">Vazirlar Mahkamasining 2019-yil 17-apreldagi 323-son <a href="https://lex.uz/uz/docs/-4290636">qaroriga</a> <br />ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-4292282" id="-4292282">Oʻzbekiston Respublikasi Milliy gvardiyasining tegishli boʻlinmalarida shaxsiy tarkibning ovqatlanishini tashkil etish boʻyicha autsorsing xizmatlari koʻrsatish tartibi toʻgʻrisida</div></div><div class="ACT_FORM"><div name="-4292284" id="-4292284">NIZOM</div></div><div class="BY_DEFAULT"><div name="-4292285" id="-4292285"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292287" id="-4292287">1-bob. Umumiy qoidalar</div></div><div class="ACT_TEXT"><div name="-4292288" id="-4292288">1. Ushbu Nizom Oʻzbekiston Respublikasi Milliy gvardiyasi (keyingi oʻrinlarda Milliy gvardiya deb ataladi) boʻlinmalaridagi ofitserlar, shartnoma asosidagi harbiy xizmatchilar, xodimlar, muddatli harbiy xizmatchilar, kursantlar hamda akademik litsey oʻquvchilarining (keyingi oʻrinlarda shaxsiy tarkib deb ataladi) ovqatlanishini autsorsing shartlarida tashkil etish tartibini belgilaydi. </div></div><div class="ACT_TEXT"><div name="-4292289" id="-4292289">2. Ushbu Nizomda quyidagi asosiy tushunchalardan foydalaniladi:</div></div><div class="ACT_TEXT"><div name="-4292290" id="-4292290">autsorsing — buyurtmachining shaxsiy tarkibni ovqatlantirish vazifasini shartnoma asosida autsorserga oʻtkazish;</div></div><div class="ACT_TEXT"><div name="-4292291" id="-4292291">autsorser — shartnoma asosida buyurtmachiga autsorsing xizmati koʻrsatuvchi yuridik shaxs;</div></div><div class="ACT_TEXT"><div name="-4292292" id="-4292292">buyurtmachi — Milliy gvardiya boʻlinmalari.</div></div><div class="ACT_TEXT"><div name="-4292293" id="-4292293">3. Shaxsiy tarkibni ovqatlantirish quyidagilarni oʻz ichiga oladi:</div></div><div class="ACT_TEXT"><div name="-4292294" id="-4292294">statsionar va dala sharoitida oziq-ovqat taʼminoti;</div></div><div class="ACT_TEXT"><div name="-4292295" id="-4292295">quruq mahsulotlar taʼminoti.</div></div><div class="ACT_TEXT"><div name="-4292296" id="-4292296">4. Shaxsiy tarkibni ovqatlantirish buyurtmachining oziq-ovqat xizmati tomonidan autsorser xizmatini jalb qilish orqali amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4292297" id="-4292297">5. Shaxsiy tarkibni ovqatlantirish uchun pul mablagʻlari yillik talabnomalar boʻyicha belgilanadi va autsorsing xizmatlari uchun kelishilgan hisob-kitoblar, oziq-ovqat meʼyori narxlari belgilangan meʼyorlar asosida yil boʻyicha rejalashtiriladi.</div></div><div class="ACT_TEXT"><div name="-4292298" id="-4292298">6. Autsorsing xizmati buyurtmachining tasdiqlangan xarajatlar smetasi doirasida budjet mablagʻlari hisobidan moliyalashtiriladi. </div></div><div class="ACT_TEXT"><div name="-4292304" id="-4292304">7. Autsorsing xizmati koʻrsatish jarayonida maxfiylik tartibiga rioya etish buyurtmachi tomonidan taʼminlanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292300" id="-4292300">2-bob. Autsorserni tanlash, shartnoma tuzish va hisob-kitoblarni amalga oshirish tartibi </div></div><div class="ACT_TEXT"><div name="-4292301" id="-4292301">8. Autsorserlar Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari tomonidan talabgorlarni oʻrganish hamda eng yaxshi takliflarni tanlash orqali tanlab olinadi. Bunda umumiy ovqatlanish sohasida katta ish tajribasiga, tegishli moliyaviy, moddiy-texnika va logistika bazasiga ega, oshxonalarning holatini yaxshilashga tayyor boʻlgan talabgorlarga ustunlik beriladi. </div></div><div class="ACT_TEXT"><div name="-4292302" id="-4292302">9. Autsorser talabgorlariga nisbatan quyidagi talablar qoʻyiladi:</div></div><div class="ACT_TEXT"><div name="-4292305" id="-4292305">yuridik shaxs boʻlishi;</div></div><div class="ACT_TEXT"><div name="-4292307" id="-4292307">autsorsing xizmati boʻyicha kamida bir oylik shartnoma summasiga teng aylanma mablagʻlarga ega boʻlishi;</div></div><div class="ACT_TEXT"><div name="-4292308" id="-4292308">moliyaviy ahvolining barqarorligi, soliq va boshqa majburiy toʻlovlardan qarzdorligi mavjud emasligi;</div></div><div class="ACT_TEXT"><div name="-4292309" id="-4292309">statsionar va dala sharoitida autsorsing xizmati koʻrsatish uchun yetarli moddiy-texnika va logistika bazasiga ega boʻlishi;</div></div><div class="ACT_TEXT"><div name="-4292310" id="-4292310">shtatida yetarli ish tajribasiga va koʻnikmaga ega xodimlar boʻlishi.</div></div><div class="ACT_TEXT"><div name="-4292311" id="-4292311">10. Autsorserlarni tanlab olish Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari tomonidan talabgorlarni oʻrganish hamda belgilangan tartibda tanlovni oʻtkazish yoʻli bilan zarurat tugʻilganda amalga oshiriladi. </div></div><div class="BY_DEFAULT"><div name="-5745328" id="-5745328"></div></div><div class="ACT_TEXT"><div name="-5745329" id="-5745329">11. Autsorserlarni tanlash natijalari maxsus komissiyaning bayonnomasi bilan rasmiylashtiriladi va tasdiqlangan kunning ertasidan kechiktirmay shaxsiy tarkibning ovqatlanishini tashkil qilish boʻyicha autsorsing xizmatlari koʻrsatish yuzasidan Milliy gvardiya boʻlinmalari bilan belgilangan tartibda shartnoma tuzish uchun buyurtmachiga yuboriladi.</div></div><div class="ACT_TEXT"><div name="-4292316" id="-4292316">12. Oziq-ovqat mahsulotlari narxlarining bozordagi oʻrtacha koʻrsatkichlari tegishli hududda yuzaga kelgan narxlar darajasini har oy oʻrganish orqali Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari tomonidan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-4292318" id="-4292318">13. Agar oziq-ovqat mahsulotlarining amaldagi bozor narxlari Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklarining bayonnoma qarorida belgilangan narxlardan baland boʻlsa, buyurtmachi autsorser bilan birgalikda Qoraqalpogʻiston Respublikasi Vazirlar Kengashiga, viloyatlar va Toshkent shahar hokimliklariga koʻrib chiqish va qaror qabul qilish uchun tegishli hududdagi amaldagi narxlarni oʻrganib chiqish dalolatnomasi ilova qilingan takliflarni belgilangan tartibda yuboradi. </div></div><div class="ACT_TEXT"><div name="-4292319" id="-4292319">14. Oziq-ovqat mahsulotlarining Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari bayonnomalarida belgilangan narxlari ular tasdiqlangandan keyingi kundan eʼtiboran kuchga kiradi. </div></div><div class="ACT_TEXT"><div name="-4292322" id="-4292322">15. Bayonnoma qarorlarning toʻgʻri tuzilishi uchun javobgarlik Qoraqalpogʻiston Respublikasi Vazirlar Kengashiga, viloyatlar va Toshkent shahar hokimliklariga yuklanadi.</div></div><div class="ACT_TEXT"><div name="-4292323" id="-4292323">16. Autsorsing xizmati koʻrsatish boʻyicha shartnoma buyurtmachi va autsorser oʻrtasida kalendar yil uchun yozma shaklda ikki nusxada tuziladi. </div></div><div class="ACT_TEXT"><div name="-4292324" id="-4292324">Shartnomada shaxsiy tarkibning soni, bir nafar ovqatlanuvchi uchun tasdiqlangan meʼyorlardagi kunlik oziq-ovqat qiymati, kalendar kuni va jami yillik summa aks ettiriladi. </div></div><div class="ACT_TEXT"><div name="-4292325" id="-4292325">17. Oziq-ovqat mahsulotlarining oʻrtacha bozor narxlari Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklaridan har oyning 1-sanasiga qadar Milliy gvardiya boʻlinmalari tomonidan olinadi. </div></div><div class="ACT_TEXT"><div name="-4292326" id="-4292326">Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklaridan olingan oziq-ovqat mahsulotlari narxi oʻzgarganda yoki boshqa asosli holatlarda shartnomaga tegishli oʻzgartirish kiritilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-4292328" id="-4292328">18. Koʻrsatilgan xizmatlar hisob-kitobi shartnoma oylik summasining 15 foizi miqdorida oldindan, 85 foizi haqiqatda koʻrsatilgan xizmatlar summasidan kelib chiqib har 10 kunda, yakuniy hisob-kitob esa — keyingi oyning 5-sanasiga qadar amalga oshiriladi. </div></div><div class="ACT_TEXT"><div name="-4292333" id="-4292333">Oʻzbekiston Respublikasi Milliy gvardiyasi boʻlinmalarida ovqatlanishni tashkil etish uchun autsorserni tanlash, autsorser va harbiy qism (muassasa) oʻrtasida hisob-kitoblar mazkur Nizomga <a href="https://lex.uz/uz/docs/-4290636#-4292721">2</a> va <a href="https://lex.uz/uz/docs/-4290636#-4292776">3-ilovalarga </a>muvofiq sxemalar boʻyicha amalga oshiriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292337" id="-4292337">3-bob. Autsorsing xizmati koʻrsatishda oziq-ovqatlar sifatiga va xavfsizligiga qoʻyiladigan talablar </div></div><div class="BY_DEFAULT"><div name="-5976436" id="-5976436"></div></div><div class="ACT_TEXT"><div name="-5976445" id="-5976445">19. Autsorsing xizmatlari asosida ovqat bilan taʼminlash qonunchilik hujjatlarida belgilangan xavfsizlik texnikasi va yongʻin xavfsizligi, mehnat muhofazasi hamda sanitariya qoidalari, normalari va gigiyena normativlariga rioya qilingan holda amalga oshirilishi lozim.</div></div><div class="ACT_TEXT"><div name="-4292341" id="-4292341">20. Autsorser tomonidan foydalaniladigan oziq-ovqat mahsulotlari tegishli muvofiqlik sertifikatlari bilan tasdiqlanishi, shuningdek, xalqaro va milliy standartlar talablariga javob berishi shart. </div></div><div class="ACT_TEXT"><div name="-4292342" id="-4292342">21. Buyurtmachiga yetkazib berilayotgan oziq-ovqat mahsulotlari sifati yuzasidan nazorat autsorser ishtirokida buyurtmachining tibbiy hamda oziq-ovqat xizmatlari tomonidan amalga oshiriladi, bunda qabul qilish dalolatnomasi tuzilib, u mahsulot sifatini tekshirgan shaxslar tomonidan imzolanadi va buyurtmachi tomonidan tasdiqlanadi. </div></div><div class="ACT_TEXT"><div name="-4292343" id="-4292343">22. Autsorser xodimlari:</div></div><div class="ACT_TEXT"><div name="-4292345" id="-4292345">sifatli oziq-ovqat mahsulotlarini qabul qilishi, ularni toʻgʻri saqlashi va belgilangan meʼyorlar asosida sarflashi; </div></div><div class="ACT_TEXT"><div name="-4292348" id="-4292348">belgilangan meʼyorlar asosida taom tayyorlash texnologiyasiga qatʼiy amal qilishi, ortiqcha isrofgarchilikka yoʻl qoʻymasligi;</div></div><div class="ACT_TEXT"><div name="-4292350" id="-4292350">taomlarni tayyorlashda, oziq-ovqat mahsulotlarini qabul qilish hamda saqlashda sanitariya qoidalari, normalari va gigiyena normativlariga qatʼiy rioya etishi;</div></div><div class="ACT_TEXT"><div name="-4292352" id="-4292352">oshpazlik sohasida zarur bilim va koʻnikmalarga ega boʻlishi va oʻz malakasini doimiy ravishda oshirib borishi zarur.</div></div><div class="BY_DEFAULT"><div name="-5976463" id="-5976463"></div></div><div class="ACT_TEXT"><div name="-5976475" id="-5976475">Autsorser xodimlari qonunchilik hujjatlarida belgilangan tartibda tibbiy koʻrikdan oʻtishi va tibbiy daftarchaga ega boʻlishi shart.</div></div><div class="ACT_TEXT"><div name="-4292355" id="-4292355">Mazkur bandda belgilangan talablarga rioya qilmagan shaxslarning autsorser tomonidan xizmat koʻrsatishga jalb etilishi taqiqlanadi.</div></div><div class="ACT_TEXT"><div name="-4292357" id="-4292357">23. Oziq-ovqat mahsulotlarini belgilangan tartibda saqlash qoidalariga rioya etilishi boʻyicha javobgarlik autsorserga yuklanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292360" id="-4292360">4-bob. Shaxsiy tarkibning ovqatlanish tartibini rejalashtirish, nazorat qilish va monitoringni amalga oshirish </div></div><div class="ACT_TEXT"><div name="-4292361" id="-4292361">24. Shaxsiy tarkibning ovqatlanish tartibi buyurtmachi tomonidan ishlab chiqiladi.</div></div><div class="ACT_TEXT"><div name="-4292362" id="-4292362">25. Taomnoma sanitariya qoidalari, normalari va gigiyena normativlari asosida tuziladi, autsorser va buyurtmachi rahbari tomonidan imzo bilan tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-4292364" id="-4292364">26. Taomnoma uch nusxada tuziladi — birinchi nusxasi autsorserga, ikkinchi nusxasi buyurtmachiga hamda uchinchi nusxasi oshxonaga foydalanish uchun beriladi.</div></div><div class="ACT_TEXT"><div name="-4292366" id="-4292366">27. Taomlar ovqatlanish texnologiyasi qoidalariga amal qilgan holda tayyorlanadi, saqlanadi va tarqatiladi.</div></div><div class="ACT_TEXT"><div name="-4292368" id="-4292368">28. Shaxsiy tarkibning ovqatlanishi kun mobaynida sutkalik ovqatlanish meʼyorlari boʻyicha oziq-ovqat mahsulotlarining toʻgʻri taqsimlanishi, shuningdek, kun tartibi boʻyicha qatʼiy belgilangan vaqtda ovqatlanish tashkillashtirilishi lozim.</div></div><div class="ACT_TEXT"><div name="-4292369" id="-4292369">29. Oziq-ovqat mahsulotlarini qozonga solish autsorser va buyurtmachi vakillari ishtirokida amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4292371" id="-4292371">30. Ovqatlarni tarqatish boshlangunga qadar buyurtmachi vakillari tomonidan ovqatlar sifati, shuningdek, oshxona binosining sanitariya holati, oshxona idishlari va inventarlari tekshiriladi. Buyurtmachi vakillari tekshiruv natijalarini ovqatlarni tayyorlash sifatining nazorat kitobida aks ettiradi. Bunda uning sifati toʻgʻrisidagi xulosa har bir ovqat pishirish (nonushta, tushlik, kechki ovqat) uchun alohida yoziladi. </div></div><div class="ACT_TEXT"><div name="-4292374" id="-4292374">31. Autsorsing xizmati koʻrsatilishi yuzasidan monitoring buyurtmachi tashkil etadigan komissiya (keyingi oʻrinlarda komissiya deb ataladi) tomonidan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4292376" id="-4292376">32. Komissiya tarkibi Milliy gvardiya Moddiy-texnika taʼminoti boshqarmasi moddiy taʼminot boʻlimi, buyurtmachining taʼminot va boshqa boʻlinmalari xodimlaridan shakllantiriladi.</div></div><div class="ACT_TEXT"><div name="-4292378" id="-4292378">33. Komissiya:</div></div><div class="ACT_TEXT"><div name="-4297671" id="-4297671">autsorsing xizmati koʻrsatilishi yuzasidan doimiy monitoring olib boradi, jumladan shaxsiy tarkib oʻrtasida soʻrovnomalar oʻtkazadi;</div></div><div class="ACT_TEXT"><div name="-4292380" id="-4292380">monitoring natijalaridan kelib chiqib, buyurtmachi va autsorserga tegishli taklif va tavsiyalar kiritadi;</div></div><div class="ACT_TEXT"><div name="-4292382" id="-4292382">oshxona va omborlarda sanitariya qoidalari, normalari va gigiyena normativlariga rioya qilinishi hamda epidemiyaga qarshi tadbirlar talablarining buzilishi holatlarini bartaraf etish choralarini koʻradi;</div></div><div class="ACT_TEXT"><div name="-4292384" id="-4292384">tayyor taom va oziq-ovqat mahsulotlarining belgilangan kunlik meʼyorlarga mos boʻlishini hamda sifatini oʻrganadi, zarur holatlarda chetdan mutaxassislar jalb etadi.</div></div><div class="ACT_TEXT"><div name="-4292386" id="-4292386">Komissiya buyurtmachi tomonidan yuklangan boshqa vakolatlarni ham amalga oshirishi mumkin.</div></div><div class="ACT_TEXT"><div name="-4292388" id="-4292388">34. Komissiya tomonidan oʻtkazilgan oʻrganish natijalari alohida yuritiladigan jurnalda qayd etib boriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292390" id="-4292390">5-bob. Shaxsiy tarkibni issiq ovqat bilan taʼminlash</div></div><div class="ACT_TEXT"><div name="-4292391" id="-4292391">35. Autsorsing sharoitida shaxsiy tarkibni issiq ovqat bilan taʼminlash shaxsiy tarkib yetib kelishi va ketishini hisobga olgan holda belgilangan tartibda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4292393" id="-4292393">36. Shaxsiy tarkibni ovqatlantirish boʻyicha hisobga kiritishda yoki hisobdan chiqarishda hisob-kitoblar belgilangan kunlik meʼyor summasiga nisbatan quyidagicha amalga oshiriladi: </div></div><div class="ACT_TEXT"><div name="-4292394" id="-4292394">nonushta uchun — 25 %;</div></div><div class="ACT_TEXT"><div name="-4292417" id="-4292417">tushlik uchun — 50 %;</div></div><div class="ACT_TEXT"><div name="-4292419" id="-4292419">kechki taom uchun — 25 %.</div></div><div class="ACT_TEXT"><div name="-4292421" id="-4292421">37. Milliy gvardiya akademik litsey oʻquvchilarini ovqatlantirish boʻyicha hisobga kiritishda yoki hisobdan chiqarishda hisob-kitoblar belgilangan kunlik meʼyor summasiga nisbatan quyidagicha amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-4292424" id="-4292424">nonushta uchun — 20 %;</div></div><div class="ACT_TEXT"><div name="-4292426" id="-4292426">ikkinchi nonushta (yoki tushlik) uchun — 20 %;</div></div><div class="ACT_TEXT"><div name="-4292429" id="-4292429">tushlik uchun — 40 %;</div></div><div class="ACT_TEXT"><div name="-4292432" id="-4292432">kechki ovqatlanish uchun — 20 %.</div></div><div class="ACT_TEXT"><div name="-4292435" id="-4292435">38. Agar shaxsiy tarkibning oziq-ovqat taʼminotini tashkil qilish boʻyicha jami xarajatlar ovqatlanish payogi oʻrniga pul kompensatsiyasining belgilangan miqdoridan oshib ketsa, mavjud tafovut shaxsiy tarkibdan undirilmaydi, xarajatlar esa — Oʻzbekiston Respublikasi Davlat budjeti va Milliy gvardiyaning budjetdan tashqari mablagʻlari hisobidan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4292437" id="-4292437">39. Shaxsiy tarkibni ovqatlantirish jismoniy va yuridik shaxslarning homiylik xayriyalari hisobiga tashkil etilganda shaxsiy tarkib uchun belgilangan bir kunlik ovqatlanish ratsioni sanitariya qoidalari, normalari va gigiyena normativlariga muvofiq belgilangan meʼyorlardan oshmasligi lozim. </div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292440" id="-4292440">6-bob. Autsorser va buyurtmachining huquqlari va majburiyatlari</div></div><div class="ACT_TEXT"><div name="-4292444" id="-4292444">40. Autsorser quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-4292446" id="-4292446">ijaraga olingan mol-mulkdan foydalanish;</div></div><div class="ACT_TEXT"><div name="-4292450" id="-4292450">ijaraga olingan bino va inshootlarning ichki qismida texnik jihatdan jihozlash va taʼmirlash ishlarini amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-4292451" id="-4292451">shaxsiy tarkibning soni va ovqatlanish jadvalini belgilangan tartibda olish;</div></div><div class="ACT_TEXT"><div name="-4292454" id="-4292454">olingan oziq-ovqat mahsulotlari narxlarining oʻzgarishi munosabati bilan shartnomaga oʻzgartirish kiritish taklifi bilan chiqish;</div></div><div class="ACT_TEXT"><div name="-4292456" id="-4292456">koʻrsatilgan xizmatlar uchun oʻz vaqtida toʻlovlar amalga oshirilishini talab qilish;</div></div><div class="ACT_TEXT"><div name="-4292459" id="-4292459">buyurtmachidan shartnoma shartlarining bajarilishini talab qilish.</div></div><div class="BY_DEFAULT"><div name="-5976507" id="-5976507"></div></div><div class="ACT_TEXT"><div name="-5976508" id="-5976508">Autsorser qonunchilik hujjatlariga muvofiq boshqa huquqlarga ham ega boʻlishi mumkin.</div></div><div class="ACT_TEXT"><div name="-4292463" id="-4292463">41. Autsorser:</div></div><div class="ACT_TEXT"><div name="-4292465" id="-4292465">shaxsiy tarkibning oziq-ovqat taʼminotini uzluksiz, shu jumladan, zarur holatlarda, dam olish va bayram kunlari hamda dala sharoitida amalga oshirishi;</div></div><div class="ACT_TEXT"><div name="-4292466" id="-4292466">oziq-ovqat mahsulotlarining yangi va sifatli boʻlishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-4292468" id="-4292468">sogʻliq uchun zararli va yaroqsiz oziq-ovqat mahsulotlaridan foydalanmasligi va taomlarni tarqatmasligi;</div></div><div class="ACT_TEXT"><div name="-4292469" id="-4292469">dala sharoitida koʻchma oshxona faoliyatini toʻliq tashkil etgan holda, shaxsiy tarkibning oziq-ovqat taʼminotini amalga oshirishi;</div></div><div class="ACT_TEXT"><div name="-4292471" id="-4292471">ijaraga olingan bino va inshootlar, jihozlardan maqsadli hamda oqilona foydalanishi, saqlashi, nosoz holga kelganda ularni oʻz hisobidan taʼmirlashi, shuningdek, mulkni saqlash xarajatlarini qoplashi;</div></div><div class="ACT_TEXT"><div name="-4292475" id="-4292475">autsorsing xizmati koʻrsatishda xavfsizlik texnikasi, yongʻin xavfsizligi, mehnat muhofazasi hamda sanitariya qoidalari, normalari va gigiyena normativlariga qatʼiy rioya etishi; </div></div><div class="ACT_TEXT"><div name="-4292478" id="-4292478">oziq-ovqat mahsulotlarining sifatli saqlanishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-4292480" id="-4292480">maxfiylik tartibiga qatʼiy rioya qilishi lozim.</div></div><div class="BY_DEFAULT"><div name="-5976540" id="-5976540"></div></div><div class="ACT_TEXT"><div name="-5976548" id="-5976548">Autsorserga qonunchilik hujjatlariga muvofiq boshqa majburiyatlar ham yuklanishi mumkin.</div></div><div class="ACT_TEXT"><div name="-4292485" id="-4292485">42. Buyurtmachi quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-4292488" id="-4292488">autsorserdan shartnoma shartlarini bajarish bilan bogʻliq jarayonda qatnashuvchi shaxslar (oshxona xodimlari) roʻyxatini olish;</div></div><div class="ACT_TEXT"><div name="-4292490" id="-4292490">oziq-ovqat mahsulotlarining sifatini tasdiqlovchi hujjatlarni talab qilish;</div></div><div class="ACT_TEXT"><div name="-4292491" id="-4292491">ovqatlanish jadvaliga oʻzgartirishlar kiritish;</div></div><div class="ACT_TEXT"><div name="-4292494" id="-4292494">autsorserning ishlab chiqarish faoliyatiga aralashmagan holda shartnoma shartlarining bajarilishini nazorat qilish. </div></div><div class="BY_DEFAULT"><div name="-5976594" id="-5976594"></div></div><div class="ACT_TEXT"><div name="-5976596" id="-5976596">Buyurtmachi qonunchilik hujjatlariga muvofiq boshqa huquqlarga ham ega boʻlishi mumkin.</div></div><div class="ACT_TEXT"><div name="-4292497" id="-4292497">43. Buyurtmachi:</div></div><div class="ACT_TEXT"><div name="-4292498" id="-4292498">autsorserga shaxsiy tarkibning sonini va ularning ovqatlanish jadvalini oʻz vaqtida taqdim etishi;</div></div><div class="ACT_TEXT"><div name="-4292499" id="-4292499">shartnomaga muvofiq belgilangan muddat va shartlar asosida autsorserga koʻrsatilgan xizmatlar uchun toʻlovlarni amalga oshirishi lozim.</div></div><div class="BY_DEFAULT"><div name="-5976604" id="-5976604"></div></div><div class="ACT_TEXT"><div name="-5976607" id="-5976607">Buyurtmachi zimmasiga qonunchilik hujjatlariga muvofiq boshqa majburiyatlar ham yuklanishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292501" id="-4292501">7-bob. Obyektlar va moddiy-texnika vositalaridan foydalanish</div></div><div class="ACT_TEXT"><div name="-4292502" id="-4292502">44. Oshxonada joylashgan moddiy-texnika vositalari buyurtmachi tomonidan tegishli dalolatnoma rasmiylashtirilgan holda autsorsyerga vaqtinchalik foydalanishga beriladi. Dalolatnoma ikki nusxada buyurtmachi komissiyasi va autsorser tomonidan imzolanadi. Dalolatnoma buyurtmachi tomonidan tasdiqlanadi. </div></div><div class="ACT_TEXT"><div name="-4292503" id="-4292503">45. Autsorsyerga vaqtinchalik foydalanishga beriladigan oshxona binosiga qoʻyiladigan asosiy talablar quyidagilar hisoblanadi:</div></div><div class="ACT_TEXT"><div name="-4292506" id="-4292506">yetarli oʻringa ega boʻlgan, texnologik jihozlar bilan taʼminlangan, texnik holati belgilangan meʼyorlarga mos boʻlgan ovqatlanish binosining mavjudligi;</div></div><div class="ACT_TEXT"><div name="-4292507" id="-4292507">mahsulotlarni saqlash uchun omborlarning mavjudligi;</div></div><div class="ACT_TEXT"><div name="-4292509" id="-4292509">taom tayyorlash uskunalari, oshxona mebellari va ovqatlanish uchun zarur boʻlgan boshqa jihozlarning mavjudligi.</div></div><div class="ACT_TEXT"><div name="-4292510" id="-4292510">46. Belgilangan foydalanish muddatini oʻtab boʻlgan va yaroqsiz holatga kelgan moddiy-texnika vositalari belgilangan tartibda buyurtmachi tomonidan hisobdan chiqariladi. </div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4292511" id="-4292511">8-bob. Yakunlovchi qoidalar </div></div><div class="ACT_TEXT"><div name="-4292514" id="-4292514">47. Ushbu Nizomda nazarda tutilgan talablarning buzilishi buyurtmachi va autsorserning tuzilgan shartnomani belgilangan tartibda bekor qilishiga asos boʻladi. </div></div><div class="BY_DEFAULT"><div name="-5976615" id="-5976615"></div></div><div class="ACT_TEXT"><div name="-5976622" id="-5976622">48. Mazkur Nizom talablarining buzilishida aybdor boʻlgan shaxslar qonunchilik hujjatlarida belgilangan tartibda javobgar boʻladi.</div></div><div class="BY_DEFAULT"><div name="-4292721" id="-4292721"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4292724" id="-4292724">Oʻzbekiston Respublikasi Milliy gvardiyasining tegishli boʻlinmalarida shaxsiy tarkibning ovqatlanishini tashkil etish boʻyicha autsorsing xizmatlari koʻrsatish tartibi toʻgʻrisidagi <a href="https://lex.uz/uz/docs/-4290636#-4292282">nizomga</a><br /> 2-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-4292726" id="-4292726">Oʻzbekiston Respublikasi Milliy gvardiyasi boʻlinmalarida ovqatlanishni tashkil etish uchun autsorserlarni tanlash</div></div><div class="ACT_FORM"><div name="-4292727" id="-4292727">SXEMASI</div></div><div class="BY_DEFAULT"><div name="-4292728" id="-4292728"></div></div><div class="BY_DEFAULT"><div name="-4292730" id="-4292730"><div align="center">
