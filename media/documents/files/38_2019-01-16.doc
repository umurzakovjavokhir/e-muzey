<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-4169759" id="-4169759">Oʻzbekiston Respublikasi Vazirlar Mahkamasining</div></div><div class="ACT_FORM"><div name="-4169763" id="-4169763">qarori</div></div><div class="ACT_TITLE"><div name="-4169765" id="-4169765">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabi faoliyatini tashkil etish toʻgʻrisida</div></div><div class="BY_DEFAULT"><div name="-4169769" id="-4169769"></div></div><div class="ACT_TEXT"><div name="-4169770" id="-4169770">Mamlakatimizda olimpiya sport turlaridan biri boʻlgan sport kurashini yanada rivojlantirish, iqtidorli yoshlarni erkin va yunon-rum kurashi bilan muntazam shugʻullanishga faol jalb etish, ularning sport mahoratini oshirish hamda shu asosda mamlakatimiz terma jamoalari uchun ishonchli zaxirani shakllantirish uchun zarur shart-sharoitlar yaratish maqsadida Vazirlar Mahkamasi qaror qiladi:</div></div><div class="ACT_TEXT"><div name="-4169772" id="-4169772">1. Quyidagilar:</div></div><div class="ACT_TEXT"><div name="-4169773" id="-4169773">Oʻzbekiston Respublikasi Prezidentining “Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabini tashkil etish toʻgʻrisida” 2012-yil 24-sentabrdagi PQ-1822-son <a href="https://lex.uz/uz/docs/-2055589">qaroriga</a> asosan Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabi Oʻzbekiston Respublikasi Ichki ishlar vazirligi huzurida sport-sogʻlomlashtirish muassasasi sifatida tashkil qilinganligi hamda uning asosiy vazifalari va moliyalashtirish manbalari belgilanganligi;</div></div><div class="ACT_TEXT"><div name="-4169781" id="-4169781">Oʻzbekiston Respublikasi Prezidentining 2017-yil 21-noyabrdagi qaroriga asosan Oʻzbekiston Respublikasi Ichki ishlar vazirligi huzuridagi Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabining Oʻzbekiston Respublikasi Milliy gvardiyasi tarkibiga berilganligi va sport maktabi Milliy gvardiyaning Toshkent shahri, Mirzo Ulugʻbek tumani, Mustaqillik shoh koʻchasi, “Dinamo” stadionida joylashtirilganligi maʼlumot uchun qabul qilinsin.</div></div><div class="ACT_TEXT"><div name="-4169784" id="-4169784">2. Quyidagilar: </div></div><div class="ACT_TEXT"><div name="-4169786" id="-4169786">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabi xodimlarining cheklangan umumiy soni 115 nafar (shu jumladan 60 nafar sportchi shtati)dan iborat tuzilmasi <a href="https://lex.uz/uz/docs/-4164213#-4169844">1-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-4169788" id="-4169788">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga oʻquvchi-sportchilarni qabul qilish tartibi toʻgʻrisida nizom <a href="https://lex.uz/uz/docs/-4164213#-4169854">2-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-4169793" id="-4169793">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabi oʻquvchi-sportchilari uchun zarur anjomlar, sport ekipirovkasi va formali kiyim-bosh bilan taʼminlash normativlari <a href="https://lex.uz/uz/docs/-4164213#-4171158">3-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-4169794" id="-4169794">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabini jihozlash uchun zarur sport oʻquv-mashq va tibbiyot anjomlari, shuningdek, texnika va transport vositalari roʻyxati <a href="https://lex.uz/uz/docs/-4164213#-4171245">4-ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-4169795" id="-4169795">Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoniga Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabi (keyingi oʻrinlarda sport maktabi deb ataladi) tuzilmasiga xodimlarning belgilangan umumiy soni doirasida oʻzgartirishlar kiritish huquqi berilsin.</div></div><div class="ACT_TEXT"><div name="-4169796" id="-4169796">3. Belgilab qoʻyilsinki:</div></div><div class="ACT_TEXT"><div name="-4169798" id="-4169798">sport maktabi oʻz faoliyatini Vazirlar Mahkamasining “Sport maktablari faoliyatini hamda sport maktablari trenerlari va mutaxassislari mehnatini moddiy ragʻbatlantirish tizimini yanada takomillashtirish toʻgʻrisida” 2010-yil 23-sentabrdagi 211-son <a href="https://lex.uz/uz/docs/-1683015">qarori</a> asosida tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-4169800" id="-4169800">sport maktabida oʻquvchi-sportchilarning kontingenti, ularning vazn toifalarini hisobga olgan holda, 60 nafardan iborat etib belgilanadi hamda taʼlim olish muddati oʻquvchi-sportchi Oʻzbekiston Respublikasi terma jamoasining asosiy (yoki zaxira) tarkibida boʻlgan davr mobaynida davom etadi;</div></div><div class="ACT_TEXT"><div name="-4169802" id="-4169802">sportchi lavozimiga sport maktabi oʻquvchi-sportchilarining kontingenti orasidan qabul qilinadi;</div></div><div class="ACT_TEXT"><div name="-4169805" id="-4169805">sport maktabiga oʻquvchi-sportchilarni qabul qilish umumiy kontingentdan kelib chiqqan holda yil davomida amalga oshirib boriladi;</div></div><div class="ACT_TEXT"><div name="-4169807" id="-4169807">sport maktabida oʻquv-mashq jarayonining davomiyligi va davriyligi sport musobaqalari taqvimi va oʻquvchi-sportchilarning har bir guruhi uchun yakka tartibda sport tayyorgarligi davrlari hisobga olingan holda sport maktabi rahbariyati tomonidan belgilanadi;</div></div><div class="BY_DEFAULT"><div name="-5893924" id="-5893924"></div></div><div class="ACT_TEXT"><div name="-5893928" id="-5893928">sport maktabi oʻquvchi-sportchilarini oziq-ovqat bilan taʼminlash xarajatlarining har kunlik normasi amalda boʻlgan bazaviy hisoblash miqdoriga nisbatan foizlarda, lekin Oʻzbekiston Respublikasi Milliy gvardiyasi “Dinamo” jismoniy tarbiya va sport jamiyati Respublika kengashi huzuridagi turgʻun ovqatlanish shoxobchasining qoʻshimcha xarajatlarini qoplashni hisobga olgan holda 30 foizdan ortiq boʻlmagan miqdorda belgilanadi.</div></div><div class="ACT_TEXT"><div name="-4169811" id="-4169811">4. Oʻzbekiston Respublikasi Milliy gvardiyasi Jismoniy tarbiya va sport vazirligi hamda Oʻzbekiston sport kurashlari assotsiatsiyasi bilan birgalikda:</div></div><div class="ACT_TEXT"><div name="-4169813" id="-4169813">sport maktabi belgilangan kontingentining vazn toifalarini hisobga olgan holda nomzodlarni tanlab olish va oʻquvchi-sportchilar safiga qabul qilishni;</div></div><div class="ACT_TEXT"><div name="-4169816" id="-4169816">sport maktabining turli darajadagi musobaqalar va oʻquv-mashq yigʻinlari sport tadbirlari taqvim rejasini belgilangan muddatlarda tasdiqlashni;</div></div><div class="ACT_TEXT"><div name="-4169817" id="-4169817">sport maktabining oʻquv-mashq jarayonida sport kurashlari boʻyicha yuqori malakali kadrlardan hamda ularning ilmiy-metodik salohiyatidan unumli foydalanishni;</div></div><div class="ACT_TEXT"><div name="-4169823" id="-4169823">trenerlar tarkibi va oʻquvchi-sportchilarning sport kurashlari boʻyicha yetakchi xorijiy markazlar va maktablarda stajirovkadan oʻtishini tizimli asosda tashkil etishni;</div></div><div class="ACT_TEXT"><div name="-4169825" id="-4169825">erkin va yunon-rum kurashi boʻyicha yosh kurashchilarni tayyorlashda ilgʻor xalqaro tajribalarning hisobga olinishini;</div></div><div class="ACT_TEXT"><div name="-4169827" id="-4169827">oʻquv-mashq jarayonini zarur darajada tashkil etish maqsadida sport maktabini malakali mutaxassislar bilan toʻldirish, oʻquv xonalarini zarur oʻquv-metodik adabiyotlar bilan jihozlash chora-tadbirlari koʻrilishini;</div></div><div class="ACT_TEXT"><div name="-4169830" id="-4169830">sport maktabi oʻquvchi-sportchilari tayyorgarligining sifati muntazam ravishda monitoring qilib borilishini va zarur holatlarda tayyorgarlik jarayoniga tegishli oʻzgartirishlar kiritilishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-4169832" id="-4169832">5. Sport maktabiga belgilangan tartibda tasdiqlanadigan sport maktabi sport tadbirlarining taqvim rejasi hamda ushbu maqsadlar uchun nazarda tutilgan mablagʻlar doirasida oʻquvchi-sportchilar va trenerlarni xalqaro musobaqalarda va xorijda oʻtkaziladigan oʻquv-mashq yigʻinlarida qatnashish uchun yuborish huquqi berilsin.</div></div><div class="ACT_TEXT"><div name="-4169833" id="-4169833">6. Oʻzbekiston Respublikasi Hukumatining <a href="https://lex.uz/uz/docs/-4164213#-4171286">5-ilovaga</a> muvofiq ayrim qarorlari oʻz kuchini yoʻqotgan deb hisoblansin.</div></div><div class="ACT_TEXT"><div name="-4169834" id="-4169834">7. Vazirliklar va idoralar oʻzlari qabul qilgan normativ-huquqiy hujjatlarni bir oy muddatda ushbu qarorga muvofiqlashtirsinlar.</div></div><div class="ACT_TEXT"><div name="-4169835" id="-4169835">8. Mazkur qarorning bajarilishini nazorat qilish Oʻzbekiston Respublikasi Bosh vazirining oʻrinbosari A.A. Abduxakimov va Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoni B.X. Tashmatov zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-4169837" id="-4169837">Oʻzbekiston Respublikasining Bosh vaziri A. ARIPOV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4169838" id="-4169838">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4169840" id="-4169840">2019-yil 16-yanvar,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-4169842" id="-4169842">38-son</div></div><div class="BY_DEFAULT"><div name="-4169844" id="-4169844"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4169845" id="-4169845">Vazirlar Mahkamasining 2019-yil 16-yanvardagi 38-son <a href="https://lex.uz/uz/docs/-4164213">qaroriga</a><br />1-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4169846" id="-4169846">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabi</div></div><div class="ACT_FORM"><div name="-4169849" id="-4169849"><strong>TUZILMASI</strong></div></div><div class="BY_DEFAULT"><div name="-4169850" id="-4169850"></div></div><div class="TEXT_CENTER"><div name="-4169852" id="-4169852"><img src="https://lex.uz/uz/files/4170885" /></div></div><div class="FOOTNOTE"><div name="-4169861" id="-4169861">Xodimlarning cheklangan umumiy soni — 115 nafar, shu jumladan, Oʻzbekiston milliy terma jamoalarining asosiy tarkibidagi sportchilari — 60 nafar, boshqaruv xodimlari — 9 nafar.</div></div><div class="BY_DEFAULT"><div name="-4169854" id="-4169854"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4169856" id="-4169856">Vazirlar Mahkamasining 2019-yil 16-yanvardagi 38-son <a href="https://lex.uz/uz/docs/-4164213">qaroriga</a><br /> 2-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4169859" id="-4169859">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga oʻquvchi-sportchilarni qabul qilish tartibi toʻgʻrisida</div></div><div class="ACT_FORM"><div name="-4169862" id="-4169862"><strong>NIZOM</strong></div></div><div class="BY_DEFAULT"><div name="-4169871" id="-4169871"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4169872" id="-4169872">1-bob. Umumiy qoidalar</div></div><div class="ACT_TEXT"><div name="-4169873" id="-4169873">1. Ushbu Nizom Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga (keyingi oʻrinlarda sport maktabi deb ataladi) oʻquvchi-sportchilarni qabul qilish tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-4169875" id="-4169875">2. Sport maktabida oʻquvchi-sportchilarning kontingenti, ularning vazn toifalarini hisobga olgan holda, 60 nafardan iborat boʻladi hamda taʼlim olish muddati oʻquvchi-sportchi Oʻzbekiston Respublikasi terma jamoasining asosiy (yoki zaxira) tarkibida boʻlgan davr mobaynida davom etadi.</div></div><div class="ACT_TEXT"><div name="-4169876" id="-4169876">3. Sport maktabiga 18 yosh va undan katta boʻlgan sportchilar qabul qilinadi.</div></div><div class="ACT_TEXT"><div name="-4169877" id="-4169877">4. Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga nomzodlarni tanlab olish va oʻqishga qabul qilish ushbu Nizomning <a href="https://lex.uz/uz/docs/-4164213#-4169955">1-ilovasidagi</a> sxemaga muvofiq amalga oshiriladi. </div></div><div class="ACT_TEXT"><div name="-4169878" id="-4169878">5. Oʻquvchi-sportchilarni sifatli tanlab olishni taʼminlash maqsadida sport maktabi Oʻzbekiston sport kurashlari assotsiatsiyasi bilan birgalikda sport maktabida qabul oʻrinlari boʻshagan kundan boshlab bir oy muddat davomida tanlov va uni oʻtkazish shartlari toʻgʻrisida ommaviy axborot vositalari orqali eʼlon beradi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4169880" id="-4169880">2-bob. Nomzodlardan hujjatlarni qabul qilish</div></div><div class="ACT_TEXT"><div name="-4169882" id="-4169882">6. Nomzodlarning hujjatlarini qabul qilish sport maktabida qabul oʻrinlari boʻshagan muddatdan boshlab amalga oshiriladi. </div></div><div class="ACT_TEXT"><div name="-4169884" id="-4169884">7. Sport maktabiga kirish uchun nomzodlar tomonidan quyidagi hujjatlar taqdim etiladi:</div></div><div class="ACT_TEXT"><div name="-4169887" id="-4169887">sport maktabiga qabul qilish toʻgʻrisida direktor nomiga nomzodning arizasi;</div></div><div class="ACT_TEXT"><div name="-4169888" id="-4169888">pasportning nusxasi (asl nusxalari qabul komissiyasi tomonidan hujjatlarni qabul qilishda taqdim etiladi);</div></div><div class="ACT_TEXT"><div name="-4169890" id="-4169890">F-086-u shaklidagi tibbiy maʼlumotnoma;</div></div><div class="ACT_TEXT"><div name="-4169891" id="-4169891">nomzodning 3,5 x 4,5 sm oʻlchamli 6 ta fotosurati;</div></div><div class="ACT_TEXT"><div name="-4169892" id="-4169892">nomzodning sport toifasini (unvonini) tasdiqlaydigan sportchining klassifikatsiya daftarchasi (guvohnomasi);</div></div><div class="ACT_TEXT"><div name="-4169893" id="-4169893">umurtqa pogʻonasining koʻkrak va bel qismlarining ikki proyeksiyadagi rentgen rasmi va travmatolog xulosasi;</div></div><div class="ACT_TEXT"><div name="-4169894" id="-4169894">koʻkrak qafasi flyurografiyasi rasmi va shifokor (vrach) xulosasi.</div></div><div class="ACT_TEXT"><div name="-4169895" id="-4169895">Mazkur bandda koʻrsatilmagan hujjatlarni talab qilishga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-4169896" id="-4169896">8. Sport maktabiga kiruvchi nomzodlarga quyidagi minimal talablar qoʻyiladi:</div></div><div class="ACT_TEXT"><div name="-4169898" id="-4169898">sport ustaligiga nomzoddan past boʻlmagan sport toifasining mavjudligi;</div></div><div class="ACT_TEXT"><div name="-4169901" id="-4169901">kurashning tegishli yosh guruhlari va uslublari boʻyicha sportchilar oʻrtasida Oʻzbekiston, Osiyo va jahon chempionatlarida egallangan sovrinli oʻrinlarning (1 — 3-oʻrinlar) mavjudligi. </div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4169904" id="-4169904">3-bob. Tanlovni oʻtkazish va oʻqishga qabul qilish</div></div><div class="ACT_TEXT"><div name="-4169905" id="-4169905">9. Sport maktabiga oʻquvchi-sportchilarni tanlovdan oʻtkazish va qabul qilish Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondonining buyrugʻi bilan tasdiqlangan, yetti kishidan iborat (komissiya raisi, kotibi va aʼzolari) tarkibdagi doimiy faoliyat koʻrsatuvchi qabul komissiyasi tomonidan amalga oshiriladi. </div></div><div class="ACT_TEXT"><div name="-4169907" id="-4169907">Qabul komissiyasining raisi va kotibi nomzodlarni qabul qilish, ularning hujjatlarini rasmiylashtirish va saqlash yuzasidan masʼul shaxslar hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-4169913" id="-4169913">10. Sport maktabi direktori komissiyaning raisi hisoblanadi. Komissiya raisi etib, sport maktabining tajribali, malakali mutaxassislaridan biri ham tayinlanishi mumkin. </div></div><div class="ACT_TEXT"><div name="-4169916" id="-4169916">11. Komissiya tarkibiga psixolog, tibbiyot xodimi, Oʻzbekiston sport kurashlari assotsiatsiyasi, shuningdek boshqa manfaatdor sport tashkilotlari vakillari kiritiladi.</div></div><div class="ACT_TEXT"><div name="-4169918" id="-4169918">12. Qabul komissiyasi:</div></div><div class="ACT_TEXT"><div name="-4169921" id="-4169921">sport maktabida oʻqishga nomzodlar, nomzodlarning ota-onalari hamda jamoatchilik oʻrtasida sport maktabiga qabul qilish tartibi, shuningdek, sport maktabining faoliyati toʻgʻrisida tushuntirish ishlarini amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-4169925" id="-4169925">nomzodlar va ota-onalar uchun maslahatlar berilishini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-4169926" id="-4169926">nomzodlarning hujjatlarini qabul qiladi va rasmiylashtiradi;</div></div><div class="ACT_TEXT"><div name="-4169929" id="-4169929">tanlovni tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-4169931" id="-4169931">qabul jarayoni yakunlarini umumlashtiradi.</div></div><div class="ACT_TEXT"><div name="-4169933" id="-4169933">13. Sport maktabiga kirish uchun umumiy jismoniy tayyorgarlik hamda maxsus jismoniy tayyorgarlik boʻyicha tanlovlar nomzodlarning hujjatlari rasmiylashtirilgandan soʻng 10 kun mobaynida oʻtkaziladi.</div></div><div class="ACT_TEXT"><div name="-4169935" id="-4169935">14. Sport maktabiga oʻqishga kirishga nomzodlarning koʻnikmalari, layoqati, bilimlari 100 ballik tizim (eng yuqori ball) boʻyicha baholanadi, shundan 30 ball umumiy jismoniy tayyorgarlikka va 70 ball maxsus jismoniy tayyorgarlikka ajratiladi. </div></div><div class="ACT_TEXT"><div name="-4169938" id="-4169938">15. Umumiy jismoniy tayyorgarlik boʻyicha tanlov sinovlari mazkur Nizomning <a href="https://lex.uz/uz/docs/-4164213#-4169961">2-ilovasiga</a> muvofiq Umumiy jismoniy tayyorgarlik boʻyicha normativlarni bajarish metodikasi asosida, maxsus jismoniy tayyorgarlik boʻyicha tanlov sinovlari esa mazkur Nizomning <a href="https://lex.uz/uz/docs/-4164213#-4169981">3-ilovasiga</a> muvofiq Maxsus jismoniy tayyorgarlik boʻyicha normativlarni bajarish metodikasi asosida oʻtkaziladi hamda baholanadi.</div></div><div class="ACT_TEXT"><div name="-4169939" id="-4169939">16. Sport maktabidagi boʻsh oʻrinlarga tanlovlardan muvaffaqiyatli oʻtgan va eng yuqori ball toʻplagan nomzodlar qabul komissiyasi bayonnomasi asosida qabul qilinadi. </div></div><div class="ACT_TEXT"><div name="-4169940" id="-4169940">Qabul komissiyasining bayonnomasini kotib rasmiylashtiradi va komissiya raisi hamda aʼzolari tomonidan imzolanadi.</div></div><div class="ACT_TEXT"><div name="-4169941" id="-4169941">17. Tanlov natijalari qabul komissiyasi tomonidan bayonnoma rasmiylashtirilganidan soʻng bir kun mobaynida eʼlon qilinadi.</div></div><div class="ACT_TEXT"><div name="-4169942" id="-4169942">18. Sport maktabi direktorining nomzodlarni oʻquvchi-sportchilar safiga qabul qilish toʻgʻrisidagi buyrugʻi bayonnoma rasmiylashtirilganidan soʻng uch kun ichida chiqariladi.</div></div><div class="ACT_TEXT"><div name="-4169943" id="-4169943">19. Tanlov natijalariga koʻra nomzodlarning oʻtish ballari teng boʻlib qolgan taqdirda, sport musobaqalarida erishgan natijalari yuqori boʻlgan nomzodlar sport maktabiga oʻqishga qabul qilinadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4169944" id="-4169944">4-bob. Tanlov natijalari yuzasidan berilgan murojaatlarni koʻrib chiqish</div></div><div class="ACT_TEXT"><div name="-4169945" id="-4169945">20. Tanlov natijalari boʻyicha berilgan murojaatlarni koʻrib chiqish uchun sport maktabi direktorining buyrugʻi bilan apellatsiya komissiyasi tashkil etiladi va kamida 3 kishidan iborat tarkibda tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-4169946" id="-4169946">Apellatsiya komissiyasi qabul komissiyasi tarkibida boʻlmagan sport maktabi mutaxassislaridan shakllantiriladi.</div></div><div class="ACT_TEXT"><div name="-4169947" id="-4169947">21. Murojaatlar kelib tushgan paytdan boshlab uch ish kuni ichida apellatsiya komissiyasi tomonidan koʻrib chiqiladi va tegishli qaror qabul qilinadi. Murojaatni koʻrib chiqish vaqtida murojaat qilgan shaxs apellatsiya komissiyasi ishida oʻzining iltimosiga asosan ishtirok etishi mumkin. </div></div><div class="ACT_TEXT"><div name="-4169948" id="-4169948">22. Qabul qilingan qaror natijasi boʻyicha murojaat qilgan shaxsga bir ish kuni ichida apellatsiya komissiyasi tomonidan yozma ravishda maʼlum qilinadi.</div></div><div class="ACT_TEXT"><div name="-4169949" id="-4169949">23. Apellatsiya komissiyasi murojaatni koʻrib chiqish natijalariga koʻra tanlov natijasini bekor qilishi yoki unga tegishli oʻzgartirish kiritishi mumkin.</div></div><div class="BY_DEFAULT"><div name="-5973466" id="-5973466"></div></div><div class="ACT_TEXT"><div name="-5973469" id="-5973469">24. Apellatsiya komissiyasining murojaatni koʻrib chiqish natijalari boʻyicha qabul qilgan qarori yuzasidan qonunchilik hujjatlarida belgilangan tartibda yuqori turuvchi organga yoki sudga murojaat qilinishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4169951" id="-4169951">5-bob. Yakuniy qoidalar</div></div><div class="ACT_TEXT"><div name="-4169952" id="-4169952">25. Sport maktabining barcha oʻquvchi-sportchilari oʻquv yili mobaynida har oyda ixtisosi boʻyicha, shuningdek, umumiy va jismoniy tayyorgarlik boʻyicha nazorat sinovlari topshiradilar. </div></div><div class="ACT_TEXT"><div name="-4169953" id="-4169953">26. Yil mobaynida ixtisosi boʻyicha oʻquv dasturlari talablarini bajarmagan va nazorat sinovlaridan oʻtmagan, ichki tartib-qoidalarni buzgan, sogʻligʻining holatiga koʻra oʻqishga noloyiq boʻlgan oʻquvchi-sportchilar sport maktabi oʻquvchi-sportchilari safidan chetlatiladi.</div></div><div class="ACT_TEXT"><div name="-4169954" id="-4169954">27. Sport maktabidan turli sabablarga koʻra oʻquvchi-sportchilar safidan chetlatilganlar oʻrni mazkur Nizomda belgilangan tartibda yil davomida toʻldirilib boriladi.</div></div><div class="BY_DEFAULT"><div name="-4169955" id="-4169955"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4169956" id="-4169956">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga oʻquvchi-sportchilarni qabul qilish tartibi toʻgʻrisida <a href="https://lex.uz/uz/docs/-4164213#-4169854">nizomga</a><br /> 1-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4169957" id="-4169957">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga nomzodlarni tanlab olish va oʻqishga qabul qilish</div></div><div class="ACT_FORM"><div name="-4169958" id="-4169958"><strong>SXEMASI</strong></div></div><div class="BY_DEFAULT"><div name="-4169959" id="-4169959"></div></div><div class="TEXT_CENTER"><div name="-4169960" id="-4169960"><img src="https://lex.uz/uz/files/4175813" /></div></div><div class="BY_DEFAULT"><div name="-4169961" id="-4169961"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4169962" id="-4169962">Oʻzbekiston Respublikasi Milliy gvardiyasining Sport kurashlari boʻyicha ixtisoslashtirilgan olimpiya zaxiralari maktabiga oʻquvchi-sportchilarni qabul qilish tartibi toʻgʻrisida <a href="https://lex.uz/uz/docs/-4164213#-4169854">nizomga</a><br /> 2-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4169965" id="-4169965">Umumiy jismoniy tayyorgarlik boʻyicha normativlarni bajarish</div></div><div class="ACT_FORM"><div name="-4169968" id="-4169968"><strong>METODIKASI</strong></div></div><div class="BY_DEFAULT"><div name="-4169969" id="-4169969"></div></div><div class="ACT_TEXT"><div name="-4169971" id="-4169971">1. Umumiy jismoniy tayyorgarlik boʻyicha sinovga qoʻyiladigan eng yuqori ball — 30 ballni tashkil qiladi. </div></div><div class="ACT_TEXT"><div name="-4169972" id="-4169972">2. Umumiy jismoniy tayyorgarlik boʻyicha sinovlarda nomzod mazkur Metodikaning <a href="https://lex.uz/uz/docs/-4164213#-4169981">ilovasida</a> koʻrsatilgan normativlarni bajaradi. Bunda:</div></div><div class="ACT_TEXT"><div name="-4169974" id="-4169974"><strong>100 metrga yugurish</strong> — mashq past startda belgilangan chiziqdan “Startga!”, “Diqqat!”, “Yugur!” buyruqlari bilan bajariladi. Mashq “start”dan “marra” chizigʻigacha boʻlgan masofa boʻylab yugurish orqali bajariladi. Ushbu mashq uch urinishda bajariladi va eng yaxshi natija hisobga olinadi. Natija 0,1 soniyagacha aniqlanadi; </div></div><div class="ACT_TEXT"><div name="-4169975" id="-4169975"><strong>1500 metrga yugurish</strong> — mashq yuqori startda belgilangan chiziqdan “Startga!”, “Diqqat!”, “Yugur!” buyruqlari bilan bajariladi. Mashq “start”dan “marra” chizigʻigacha boʻlgan masofa boʻylab yugurish orqali bajariladi. Ushbu mashq bir urinishda bajariladi va natija hisobga olinadi. Natija 0,1 soniyagacha aniqlanadi;</div></div><div class="ACT_TEXT"><div name="-4169977" id="-4169977"><strong>“mokisimon” yugurish (3 x 10 metr)</strong> — mashq yuqori startda belgilangan chiziqdan “Startga!”, “Diqqat!”, “Yugur!” buyruqlari bilan oraligʻi 120 sm boʻlgan ikki tomonidan chizilgan, 10 metr masofali yoʻlakcha ichida yugurish orqali bajariladi. Yugurish jarayonida burilishlarda oyoq uchlari chiziqdan tashqariga chiqmagan holda bajarilgan mashq hisobga olinmaydi. Ushbu mashq uch urinishda bajariladi va eng yaxshi natija hisobga olinadi. Natija 0,1 soniyagacha aniqlanadi;</div></div><div class="ACT_TEXT"><div name="-4169978" id="-4169978"><strong>turnikda tortilish</strong> — mashq turnikka ikki qoʻlda toʻgʻri osilib turgan hamda oyoqlar erga tegmagan holatda, iyak turnik poyasidan oʻtgunga qadar qoʻllarni bukish orqali bajariladi. Mashq bajarish jarayonida oyoqlarni kerish yoki bukish, tanani harakatsiz holatda egish, oyoqlar bilan siltanma harakatlar qilish hamda iyak turnik poyasidan oʻtmagunga qadar tortilish orqali bajarilgan harakatlar hisobga olinmaydi;</div></div><div class="ACT_TEXT"><div name="-4169979" id="-4169979"><strong>arqonga tirmashib chiqish</strong> — mashq arqonga tirmashib, oyoqlar yordamisiz qoʻllarda yuqoriga chiqib bajariladi. Mashq jarayonida oyoq yordamida bajarilgan chiqish hisobga olinmaydi. Ushbu mashq besh marta bajariladi va toʻgʻri bajarilgan mashq hisobga olinadi. Mashq bajarib boʻlingandan soʻng erga (dastlabki holat)ga tushiladi va yana bajariladi.</div></div><div class="ACT_TEXT"><div name="-4169980" id="-4169980"><strong>oʻz vazniga teng ogʻirlikdagi shtanga bilan oʻtirib turish</strong> — mashq “Boshla!” buyrugʻi bilan bajariladi. Dastlabki holat: Oyoqlar yelka kengligida tik turgan holatda. “Boshla!” buyrugʻidan soʻng, belgilangan ogʻirlikdagi shtanga yelkaga olinadi va shu holatda shtanga bilan oʻtirib turiladi. Mashq bajarilgandan soʻng dastlabki holatga qaytiladi.</div></div><div class="BY_DEFAULT"><div name="-4169981" id="-4169981"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4169984" id="-4169984">Umumiy jismoniy tayyorgarlik boʻyicha normativlarni bajarish <a href="https://lex.uz/uz/docs/-4164213#-4169961">metodikasiga</a><br /> ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-4169987" id="-4169987">Umumiy jismoniy tayyorgarlik boʻyicha</div></div><div class="ACT_FORM"><div name="-4169988" id="-4169988"><strong>NORMATIVLAR</strong></div></div><div class="BY_DEFAULT"><div name="-4169990" id="-4169990"></div></div><div class="BY_DEFAULT"><div name="-4169992" id="-4169992"><div align="center">
