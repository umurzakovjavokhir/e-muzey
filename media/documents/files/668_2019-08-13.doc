ily:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-4474204" id="-4474204">Oʻzbekiston Respublikasi Vazirlar Mahkamasining</div></div><div class="ACT_FORM"><div name="-4474205" id="-4474205">qarori</div></div><div class="BY_DEFAULT"><div name="-8092673" id="-8092673"></div></div><div class="ACT_TITLE"><div name="-8092675" id="-8092675">Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi qoʻriqlash boʻlinmalari tomonidan jismoniy va yuridik shaxslar mol-mulki hamda obyektlarini qoʻriqlash borasida koʻrsatiladigan xizmatlar tariflarini belgilash metodikasini tasdiqlash toʻgʻrisida</div></div><div class="BY_DEFAULT"><div name="-4474208" id="-4474208"></div></div><div class="BY_DEFAULT"><div name="-8092679" id="-8092679"></div></div><div class="ACT_TEXT"><div name="-8092680" id="-8092680">Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi qoʻriqlash boʻlinmalari tomonidan koʻrsatiladigan qoʻriqlash xizmati tariflarini shakllantirishni tartibga solish, bunda ochiqlik va shaffoflikni taʼminlash maqsadida Vazirlar Mahkamasi qaror qiladi:</div></div><div class="BY_DEFAULT"><div name="-8092683" id="-8092683"></div></div><div class="ACT_TEXT"><div name="-8092684" id="-8092684">2. Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi qoʻriqlash boʻlinmalari tomonidan jismoniy va yuridik shaxslar mol-mulki hamda obyektlarini qoʻriqlash borasida koʻrsatiladigan xizmatlar tariflarini belgilash metodikasi <a href="https://lex.uz/uz/docs/-4472471?ONDATE=14.08.2019 00#-4475989">ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="BY_DEFAULT"><div name="-8092686" id="-8092686"></div></div><div class="ACT_TEXT"><div name="-8092687" id="-8092687">3. Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi qoʻriqlash xizmati tariflarini ishlab chiqishda Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi qoʻriqlash boʻlinmalari tomonidan jismoniy va yuridik shaxslar mol-mulki xamda obyektlarini qoʻriqlash borasida koʻrsatiladigan xizmatlar tariflarini belgilash metodikasiga amal qilsin.</div></div><div class="ACT_TEXT"><div name="-4475982" id="-4475982">4. Mazkur qarorning bajarilishini nazorat qilish Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoni B.X. Tashmatov zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-4475983" id="-4475983">Oʻzbekiston Respublikasining Bosh vaziri A. ARIPOV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4475985" id="-4475985">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4475986" id="-4475986">2019-yil 13-avgust,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-4475987" id="-4475987">668-son</div></div><div class="BY_DEFAULT"><div name="-4475989" id="-4475989"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4475992" id="-4475992">Vazirlar Mahkamasining 2019-yil 13-avgustdagi 668-son <a href="https://lex.uz/uz/docs/-4472471">qaroriga </a><br />ILOVA</div></div><div class="BY_DEFAULT"><div name="-8092689" id="-8092689"></div></div><div class="ACT_TITLE_APPL"><div name="-8092690" id="-8092690">Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi qoʻriqlash  boʻlinmalari tomonidan jismoniy va yuridik shaxslar mol-mulki xamda obyektlarini qoʻriqlash borasida koʻrsatiladigan xizmatlar tariflarini belgilash</div></div><div class="ACT_FORM"><div name="-8092691" id="-8092691">METODIKASI</div></div><div class="BY_DEFAULT"><div name="-4475996" id="-4475996"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4475998" id="-4475998">1-bob. Umumin qoidalar</div></div><div class="BY_DEFAULT"><div name="-8092693" id="-8092693"></div></div><div class="ACT_TEXT"><div name="-8092694" id="-8092694">1. Ushbu metodika Oʻzbekiston Respublikasi Ichki ishlar vazirligi huzuridagi Qoʻriqlash departamenti hamda Milliy gvardiyasi Muhim davlat obyektlarini qoʻriqlash boshqarmasi boʻlinmalari (keyingi oʻrinlarda qoʻriqlash boʻlinmalari deb ataladi) tomonidan koʻrsatiladigan jismoniy va yuridik shaxslarning mol-mulki hamda obyektlarini qoʻriqlash xizmatlarining, shuningdek, shartnoma asosida mol-mulk qoʻriqlovini taʼminlash bilan bogʻliq boshqa xizmatlarning tariflarini belgilash tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-4476001" id="-4476001">2. Jismoniy va yuridik shaxslar mol-mulki xamda obyektlarini qoʻriqlash boʻyicha koʻrsatiladigan xizmatlar, shuningdek, shartnoma asosida mol-mulk qoʻriqlovini taʼminlash bilan bogʻlik boshqa xizmatlar tariflari (keyingi oʻrinlarda tarif deb ataladi) qoʻriqlash xizmatining xar bir turi boʻyicha belgilanadi:</div></div><div class="ACT_TEXT"><div name="-4476003" id="-4476003">saf boʻlinmalari naryadlari bilan qoʻriqlash;</div></div><div class="ACT_TEXT"><div name="-4476004" id="-4476004">harbiylashtirilgan boʻlinmalar bilan qoʻriqlash;</div></div><div class="ACT_TEXT"><div name="-4476006" id="-4476006">erkin yollangan qorovullar bilan qoʻriqlash;</div></div><div class="ACT_TEXT"><div name="-4476007" id="-4476007">texnik vositalar yordamida qoʻriqlash (texnik qoʻriqlash).</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4476009" id="-4476009">2-bob. Tarifni hisob-kitob qilishda qoʻllaniladigan xarajatlar</div></div><div class="BY_DEFAULT"><div name="-6033831" id="-6033831"></div></div><div class="ACT_TEXT"><div name="-6033833" id="-6033833">3. Qoʻriqlash boʻlinmalari tomonidan koʻrsatiladigan qoʻriqlash xizmatlarining tariflarining xizmat tannarxiga kiritilgan sarf-xarajatlar, davr xarajatlari, moliyaviy faoliyat boʻyicha xarajatlar, soliq va yigʻimlar boʻyicha xarajatlar yigʻindisidan kelib chiqib hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-4476014" id="-4476014">4. Asosiy vositalarning eskirishi amortizatsiya ajratmalari hisobidan qoplanadi.</div></div><div class="ACT_TEXT"><div name="-4476016" id="-4476016">5. Har bir qoʻriqlash turi boʻyicha tarifni hisoblash xizmatga tegishli haqiqiy sarf-xarajatlar koʻrsatkichlari asosida amalga oshiriladi va toʻgʻridan-toʻgʻri xarajatlar (X<sub>t</sub>) hamda ustama xarajatlarning tegishli xizmat turiga toʻgʻri keladigan qismidan tashkil topadi.</div></div><div class="ACT_TEXT"><div name="-4476018" id="-4476018">Qoʻriqlash xizmatini koʻrsatish bilan bogʻliq toʻgʻridan-toʻgʻri xarajatlar pul taʼminoti va kiyim-kechak taʼminotini oʻz ichiga oladi.</div></div><div class="ACT_TEXT"><div name="-4476020" id="-4476020">6. Ustama xarajatlarning qoʻriqlash xizmatlari turlari boʻyicha taqsimlanishi har bir qoʻriqlash turi boʻyicha yil davomida koʻrsatilgan xizmat hajmiga mutanosib ravishda amalga oshiriladi va quyidagi formula asosida hisoblanadi:</div></div><div class="TEXT_CENTER"><div name="-4476022" id="-4476022">X<sub>ut</sub> = (X<sub>u</sub>/ U) x U<sub>xt </sub>,</div></div><div class="ACT_TEXT"><div name="-4476026" id="-4476026">bunda:</div></div><div class="ACT_TEXT"><div name="-4476028" id="-4476028">X<sub>ut</sub> — qoʻriqlash xizmati turlari boʻyicha ustama xarajatlar;</div></div><div class="ACT_TEXT"><div name="-4476030" id="-4476030">X<sub>u</sub> — qoʻriqlash boʻlinmalari faoliyatini boshqarish bilan bogʻlik umumiy yillik ustama xarajatlari. Bunga quyidagi xarajatlar kiradi:</div></div><div class="ACT_TEXT"><div name="-4476031" id="-4476031">maʼmuriy-boshqaruv xodimlari va qoʻmondonlik tarkibini saqlash xarajatlari;</div></div><div class="ACT_TEXT"><div name="-4476033" id="-4476033">asosiy vositalarning amortizatsiyasi;</div></div><div class="ACT_TEXT"><div name="-4476034" id="-4476034">xizmat safarlari xarajatlari;</div></div><div class="ACT_TEXT"><div name="-4476035" id="-4476035">ijtimoiy nafaqalar;</div></div><div class="ACT_TEXT"><div name="-4476036" id="-4476036">kommunal xarajatlar;</div></div><div class="BY_DEFAULT"><div name="-6033839" id="-6033839"></div></div><div class="ACT_TEXT"><div name="-6033840" id="-6033840">soliq va yigʻimlar;</div></div><div class="ACT_TEXT"><div name="-4476038" id="-4476038">avtotransport vositalarini saqlash va sugʻurtalash;</div></div><div class="ACT_TEXT"><div name="-4476039" id="-4476039">tavakkalchilik sugʻurtasi;</div></div><div class="ACT_TEXT"><div name="-4476040" id="-4476040">benzin va yoqilgʻi moylash materiallari sotib olish;</div></div><div class="ACT_TEXT"><div name="-4476041" id="-4476041">bank xizmatlari;</div></div><div class="ACT_TEXT"><div name="-4476042" id="-4476042">kanselyariya mollari sotib olish;</div></div><div class="ACT_TEXT"><div name="-4476044" id="-4476044">ijara xarajatlari;</div></div><div class="ACT_TEXT"><div name="-4476045" id="-4476045">oʻqitish;</div></div><div class="ACT_TEXT"><div name="-4476047" id="-4476047">dezinfeksiya;</div></div><div class="ACT_TEXT"><div name="-4476048" id="-4476048">poligrafiya xarajatlari;</div></div><div class="ACT_TEXT"><div name="-4476050" id="-4476050">aloqa va obuna xarajatlari;</div></div><div class="ACT_TEXT"><div name="-4476052" id="-4476052">texnika va uskunalar sotib olish;</div></div><div class="ACT_TEXT"><div name="-4476054" id="-4476054">asosiy vositalarning joriy taʼmiri;</div></div><div class="ACT_TEXT"><div name="-4476056" id="-4476056">bino va inshootlarni qurish;</div></div><div class="ACT_TEXT"><div name="-4476060" id="-4476060">qoʻriqlash uskunalarini oʻrnatish va xizmat koʻrsatish;</div></div><div class="ACT_TEXT"><div name="-4476062" id="-4476062">harbiy mulkni sotib olish xarajatlari.</div></div><div class="ACT_TEXT"><div name="-4476064" id="-4476064">U — koʻrsatilgan xizmatlarning umumiy yillik hajmi;</div></div><div class="ACT_TEXT"><div name="-4476065" id="-4476065">U<sub>xt</sub> — qoʻriqlash turi boʻyicha koʻrsatilgan xizmatlarning yillik hajmi.</div></div><div class="ACT_TEXT"><div name="-4476067" id="-4476067">Bunda qoʻriqlash boʻlinmalari faoliyati bilan bogʻliq umumiy yillik ustama xarajatlar narxlarining keyingi davrlar uchun qayta hisoblanishi Vazirlar Mahkamasining “Tovar bozorlarida monopoliyaga qarshi tartibga solishni yanada takomillashtirish chora-tadbirlari toʻgʻrisida” 2018-yil 30-martdagi 249-son <a href="https://lex.uz/uz/docs/-3607952">qaroriga </a>muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4476069" id="-4476069">Qoʻriqlash xizmatining prognozlashtirilgan umumiy xarajatlari qoʻriqlash xizmatiga sarflangan haqiqiy xarajatlar va oxirgi toʻrt chorak hisobot koʻrsatkichlarining tahlili asosida hamda prognozlashtirilgan xarajatlarni va narxlar oʻzgarishini hisobga olgan holda hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-4476071" id="-4476071">Qoʻriqlash xizmatining har bir turi boʻyicha prognoz qilingan xarajatlar hajmi quyidagi formula asosida belgilanadi:</div></div><div class="TEXT_CENTER"><div name="-4476074" id="-4476074">X<sub>qt</sub> = X<sub>tt</sub> + X<sub>ut </sub>,</div></div><div class="ACT_TEXT"><div name="-4476075" id="-4476075">bunda:</div></div><div class="ACT_TEXT"><div name="-4476076" id="-4476076">X<sub>tt</sub> — tegishli qoʻriqlash xizmati turiga prognozlashtirilgan toʻgʻridan-toʻgʻri xarajatlar;</div></div><div class="ACT_TEXT"><div name="-4476078" id="-4476078">X<sub>ut</sub> — tegishli qoʻriqlash xizmati turiga toʻgʻri keladigan prognozlashtirilgan ustama xarajatlarning qismi;</div></div><div class="ACT_TEXT"><div name="-4476079" id="-4476079">X<sub>qt</sub> — jismoniy va yuridik shaxslarning mol-mulkini va obyektlarini qoʻriqlash boʻyicha tegishli qoʻriqlash turiga bevosita bogʻliq boʻlgan va prognozlashtirilgan xarajatlarning yillik summasi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-4476081" id="-4476081">3-bob. Qoʻriqlash xizmati turlari boʻyicha tariflarni shakllantirish</div></div><div class="ACT_TEXT"><div name="-4476082" id="-4476082">7. Har bir qoʻriqlash turi boʻyicha qoʻriqlash xizmatining bir soatlik prognozlashtirilgan narxi (TqT) quyidagicha aniqlanadi:</div></div><div class="TEXT_CENTER"><div name="-4476086" id="-4476086">T<sub>qt</sub> = X<sub>qt</sub> / V<sub>qt</sub> ,</div></div><div class="ACT_TEXT"><div name="-4476088" id="-4476088">bunda:</div></div><div class="ACT_TEXT"><div name="-4476090" id="-4476090">X<sub>qt</sub> — tegishli qoʻriqlash turiga prognozlashtirilgan xarajat hajmi;</div></div><div class="ACT_TEXT"><div name="-4476091" id="-4476091">V<sub>kt</sub> — tegishli qoʻriqlash turining taxmin qilingan vaqti, soat.</div></div><div class="ACT_TEXT"><div name="-4476094" id="-4476094">Masalan, qoʻriqlash saf boʻlinmalari naryadlari bilan qoʻriqlashning bir post-soati tarifi (TPSB) qoʻriqlash saf boʻlinmalari naryadlari bilan qoʻriqlashga prognoz qilingan xarajatlar hajmining taxmin qilingan qoʻriqlash vaqtiga nisbati orqali aniqlanadi.</div></div><div class="ACT_TEXT"><div name="-4476095" id="-4476095">8. Texnik qoʻriqlashning tarifi (T<sub>tq</sub>) quyidagi formula boʻyicha aniqlanadi:</div></div><div class="TEXT_CENTER"><div name="-4476096" id="-4476096">T<sub>tq</sub> = X<sub>tq </sub>/ V<sub>tq </sub>,</div></div><div class="ACT_TEXT"><div name="-4476100" id="-4476100">bunda:</div></div><div class="ACT_TEXT"><div name="-4476101" id="-4476101">X<sub>tq</sub> — jismoniy va yuridik shaxslar mol-mulki hamda obyektlarini texnik vositalar yordamida qoʻriqlash xizmatlarini koʻrsatish bilan bevosita bogʻliq boʻlgan xarajatlarning prognozlashtirilgan yillik summasi. Bunga quyidagilar kiradi:</div></div><div class="BY_DEFAULT"><div name="-6001380" id="-6001380"></div></div><div class="ACT_TEXT"><div name="-6001384" id="-6001384">pul taʼminoti (lavozim maoshi, maxsus unvon boʻyicha maoshi, xizmat yillari uchun foizli ustama, Oʻzbekiston Respublikasi qonunchilik hujjatlarida belgilangan ustama va boshqa qoʻshimcha toʻlovlar), davlat majburiy sugʻurtasi, pensiya huquqiga ega xodimni ishdan boʻshatish munosabati bilan beriladigan bir martalik nafaqa, xodimning yaralanishi yoki halok boʻlishi bilan bogʻliq beriladigan bir martalik nafaqa, turar joyni vaqtincha ijaraga olganlik (ijarada turganlik) uchun pul kompensatsiyasi, xizmat safari xarajatlari hamda navbatdagi taʼtilga borib-kelishdagi yoʻlkira xarajatlari toʻlovlari;</div></div><div class="ACT_TEXT"><div name="-4476103" id="-4476103">texnik qoʻriqlash punkti (keyingi oʻrinlarda TQP deb ataladi) xodimlari hamda qoʻriqlash tizimlari naryadlari bilan “Tashvish” signaliga javob beradigan, shuningdek, patrullik qiladigan va qoʻriqlanayotgan obyektlardan TQPlarga kelib tushayotgan “Tashvish” signallariga tezkor javob beradigan xodimlarning kiyim-kechak taʼminoti;</div></div><div class="ACT_TEXT"><div name="-4476104" id="-4476104">maxsus vositalar sotib olish va saqlash (qurol-yarogʻ, aslahalar va ularga oʻq-dorilar, shaxsiy himoya va faol himoyalanish vositalari);</div></div><div class="ACT_TEXT"><div name="-4476105" id="-4476105">avtomototransportni saqlash;</div></div><div class="ACT_TEXT"><div name="-4476106" id="-4476106">maxsus texnika va xizmat radioaloka vositalarini saqlash;</div></div><div class="ACT_TEXT"><div name="-4476107" id="-4476107">TQP ishchilarini saqlash (lavozim maoshi, kompensatsiya va ragʻbatlantirish xususiyatiga ega toʻlovlar, ish haqlarini hududiy tartibga soladigan toʻlovlar, shu jumladan ogʻir iqlim sharoitiga ega boʻlgan hududlarda tuman koeffitsiyenti va ish haqiga foizli ustama toʻlovlari, ishdan boʻshatilish chogʻida beriladigan nafaqa, ish bilan taʼminlanish davrida oʻrtacha oylik ish haqini saqlab qolish, oʻrindoshlik uchun toʻlov, moddiy yordam);</div></div><div class="ACT_TEXT"><div name="-4476109" id="-4476109">qoʻriqlash texnika vositalarini ishlatish va taʼmirlash xarajatlari;</div></div><div class="ACT_TEXT"><div name="-4476110" id="-4476110">simli va (yoki) simsiz aloqa operatorlarining xizmatlari uchun toʻlovlar;</div></div><div class="ACT_TEXT"><div name="-4476111" id="-4476111">bino, xonalarni saqlash (kommunal xizmatlar) hamda ijaraga olish boʻyicha toʻlovlar;</div></div><div class="ACT_TEXT"><div name="-4476112" id="-4476112">asosiy vositalar amortizatsiyasi;</div></div><div class="ACT_TEXT"><div name="-4476113" id="-4476113">ustama xarajatlar (ushbu Metodikaning <a href="https://lex.uz/uz/docs/-4472471#-4476020">6-bandida </a>keltirilgan formula boʻyicha aniqlanadi);</div></div><div class="ACT_TEXT"><div name="-4476115" id="-4476115">V<sub>tq </sub>— tuzilgan shartnomalarga muvofiq jismoniy va yuridik shaxslar mol-mulki hamda obyektlarini texnik vositalar yordamida qoʻriqlash soatlari miqdori.</div></div><div class="ACT_TEXT"><div name="-4476116" id="-4476116">9. “Tashvish” signali boʻyicha bir soatlik xizmat tarifi texnik qoʻriqlashning bir soatlik narxining 50% miqdorida belgilanadi.</div></div><div class="ACT_TEXT"><div name="-4476117" id="-4476117">10. Soxta “tashvish” signali boʻyicha chiqish tarifi (T<sub>sts</sub>) kuyidagi formula boʻyicha aniqlanadi:</div></div><div class="TEXT_CENTER"><div name="-4476122" id="-4476122">T<sub>sts</sub> = ((T<sub>psb</sub> / X<sub>s</sub>) x S x V) + X ,</div></div><div class="ACT_TEXT"><div name="-4476124" id="-4476124">bunda:</div></div><div class="ACT_TEXT"><div name="-4476125" id="-4476125">T<sub>psb</sub> — qoʻriqlash saf boʻlinmalari naryadlari bilan qoʻriqlashning bir post-soati tarifi;</div></div><div class="ACT_TEXT"><div name="-4476127" id="-4476127">X<sub>s</sub> — saf boʻlinmalari naryadlari bilan qoʻriqlashning bitta postiga ajratilgan xodimlar soni;</div></div><div class="ACT_TEXT"><div name="-4476128" id="-4476128">S — qoʻriqlashni taʼminlash uchun ajratiladigan xodimlar soni;</div></div><div class="ACT_TEXT"><div name="-4476129" id="-4476129">B — qoʻriqlashning haqiqiy vaqti (soat);</div></div><div class="ACT_TEXT"><div name="-4476131" id="-4476131">X — jalb qilingan xizmat avtotransportining xarajatlari (mashina/soat). Mashina/soatlarni hisoblash avtotransport korxonalarining hisob-kitoblari asosida amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-4476132" id="-4476132">11. Texnik qoʻriqlash tarifi quyidagi turlar boʻyicha hisoblanishi mumkin: fuqarolarning mol-mulki saqlanadigan joylar, xonadonlar, tashkilot va muassasalar obyektlari.</div></div><div class="ACT_TEXT"><div name="-4476134" id="-4476134">12. Harbiylashtirilgan qoʻriqlash boʻlinmalari bilan qoʻriqlashning bir post-soat tarifi (T<sub>PXB</sub>) koʻyidagi formula boʻyicha aniqlanadi:</div></div><div class="TEXT_CENTER"><div name="-4476148" id="-4476148">T<sub>pxb</sub> = X<sub>xb</sub> / S<sub>xb </sub>,</div></div><div class="ACT_TEXT"><div name="-4476150" id="-4476150">bunda:</div></div><div class="ACT_TEXT"><div name="-4476154" id="-4476154">X<sub>xb</sub> — harbiylashtirilgan qoʻriqlash boʻlinmalari bilan qoʻriqlash uchun prognozlashtirilgan xarajatlar:</div></div><div class="BY_DEFAULT"><div name="-6001398" id="-6001398"></div></div><div class="ACT_TEXT"><div name="-6001400" id="-6001400">pul taʼminoti (lavozim maoshi, xizmat yillari uchun foizli ustama, Oʻzbekiston Respublikasi qonunchilik hujjatlarida belgilangan ustama va boshqa qoʻshimcha toʻlovlar);</div></div><div class="ACT_TEXT"><div name="-4476157" id="-4476157">davlat majburiy sugʻurtasi;</div></div><div class="ACT_TEXT"><div name="-4476158" id="-4476158">kiyim-kechak taʼminoti;</div></div><div class="ACT_TEXT"><div name="-4476160" id="-4476160">maxsus vositalarni sotib olish va saqlash (qurol-yarogʻ, aslahalar va oʻq-dorilar, shaxsiy himoya va faol mudofaa vositalari);</div></div><div class="ACT_TEXT"><div name="-4476162" id="-4476162">ustama xarajatlar (ushbu Metodikaning <a href="https://lex.uz/uz/docs/-4472471#-4476020">6-bandida </a>keltirilgan formula boʻyicha aniqlanadi);</div></div><div class="ACT_TEXT"><div name="-4476163" id="-4476163">S<sub>xb</sub> — harbiylashtirilgan qoʻriqlash boʻlinmalari bilan qoʻriqlashning taxmin qilingan soatlari.</div></div><div class="ACT_TEXT"><div name="-4476166" id="-4476166">13. Qoʻriqlash boʻlinmalarining erkin yollangan qorovullari bilan qoʻriqlashning bir post-soat tarifi (T<sub>peq</sub>) quyidagi formula boʻyicha aniqlanadi:</div></div><div class="TEXT_CENTER"><div name="-4476169" id="-4476169">T<sub>peq</sub> = X<sub>eq</sub> / S<sub>eq</sub> ,</div></div><div class="ACT_TEXT"><div name="-4476173" id="-4476173">bunda:</div></div><div class="ACT_TEXT"><div name="-4476176" id="-4476176">X<sub>eq</sub> — erkin yollangan qorovullar bilan qoʻriqlashga prognozlashtirilgan xarajatlar. Bunga quyidagi xarajatlar kiradi::</div></div><div class="BY_DEFAULT"><div name="-6001403" id="-6001403"></div></div><div class="ACT_TEXT"><div name="-6001404" id="-6001404">pul taʼminoti (lavozim maoshi, xizmat yillari uchun foizli ustama, Oʻzbekiston Respublikasi qonunchilik hujjatlarida belgilangan ustama va boshqa qoʻshimcha toʻlovlar);</div></div><div class="ACT_TEXT"><div name="-4476178" id="-4476178">davlat majburiy sugʻurtasi;</div></div><div class="ACT_TEXT"><div name="-4476180" id="-4476180">kiyim-kechak taʼminoti;</div></div><div class="ACT_TEXT"><div name="-4476182" id="-4476182">ustama xarajatlar (ushbu Metodikaning <a href="https://lex.uz/uz/docs/-4472471#-4476020">6-bandida </a>keltirilgan formula boʻyicha aniqlanadi);</div></div><div class="ACT_TEXT"><div name="-4476183" id="-4476183">S<sub>eq </sub>— erkin yollangan qorovullar bilan qoʻriqlashning taxmin qilingan soatlari.</div></div></div>
</div></body></html>