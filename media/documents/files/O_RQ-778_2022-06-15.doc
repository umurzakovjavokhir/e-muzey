<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-6067804" id="-6067804"></div></div><div class="ACT_FORM"><div name="-6067807" id="-6067807">Oʻzbekiston Respublikasining Qonuni</div></div><div class="ACT_TITLE"><div name="-6067809" id="-6067809">Qoʻriqlash faoliyati toʻgʻrisida</div></div><div class="GRIF_PARLAMENT"><div name="-6067814" id="-6067814">Qonunchilik palatasi tomonidan 2022-yil 1-fevralda qabul qilingan<br /> Senat tomonidan 2022-yil 28-aprelda maʼqullangan </div></div><div class="BY_DEFAULT"><div name="-6067819" id="-6067819"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6067822" id="-6067822">1-bob. Umumiy qoidalar</div></div><div class="CLAUSE_DEFAULT"><div name="-6067826" id="-6067826">1-modda. Ushbu Qonunning maqsadi</div></div><div class="ACT_TEXT"><div name="-6067829" id="-6067829">Ushbu Qonunning maqsadi qoʻriqlash faoliyati sohasidagi munosabatlarni tartibga solishdan iborat.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067831" id="-6067831">2-modda. Qoʻriqlash faoliyati toʻgʻrisidagi qonunchilik</div></div><div class="ACT_TEXT"><div name="-6067832" id="-6067832">Qoʻriqlash faoliyati toʻgʻrisidagi qonunchilik ushbu Qonun va boshqa qonunchilik hujjatlaridan iboratdir.</div></div><div class="ACT_TEXT"><div name="-6067833" id="-6067833">Agar Oʻzbekiston Respublikasining xalqaro shartnomasida Oʻzbekiston Respublikasining qoʻriqlash faoliyati toʻgʻrisidagi qonunchiligida nazarda tutilganidan boshqacha qoidalar belgilangan boʻlsa, xalqaro shartnoma qoidalari qoʻllaniladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067835" id="-6067835">3-modda. Asosiy tushunchalar</div></div><div class="ACT_TEXT"><div name="-6067836" id="-6067836">Ushbu Qonunda quyidagi asosiy tushunchalar qoʻllaniladi: </div></div><div class="BY_DEFAULT"><div name="-8230423" id="-8230423"></div></div><div class="ACT_TEXT"><div name="-8230424" id="-8230424"><strong>idoraviy jihatdan tegishli boʻlmagan qorovullik</strong> — Oʻzbekiston Respublikasi Ichki ishlar vazirligining shartnoma asosida davlat organlarining, mahalliy davlat hokimiyati organlarining, shuningdek jismoniy va yuridik shaxslarning obyektlarini qoʻriqlash uchun tuziladigan tarkibiy boʻlinmasi tomonidan amalga oshiriladigan qoʻriqlash faoliyatining turi;</div></div><div class="BY_DEFAULT"><div name="-8230426" id="-8230426"></div></div><div class="ACT_TEXT"><div name="-8230427" id="-8230427"><strong>idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash</strong> — Oʻzbekiston Respublikasi Ichki ishlar vazirligining oʻta muhim va toifalangan obyektlarni, davlat va xoʻjalik boshqaruvi organlarining, mahalliy davlat hokimiyati organlarining, shuningdek jismoniy va yuridik shaxslarning obyektlarini shartnoma asosida qoʻriqlash boʻyicha maxsus vazifalarni bajarish uchun tuziladigan, xizmat faoliyati qorovullik xizmatini tashkil etish va oʻtash tartibi talablariga muvofiq tashkil etiladigan tarkibiy boʻlinmasi tomonidan amalga oshiriladigan qoʻriqlash faoliyatining turi;</div></div><div class="ACT_TEXT"><div name="-6067842" id="-6067842"><strong>idoraviy qorovullik</strong> — davlat va xoʻjalik boshqaruvi organlarining, mahalliy davlat hokimiyati organlarining hamda boshqa tashkilotlarning, tadbirkorlik subyektlarining oʻz obyektlarini qoʻriqlash uchun yuridik shaxs tashkil etmasdan tuziladigan tarkibiy boʻlinmasi tomonidan yoki zimmasiga tegishli vazifalarni bajarish yuklatilgan alohida xodimi tomonidan amalga oshiriladigan qoʻriqlash faoliyatining turi;</div></div><div class="ACT_TEXT"><div name="-6067844" id="-6067844"><strong>idoraviy harbiylashtirilgan qoʻriqlash</strong> — davlat va xoʻjalik boshqaruvi organlarining, mahalliy davlat hokimiyati organlarining hamda boshqa tashkilotlarning oʻz obyektlarini qoʻriqlash boʻyicha maxsus vazifalarni bajarish uchun yuridik shaxs tashkil etmasdan tuziladigan, xizmat faoliyati qorovullik xizmatini tashkil etish va oʻtash tartibi talablariga muvofiq tashkil etiladigan tarkibiy boʻlinmasi tomonidan amalga oshiriladigan qoʻriqlash faoliyatining turi;</div></div><div class="ACT_TEXT"><div name="-6067846" id="-6067846"><strong>idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchisi va xizmatchisi</strong> — idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining qoʻriqlash faoliyatini boshqarish, nazorat qilish va amalga oshirish vazifalari oʻz zimmasiga yuklatilgan ishchisi va xizmatchisi;</div></div><div class="ACT_TEXT"><div name="-6067849" id="-6067849"><strong>nazorat-oʻtkazish rejimi</strong> — qoʻriqlanadigan obyektlarga (qoʻriqlanadigan obyektlardan) shaxslarning kirishini (chiqishini), transport vositalarining kirib kelishini (chiqib ketishini), mol-mulk olib kirilishini (olib chiqilishini), tashib kirilishini (tashib chiqilishini) nazorat qilish tartibini taʼminlovchi qoidalar majmui;</div></div><div class="ACT_TEXT"><div name="-6067852" id="-6067852"><strong>obyektning ichki rejimi </strong>— qoʻriqlanadigan obyektda belgilangan ichki tartib qoidalariga va yongʻin xavfsizligi talablariga rioya etilishini taʼminlovchi tadbirlar majmui;</div></div><div class="ACT_TEXT"><div name="-6067854" id="-6067854"><strong>qoʻriqlanadigan obyekt</strong> — belgilangan tartibda qoʻriqlashga olingan jismoniy va yuridik shaxslarning binolari, imoratlari, inshootlari, ularning hududlari, joyning uchastkalari, transport vositalari, transportda tashiladigan yuklari, pul mablagʻlari, moddiy boyliklari va boshqa mol-mulki, shuningdek jismoniy shaxs;</div></div><div class="ACT_TEXT"><div name="-6067856" id="-6067856"><strong>qoʻriqlashning muhandislik vositalari</strong> — qoʻriqlanadigan obyektlarni tajovuzlardan mexanik jihatdan himoya qilish uchun qoʻllaniladigan qurilmalar va inshootlar;</div></div><div class="ACT_TEXT"><div name="-6067857" id="-6067857"><strong>qoʻriqlashning texnik vositalari</strong> — qoʻriqlanadigan obyektlarni tajovuzlardan himoya qilish uchun foydalaniladigan, mustaqil vazifalarni bajaradigan, konstruktiv jihatdan yakunlangan qurilmalar;</div></div><div class="ACT_TEXT"><div name="-6067858" id="-6067858"><strong>qoʻriqlash faoliyati</strong> — qoʻriqlanadigan obyektlarni himoya qilish, shuningdek yuridik shaxslarning qoʻriqlanadigan obyektlarida nazorat-oʻtkazish va obyektning ichki rejimlarini taʼminlash boʻyicha faoliyat.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067862" id="-6067862">4-modda. Qoʻriqlash faoliyatining asosiy vazifalari</div></div><div class="ACT_TEXT"><div name="-6067863" id="-6067863">Qoʻriqlash faoliyatining asosiy vazifalari quyidagilardan iborat:</div></div><div class="ACT_TEXT"><div name="-6067866" id="-6067866">jismoniy shaxslarning hayotini va sogʻligʻini tajovuzlardan himoya qilish;</div></div><div class="ACT_TEXT"><div name="-6067867" id="-6067867">jismoniy va yuridik shaxslarning mol-mulkini hamda obyektlarini tajovuzlardan himoya qilish;</div></div><div class="ACT_TEXT"><div name="-6067868" id="-6067868">qoʻriqlanadigan obyektlar hududida jamoat tartibini saqlash, huquqbuzarliklarni profilaktika qilish va ularga chek qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6067869" id="-6067869">yuridik shaxslarning qoʻriqlanadigan obyektlarida nazorat-oʻtkazish va obyektning ichki rejimlarini taʼminlash.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067870" id="-6067870">5-modda. Qoʻriqlash faoliyatining asosiy prinsiplari</div></div><div class="ACT_TEXT"><div name="-6067871" id="-6067871">Qoʻriqlash faoliyatining asosiy prinsiplari quyidagilardan iborat:</div></div><div class="ACT_TEXT"><div name="-6067872" id="-6067872">qonuniylik;</div></div><div class="ACT_TEXT"><div name="-6067873" id="-6067873">qoʻriqlanadigan obyektning daxlsizligi;</div></div><div class="ACT_TEXT"><div name="-6067874" id="-6067874">jismoniy va yuridik shaxslarning huquqlari, erkinliklari hamda qonuniy manfaatlarini himoya qilish.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067875" id="-6067875">6-modda. Oʻta muhim va toifalangan obyektlarni, shuningdek maxsus yuklarni qoʻriqlash</div></div><div class="ACT_TEXT"><div name="-6067876" id="-6067876">Oʻta muhim va toifalangan obyektlar roʻyxati, mazkur obyektlarni qoʻriqlash turlari, qoʻriqlashning muhandislik va texnik vositalari bilan jihozlashga doir talablar, shuningdek maxsus yuklarni transportda tashish jarayonida ularni qoʻriqlash tartibi Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6067877" id="-6067877">2-bob. Qoʻriqlash faoliyati sohasini davlat tomonidan tartibga solish</div></div><div class="CLAUSE_DEFAULT"><div name="-6067878" id="-6067878">7-modda. Oʻzbekiston Respublikasi Vazirlar Mahkamasining qoʻriqlash faoliyati sohasidagi vakolatlari</div></div><div class="ACT_TEXT"><div name="-6067879" id="-6067879">Oʻzbekiston Respublikasi Vazirlar Mahkamasi:</div></div><div class="BY_DEFAULT"><div name="-8230431" id="-8230431"></div></div><div class="ACT_TEXT"><div name="-8230432" id="-8230432">Oʻzbekiston Respublikasi Ichki ishlar vazirligi tomonidan qoʻriqlanishi lozim boʻlgan obyektlar roʻyxatini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-6067881" id="-6067881">Oʻzbekiston Respublikasining oʻta muhim va toifalangan obyektlarida qoʻriqlashning texnik vositalarini loyihalash, montaj qilish, sozlash, taʼmirlash hamda ularga texnik xizmat koʻrsatish boʻyicha ishlarni bajarish uchun ruxsatnoma berish tartibini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-6067882" id="-6067882">qoʻriqlashning texnik vositalarini montaj qilish, sozlash, taʼmirlash va ularga texnik xizmat koʻrsatish boʻyicha xizmatlar (bundan buyon matnda qoʻriqlash-texnik xizmatlar deb yuritiladi) koʻrsatish faoliyatini boshlaganlik yoki tugatganlik haqida xabardor qilish tartibini belgilaydi;</div></div><div class="BY_DEFAULT"><div name="-8230435" id="-8230435"></div></div><div class="ACT_TEXT"><div name="-8230436" id="-8230436">Oʻzbekiston Respublikasi Ichki ishlar vazirligi tomonidan qoʻriqlash-texnik xizmatlar koʻrsatish boʻyicha faoliyat ustidan nazoratni amalga oshirish tartibini belgilaydi, bundan yakka tartibda foydalaniladigan qoʻriqlashning texnik vositalari (avtotransport vositalarini olib qochishga qarshi qoʻriqlashning texnik vositalari va boshqalar) ustidan nazorat qilish mustasno;</div></div><div class="ACT_TEXT"><div name="-6067884" id="-6067884">xizmat qurolidan foydalanish huquqiga ega boʻlgan idoraviy harbiylashtirilgan qoʻriqlashni, idoraviy qorovullikni tashkil etish huquqiga ega boʻlgan davlat va xoʻjalik boshqaruvi organlarining, mahalliy davlat hokimiyati organlarining hamda boshqa tashkilotlarning roʻyxatini, shuningdek idoraviy harbiylashtirilgan qoʻriqlash toʻgʻrisidagi namunaviy nizomni tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-6067885" id="-6067885">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari ishchilarining va xizmatchilarining kasbiy tayyorgarligini amalga oshirish tartibini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-6067886" id="-6067886">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari tomonidan shaxsiy koʻrikdan oʻtkazishni, ashyolarni, qoʻl yukini, bagajni, transport vositalarini koʻzdan kechirishni amalga oshirish qoidalarini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-6067887" id="-6067887">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchilarining va xizmatchilarining oʻz majburiyatlarini bajarishiga toʻsqinlik qiladigan kasalliklar va jismoniy nuqsonlar roʻyxatini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-6067888" id="-6067888">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari tomonidan qoʻllaniladigan xizmat qurolining hamda uning oʻq-dorilarining turlari, xillari, modellarini, taʼminot normalarini, shuningdek idoraviy qorovullik boʻlinmalarining ishchilariga va xizmatchilariga foydalanish uchun ruxsat etilgan maxsus vositalar roʻyxatini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-6067889" id="-6067889">Oʻzbekiston Respublikasi hududi boʻylab xavfli yuklarni tashish jarayonida ularni qoʻriqlash qoidalarini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-6067890" id="-6067890">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarida xizmat qurolining va uning oʻq-dorilarining muomalada boʻlishi tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-6068913" id="-6068913">Oʻzbekiston Respublikasi Vazirlar Mahkamasi qonunchilikka muvofiq boshqa vakolatlarni ham amalga oshirishi mumkin.</div></div><div class="BY_DEFAULT"><div name="-8230440" id="-8230440"></div></div><div class="CLAUSE_DEFAULT"><div name="-8230441" id="-8230441">7<sup>1</sup>-modda. Oʻzbekiston Respublikasi Ichki ishlar vazirligining qoʻriqlash faoliyati sohasidagi vakolatlari</div></div><div class="ACT_TEXT"><div name="-8230442" id="-8230442">Oʻzbekiston Respublikasi Ichki ishlar vazirligi:</div></div><div class="ACT_TEXT"><div name="-8230443" id="-8230443">qoʻriqlash faoliyati sohasidagi davlat siyosatini amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-8230444" id="-8230444">Oʻzbekiston Respublikasi Ichki ishlar vazirligi tomonidan koʻrsatiladigan qoʻriqlash xizmatlari uchun tariflarni tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-8230445" id="-8230445">qoʻriqlanishi lozim boʻlgan davlat obyektlari, oʻta muhim va toifalangan obyektlar, shuningdek savdo, xizmat koʻrsatish, koʻngilochar, qurilish obyektlarida va boshqa obyektlarda Oʻzbekiston Respublikasi Ichki ishlar vazirligi huzuridagi Qoʻriqlash departamenti tomonidan qoʻriqlash xizmatlarini koʻrsatish tartibini tasdiqlaydi hamda qoʻriqlash faoliyatini amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-8230447" id="-8230447">qoʻriqlash vositalarining va tizimlarining qoʻllanilishi sohasida yagona texnik siyosat yuritilishini, ulardan foydalanilishi ustidan samarali nazoratni, shuningdek qoʻriqlash faoliyatiga zamonaviy axborot-kommunikatsiya texnologiyalari keng miqyosda joriy etilishini taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8230448" id="-8230448">Oʻzbekiston Respublikasi Ichki ishlar vazirligining idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalari hamda idoraviy jihatdan tegishli boʻlmagan qorovullik boʻlinmalari ishchilari va xizmatchilarining formali kiyim-boshi hamda farqlovchi belgilari namunalarini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-8230449" id="-8230449">Oʻzbekiston Respublikasi Ichki ishlar vazirligi tomonidan qoʻriqlash xizmatlarini koʻrsatish boʻyicha shartnomalarning namunaviy shaklini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-8230450" id="-8230450">saf boʻlinmalari, idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalari, idoraviy jihatdan tegishli boʻlmagan qorovullik boʻlinmalari tomonidan qoʻriqlashning texnik vositalaridan foydalangan holda qoʻriqlash xizmatlarini, shuningdek qoʻriqlash-texnik xizmatlarni koʻrsatadi;</div></div><div class="ACT_TEXT"><div name="-8230451" id="-8230451">Oʻzbekiston Respublikasi Ichki ishlar vazirligi huzuridagi Qoʻriqlash departamentiga qoʻriqlash uchun topshirilgan obyektlarni qoʻriqlashning muhandislik va texnik vositalari bilan jihozlash talablari, tartibi hamda shartlarini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-8230452" id="-8230452">Oʻzbekiston Respublikasining oʻta muhim va toifalangan obyektlarida qoʻriqlash-texnik xizmatlar koʻrsatish boʻyicha ishlarni bajarish uchun ruxsatnomalar beradi;</div></div><div class="ACT_TEXT"><div name="-8230453" id="-8230453">qoʻriqlash-texnik xizmatlar koʻrsatish boʻyicha faoliyatni boshlaganlik yoki tugatganlik toʻgʻrisida xabardor qilish tartibiga rioya etilishini nazorat qiladi;</div></div><div class="ACT_TEXT"><div name="-8230454" id="-8230454">qoʻriqlanadigan obyektlar hududida jamoat tartibini saqlaydi, huquqbuzarliklarning oldini oladi va ularga chek qoʻyadi;</div></div><div class="ACT_TEXT"><div name="-8230455" id="-8230455">oʻzgalar mol-mulkini talon-toroj qilish bilan bogʻliq boʻlgan jinoyatlarning oldini olish boʻyicha profilaktika tadbirlarini amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-8230456" id="-8230456">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalarining hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari tomonidan qoʻllanilishiga ruxsat etilgan maxsus vositalarni olish, transportda tashish, saqlash, hisobga olish, taʼmirlash va yoʻq qilish qoidalarini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-8230457" id="-8230457">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari hamda idoraviy qorovullik boʻlinmalari ishchilari va xizmatchilarining xizmat-jangovar, ijtimoiy-huquqiy, axloqiy-ruhiy hamda jismoniy tayyorgarligini amalga oshirish tartibini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-8230458" id="-8230458">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari hamda idoraviy qorovullik boʻlinmalari naryadlari tomonidan xizmatni oʻtash tartibi toʻgʻrisidagi tavsiyalarni ishlab chiqadi;</div></div><div class="ACT_TEXT"><div name="-8230460" id="-8230460">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari hamda idoraviy qorovullik boʻlinmalari ishchilari va xizmatchilarining boshlangʻich tayyorgarligini hamda ularning malakasi oshirilishini shartnoma asosida taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8230461" id="-8230461">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalarining hamda idoraviy qorovullik boʻlinmalarining faoliyati tashkil etilishini nazorat qiladi, shuningdek davlat organlari va xoʻjalik birlashmalarining ushbu boʻlinmalar tomonidan qoʻriqlanadigan obyektlarida qoʻriqlanish, nazorat-oʻtkazish rejimi, qoʻriqlashning muhandislik va texnik vositalari bilan jihozlanganlik holatini tekshiradi (ikki yilda bir marta);</div></div><div class="ACT_TEXT"><div name="-8230462" id="-8230462">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari shaxsiy tarkibining eng koʻp sonini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-8230463" id="-8230463">qoʻriqlash faoliyati sohasidagi normativ-huquqiy hujjatlar loyihalarini ishlab chiqishda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-8230465" id="-8230465">qoʻriqlash faoliyati sohasida xalqaro hamkorlikni amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8230466" id="-8230466">Oʻzbekiston Respublikasi Ichki ishlar vazirligi qonunchilikka muvofiq boshqa vakolatlarni ham amalga oshirishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067892" id="-6067892">8-modda. Oʻzbekiston Respublikasi Milliy gvardiyasining qoʻriqlash faoliyati sohasidagi vakolatlari</div></div><div class="BY_DEFAULT"><div name="-8230470" id="-8230470"></div></div><div class="ACT_TEXT"><div name="-8230472" id="-8230472">Oʻzbekiston Respublikasi Milliy gvardiyasi:</div></div><div class="ACT_TEXT"><div name="-8230473" id="-8230473">qoʻriqlash faoliyati sohasidagi davlat siyosatini amalga oshirishda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-8230474" id="-8230474">Oʻzbekiston Respublikasi Milliy gvardiyasi tomonidan koʻrsatiladigan qoʻriqlash xizmatlari uchun tariflarni tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-8230475" id="-8230475">davlat obyektlarini, oʻta muhim va toifalangan obyektlarni hamda boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini, shuningdek xorijiy davlatlar hamda xalqaro tashkilotlarning diplomatik, konsullik va boshqa vakolatxonalarini qoʻriqlashni amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-8230476" id="-8230476">qoʻriqlash faoliyatiga zamonaviy axborot-kommunikatsiya texnologiyalarini joriy etadi;</div></div><div class="ACT_TEXT"><div name="-8230477" id="-8230477">Oʻzbekiston Respublikasi Milliy gvardiyasi tomonidan qoʻriqlash xizmatlarini koʻrsatish boʻyicha shartnomalarning namunaviy shaklini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-8230478" id="-8230478">Oʻzbekiston Respublikasi Milliy gvardiyasining qoʻriqlash boʻlinmalariga qoʻriqlash uchun topshirilgan obyektlarni qoʻriqlashning muhandislik va texnik vositalari bilan jihozlash talablari, tartibi hamda shartlarini belgilaydi;</div></div><div class="ACT_TEXT"><div name="-8230479" id="-8230479">Oʻzbekiston Respublikasi Milliy gvardiyasining qoʻriqlash boʻlinmalariga qoʻriqlash uchun topshirilgan obyektlar hududida jamoat tartibini saqlaydi, huquqbuzarliklarning oldini oladi va ularga chek qoʻyadi;</div></div><div class="ACT_TEXT"><div name="-8230480" id="-8230480">qoʻriqlash faoliyati sohasidagi normativ-huquqiy hujjatlar loyihalarini ishlab chiqishda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-8230481" id="-8230481">qoʻriqlash faoliyati sohasida xalqaro hamkorlikni amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8230482" id="-8230482">Oʻzbekiston Respublikasi Milliy gvardiyasi qonunchilikka muvofiq boshqa vakolatlarni ham amalga oshirishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6067927" id="-6067927">3-bob. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar, ularning huquqlari, majburiyatlari va javobgarligi</div></div><div class="CLAUSE_DEFAULT"><div name="-6067928" id="-6067928">9-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar</div></div><div class="ACT_TEXT"><div name="-6067930" id="-6067930">Quyidagilar qoʻriqlash faoliyatini amalga oshirish huquqiga ega:</div></div><div class="ACT_TEXT"><div name="-6067931" id="-6067931">davlat organlarining qoʻriqlash boʻlinmalari;</div></div><div class="ACT_TEXT"><div name="-6067933" id="-6067933">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari;</div></div><div class="ACT_TEXT"><div name="-6067935" id="-6067935">idoraviy qorovullik boʻlinmalari.</div></div><div class="ACT_TEXT"><div name="-6067937" id="-6067937">Oʻzbekiston Respublikasi hududida qoʻriqlash faoliyatini chet davlatlarning jismoniy shaxslari va tashkilotlari, shu jumladan xususiy tashkilotlari tomonidan amalga oshirishga yoʻl qoʻyilmaydi, bundan Oʻzbekiston Respublikasi hududiga qisqa muddatli tashrif bilan kelgan oliy darajali mehmonlar xavfsizligini taʼminlash hollari mustasno.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067940" id="-6067940">10-modda. Davlat organlarining qoʻriqlash boʻlinmalari</div></div><div class="ACT_TEXT"><div name="-6067942" id="-6067942">Oʻzbekiston Respublikasi Milliy gvardiyasining, Oʻzbekiston Respublikasi Prezidenti davlat xavfsizlik xizmatining, Oʻzbekiston Respublikasi Mudofaa vazirligining, Ichki ishlar vazirligining, Davlat xavfsizlik xizmatining, Favqulodda vaziyatlar vazirligining, Davlat bojxona qoʻmitasining hamda Oʻzbekiston Respublikasi Qurolli Kuchlari tarkibiga kiruvchi harbiy tuzilmalarning tegishli boʻlinmalari davlat organlarining qoʻriqlash boʻlinmalaridir.</div></div><div class="ACT_TEXT"><div name="-6067944" id="-6067944">Davlat organlarining qoʻriqlash boʻlinmalari jamoat tartibini saqlash va favqulodda vaziyatlar oqibatlarini bartaraf etish uchun belgilangan tartibda jalb qilinishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067946" id="-6067946">11-modda. Idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari va idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalari </div></div><div class="BY_DEFAULT"><div name="-8230486" id="-8230486"></div></div><div class="ACT_TEXT"><div name="-8230488" id="-8230488">Idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari naryadlari tomonidan xizmatning oʻtalishini tashkil etish va xizmatning oʻtalishi tartibi Oʻzbekiston Respublikasi Qurolli Kuchlarining Garnizon va qorovullik xizmatlari ustavi asosida ishlab chiqilgan hamda Oʻzbekiston Respublikasi Ichki ishlar vazirligi bilan kelishilgan, oʻz tasarrufida idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari boʻlgan davlat va xoʻjalik boshqaruvi organlari, mahalliy davlat hokimiyati organlari hamda boshqa tashkilotlar tasdiqlagan qoidalarga muvofiq belgilanadi.</div></div><div class="BY_DEFAULT"><div name="-8230491" id="-8230491"></div></div><div class="ACT_TEXT"><div name="-8230492" id="-8230492">Idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalarining ishchilari va xizmatchilari oʻz xizmat majburiyatlarini bajarish chogʻida davlat hamda xoʻjalik boshqaruvi organlari, mahalliy davlat hokimiyati organlari va boshqa tashkilotlar tomonidan Oʻzbekiston Respublikasi Ichki ishlar vazirligi bilan kelishuvga koʻra ishlab chiqilgan hamda tasdiqlangan, tegishli farqlovchi belgilari boʻlgan formali kiyim-bosh kiyib yurish huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-6067955" id="-6067955">Idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalarining ishchilariga va xizmatchilariga belgilangan tartibda xizmat guvohnomalari beriladi.</div></div><div class="BY_DEFAULT"><div name="-8230494" id="-8230494"></div></div><div class="ACT_TEXT"><div name="-8230496" id="-8230496">Oʻzbekiston Respublikasi Ichki ishlar vazirligining idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalarining ishchilari va xizmatchilari qonunchilikda idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalarining ishchilari hamda xizmatchilari uchun belgilangan huquqlarga ega boʻladi va majburiyatlarni oʻz zimmasiga oladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067960" id="-6067960">12-modda. Idoraviy qorovullik boʻlinmalari va idoraviy jihatdan tegishli boʻlmagan qorovullik boʻlinmalari</div></div><div class="ACT_TEXT"><div name="-6067961" id="-6067961">Idoraviy qorovullik boʻlinmalarining faoliyatini tashkil etish hamda ularning xizmatni oʻtashi tartibi davlat va xoʻjalik boshqaruvi organlarining, mahalliy davlat hokimiyati organlarining va boshqa tashkilotlarning idoraviy hujjatlarida belgilanadi.</div></div><div class="ACT_TEXT"><div name="-6067963" id="-6067963">Idoraviy qorovullik boʻlinmalari naryadlarining ish vaqti va smenasi davomiyligi Oʻzbekiston Respublikasining mehnat toʻgʻrisidagi qonunchiligiga muvofiq belgilanadi.</div></div><div class="ACT_TEXT"><div name="-6067964" id="-6067964">Idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari tegishli idoralar tomonidan belgilangan tartibda joriy etilgan maxsus formali kiyim-boshga, farqlovchi belgilarga ega boʻlishi mumkin.</div></div><div class="BY_DEFAULT"><div name="-8230498" id="-8230498"></div></div><div class="ACT_TEXT"><div name="-8230499" id="-8230499">Oʻzbekiston Respublikasi Ichki ishlar vazirligining idoraviy jihatdan tegishli boʻlmagan qorovullik boʻlinmalarining ishchilari va xizmatchilari qonunchilikda idoraviy qorovullik boʻlinmalarining ishchilari hamda xizmatchilari uchun belgilangan huquqlarga ega boʻladi va majburiyatlarni oʻz zimmasiga oladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067967" id="-6067967">13-modda. Qoʻriqlash faoliyatini shartnoma asosida amalga oshiruvchi subyektlar</div></div><div class="ACT_TEXT"><div name="-6067968" id="-6067968">Quyidagilar shartnoma asosida qoʻriqlash faoliyatini amalga oshirish huquqiga ega:</div></div><div class="BY_DEFAULT"><div name="-8230502" id="-8230502"></div></div><div class="ACT_TEXT"><div name="-8230503" id="-8230503">Oʻzbekiston Respublikasi Milliy gvardiyasi — Oʻzbekiston Respublikasi Milliy gvardiyasi tomonidan qoʻriqlanishi lozim boʻlgan obyektlarda;</div></div><div class="ACT_TEXT"><div name="-6067970" id="-6067970">Oʻzbekiston Respublikasi Mudofaa vazirligi — Oʻzbekiston Respublikasi Mudofaa vazirligi tomonidan majburiy qoʻriqlanishi lozim boʻlgan oʻta muhim va toifalangan obyektlarda, shuningdek transportda tashiladigan maxsus yuklarni qoʻriqlash boʻyicha;</div></div><div class="BY_DEFAULT"><div name="-8230506" id="-8230506"></div></div><div class="ACT_TEXT"><div name="-8230507" id="-8230507">Oʻzbekiston Respublikasi Ichki ishlar vazirligi — Oʻzbekiston Respublikasi Ichki ishlar vazirligi tomonidan qoʻriqlanishi lozim boʻlgan obyektlarda, qonunchilikda belgilanadigan transportda tashiladigan yuklarni va boshqa obyektlarni qoʻriqlash, shuningdek jismoniy va yuridik shaxslarning murojaatlari boʻyicha.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067974" id="-6067974">14-modda. Qoʻriqlash faoliyatini shartnoma tuzmasdan amalga oshiruvchi subyektlar</div></div><div class="ACT_TEXT"><div name="-6067975" id="-6067975">Quyidagilar qoʻriqlash faoliyatini qonunchilikda berilgan vakolatlar doirasida shartnoma tuzmasdan amalga oshirish huquqiga ega:</div></div><div class="ACT_TEXT"><div name="-6067976" id="-6067976">davlat organlarining qoʻriqlash boʻlinmalari;</div></div><div class="ACT_TEXT"><div name="-6067979" id="-6067979">idoraviy harbiylashtirilgan qoʻriqlash boʻlinmalari;</div></div><div class="ACT_TEXT"><div name="-6067980" id="-6067980">idoraviy qorovullik boʻlinmalari.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067981" id="-6067981">15-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning huquqlari</div></div><div class="ACT_TEXT"><div name="-6067982" id="-6067982">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar oʻz vakolatlari doirasida quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-6067983" id="-6067983">qoʻriqlash faoliyatini amalga oshirishda fuqarolarning hayotiga va sogʻligʻiga, atrof-muhitga zarar yetkazmaydigan zamonaviy texnika va texnologiyalardan foydalanish;</div></div><div class="ACT_TEXT"><div name="-6067984" id="-6067984">qoʻriqlanadigan obyekt hududida jismoniy va yuridik shaxslardan qonunchilikka rioya etishni, qonunga xilof xatti-harakatlarni toʻxtatishni talab qilish;</div></div><div class="ACT_TEXT"><div name="-6067986" id="-6067986">davlat va xoʻjalik boshqaruvi organlaridan, mahalliy davlat hokimiyati organlaridan hamda boshqa tashkilotlardan qoʻriqlash faoliyatini amalga oshirish uchun zarur boʻlgan axborotni bepul olish, bundan qonunchilikda boshqacha tartib nazarda tutilgan hollar mustasno;</div></div><div class="ACT_TEXT"><div name="-6067987" id="-6067987">radioaloqani amalga oshirish uchun radiochastotadan (radiotoʻlqindan) belgilangan tartibda foydalanish;</div></div><div class="ACT_TEXT"><div name="-6067988" id="-6067988">buyurtmachidan qoʻriqlash faoliyatini amalga oshirish uchun zarur boʻlgan hujjatlarni, axborotni olish;</div></div><div class="ACT_TEXT"><div name="-6067989" id="-6067989">qoʻriqlanadigan obyektni koʻzdan kechirish.</div></div><div class="ACT_TEXT"><div name="-6067990" id="-6067990">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar qonunchilikka muvofiq boshqa huquqlarga ham ega boʻlishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6067992" id="-6067992">16-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning majburiyatlari </div></div><div class="ACT_TEXT"><div name="-6067993" id="-6067993">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar qoʻriqlanadigan obyektlardagi xizmatni tashkil etish va oʻtash chogʻida:</div></div><div class="ACT_TEXT"><div name="-6067994" id="-6067994">qoʻriqlanadigan obyektlarning ishonchli himoya qilinishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6067995" id="-6067995">qoʻriqlanadigan obyektlarning barqaror faoliyat koʻrsatishini izdan chiqarishga qaratilgan qonunga xilof harakatlarning oldini olishi va tashiladigan yuklarning but saqlanishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6067996" id="-6067996">qoʻriqlanadigan obyektlarda tabiiy va texnogen xususiyatli favqulodda vaziyatlar oqibatlarini bartaraf qilishda ishtirok etishi;</div></div><div class="ACT_TEXT"><div name="-6067997" id="-6067997">qoʻriqlanadigan obyektga qonunga xilof ravishda kirgan shaxslarni qidirish va ushlashda ishtirok etishi;</div></div><div class="ACT_TEXT"><div name="-6068000" id="-6068000">nazorat-oʻtkazish rejimini tashkil etishi va qoʻriqlanadigan obyekt hududida obyektning ichki rejimiga rioya etilishini nazorat qilishi;</div></div><div class="ACT_TEXT"><div name="-6068001" id="-6068001">qoʻriqlash faoliyatiga zamonaviy texnik vositalar va tizimlarni joriy etishi hamda ulardan samarali foydalanishi;</div></div><div class="ACT_TEXT"><div name="-6068003" id="-6068003">qoʻriqlanadigan obyektlar hududida jamoat tartibini saqlashi, huquqbuzarliklarning oldini olishi va ularga chek qoʻyishi;</div></div><div class="ACT_TEXT"><div name="-6068004" id="-6068004">qoʻriqlash faoliyatini amalga oshirish chogʻida oʻziga maʼlum boʻlib qolgan davlat sirlarini va qonun bilan qoʻriqlanadigan boshqa sirni oshkor qilmasligi shart.</div></div><div class="ACT_TEXT"><div name="-6068005" id="-6068005">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning zimmasida qonunchilikka muvofiq boshqa majburiyatlar ham boʻlishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068006" id="-6068006">17-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning javobgarligi</div></div><div class="ACT_TEXT"><div name="-6068007" id="-6068007">Qoʻriqlash xizmatlarini koʻrsatishga doir shartnomaga muvofiq qoʻriqlash faoliyatini amalga oshiruvchi subyektlar oʻz harakatlari (harakatsizligi) natijasida qoʻriqlanadigan obyektga yetkazilgan zararning oʻrnini toʻliq hajmda qoplashi shart.</div></div><div class="ACT_TEXT"><div name="-6068008" id="-6068008">Zararning oʻrnini qoplash miqdori va shartlari qoʻriqlash xizmatlarini koʻrsatish toʻgʻrisidagi ikki tomonlama shartnomada belgilanadi.</div></div><div class="ACT_TEXT"><div name="-6068010" id="-6068010">Qoʻriqlash faoliyatini shartnoma tuzmasdan amalga oshiruvchi subyektlarning harakatlari (harakatsizligi) natijasida qoʻriqlanadigan obyektga zarar yetkazilgan taqdirda javobgarlik qonunchilikka muvofiq belgilanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6068012" id="-6068012">4-bob. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar harbiy xizmatchilarining, xodimlarining, ishchilari hamda xizmatchilarining huquq va majburiyatlari</div></div><div class="CLAUSE_DEFAULT"><div name="-6068014" id="-6068014">18-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar harbiy xizmatchilarining, xodimlarining, ishchilari va xizmatchilarining huquqlari</div></div><div class="ACT_TEXT"><div name="-6068015" id="-6068015">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari xizmatni oʻtayotganda quyidagi huquqlarga ega boʻladi:</div></div><div class="ACT_TEXT"><div name="-6068016" id="-6068016">jismoniy va yuridik shaxslardan belgilangan nazorat-oʻtkazish va obyektning ichki rejimlariga, shuningdek jamoat tartibiga rioya etilishini talab qilish;</div></div><div class="ACT_TEXT"><div name="-6068017" id="-6068017">qoʻriqlanadigan obyekt hududidan mol-mulkni qonunga xilof ravishda olib chiqishga yoki qoʻriqlanadigan obyektga taqiqlangan predmetlarni olib kirishga urinish chogʻida shaxslarni ushlash;</div></div><div class="ACT_TEXT"><div name="-6068018" id="-6068018">qoʻriqlanadigan obyektlardagi mol-mulkni saqlash sharoitlarini, qoʻriqlashning muhandislik va texnik vositalari holatini hamda sozligini tekshirish, aniqlangan qoidabuzarliklarning, kamchiliklarning bartaraf etilishini talab qilish;</div></div><div class="ACT_TEXT"><div name="-6068020" id="-6068020">qoʻriqlanadigan obyektga qonunga xilof ravishda kirgan yoki qoʻriqlanadigan obyektda huquqbuzarlik sodir etgan shaxslarning shaxsini aniqlash, ularni ushlash hamda qoʻriqlash xizmati xonasiga yetkazish (bunday vakolatlari mavjud boʻlmaganda huquqni muhofaza qiluvchi organlarning xodimlarini chaqirish);</div></div><div class="ACT_TEXT"><div name="-6068021" id="-6068021">muomalada boʻlishi cheklangan moddalar, shu jumladan obyektga olib kirish (undan olib chiqish) uchun taqiqlangan predmetlar roʻyxatiga qoʻriqlanadigan obyekt maʼmuriyati tomonidan kiritilgan moddalar bor deb hisoblash uchun asoslar mavjud boʻlgan taqdirda, fuqarolarni shaxsiy koʻrikdan oʻtkazish, ularning ashyolarini, qoʻl yukini, bagajini koʻzdan kechirish hamda ularni olib yurish va saqlash uchun asoslar mavjud boʻlmagan taqdirda mazkur predmetlar, vositalar va moddalarni olib qoʻyish, shuningdek transport vositalarini koʻzdan kechirish, ularda tashilayotgan yuklarning ilova qilinadigan hujjatlarga muvofiqligini tekshirish;</div></div><div class="ACT_TEXT"><div name="-6068022" id="-6068022">qoʻriqlanadigan obyektdagi, patrullik yoʻnalishidagi hodisani, sodir etilgan huquqbuzarlikni belgilangan tartibda rasmiylashtirish, jinoyat izlarini saqlash maqsadida fuqarolardan hodisa joyini tark etishni talab qilish;</div></div><div class="ACT_TEXT"><div name="-6068023" id="-6068023">qonunchilikda nazarda tutilgan tartibda xizmat qurolini hamda maxsus vositalarni olib yurish va ulardan foydalanish, shuningdek jismoniy kuch ishlatish.</div></div><div class="ACT_TEXT"><div name="-6068024" id="-6068024">Qoʻriqlash boʻlinmalarining xizmatni noqulay mehnat sharoitlariga ega boʻlgan obyektlarda oʻtaydigan harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari ushbu obyektlarning xodimlari uchun nazarda tutilgan mehnat sohasidagi qoʻshimcha kafolatlardan foydalanadi. Mehnat sohasidagi qoʻshimcha kafolatlar qoʻriqlash xizmatlarini koʻrsatish toʻgʻrisidagi shartnomada aks ettiriladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068028" id="-6068028">19-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar harbiy xizmatchilarining, xodimlarining, ishchilari va xizmatchilarining majburiyatlari</div></div><div class="ACT_TEXT"><div name="-6068031" id="-6068031">Qoʻriqlash boʻlinmalarining harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari qoʻriqlash turi, shakllari, usullaridan qatʼi nazar, xizmatni oʻtash vaqtida:</div></div><div class="ACT_TEXT"><div name="-6068034" id="-6068034">qoʻriqlanadigan obyektlarni himoya qilishi, belgilangan tartibga va qoʻriqlash faoliyati toʻgʻrisidagi qonunchilik talablariga qatʼiy rioya etishi, qoʻriqlanadigan obyektni kuzatib borishni amalga oshirishi;</div></div><div class="ACT_TEXT"><div name="-6068036" id="-6068036">oʻz vakolatlari doirasida jismoniy shaxslarning hayoti, sogʻligʻi va mol-mulkini, shuningdek yuridik shaxslarning mol-mulkini himoya qilish uchun zarur choralar koʻrishi;</div></div><div class="ACT_TEXT"><div name="-6068038" id="-6068038">xizmatni oʻtash joylarida jamoat tartibini saqlashi, huquqbuzarliklarning oldini olishi va ularga chek qoʻyishi;</div></div><div class="ACT_TEXT"><div name="-6068040" id="-6068040">qoʻriqlanadigan obyektda huquqbuzarliklarning va hodisalarning izlari saqlanishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6068043" id="-6068043">hodisa joyida jabrlangan fuqarolarga, shuningdek hayotiga va sogʻligʻiga zarar yetkazilgan shaxslarga birinchi yordam koʻrsatishi yoki shunday yordam koʻrsatilishini tashkil etishi;</div></div><div class="ACT_TEXT"><div name="-6068045" id="-6068045">qoʻriqlanadigan obyektlar xavfsizligini taʼminlash maqsadida fuqarolar, huquqni muhofaza qiluvchi organlar va boshqa davlat organlari, jamoatchilik vakillari bilan hamkorlikni amalga oshirishi;</div></div><div class="ACT_TEXT"><div name="-6068050" id="-6068050">huquqni muhofaza qiluvchi organlarga ularning zimmasiga yuklatilgan vazifalarni hal etishda oʻz vakolatlari doirasida koʻmaklashishi;</div></div><div class="ACT_TEXT"><div name="-6068054" id="-6068054">qoʻriqlanadigan obyektlardagi tabiiy va texnogen xususiyatli favqulodda vaziyatlar oqibatlarini bartaraf qilishda ishtirok etishi;</div></div><div class="ACT_TEXT"><div name="-6068062" id="-6068062">qoʻriqlanadigan obyektda nazorat-oʻtkazish va obyektning ichki rejimlariga rioya etilishini qoʻriqlanadigan obyekt maʼmuriyati tomonidan qoʻriqlash faoliyatini amalga oshiruvchi subyektlar bilan kelishuvga koʻra tasdiqlangan qoidalarga muvofiq taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6068066" id="-6068066">oʻziga ishonib topshirilgan xizmat qurolining va uning oʻq-dorilarining, maxsus va texnik vositalarning, shaxsiy himoya vositalarining hamda mol-mulkning xavfsiz va lozim darajada saqlanishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6068070" id="-6068070">belgilangan tartibda maxsus formali kiyim-boshini kiyishi va farqlovchi belgilarini taqib yurishi;</div></div><div class="BY_DEFAULT"><div name="-7245913" id="-7245913"></div></div><div class="ACT_TEXT"><div name="-7245914" id="-7245914">qimor va tavakkalchilikka asoslangan boshqa oʻyinlarda, shu jumladan axborot-kommunikatsiya texnologiyalaridan foydalangan holda ishtirok etmasligi;</div></div><div class="ACT_TEXT"><div name="-7245915" id="-7245915">diniy rasm-rusumlar va marosimlarni bajarmasligi, qonunchilik hujjatlarida nazarda tutilgan alohida hollar bundan mustasno;</div></div><div class="ACT_TEXT"><div name="-7245916" id="-7245916">Internet jahon axborot tarmogʻiga qoʻriqlanayotgan obyekt hamda hududga oid maʼlumot va materiallarni, shuningdek qoʻriqlash faoliyatini amalga oshiruvchi boʻlinmalarga mansubligini oshkor etuvchi axborotni (foto, video, matn va boshqalar) kiritmasligi, matbuot xizmatlari tomonidan chop etilgan materiallar bundan mustasno;</div></div><div class="ACT_TEXT"><div name="-6068072" id="-6068072">qoʻriqlash faoliyatini amalga oshirish chogʻida oʻzlariga maʼlum boʻlib qolgan xizmatga doir axborotning va boshqa axborotning maxfiyligini taʼminlashi shart.</div></div><div class="ACT_TEXT"><div name="-6068075" id="-6068075">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar harbiy xizmatchilarining, xodimlarining, ishchilari va xizmatchilarining zimmasida qonunchilikka muvofiq boshqa majburiyatlar ham boʻlishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6068078" id="-6068078">5-bob. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilariga, xodimlariga, ishchilari va xizmatchilariga qoʻyiladigan talablar</div></div><div class="CLAUSE_DEFAULT"><div name="-6068081" id="-6068081">20-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari lavozimlariga nomzodlarga qoʻyiladigan talablar</div></div><div class="ACT_TEXT"><div name="-6068084" id="-6068084">Quyidagi shaxslar qoʻriqlash faoliyatini amalga oshiruvchi boʻlinmalarga ishga (xizmatga) qabul qilinmaydi:</div></div><div class="ACT_TEXT"><div name="-6068087" id="-6068087">qasddan sodir etgan jinoyatlari uchun sudlanganlik holati tugallanmagan yoki sudlanganligi olib tashlanmagan shaxslar;</div></div><div class="ACT_TEXT"><div name="-6068090" id="-6068090">jinoiy jazoni oʻtayotgan shaxslar;</div></div><div class="ACT_TEXT"><div name="-6068091" id="-6068091">mulkka tajovuz qiluvchi huquqbuzarliklarni sodir etganlik uchun maʼmuriy javobgarlikka tortilgan, shuningdek jamoat tartibiga yoki boshqaruvning belgilangan tartibiga tajovuz qiluvchi huquqbuzarliklarni sodir etganlik uchun bir yil ichida takroran maʼmuriy javobgarlikka tortilgan shaxslar;</div></div><div class="ACT_TEXT"><div name="-6068093" id="-6068093">ruhiy kasalliklari boʻlgan, narkologik kasalliklarga chalingan, shuningdek sogʻligʻining holatiga nisbatan belgilangan talablarga javob bermaydigan shaxslar;</div></div><div class="ACT_TEXT"><div name="-6068096" id="-6068096">sud tomonidan muomalaga layoqatsiz yoki muomala layoqati cheklangan deb topilgan shaxslar;</div></div><div class="ACT_TEXT"><div name="-6068098" id="-6068098">umumiy oʻrta yoki oʻrta maxsus maʼlumotga ega boʻlmagan shaxslar;</div></div><div class="ACT_TEXT"><div name="-6068100" id="-6068100">chet el fuqarolari boʻlgan shaxslar;</div></div><div class="BY_DEFAULT"><div name="-7245919" id="-7245919"></div></div><div class="ACT_TEXT"><div name="-7245920" id="-7245920">qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari uchun qonunchilik hujjatlarida belgilangan cheklovlarga rioya etishni rad etganda yoki qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning maxsus talablariga javob bermasa.</div></div><div class="ACT_TEXT"><div name="-6068102" id="-6068102">Qoʻriqlash faoliyatini amalga oshiruvchi boʻlinmalarga ishga (xizmatga) kirish uchun nomzodlarga nisbatan qonunchilikka muvofiq qoʻshimcha talablar qoʻyilishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068105" id="-6068105">21-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilarini, xodimlarini, ishchilari va xizmatchilarini tayyorlash, qayta tayyorlash hamda ularning malakasini oshirish</div></div><div class="ACT_TEXT"><div name="-6068108" id="-6068108">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari quyidagi tartibda tayyorlash, qayta tayyorlash hamda malaka oshirish oʻquv kurslarida oʻquvdan oʻtadi:</div></div><div class="ACT_TEXT"><div name="-6068109" id="-6068109">davlat organlari qoʻriqlash boʻlinmalarining harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari — tegishli organlar tomonidan tasdiqlanadigan oʻquv dasturlari asosida;</div></div><div class="BY_DEFAULT"><div name="-8230514" id="-8230514"></div></div><div class="ACT_TEXT"><div name="-8230515" id="-8230515">xizmat qurolidan foydalanish huquqiga ega boʻlgan idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari — shartnoma asosida Oʻzbekiston Respublikasi Ichki ishlar vazirligining va Milliy gvardiyasining taʼlim muassasalarida hamda roʻyxati Oʻzbekiston Respublikasi Vazirlar Mahkamasi tomonidan belgilanadigan boshqa taʼlim tashkilotlarida;</div></div><div class="BY_DEFAULT"><div name="-8230518" id="-8230518"></div></div><div class="ACT_TEXT"><div name="-8230519" id="-8230519">xizmat qurolidan foydalanish huquqiga ega boʻlmagan idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari — mustaqil ravishda oʻz boʻlinmalarida, shuningdek ixtiyoriy tartibda — shartnoma asosida Oʻzbekiston Respublikasi Ichki ishlar vazirligi va Milliy gvardiyasi taʼlim muassasalarining oʻquv kurslarida.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068112" id="-6068112">22-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar harbiy xizmatchilarining, xodimlarining, ishchilari va xizmatchilarining kasbiy, jismoniy va jangovar tayyorgarligi</div></div><div class="ACT_TEXT"><div name="-6068114" id="-6068114">Davlat organlarining qoʻriqlash boʻlinmalari harbiy xizmatchilarining, xodimlarining, ishchilari va xizmatchilarining kasbiy, jismoniy hamda jangovar tayyorgarligini tashkil etish tartibi ular qaysi organning tasarrufida boʻlsa, oʻsha organ tomonidan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-6068115" id="-6068115">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari maxsus oʻquv dasturlari boʻyicha maxsus tayyorgarlikdan (xizmat tayyorgarligidan, jismoniy, jangovar tayyorgarlikdan) oʻtadi. Maxsus tayyorgarlik (xizmat tayyorgarligi, jismoniy, jangovar tayyorgarlik) boʻyicha mashgʻulotlar oʻtkaziladigan vaqt ish vaqtiga kiritiladi.</div></div><div class="ACT_TEXT"><div name="-6068117" id="-6068117">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari bir yilda bir marta majburiy tibbiy koʻrikdan oʻtadi, bundan qonunchilikda davlat organlarining qoʻriqlash boʻlinmalari xodimlari uchun majburiy tibbiy koʻrikdan oʻtishning boshqacha muddati belgilangan hollar mustasno.</div></div><div class="ACT_TEXT"><div name="-6068118" id="-6068118">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning maxsus tayyorgarlik (xizmat tayyorgarligi, jismoniy, jangovar tayyorgarlik) boʻyicha oʻquv dasturlari fanlarini oʻzlashtirmagan harbiy xizmatchilariga, xodimlariga, ishchilari va xizmatchilariga qoʻriqlash faoliyatini amalga oshirish taqiqlanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6068120" id="-6068120">6-bob. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari tomonidan jismoniy kuch ishlatish, maxsus vositalarni va xizmat qurolini qoʻllash</div></div><div class="CLAUSE_DEFAULT"><div name="-6068121" id="-6068121">23-modda. Jismoniy kuch ishlatish, maxsus vositalarni va xizmat qurolini qoʻllash shartlari</div></div><div class="ACT_TEXT"><div name="-6068122" id="-6068122">Davlat organlari qoʻriqlash boʻlinmalarining harbiy xizmatchilari va xodimlari tomonidan jismoniy kuch ishlatish, maxsus vositalarni hamda xizmat qurolini qoʻllash qonunchilikda belgilangan tartibda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-6068124" id="-6068124">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari xizmat majburiyatlarini bajarish chogʻida faqat qonunda nazarda tutilgan hollarda va tartibda xizmat qurolini hamda maxsus vositalarni olib yurish, jismoniy kuch ishlatish, maxsus vositalarni va xizmat qurolini qoʻllash huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-6068125" id="-6068125">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari maxsus tayyorgarlikdan, shuningdek jismoniy kuch ishlatish, maxsus vositalarni hamda xizmat qurolini qoʻllash bilan bogʻliq sharoitlardagi harakatlarga kasbiy yaroqliligini aniqlash uchun davriy tekshiruvlardan oʻtishi kerak. Maxsus tayyorgarlikdan oʻtgan ishchilar va xizmatchilarga belgilangan namunadagi sertifikatlar beriladi.</div></div><div class="ACT_TEXT"><div name="-6068126" id="-6068126">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining jismoniy kuch ishlatish, maxsus vositalarni va xizmat qurolini qoʻllash bilan bogʻliq sharoitlardagi harakatlarga kasbiy yaroqliligini aniqlash uchun tekshiruvdan oʻtmagan ishchilari va xizmatchilari jismoniy kuch ishlatish, maxsus vositalarni hamda xizmat qurolini qoʻllash bilan bogʻliq boʻlmagan boshqa lavozimga mehnat shartnomasiga muvofiq oʻtkaziladi yoki ular bilan tuzilgan mehnat shartnomasi bekor qilinadi.</div></div><div class="ACT_TEXT"><div name="-6068129" id="-6068129">Jismoniy kuch ishlatishdan, maxsus vositalarni hamda xizmat qurolini qoʻllashdan avval ularni qoʻllash niyati toʻgʻrisida aniq ifodalangan ogohlantirish boʻlishi kerak, bundan bunday ogohlantirishning imkoni boʻlmagan yoxud ularning qoʻllanilishini kechiktirish fuqarolarning, idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchisining va xizmatchisining hayoti hamda sogʻligʻi uchun bevosita xavf tugʻdiradigan va boshqa ogʻir oqibatlarga olib kelishi mumkin boʻlgan hollar mustasno. </div></div><div class="ACT_TEXT"><div name="-6068131" id="-6068131">Jismoniy kuch ishlatilishi, maxsus vositalarning yoki xizmat qurolining qoʻllanilishi yuzaga kelgan vaziyatga, shaxslar xatti-harakatlarining xususiyatiga va xavflilik darajasiga muvofiq boʻlishi kerak. Bunda idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari har qanday zararning imkon qadar kam boʻlishiga intilishi shart.</div></div><div class="ACT_TEXT"><div name="-6068133" id="-6068133">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari, agar yuzaga kelgan vaziyatda maxsus vositalarni yoki xizmat qurolini qoʻllash uchun mazkur moddada, ushbu Qonunning <a href="https://lex.uz/uz/docs/-6066682#-6068166">25</a> va <a href="https://lex.uz/uz/docs/-6066682#-6068213">26-moddalarida </a>nazarda tutilgan asoslar yuzaga kelishi mumkin deb hisoblasa, maxsus vositalarni yoki xizmat qurolini qoʻllash uchun tayyorlash hamda ularni jangovar holatga keltirish huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-6068136" id="-6068136">Jismoniy kuch ishlatilganligi, maxsus vositalar yoki xizmat quroli qoʻllanilganligi natijasida tan jarohati olgan fuqarolarga birinchi yordam koʻrsatilishi hamda eng qisqa muddatlarda tibbiy yordam koʻrsatish choralari koʻrilishi kerak.</div></div><div class="ACT_TEXT"><div name="-6068139" id="-6068139">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari jismoniy kuch ishlatilgan, maxsus vositalar hamda xizmat quroli qoʻllanilgan har bir holat toʻgʻrisida bevosita boshligʻiga darhol xabar berishi shart.</div></div><div class="ACT_TEXT"><div name="-6068141" id="-6068141">Qoʻriqlash faoliyatini amalga oshiruvchi subyekt jismoniy kuch ishlatilganligi va maxsus vositalar qoʻllanilganligi natijasida jismoniy yoki yuridik shaxslarning hayotiga, sogʻligʻiga yoki mol-mulkiga zarar yetkazilgan har bir holat haqida, shuningdek xizmat quroli qoʻllanilgan barcha hollar toʻgʻrisida prokurorga va ichki ishlar organlariga darhol xabar beradi.</div></div><div class="ACT_TEXT"><div name="-6068143" id="-6068143">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchilari va xizmatchilarining jismoniy kuch ishlatish, maxsus vositalarni yoki xizmat qurolini qoʻllash chogʻida oʻz vakolatlari doirasidan chiqqanligi qonunda belgilangan javobgarlikka sabab boʻladi.</div></div><div class="ACT_TEXT"><div name="-6068145" id="-6068145">Agar jismoniy kuch ishlatish, maxsus vositalarni yoki xizmat qurolini qoʻllash qonunchilikda belgilangan asoslar boʻyicha va tartibda amalga oshirilgan boʻlsa, idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari bunday jismoniy kuch ishlatish, maxsus vositalarni yoki xizmat qurolini qoʻllash chogʻida jismoniy va yuridik shaxslarga yetkazilgan zarar uchun javobgar boʻlmaydi.</div></div><div class="ACT_TEXT"><div name="-6068147" id="-6068147">Agar idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari tomonidan jismoniy kuch ishlatilganligi, maxsus vositalar yoki xizmat quroli qoʻllanilganligi natijasida fuqaroga tan jarohati yetkazilsa yoxud u vafot etsa, idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari hodisa joyini oʻzgarishsiz saqlashga qaratilgan choralarni koʻrishi shart.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068152" id="-6068152">24-modda. Jismoniy kuch ishlatish</div></div><div class="ACT_TEXT"><div name="-6068155" id="-6068155">Agar kuch ishlatilmaydigan usullar idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari zimmasiga yuklatilgan majburiyatlarning bajarilishini taʼminlamasa, ular quyidagi hollarda shaxsan oʻzi yoki boʻlinma (guruh) tarkibida jismoniy kuch ishlatish, shu jumladan kurashning jang usullarini qoʻllash huquqiga ega boʻladi:</div></div><div class="ACT_TEXT"><div name="-6068157" id="-6068157">qoʻriqlanadigan obyektga tajovuzlarning oldini olishda va uning hududidagi gʻayriqonuniy xatti-harakatlarni toʻxtatishda;</div></div><div class="ACT_TEXT"><div name="-6068159" id="-6068159">qoʻriqlanadigan hududda huquqbuzarlik sodir etgan shaxsni ushlab turishda va uni huquqni muhofaza qiluvchi organlarga topshirishda;</div></div><div class="ACT_TEXT"><div name="-6068161" id="-6068161">qoʻriqlash boʻlinmasining harbiy xizmatchisi, xodimi, ishchisi va xizmatchisining qonuniy talablariga qarshilik koʻrsatilishini bartaraf etishda.</div></div><div class="ACT_TEXT"><div name="-6068163" id="-6068163">Qoʻriqlash boʻlinmalarining ishchilari va xizmatchilari ushbu Qonunda maxsus vositalar yoki xizmat quroli qoʻllanilishiga ruxsat etilgan hollarda ham jismoniy kuch ishlatish huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-6068164" id="-6068164">Homiladorlik belgilari sezilib turgan ayollarga, nogironlik belgilari koʻrinib turgan shaxslarga, yoshi aniq koʻrinib turgan yoki maʼlum boʻlgan voyaga yetmaganlarga nisbatan jismoniy kuch ishlatish taqiqlanadi, bundan ularning qurolli qarshilik koʻrsatganligi, fuqarolarning yoxud qoʻriqlash faoliyatini amalga oshiruvchi subyekt harbiy xizmatchisining, xodimining, ishchisi va xizmatchisining hayotiga hamda sogʻligʻiga haqiqatda tahdid etib, hujum qilinganligi hollari mustasno.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068166" id="-6068166">25-modda. Maxsus vositalarni qoʻllash</div></div><div class="ACT_TEXT"><div name="-6068168" id="-6068168">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari quyidagi hollarda maxsus vositalarni qoʻllash huquqiga ega:</div></div><div class="ACT_TEXT"><div name="-6068170" id="-6068170">qoʻriqlanadigan obyektga qilingan hujumni qaytarishda;</div></div><div class="ACT_TEXT"><div name="-6068171" id="-6068171">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchisiga va xizmatchisiga yoki qoʻriqlanadigan obyekt hududidagi fuqaroga qilingan hujumni qaytarishda;</div></div><div class="ACT_TEXT"><div name="-6068173" id="-6068173">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchisiga va xizmatchisiga koʻrsatilayotgan qarshilikka barham berishda;</div></div><div class="ACT_TEXT"><div name="-6068186" id="-6068186">qoʻriqlanadigan obyektda huquqbuzarlik sodir etish chogʻida koʻrib qolingan shaxsni ushlashda, agar ushbu shaxs qurolli qarshilik koʻrsatishi mumkin boʻlsa;</div></div><div class="ACT_TEXT"><div name="-6068187" id="-6068187">ushlab turilgan shaxslarni olib borish va qoʻriqlashda, shuningdek qochishga urinishini, atrofdagilarga yoki oʻziga zarar yetkazishini bartaraf etish maqsadida;</div></div><div class="ACT_TEXT"><div name="-6068189" id="-6068189">qoʻriqlanadigan obyektda haydovchisi qoʻriqlash faoliyatini amalga oshiruvchi subyektning harbiy xizmatchisi, xodimi, ishchisi va xizmatchisi talablarini bajarmagan transport vositasini toʻxtatish zarur boʻlganda.</div></div><div class="ACT_TEXT"><div name="-6068191" id="-6068191">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari quyidagi maxsus vositalarni qoʻllash huquqiga ega:</div></div><div class="ACT_TEXT"><div name="-6068193" id="-6068193">rezina tayoqlarni — ushbu modda birinchi qismining<a href="https://lex.uz/uz/docs/-6066682#-6068170"> ikkinchi</a>, <a href="https://lex.uz/uz/docs/-6066682#-6068171">uchinchi</a> va<a href="https://lex.uz/uz/docs/-6066682#-6068173"> toʻrtinchi xatboshilarida </a>nazarda tutilgan hollarda;</div></div><div class="ACT_TEXT"><div name="-6068194" id="-6068194">qoʻlkishanlarni yoki boshqa bogʻlash vositalarini — ushbu modda birinchi qismining<a href="https://lex.uz/uz/docs/-6066682#-6068171"> uchinchi — oltinchi xatboshilarida </a>nazarda tutilgan hollarda;</div></div><div class="ACT_TEXT"><div name="-6068195" id="-6068195">xizmat (qoʻriqchi) itlarini — ushbu modda birinchi qismining <a href="https://lex.uz/uz/docs/-6066682#-6068170">ikkinchi — oltinchi xatboshilarida </a>nazarda tutilgan hollarda;</div></div><div class="ACT_TEXT"><div name="-6068197" id="-6068197">transport vositalarini majburiy toʻxtatish vositalarini — ushbu modda birinchi qismining <a href="https://lex.uz/uz/docs/-6066682#-6068170">ikkinchi </a>va <a href="https://lex.uz/uz/docs/-6066682#-6068189">yettinchi xatboshilarida </a>nazarda tutilgan hollarda.</div></div><div class="ACT_TEXT"><div name="-6068204" id="-6068204">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari ushbu Qonunda xizmat qurolini ishlatishga ruxsat etilgan barcha hollarda maxsus vositalarni qoʻllash huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-6068205" id="-6068205">Maxsus vositalar, agar idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari tomonidan huquqbuzarga nisbatan ogohlantiruvchi harakatlarning boshqa barcha shakllaridan foydalanilsa va ular kutilgan natijalarni bermasa, qoʻllaniladi.</div></div><div class="ACT_TEXT"><div name="-6068207" id="-6068207">Maxsus vositalarning qoʻllanilishi uchinchi shaxslarning hayotiga, sogʻligʻiga xavf tugʻdirmasligi va mol-mulkiga zarar yetkazmasligi kerak.</div></div><div class="ACT_TEXT"><div name="-6068208" id="-6068208">Homiladorlik belgilari sezilib turgan ayollarga, nogironlik belgilari koʻrinib turgan shaxslarga hamda yoshi aniq koʻrinib turgan yoki maʼlum boʻlgan voyaga yetmaganlarga nisbatan maxsus vositalarni qoʻllash taqiqlanadi, bundan ularning qurolli qarshilik koʻrsatganligi yoki fuqarolarning yoxud idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchilarining va xizmatchilarining hayotiga hamda sogʻligʻiga haqiqatda tahdid etib, guruh boʻlib hujum qilganligi hollari mustasno.</div></div><div class="ACT_TEXT"><div name="-6068212" id="-6068212">Odamning boshiga, boʻyniga, oʻmrov suyagiga, qorniga, jinsiy aʼzolariga, yurak sohasiga rezina tayoq bilan zarbalar berish taqiqlanadi, bundan odam qurolli qarshilik koʻrsatganligi yoki fuqarolarning yoxud idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchilarining va xizmatchilarining hayotiga hamda sogʻligʻiga haqiqatda tahdid etib, guruh boʻlib hujum qilganligi hollari mustasno.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068213" id="-6068213">26-modda. Xizmat qurolini qoʻllash</div></div><div class="ACT_TEXT"><div name="-6068215" id="-6068215">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari quyidagi hollarda xizmat qurolini qoʻllash huquqiga ega boʻladi: </div></div><div class="ACT_TEXT"><div name="-6068217" id="-6068217">qoʻriqlanadigan shaxsni va qoʻriqlanadigan obyektda boʻlgan boshqa fuqarolarni hujumdan himoya qilishda, agar hujum hayot yoki sogʻliq uchun xavfli boʻlgan zoʻrlik ishlatish bilan qilingan boʻlsa;</div></div><div class="ACT_TEXT"><div name="-6068218" id="-6068218">qoʻriqlanadigan obyektlarga qurolli hujumni yoki guruh boʻlib qilingan hujumni qaytarishda;</div></div><div class="ACT_TEXT"><div name="-6068220" id="-6068220">idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchilarining va xizmatchilarining hayotiga va sogʻligʻiga tahdid soladigan hujumni qaytarishda, shuningdek xizmat qurolini egallab olishga boʻlgan urinishlarning oldini olishda;</div></div><div class="ACT_TEXT"><div name="-6068222" id="-6068222">oʻta ogʻir jinoyatni sodir etish chogʻida koʻrib qolingan va qoʻriqlanadigan obyekt hududidan yashirinishga urinayotgan shaxsni ushlashda, agar boshqa vositalar bilan bu shaxsni ushlash imkoni boʻlmasa; </div></div><div class="ACT_TEXT"><div name="-6068223" id="-6068223">qurolli qarshilik koʻrsatayotgan shaxsni, shuningdek oʻzidagi qurolni, oʻq-dorilarni, portlovchi moddalarni, portlatish qurilmalarini, zaharli yoki radioaktiv moddalarni topshirish toʻgʻrisidagi qonuniy talabni bajarishni rad etayotgan shaxsni ushlashda;</div></div><div class="ACT_TEXT"><div name="-6068225" id="-6068225">agar haydovchi qoʻriqlanadigan obyekt ishchilari va xizmatchilarining, qoʻriqlanadigan shaxsning hayotiga hamda sogʻligʻiga haqiqiy xavf tugʻdirsa va idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchisi va xizmatchisining qonuniy talablariga qaramasdan toʻxtashni rad etsa, ushbu transport vositasini unga shikast yetkazish yoʻli bilan toʻxtatishda;</div></div><div class="ACT_TEXT"><div name="-6068228" id="-6068228">insonning hayotiga va sogʻligʻiga tahdid solayotgan hayvonni zararsizlantirishda;</div></div><div class="ACT_TEXT"><div name="-6068230" id="-6068230">xizmat qurolini qoʻllash niyati toʻgʻrisida ogohlantirish sifatida oʻq otishda, yuqoriga qarata yoki boshqa xavfsiz yoʻnalishda oʻq otish orqali xavf-xatar signalini berishda yoki yordamga chaqirishda. </div></div><div class="ACT_TEXT"><div name="-6068231" id="-6068231">Idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchisi va xizmatchisi xizmat qurolini qoʻllashdan oldin ogohlantirishi shart, bundan ularning oʻz hayotiga yoki fuqarolarning hayotiga bevosita xavf tahdid solayotgan hollar mustasno.</div></div><div class="ACT_TEXT"><div name="-6068233" id="-6068233">Ayollarga, nogironlik belgilari koʻrinib turgan shaxslarga, yoshi aniq koʻrinib turgan yoki maʼlum boʻlgan voyaga yetmaganlarga nisbatan xizmat qurolini qoʻllash taqiqlanadi, bundan ularning qurolli hujum qilganligi, qurolli qarshilik koʻrsatganligi yoki fuqarolarning yoxud idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalari ishchisi va xizmatchisining hayotiga va sogʻligʻiga tahdid etib, guruh boʻlib hujum qilganligi hollari mustasno.</div></div><div class="ACT_TEXT"><div name="-6068235" id="-6068235">Agar xizmat quroli qoʻllanilishi natijasida tasodifiy shaxslar jabrlanishi mumkin boʻlsa, idoraviy harbiylashtirilgan qoʻriqlash hamda idoraviy qorovullik boʻlinmalarining ishchilari va xizmatchilari koʻp fuqarolar toʻplanganda uni qoʻllash huquqiga ega emas, bundan terrorchilik harakatining oldini olish, garovdagilarni ozod qilish, qurolli hujumni qaytarish hollari mustasno.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068236" id="-6068236">27-modda. Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar tomonidan xizmat (qoʻriqchi) itlaridan foydalanilishi</div></div><div class="ACT_TEXT"><div name="-6068237" id="-6068237">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlar oʻz zimmasiga yuklatilgan vazifalarni bajarish uchun xizmat (qoʻriqchi) itlaridan foydalanishi mumkin. Xizmat (qoʻriqchi) itlari xizmatda foydalanishga yaroqli deb topilgan boʻlishi va ularning veterinar pasporti boʻlishi kerak.</div></div><div class="ACT_TEXT"><div name="-6068238" id="-6068238">Qoʻriqlash faoliyatini amalga oshiruvchi subyektlarning harbiy xizmatchilari, xodimlari, ishchilari va xizmatchilari qoʻriqlanadigan hududni xizmat (qoʻriqchi) iti bilan aylanib chiqishi vaqtida xizmat (qoʻriqchi) iti tasmada va tumshuqbogʻda boʻlishi kerak. Jamoat joylarida va odamlar gavjum boʻlgan joylarda maxsus tayyorgarlikdan oʻtkazilmagan xizmat (qoʻriqchi) itlaridan foydalanish taqiqlanadi.</div></div><div class="ACT_TEXT"><div name="-6068240" id="-6068240">Odamlar boʻlmagan vaqtda yopiq hududda xizmat (qoʻriqchi) itlaridan qoʻriqlash boʻlinmasi xodimining nazorati ostida tasmasiz foydalanishga ruxsat beriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6068242" id="-6068242">7-bob. Yakunlovchi qoidalar</div></div><div class="CLAUSE_DEFAULT"><div name="-6068244" id="-6068244">28-modda. Qoʻriqlash faoliyati toʻgʻrisidagi qonunchilikni buzganlik uchun javobgarlik</div></div><div class="ACT_TEXT"><div name="-6068247" id="-6068247">Qoʻriqlash faoliyati toʻgʻrisidagi qonunchilikni buzganlikda aybdor shaxslar belgilangan tartibda javobgar boʻladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068248" id="-6068248">29-modda. Ushbu Qonunning ijrosini, yetkazilishini, mohiyati va ahamiyati tushuntirilishini taʼminlash </div></div><div class="BY_DEFAULT"><div name="-8230522" id="-8230522"></div></div><div class="ACT_TEXT"><div name="-8230524" id="-8230524">Oʻzbekiston Respublikasi Ichki ishlar vazirligi va boshqa manfaatdor tashkilotlar ushbu Qonunning ijrosini, ijrochilarga yetkazilishini hamda mohiyati va ahamiyati aholi oʻrtasida tushuntirilishini taʼminlasin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068251" id="-6068251">30-modda. Qonunchilikni ushbu Qonunga muvofiqlashtirish</div></div><div class="ACT_TEXT"><div name="-6068252" id="-6068252">Oʻzbekiston Respublikasi Vazirlar Mahkamasi: </div></div><div class="ACT_TEXT"><div name="-6068253" id="-6068253">hukumat qarorlarini ushbu Qonunga muvofiqlashtirsin; </div></div><div class="ACT_TEXT"><div name="-6068254" id="-6068254">davlat boshqaruvi organlari ushbu Qonunga zid boʻlgan oʻz normativ-huquqiy hujjatlarini qayta koʻrib chiqishlari va bekor qilishlarini taʼminlasin.</div></div><div class="CLAUSE_DEFAULT"><div name="-6068255" id="-6068255">31-modda. Ushbu Qonunning kuchga kirishi</div></div><div class="ACT_TEXT"><div name="-6068257" id="-6068257">Ushbu Qonun rasmiy eʼlon qilingan kundan eʼtiboran uch oy oʻtgach kuchga kiradi.</div></div><div class="SIGNATURE"><div name="-6068258" id="-6068258">Oʻzbekiston Respublikasining Prezidenti Sh. MIRZIYOYEV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6068259" id="-6068259">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6068260" id="-6068260">2022-yil 15-iyun,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-6068261" id="-6068261">OʻRQ-778-son</div></div></div>
</div></body></html>