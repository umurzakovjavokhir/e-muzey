<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-5344312" id="-5344312">Oʻzbekiston Respublikasi Prezidentining</div></div><div class="ACT_FORM"><div name="-5344313" id="-5344313">Farmoni</div></div><div class="ACT_TITLE"><div name="-5344314" id="-5344314">Jamoat xavfsizligini taʼminlash va jinoyatchilikka qarshi kurashish sohasida ichki ishlar organlari faoliyatini sifat jihatidan yangi bosqichga koʻtarish chora-tadbirlari toʻgʻrisida</div></div><div class="BY_DEFAULT"><div name="-5344315" id="-5344315"></div></div><div class="ACT_TEXT"><div name="-5344316" id="-5344316">Jamoat xavfsizligini taʼminlash, huquqbuzarliklarning oldini olish va jinoyatchilikka qarshi kurashishning yaxlit tizimini shakllantirish, ichki ishlar organlarining eng quyi boʻgʻinidan respublika darajasigacha samarali faoliyatini yoʻlga qoʻyish va zamonaviy ish uslublarini joriy etish orqali mamlakatimizda huquq-tartibot va qonuniylikni mustahkamlash, aholining tinchligi va osoyishtaligini taʼminlash maqsadida:</div></div><div class="ACT_TEXT"><div name="-5344318" id="-5344318">1. Ichki ishlar organlari faoliyatini tashkil etishning mutlaqo yangi mexanizmlari etib quyidagilar belgilansin:</div></div><div class="ACT_TEXT"><div name="-5344319" id="-5344319">har bir mahalla, oila va shaxs kesimida jinoyatchilikning sabablarini aniqlash va ularni bartaraf etish orqali huquqbuzarliklarning oldini olish va jinoyatchilikka qarshi kurashishga oid muammolarni bevosita joylarning oʻzida hal etish;</div></div><div class="ACT_TEXT"><div name="-5344320" id="-5344320">hududlarda jinoyatchilik ahvolidan kelib chiqib, har bir tuman, shahar va mahallalarni toifalarga ajratish hamda hokimliklar, sektorlar va jamoatchilik bilan hamkorlikda “jinoyat oʻchoqlari”ni bartaraf etish uchun barcha zarur kuch va vositalarni jalb qilish;</div></div><div class="ACT_TEXT"><div name="-5344321" id="-5344321">“respublika — viloyat — tuman — mahalla” tizimi asosida yaxlit boshqaruv va uzluksiz nazorat qilish mexanizmlarini joriy etish, ichki ishlar va boshqa davlat organlarining jamoat xavfsizligini taʼminlash borasidagi faoliyatini samarali muvofiqlashtirish orqali mamlakatimizda tinchlik va barqarorlikni taʼminlash;</div></div><div class="ACT_TEXT"><div name="-5344322" id="-5344322">ichki ishlar organlari xodimlarining zamonaviy qiyofasini yaratish, ularning masʼuliyati va kasbiy salohiyatini oshirish, jinoyatchilikning yangi koʻrinishlariga qarshi kurashish uchun zarur koʻnikmalarni shakllantirish hamda sohani toʻliq raqamlashtirishga erishish.</div></div><div class="ACT_TEXT"><div name="-5344323" id="-5344323">2. Ichki ishlar organlarining tayanch punktlari negizida mahalla huquq-tartibot maskanlari bosqichma-bosqich tashkil etilsin.</div></div><div class="ACT_TEXT"><div name="-5344324" id="-5344324">Belgilab qoʻyilsinki:</div></div><div class="ACT_TEXT"><div name="-5344325" id="-5344325">mahalla huquq-tartibot maskani hududdagi jamoat xavfsizligini taʼminlash, huquqbuzarliklarning oldini olish va jinoyatchilikka qarshi kurashishning asosiy quyi boʻgʻini hisoblanadi;</div></div><div class="ACT_TEXT"><div name="-5344326" id="-5344326">mahalla huquq-tartibot maskani negizida hududdagi ichki ishlar organlarining tegishli sohaviy xizmatlari hamda Milliy gvardiya va boshqa davlat organlarining muvofiqlashtirilgan faoliyati tashkil etiladi;</div></div><div class="ACT_TEXT"><div name="-5344327" id="-5344327">mahalla huquq-tartibot maskani tomonidan jamoat xavfsizligini taʼminlash, huquqbuzarliklarning oldini olish va jinoyatchilikka qarshi kurashish ishlarini tizimli tashkil etish va muvofiqlashtirish vazifasi profilaktika inspektoriga yuklanadi.</div></div><div class="ACT_TEXT"><div name="-5344330" id="-5344330">Ichki ishlar vaziri P.R. Bobojonov va Milliy gvardiya qoʻmondoni R.M. Joʻrayev:</div></div><div class="ACT_TEXT"><div name="-5344332" id="-5344332">Toshkent shahar hokimi bilan birgalikda uch oy muddatda poytaxtda mahalla huquq-tartibot maskanlarining faoliyatini yangi talablarga koʻra namunaviy tarzda tashkil etish;</div></div><div class="ACT_TEXT"><div name="-5344333" id="-5344333">Qoraqalpogʻiston Respublikasi Vazirlar Kengashi Raisi va viloyatlar hokimlari bilan birgalikda joriy yil yakuni boʻyicha Toshkent shahridagi mahalla huquq-tartibot maskanlari faoliyatidan kelib chiqqan holda respublikaning boshqa hududlarida mahalla huquq-tartibot maskanlari faoliyatini yoʻlga qoʻyish choralarini koʻrsin.</div></div><div class="ACT_TEXT"><div name="-5344336" id="-5344336">3. Profilaktika inspektoriga masofadan turib murojaat yuborish va uni koʻrib chiqish jarayonini kuzatib borish, aholi bilan oʻzaro tezkor muloqotni yoʻlga qoʻyish, profilaktika inspektorlari va sektor rahbarlari faoliyatiga baho berish imkonini beruvchi “Smart mahalla” axborot dasturi ishlab chiqilganligi maʼlumot uchun qabul qilinsin.</div></div><div class="ACT_TEXT"><div name="-5344343" id="-5344343">Vazirlar Mahkamasi (O.M. Umarov) va Ichki ishlar vazirligi (N.S. Turaxodjayev) mazkur axborot dasturini 2021-yil 1-iyunga qadar Toshkent va Samarqand viloyatlarida, joriy yilning yakunigacha esa respublikaning boshqa hududlarida ishga tushirsin.</div></div><div class="ACT_TEXT"><div name="-5344344" id="-5344344">Ichki ishlar vazirligi (P.R. Bobojonov) bir oy muddatda viloyat, tuman va shahar ichki ishlar organlari rahbarlari tomonidan har oy yakuni boʻyicha aholiga Internet tizimidagi axborot resurslari orqali hududdagi kriminogen vaziyat yuzasidan “profilaktik-ogohlantiruvchi murojaat” qilib borish amaliyotini joriy etsin.</div></div><div class="ACT_TEXT"><div name="-5344347" id="-5344347">4. Tuman va shahar ichki ishlar organlari faoliyatining samaradorligini oshirish maqsadida:</div></div><div class="ACT_TEXT"><div name="-5344348" id="-5344348">Toshkent shahridagi 24 ta ichki ishlar boʻlimlari va ayrim tuzilmalarining rahbarlik lavozimlari maqbullashtirilib, boʻshatilayotgan shtat birliklari poytaxt ichki ishlar organlarining profilaktika va tergov-tezkor tuzilmalarini kuchaytirishga yoʻnaltirilsin;</div></div><div class="ACT_TEXT"><div name="-5344349" id="-5344349">joylardagi kriminogen va ijtimoiy vaziyatdan kelib chiqib, tuman va shahar ichki ishlar organlarining tashkiliy-shtat tuzilmalarini shakllantirish va muntazam oʻzgartirib borish tartibi joriy etilsin;</div></div><div class="ACT_TEXT"><div name="-5344351" id="-5344351">tuman va shahar probatsiya boʻlinmalari tegishincha tuman va shahar ichki ishlar organlarining bevosita boʻysunuviga oʻtkazilib, probatsiya hisobiga olingan shaxslarni kunlik nazorat qilishda profilaktika inspektorlari bilan hamkorlik mexanizmlari belgilansin.</div></div><div class="ACT_TEXT"><div name="-5344354" id="-5344354">Ichki ishlar vazirligi (P.R. Bobojonov):</div></div><div class="ACT_TEXT"><div name="-5344355" id="-5344355">bir oy muddatda Toshkent shahri tajribasiga asosan respublikaning barcha hududlaridagi ichki ishlar boʻlimlari (boʻlinmalari)ni va ayrim tuzilmalarining rahbarlik lavozimlarini maqbullashtirish hamda boʻshaydigan shtat birliklarini jamoat xavfsizligini taʼminlash sohasiga yoʻnaltirish choralarini koʻrsin;</div></div><div class="ACT_TEXT"><div name="-5344356" id="-5344356">ikki oy muddatda mazkur Farmon bilan belgilanayotgan talablarni inobatga olgan holda hududiy ichki ishlar organlarining yangi tashkiliy-shtat tuzilmalari boʻyicha takliflar kiritsin.</div></div><div class="ACT_TEXT"><div name="-5344359" id="-5344359">5. Ichki ishlar vazirligi tuzilmasini takomillashtirish orqali turdosh sohaviy xizmatlar faoliyatini boshqarish va muvofiqlashtirishning yagona tizimini joriy etish maqsadida:</div></div><div class="ACT_TEXT"><div name="-5344360" id="-5344360">a) quyidagilar tashkil etilsin:</div></div><div class="ACT_TEXT"><div name="-5344362" id="-5344362">Jinoyat qidiruv bosh boshqarmasi, Terrorizm va ekstremizmga qarshi kurashish bosh boshqarmasi, Tezkor-qidiruv hamkorligi boshqarmasini oʻz ichiga oladigan Tezkor-qidiruv departamenti;</div></div><div class="ACT_TEXT"><div name="-5344363" id="-5344363">Patrul-post xizmati va jamoat tartibini saqlash bosh boshqarmasi, Huquqbuzarliklar profilaktikasi bosh boshqarmasi, Yoʻl harakati xavfsizligi bosh boshqarmasi, Probatsiya xizmatini oʻz ichiga oladigan Jamoat xavfsizligi departamenti;</div></div><div class="ACT_TEXT"><div name="-5344364" id="-5344364">Transportda xavfsizlikni taʼminlash bosh boshqarmasi, Xavfsiz turizmni taʼminlashni muvofiqlashtirish boshqarmasini oʻz ichiga oladigan Transport va turizm obyektlarida xavfsizlikni taʼminlash departamenti;</div></div><div class="ACT_TEXT"><div name="-5344366" id="-5344366">Kadrlar bosh boshqarmasi, Maʼnaviy-maʼrifiy ishlar boshqarmasi, kasbiy tayyorgarlik boshqarmasini oʻz ichiga oladigan Maʼnaviy-maʼrifiy ishlar va kadrlar bilan taʼminlash departamenti.</div></div><div class="ACT_TEXT"><div name="-5344368" id="-5344368">Belgilansinki, ichki ishlar vazirining oʻrinbosarlari tashkil etilayotgan tegishli departamentlarning bevosita rahbarlari hisoblanadi va ularning zimmasiga departamentlarga qoʻyilgan vazifalarning samarali amalga oshirilishi boʻyicha shaxsiy javobgarlik yuklanadi;</div></div><div class="ACT_TEXT"><div name="-5344383" id="-5344383">b) Jazoni ijro etish bosh boshqarmasi Ichki ishlar vazirligi huzuridagi Jazoni ijro etish departamenti (keyingi oʻrinlarda — Jazoni ijro etish departamenti) etib qayta tashkil etilsin.</div></div><div class="ACT_TEXT"><div name="-5344385" id="-5344385">Shunday tartib oʻrnatilsinki, unga muvofiq:</div></div><div class="ACT_TEXT"><div name="-5344387" id="-5344387">Jazoni ijro etish departamenti bevosita ichki ishlar vaziriga boʻysunadi va vazirning zimmasiga ichki ishlar organlarining jinoiy jazolarni ijro etish tizimini rivojlantirish va unda qatʼiy intizomni taʼminlash uchun shaxsiy javobgarlik yuklanadi;</div></div><div class="ACT_TEXT"><div name="-5344388" id="-5344388">ichki ishlar organlarining barcha tergov hibsxonalari va jazoni ijro etish muassasalari hududiy ichki ishlar organlarining tuzilmaviy-funksional boʻysunuvidan chiqarilib, Jazoni ijro etish departamenti boʻysunuviga oʻtkaziladi;</div></div><div class="ACT_TEXT"><div name="-5344390" id="-5344390">tergov hibsxonalari va jazoni ijro etish muassasalari faoliyatini samarali yoʻlga qoʻyish va ularda kunlik nazoratni olib borish Jazoni ijro etish departamenti tizimida tashkil etiladigan 6 ta mintaqaviy muvofiqlashtirish markazlari tomonidan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-5344391" id="-5344391">6. Hududiy ichki ishlar organlarining tuzilmasi va rahbar lavozimlarini maqbullashtirish orqali mavjud kuch va vositalardan samarali foydalanishni taʼminlash maqsadida:</div></div><div class="ACT_TEXT"><div name="-5344392" id="-5344392">a) quyidagi lavozimlar tugatilsin:</div></div><div class="ACT_TEXT"><div name="-5344393" id="-5344393">Qoraqalpogʻiston Respublikasi ichki ishlar vazirining, viloyat, tuman va shahar ichki ishlar organlari boshliqlarining jamoat tartibini saqlash boʻyicha oʻrinbosari;</div></div><div class="ACT_TEXT"><div name="-5344394" id="-5344394">Qoraqalpogʻiston Respublikasi ichki ishlar vazirining, viloyat, tuman va shahar ichki ishlar organlari boshliqlarining oʻrinbosari — huquqbuzarliklar profilaktikasi boshqarmasi (boʻlimi) boshligʻi;</div></div><div class="ACT_TEXT"><div name="-5344395" id="-5344395">viloyat ichki ishlar boshqarmasi (bosh boshqarmasi) boshliqlarining probatsiya va jazoni ijro etish masalalari boʻyicha oʻrinbosari;</div></div><div class="ACT_TEXT"><div name="-5344396" id="-5344396">b) Qoraqalpogʻiston Respublikasi ichki ishlar vazirining, viloyat, tuman va shahar ichki ishlar organlari boshliqlarining oʻrinbosari — Jamoat xavfsizligi xizmati boshligʻi lavozimi joriy etilsin va quyidagilar uning asosiy vazifalari etib belgilansin:</div></div><div class="ACT_TEXT"><div name="-5344397" id="-5344397">patrul-post va yoʻl-patrul xizmati boʻlinmalari faoliyatini, shuningdek, mahallalar va jamoat joylarida manzilli profilaktik tadbirlar oʻtkazilishini muvofiqlashtirish;</div></div><div class="ACT_TEXT"><div name="-5344398" id="-5344398">muqaddam sudlangan va probatsiya hisobiga olingan shaxslar bilan ishlash hamda ichki ishlar organlarining tungi xizmatini tashkil etish.</div></div><div class="ACT_TEXT"><div name="-5344399" id="-5344399">Ichki ishlar vaziri oʻrinbosari A.I. Ikramov zimmasiga jamoat xavfsizligini taʼminlash boʻyicha yangi joriy etilayotgan boshqaruv tizimini samarali yoʻlga qoʻyish yuzasidan shaxsiy javobgarlik yuklansin.</div></div><div class="ACT_TEXT"><div name="-5344401" id="-5344401">7. Ichki ishlar vazirligining huquqiy statistikani yuritishni takomillashtirish, uning kriminogen vaziyatni tahlil qilish va jinoyatchilik dinamikasini prognoz qilishdagi rolini oshirish toʻgʻrisidagi quyidagi takliflari maʼqullansin:</div></div><div class="BY_DEFAULT"><div name="-5344872" id="-5344872"></div></div><div class="BY_DEFAULT"><div name="-7483156" id="-7483156"></div></div><div class="ACT_TEXT"><div name="-7483157" id="-7483157">a) Ichki ishlar vazirligi Huquqiy statistika va tezkor-hisob maʼlumotlar bosh markazi va uning hududiy boʻlinmalarini (keyingi oʻrinlarda — Huquqiy statistika markazi) tashkil etish hamda quyidagilarni uning asosiy vazifalari etib belgilash:</div></div><div class="ACT_TEXT"><div name="-5344873" id="-5344873">jinoyatlar va maʼmuriy huquqbuzarliklar statistikasini yuritish, jinoyatchilik holatini, shu jumladan hududlar va huquqbuzarliklar turlari kesimida statistik tahlilni amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-5344876" id="-5344876">huquqbuzarliklarning oldini olish, ularni aniqlash va fosh etishda foydalanish uchun tezkor-maʼlumotlar hisoblari, ichki ishlar organlarining arxiv-maʼlumotlari va maxsus fondlarini yuritish, shuningdek, shaxslarning qidiruvini eʼlon qilish jarayonini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-5344878" id="-5344878">avtotransport vositalari, fuqaroviy va xizmat oʻqotar qurollari, qidiruvdagi shaxslar va ashyolar, shuningdek, huquqbuzarliklarning oldini olish va jinoyatchilikka qarshi kurashish samaradorligiga koʻmaklashuvchi boshqa maʼlumotlar boʻyicha avtomatlashtirilgan axborot bankini yuritish.</div></div><div class="ACT_TEXT"><div name="-5344880" id="-5344880">Belgilansinki:</div></div><div class="ACT_TEXT"><div name="-5344881" id="-5344881">Huquqiy statistika markazi Ichki ishlar vazirligi Tezkor-maʼlumotlar boshqarmasi negizida, shuningdek, Bosh prokuraturaning Jinoiy-huquqiy statistika boshqarmasi va uning hududiy boʻlinmalari tugatilib, uning vazifalari va 120 ta shtat birliklari, ularni saqlash uchun koʻzda tutilgan Davlat budjeti mablagʻlari bilan birgalikda ichki ishlar organlariga oʻtkazilishi hisobiga tashkil etiladi;</div></div><div class="ACT_TEXT"><div name="-5344882" id="-5344882">ichki ishlar vazirining axborot texnologiyalari boʻyicha oʻrinbosari N.S. Turaxodjayev zimmasiga Huquqiy statistika markazi faoliyatini toʻliq raqamlashtirish va mazkur sohada inson omilini istisno etishni taʼminlash yuzasidan shaxsiy javobgarlik yuklanadi.</div></div><div class="BY_DEFAULT"><div name="-5344883" id="-5344883"></div></div><div class="BY_DEFAULT"><div name="-5344891" id="-5344891"></div></div><div class="ACT_TEXT"><div name="-5344896" id="-5344896">8. Ichki ishlar organlari tizimini yanada takomillashtirish boʻyicha “yoʻl xaritasi” (keyingi oʻrinlarda — “yoʻl xarita”) <a href="https://lex.uz/uz/docs/-5344118#-5344920">1-ilovaga</a> muvofiq tasdiqlansin va quyidagilar uning asosiy yoʻnalishlari etib belgilansin:</div></div><div class="ACT_TEXT"><div name="-5344897" id="-5344897">zamonaviy tahdidlarni hisobga olgan holda ichki ishlar organlari faoliyatini yanada takomillashtirish boʻyicha tashkiliy oʻzgartirishlarni amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-5344898" id="-5344898">maʼnaviy-maʼrifiy ishlarning samarali mexanizmlarini joriy etish, shuningdek, malakali kadrlarni uzluksiz tayyorlash tizimini yaratish;</div></div><div class="ACT_TEXT"><div name="-5344899" id="-5344899">ichki ishlar organlari faoliyatiga raqamli va zamonaviy axborot texnologiyalarini keng joriy etish;</div></div><div class="ACT_TEXT"><div name="-5344900" id="-5344900">ichki ishlar organlari xodimlari va ular oila aʼzolarining ijtimoiy-huquqiy himoyasini hamda maishiy sharoitlarini yaxshilash.</div></div><div class="ACT_TEXT"><div name="-5344901" id="-5344901">9. Ichki ishlar vazirligi:</div></div><div class="ACT_TEXT"><div name="-5344902" id="-5344902">bir hafta muddatda ichki ishlar organlari faoliyatini mazkur Farmonga asosan tashkil etish mexanizmlarini belgilovchi Oʻzbekiston Respublikasi Prezidenti qarori loyihasini kiritsin;</div></div><div class="ACT_TEXT"><div name="-5344903" id="-5344903">bir oy muddatda manfaatdor idoralar bilan birgalikda Jamoat xavfsizligi konsepsiyasi, Ichki ishlar organlari tizimiga axborot texnologiyalarini joriy etish konsepsiyasi va Ichki ishlar organlarida maʼnaviy-maʼrifiy ishlarni tashkil etish konsepsiyasi loyihalarini kiritsin;</div></div><div class="ACT_TEXT"><div name="-5344904" id="-5344904">ikki oy muddatda Vazirlar Mahkamasiga “Eng yaxshi hududiy ichki ishlar organi boshligʻi”, “Eng yaxshi profilaktika inspektori”, “Eng yaxshi tergovchi”, “Eng yaxshi tezkor xodim” naminatsiyalari boʻyicha har yili respublika tanlovini oʻtkazish yuzasidan Hukumat qarori loyihasini kiritsin;</div></div><div class="ACT_TEXT"><div name="-5344905" id="-5344905">uch oy muddatda manfaatdor idoralar bilan birgalikda ushbu Farmondan kelib chiqadigan oʻzgartish va qoʻshimchalarni qonunchilik hujjatlariga kiritish yuzasidan Vazirlar Mahkamasiga takliflar kiritsin.</div></div><div class="ACT_TEXT"><div name="-5344907" id="-5344907">10. Oʻzbekiston Respublikasi Prezidentining ayrim farmonlariga <a href="https://lex.uz/uz/docs/-5344118#-5344926">2-ilovaga</a> muvofiq oʻzgartirishlar kiritilsin.</div></div><div class="ACT_TEXT"><div name="-5344908" id="-5344908">11. Mazkur Farmonning ijrosini samarali tashkil etishga masʼul va shaxsiy javobgar etib ichki ishlar vaziri P.R. Bobojonov belgilansin.</div></div><div class="ACT_TEXT"><div name="-5344910" id="-5344910">Mazkur Farmonning ijrosini muhokama qilib borish, ijro uchun masʼul idoralar faoliyatini muvofiqlashtirish va nazorat qilish Oʻzbekiston Respublikasi Prezidenti Administratsiyasi rahbari Z.Sh. Nizomiddinov zimmasiga yuklansin.</div></div><div class="ACT_TEXT"><div name="-5344911" id="-5344911">Amalga oshirilayotgan chora-tadbirlar natijadorligi yuzasidan 2021-yil 1-iyul va 2022-yil 1-yanvargacha Oʻzbekiston Respublikasi Prezidentiga axborot berilsin.</div></div><div class="SIGNATURE"><div name="-5344912" id="-5344912">Oʻzbekiston Respublikasi Prezidenti Sh. MIRZIYOYEV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-5344914" id="-5344914">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-5344915" id="-5344915">2021-yil 26-mart,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-5344917" id="-5344917">PF-6196-son</div></div><div class="BY_DEFAULT"><div name="-5344920" id="-5344920"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5344921" id="-5344921">Oʻzbekiston Respublikasi Prezidentining 2021-yil 26-martdagi PF-6196-son <a href="https://lex.uz/uz/docs/-5344118">Farmoniga</a><br />1-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-5344922" id="-5344922"><strong>Ichki ishlar organlari tizimini yanada takomillashtirish boʻyicha</strong></div></div><div class="ACT_FORM"><div name="-5344923" id="-5344923"><strong>“YOʻL XARITASI”</strong></div></div><div class="BY_DEFAULT"><div name="-5344924" id="-5344924"></div></div><div class="TABLE_STD2"><div name="-5344925" id="-5344925"><table border="1" cellpadding="0" cellspacing="0" style="border-top: medium none;border-right: medium none;width: 100%;border-collapse: collapse;border-bottom: medium none;border-left: medium none" width="100%">	<tbody>		<tr>			<td style="border-top: windowtext 1pt solid;border-right: windowtext 1pt solid;width: 2.16%;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">T/r</span></span></strong></p>			</td>			<td style="border-top: windowtext 1pt solid;border-right: windowtext 1pt solid;width: 59.76%;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Chora-tadbirlarning nomlanishi</span></span></strong></p>			</td>			<td style="border-top: windowtext 1pt solid;border-right: windowtext 1pt solid;width: 14.14%;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Amalga oshirish shakli</span></span></strong></p>			</td>			<td style="border-top: windowtext 1pt solid;border-right: windowtext 1pt solid;width: 8.82%;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ijro muddati</span></span></strong></p>			</td>			<td style="border-top: windowtext 1pt solid;border-right: windowtext 1pt solid;width: 15.12%;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Masʼul ijrochilar</span></span></strong></p>			</td>		</tr>		<tr>			<td colspan="5" style="border-top: medium none;border-right: windowtext 1pt solid;width: 100%;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">I. Ichki ishlar organlari faoliyatini takomillashtirish boʻyicha tashkiliy oʻzgartirishlar</span></span></strong></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">1.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Jamoat xavfsizligini taʼminlashning sifat jihatidan yangi tizimini, shu jumladan quyidagilarni nazarda tutgan holda joriy etish:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Jamoat xavfsizligi konsepsiyasini tasdiqlash;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">patrul-post va yoʻl-patrul xizmatlari, huquqbuzarliklar profilaktikasi va probatsiya xizmatlari boʻlinmalarining oʻzaro hamkorlikda ishlashi boʻyicha yangi mexanizmlarni belgilash;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Milliy gvardiya boʻlinmalarining jamoat tartibini saqlash tizimidagi vakolatlari va shaxsiy javobgarligini belgilash;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">probatsiya nazoratidagi shaxslarning xulq-atvorini kunlik nazorat qilishda profilaktika inspektorlari bilan hamkorlik mexanizmlarini joriy etgan holda probatsiya boʻlinmalarining faoliyati samaradorligini oshirish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Prezidentining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 30-aprel</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Ikramov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Milliy gvardiya (Joʻrayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bosh prokuratura (Valiyev)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar vazirligining Huquqiy statistika va tezkor-hisob maʼlumotlari markazi va uning quyi tizimlarini, axborot texnologiyalarini keng joriy etgan va faoliyatini raqamlashtirgan holda tashkil etish va toʻlaqonli faoliyat yuritishi boʻyicha tashkiliy choralarni belgilash.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“Elektron jinoiy-huquqiy statistika” yagona axborot tizimi va 2019 — 2021-yillarda toʻplangan huquqiy statistik maʼlumotlar arxivi Ichki ishlar vazirligi tasarrufiga oʻtkazilishini hamda boshqa zarur tashkiliy choralar koʻrilishini taʼminlash.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Tashkiliy chora-tadbirlar</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 1-iyul</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Vazirlar Mahkamasi (Umarov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bosh prokuratura (Yuldashev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Pekos)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">3.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar vazirligi tuzilmasida Jamoat xavfsizligi masalalari ilmiy-amaliy tadqiqotlar markazini tashkil etish, uning faoliyati va ishlash mexanizmlari haqidagi nizomni, quyidagilarni nazarda tutgan holda tasdiqlash:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">shtat birliklari sonini 20 ta (15 ta xodim, 5 ta erkin yollangan xizmatchi) etib belgilash (ichki ishlar organlari umumiy shtat birliklari doirasida);</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">katta ilmiy va amaliy tajribaga, tahliliy fikrlash qobiliyatiga ega yuqori malakali mutaxassislar bilan jamlash tartibi;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">respublikada kriminogen vaziyatni tizimli tahlil qilish, jinoiy qilmishlarning sodir etilishiga taʼsir qilayotgan omillarni aniqlash, jinoyatlarning dinamikasini mintaqalar va turlari kesimida prognoz qilish mexanizmlari;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">huquq-tartibot kuch va vositalarini boshqarish samaradorligini oshirish boʻyicha toʻlaqonli tizimlar va ilmiy asoslangan metodikalarni ishlab chiqish, jamoat xavfsizligini taʼminlash borasidagi chora-tadbirlarning sifatini oshirish boʻyicha tavsiya va ishlanmalarni huquqni qoʻllash amaliyotiga joriy etish shakllari.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Idoraviy normativ hujjat</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 1-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">4.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar organlarining tezkor-qidiruv faoliyatini quyidagi yoʻnalishlar boʻyicha takomillashtirish:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">uyushgan jinoyatchilik, terrorizm va ekstremizm, giyohvand vositalar, psixotrop moddalar va ularning analoglari noqonuniy aylanmasiga qarshi kurashish chora-tadbirlari samaradorligini oshirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">axborot texnologiyalari va Internet tarmogʻidan foydalanish sohasidagi jinoyatlarga qarshi kurashish borasida tubdan yangi mexanizmlarni joriy etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">tezkor boʻlinmalar faoliyatini apparat-dasturiy taʼminlash, zamonaviy axborot texnologiyalarini keng tatbiq etish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Prezidentining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 15-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Sobirov, Turaxodjayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bosh prokuratura (Valiyev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">DXX, </span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Ishmetov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">5.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Transport va turizm obyektlarida xavfsizlikni taʼminlash faoliyatini tashkil etish boʻyicha, quyidagilarni nazarda tutgan holda yangi chora-tadbirlarni belgilash:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">turistlarning turistik namoyish va infratuzilma obyektlariga tashrif buyurishi, harakatlanishi va kechki vaqtini mazmunli tashkil etish vaqtida ularning shaxsiy va jamoaviy xavfsizligini taʼminlashning samarali mexanizmlarini joriy etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">transport obyektlarida mavjud kuch va vositalarni tarmoqli boshqarish tamoyilini joriy etgan holda xavfsizlikni taʼminlash boʻyicha sifat jihatidan yangi tizimni oʻrnatish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Prezidentining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 25-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Transport vazirligi (Maxkamov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Xaydarov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">6.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Quyidagilarni nazarda tutgan holda jazoni ijro etish tizimida ishlab chiqarish faoliyatini yanada kuchaytirish boʻyicha yangi chora-tadbirlarni belgilash:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">jazoni ijro etish muassasalariga litsenziya talab etiladigan ayrim faoliyat turlari bilan tegishli litsenziyani olmasdan faoliyatni amalga oshirish huquqini istisno tariqasida berish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Jazoni ijro etish departamentining Markazlashtirilgan jamgʻarmasini qayta tashkil etish va ozodlikdan mahrum etilgan shaxslarning ijro hujjatlari boʻyicha Davlat budjetiga jazoni ijro etish muassasalari tomonidan undirilgan mablagʻlarning 50 foizi miqdoridagi ajratmalarni hamda boʻsh turgan budjetdan tashqari mablagʻlarni tijorat banklari depozitlariga joylashtirish hisobidan olingan daromadlarni Jamgʻarmaning qoʻshimcha manbalari sifatida belgilash.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 15-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Xaydarov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">7.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Respublika ichki ishlar organlari uchun namunaviy hududiy idora sifatida Toshkent viloyatining Angren shahar va Boʻstonliq tumani ichki ishlar boshqarmalari negizida “Namunaviy shahar ichki ishlar organi” va “Namunaviy tuman ichki ishlar organi” loyihalarini amalga oshirish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bunda, asosiy eʼtibor ish uslublariga, aholiga xizmat koʻrsatish masalalariga, hamkorlik mexanizmlariga, raqamli texnologiyalarni joriy etish darajasiga va shaxsiy tarkib bilan maʼnaviy-maʼrifiy ishlarni tashkil etish choralariga qaratiladi.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Tashkiliy chora-tadbirlar</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 1-avgust</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov), </span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Toshkent viloyati hokimligi (Xidoyatov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Pekos)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">8.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Toshkent viloyatida ikkita tuman (shahar) doirasida, eksperiment tariqasida, ichki ishlar organlari sanitariya tadbirlarini taʼminlash boʻyicha boʻlinmalarini tashkil etish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bunda, shtatlarni kiritish va taʼminlash masalalari dastlabki davrda Toshkent viloyati hokimligining mahalliy budjeti mablagʻlari hisobidan amalga oshiriladi, keyinchalik esa oʻzini oʻzi moliyalashtirish mexanizmlari asosida tashkil etiladi.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 15-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Toshkent viloyati hokimligi (Xidoyatov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Xaydarov)</span></span></p>			</td>		</tr>		<tr>			<td colspan="5" style="border-top: medium none;border-right: windowtext 1pt solid;width: 100%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">II. Maʼnaviy-maʼrifiy ishlar, xodimlarni uzluksiz tayyorlash, qayta tayyorlash va malakasini oshirishning samarador mexanizmini joriy etish</span></span></strong></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">9.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Quyidagilarni oʻz ichiga oluvchi Ichki ishlar organlarida maʼnaviy-maʼrifiy ishlarni tashkil etish konsepsiyasini ishlab chiqish va tasdiqlash:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“Vatanga va xalqqa sadoqat bilan xizmat qilish — oliy burchimiz” konseptual gʻoyasi asosida xodimlarni tarbiyalashni takomillashtirish chora-tadbirlari;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">ichki ishlar organlarida maʼnaviy-maʼrifiy ishlarning asosiy maqsadi va vazifalari;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">har bir hududiy ichki ishlar organida jasorat va vatanparvarlik gʻoyalarini aks ettiruvchi maʼnaviy-maʼrifiy burchaklarni (xonalarni) tashkil etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">mafkuraviy ishlarni amalga oshirishning asosiy yoʻnalishlari, shu jumladan tarbiyaviy ishlar, targʻibot-tashviqot ishlari, psixologik qoʻllab-quvvatlash, ijtimoiy-huquqiy himoya va madaniy tadbirlar;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">ichki ishlar organlarida maʼnaviy-maʼrifiy ishlarning asosiy yoʻnalishlarini amalga oshirish mexanizmlari.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Normativ-huquqiy hujjat loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 15-aprel</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Maʼnaviyat va maʼrifat markazi (Xodjimatov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Madaniyat vazirligi (Nazarbekov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Yozuvchilar uyushmasi,</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, Toshkent shahar va viloyatlar hokimliklari</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">10.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Quyidagi yoʻnalishlarda jamoat xavfsizligini taʼminlash sohasida malakali kadrlarni maqsadli tayyorlash tizimini joriy etish:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">jamoat tartibini saqlash, yoʻl harakati xavfsizligi va pasport tizimi talablarini amalga oshirish yoʻnalishlari boʻyicha mutaxassislarni tayyorlash, qayta tayyorlash va malakasini oshirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">jamoat xavfsizligini taʼminlash muammolari boʻyicha fundamental ilmiy tadqiqotlar oʻtkazilishini tashkil etish, ushbu sohada yuqori malakali ilmiy-pedagog kadrlarni tayyorlash; </span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">jamoat xavfsizligi yoʻnalishi boʻyicha oʻquv jarayonini joriy etish borasida Milliy gvardiya Harbiy-texnik instituti faoliyatini tubdan takomillashtirish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Prezidentining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 10-aprel</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Milliy gvardiya (Joʻrayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Ikramov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oliy va oʻrta maxsus taʼlim vazirligi (Toshkulov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">11.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar organlari uchun intellektual-professional kadrlarni tayyorlash va ularni xizmatda koʻtarilishining sifat jihatidan yangi tizimini quyidagilarni nazarda tutgan holda joriy etish:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">oliy taʼlimning ikki bosqichli (bakalavriat va magistratura) tizimi va rahbarlik tarkibidagi kadrlarni maqsadli tayyorlash mexanizmlarini joriy etgan holda Ichki ishlar vazirligi Akademiyasi taʼlim jarayonini tubdan isloh qilish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar vazirligi Akademiyasining Nukus filialini ochish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">joylarda xodimlarni boshlangʻich tayyorlash, qayta tayyorlash va malakasini oshirishning yagona mexanizmlarini joriy etgan holda Ichki ishlar vazirligi Malaka oshirish institutini takomillashtirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 1-sentabrdan eʼtiboran oʻquv jarayonining xizmat oʻtash qoidalari bilan uzviy bogʻlangan tartibini oʻz ichiga olgan uzluksiz oʻqish-karyera tizimini joriy etish; </span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">mafkuraviy taʼlim, yuridik fanlar va jismoniy tayyorgarlikni kuchaytirgan holda Ichki ishlar vazirligining akademik litseylarida taʼlim jarayonining samaradorligini oshirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">moddiy ragʻbatlantirish mexanizmlarini joriy etgan holda, Ichki ishlar vazirligi taʼlim muassasalari pedagoglar tarkibining salohiyatini oshirish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Prezidentining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 10-aprel</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Xatamov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oliy va oʻrta maxsus taʼlim vazirligi (Toshkulov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Xaydarov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">12.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar organlari xodimlarini axloqiy-ruhiy qoʻllab-quvvatlash faoliyati boʻyicha sifat jihatidan yangi tizimni quyidagilarni nazarda tutgan holda joriy etish: </span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">ichki ishlar organlari tuzilmalarida axloqiy-ruhiy qoʻllab-quvvatlash boʻlinmalarini tashkil etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">ichki ishlar organlari tizimida psixologik xizmat koʻrsatish markazlarini tashkil etish va ularga shartnoma asosida mutaxassis-psixologlarni jalb etish imkoniyatini yaratish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">xizmat xususiyatlarini inobatga olgan holda, xodimlar orasida oʻz joniga suiqasd qilish va ruhiy tushkunlik holatlarining barvaqt oldini olishga qaratilgan yakka tartibda axloqiy-ruhiy ishlashning zamonaviy metodlarini tatbiq etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">xodimlarning psixologik portretini majburiy hisobga olish tartibini joriy etgan holda, ichki ishlar organlarining qabul va shahodatlash komissiyalarida mutaxassis-psixologlarning rolini oshirish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 15-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Sogʻliqni saqlash vazirligi (Xodjibayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Xaydarov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">13.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Quyidagilarni oʻz ichiga oluvchi “Eng yaxshi hududiy ichki ishlar organi boshligʻi”, “Eng yaxshi profilaktika inspektori”, “Eng yaxshi tergovchi”, “Eng yaxshi tezkor xodim” nominatsiyalari boʻyicha respublika tanlovini har yili oʻtkazish tartibini belgilash:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">sohaviy faoliyat boʻyicha eng yaxshi xodimlarni aniqlashning har tomonlama, xolisona, oshkora mexanizmlari va mezonlari joriy etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">eng yaxshi xodimlarni har yili “25-oktabr — Ichki ishlar organlari xodimlari kuni”ni nishonlash chogʻida eʼlon qilish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">budjetdan tashqari mablagʻlar hisobidan gʻoliblarni har oylik pul taʼminotining 100 foizgacha miqdorda bir yil davomida moddiy ragʻbatlantirish tartibini joriy etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">eng yaxshi xodimlarning fotosuratlari va ular haqidagi maʼlumotlarni bir yil davomida barcha ichki ishlar organlarida joylashtirish hamda ularning xizmat vazifalarini bajarish natijalarini keng targʻib etish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 25-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">14.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“Oʻzbekiston Respublikasi Ichki ishlar vazirligiga 30 yil” idoraviy esdalik koʻkrak nishonini taʼsis etish, ushbu koʻkrak nishoni bilan xodimlarni 2021-yilda “25-oktabr — Ichki ishlar organlari xodimlari kuni” arafasida taqdirlash.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Idoraviy normativ hujjat</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 20-aprel</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">15.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ikkinchi jahon urushi, qurolli toʻqnashuvlar va jangovar harakatlar davomida, jinoyatchilikka qarshi kurashish, favqulodda holatlarni bartaraf etish chogʻida xizmat burchini bajarib, mardlarcha halok boʻlgan ichki ishlar organlari xodimlari toʻgʻrisidagi maʼlumotlarni qamrab olgan “Ichki ishlar organlarining mard oʻgʻlonlari” kitobini tayyorlash va nashr etish. </span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Tashkiliy chora-tadbirlar</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 1-dekabr</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Maʼnaviyat va maʼrifat markazi (Xodjimatov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Yozuvchilar uyushmasi</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">16.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar organlari xodimlarining maʼnaviy-maʼrifiy saviyasini yanada yuksaltirish, vatanparvarlik va milliy gʻurur tuygʻularini yangi tizim asosida shakllantirish boʻyicha kompleks choralarni amalga oshirish.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Tashkiliy chora-tadbirlar</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil davomida</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Maʼnaviyat va maʼrifat markazi (Xodjimatov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oliy taʼlim muassasalari (Xatamov, Rustambayev)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">17.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar organlari xodimlarining sharafli faoliyatini va mazkur kasbning oʻziga xos xususiyatlarini aks ettiruvchi seriallarni olish va ularni ommaviy koʻrsatuvini tashkil etish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bunda, jamoat tartibini saqlash, huquqbuzarliklar profilaktikasi va jinoyatlarni fosh etish sohalari kesimida xodimlarning kasbiy mahoratlariga alohida eʼtibor qaratiladi.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Tashkiliy chora-tadbirlar</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-2022 yy. </span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Madaniyat vazirligi (Nazarbekov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“Oʻzbekkino”,</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Maʼnaviyat va maʼrifat markazi (Xodjimatov)</span></span></p>			</td>		</tr>		<tr>			<td colspan="5" style="border-top: medium none;border-right: windowtext 1pt solid;width: 100%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">III. Ichki ishlar organlari faoliyatiga zamonaviy raqamli va axborot texnologiyalarini tatbiq etish</span></span></strong></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">18.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar organlari tizimiga axborot texnologiyalarni joriy etish konsepsiyasini ishlab chiqish va tasdiqlash. Bunda ichki ishlar organlari faoliyatini raqamlashtirish soha va yoʻnalishlarini, shuningdek axborot texnologiyalarni toʻlish joriy etish bosqichlarini belgilash.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 1-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Turaxodjayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Pekos)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">19.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Mahkumlarni “elektron nazorati”ni taʼminlovchi axborot texnologiyalarini joriy etgan holda, jazoni ijro etish muassasalari faoliyatini bosqichma-bosqich raqamlashtirish. Xususan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">xodimlarning personal videoregistrator (bodikamera) bilan xizmatni oʻtash tartibini tatbiq etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">mahkumlarning jazoni oʻtash tartibini buzish holatlarini aniqlash maqsadida kuzatish va mustaqil nazorat qilish imkoniyatiga ega intellektual kameralar (“Smart”) tizimini muassasalarga oʻrnatish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">taqiqlangan buyumlarni olib kirish holatlarini aniqlash va oldini olish maqsadida muassasalarning nazorat oʻtish joylarida bodiskanerlarni oʻrnatish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">jazoni oʻtash jarayonida mahkumning xulq-atvori va shaxsi haqidagi “axborot portreti”ni tuzish va ozodlikka chiqishidan 2 oy oldin yashash joyi boʻyicha hududiy ichki ishlar organlariga xabar berish imkoniyatini beruvchi yagona elektron tizimni yaratish. </span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021 — 2023 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 10-may</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Turaxodjayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">20.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Lokal tarmoqlar va yagona himoyalangan korporativ tarmoqni rivojlantirish orqali ichki ishlar organlarini raqamlashtirish jarayonlarini tezlashtirish uchun telekommunikatsiya infratuzilmasini modernizatsiya qilish. Bunda:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">ichki ishlar organlarida elektron hujjat almashinuvi va himoyalangan elektron pochta yagona tizimini tatbiq etish, dasturiy taʼminot yaratish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">maʼlumotlarni qayta ishlash yagona markazini yaratish va unga idoraviy maʼlumotlarni qayta ishlash markazlarini integratsiya qilish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">idoraviy raqamli infratuzilmaning axborot xavfsizligini taʼminlash, shuningdek, elektron hujjatlar va maʼlumotlarni himoya qilish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021 — 2023 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjet va budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 10-avgust</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Turaxodjayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Moliya vazirligi (Ishmetov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">21.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Zamonaviy axborot texnologiyalarini joriy etish hamda ashyoviy dalillar boʻyicha avtomatlashtirilgan kriminalistik axborot-qidiruv tizimini yaratish orqali ekspert-kriminalistik faoliyatni bosqichma-bosqich raqamlashtirish, shuningdek kriminalistik identifikatsiya tizimi faoliyatini muvofiqlashtirish. Xususan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Genom boʻyicha yagona avtomatlashtirilgan davlat roʻyxatiga olish tizimini zaruriy vositalar bilan jihozlash;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">fuqaroviy va xizmat oʻqotar qurollarining izlari boʻyicha Davlat oʻq-gilzotekasi tizimini modernizatsiya qilish orqali uning faoliyatini avtomatlashtirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“Kriminalist” kriminalistik faoliyatni hisobga olishning axborot-maʼlumot tizimini modernizatsiya qilish hamda uni “102” tizimi doirasida Ichki ishlar vazirligi jinoyatlarni hisobga olish yagona tizimiga integratsiya qilish; </span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ekspert-kriminalistik bosh markazining biometrik identifikatsiya qilish maʼlumotlar bazalariga hududiy ekspert-kriminalistik boʻlinmalarning ulanishini taʼminlash.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021 — 2023 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjet va budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ishlab chiqilgan texnik topshiriqlar asosida xarid qilish</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 30-sentabr</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Turaxodjayev), Moliya vazirligi (Ishmetov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">22.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Probatsiya nazoratidagi shaxslarni masofadan turib nazorat qilishni taʼminlovchi zamonaviy axborot va kommunikatsiya texnologiyalarini tatbiq etgan holda Probatsiya xizmati faoliyatini raqamlashtirish. Xususan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">probatsiya nazoratidagi shaxslarning xulq-atvorini real vaqt rejimida kuzatish uchun elektron brasletdan foydalanish amaliyotini joriy etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">elektron brasletlarni hamda maʼlumotlarni saqlash va qayta ishlash uchun server va ushbu tizimga aloqador qurilmalarni xarid qilish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">monitoring qilishning zamonaviy mobil texnologiyalarini tatbiq etish, maxsus dasturiy taʼminotni ishlab chiqish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">probatsiya nazoratidagi shaxslarni umumiy nazorat qilish uchun Ichki ishlar vazirligi probatsiya xizmatida yagona elektron monitoringni (monitoring markazini) tashkil etish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021-2022 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjetdan tashqari mablagʻlari va qonunchilikda taqiqlanmagan boshqa manbalar)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ishlab chiqilgan texnik topshiriqlar asosida xarid qilish</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-2022 yy.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Turaxodjayev, Ikramov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bandlik va mehnat munosabatlari vazirligi (Xusanov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">23.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalarini tatbiq etish orqali Davlat yoʻl harakati xavfsizligi xizmati tomonidan davlat xizmatlarini taqdim etishning yangi tartibini joriy etish. Xususan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">davlat xizmatlarini taqdim etishni maqbullashtirish va yengillashtirish boʻyicha yangi mexanizmlarni ishlab chiqish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">amaldagi axborot tizimlarini yagona platformaga oʻzaro integratsiya qilish orqali Davlat yoʻl harakati xavfsizligi xizmatining yagona avtomatlashtirilgan axborot-tahlil tizimini joriy etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">saqlash funksiyasiga ega boʻlgan maʼlumotlarni qayta ishlash yagona markazini yaratish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021 — 2023 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjetdan tashqari mablagʻlari va qonunchilikda taqiqlanmagan boshqa manbalar)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 10-iyun</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Turaxodjayev, Ikramov), </span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Adliya vazirligi (Davletov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">24.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot tizimlarini modernizatsiya qilish, arxiv faoliyatini raqamlashtirish va axborot texnologiyalarini tatbiq etgan holda Ichki ishlar vazirligi Huquqiy statistika va tezkor-hisob maʼlumotlar markazi faoliyatini bosqichma-bosqich raqamlashtirish. Xususan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">shaxsiy tarkib boʻyicha buyruqlar, pul taʼminotining shaxsiy kartochkalari va boshqa maʼlumotlardan iborat elektron arxivni shakllantirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">davlat xizmatlarini taqdim etishni rivojlantirish maqsadida Markazni Oʻzbekiston Respublikasi “Oʻzarxiv” tizimi va Davlat xizmatlari agentligi bilan oʻzaro integratsiya qilish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021 — 2024 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjet va budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Texnik topshiriqlarni ishlab chiqish</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil avgust</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Turaxodjayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Adliya vazirligi (Davletov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzarxiv (Yusupov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">25.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Zamon talablaridan kelib chiqib, </span></span><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Ichki ishlar vazirligi Huquqiy statistika va tezkor-hisob maʼlumotlar markazining amaldagi axborot tizimlarini modernizatsiya qilish, maʼlumotlar bazalari boʻyicha qidirish kompleksini (rubrikator) yaratish va tegishli davlat organlari bilan integratsiya qilish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021-2022 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Texnik topshiriqni ishlab chiqish</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil avgust</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov, Turaxodjayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">26.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Huquqbuzarliklar profilaktikasi boʻlinmalari faoliyatiga uning samaradorligini oshirish va ortiqcha xizmat yuklamasini qisqartirishga yoʻnaltirilgan zamonaviy axborot texnologiyalarini tatbiq etish. Xususan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“E-inspektor” elektron kompleks tizimini tatbiq etish orqali huquqbuzarliklar profilaktikasi boʻlinmalarida ish yurituvni maqbullashtirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">profilaktik hisobdagi shaxslar bilan ishlash boʻyicha elektron axborot tizimini ishlab chiqish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">maʼmuriy huquqbuzarliklar toʻgʻrisidagi ishlarni koʻrib chiqish boʻyicha “E-maʼmuriy ish” yagona elektron hujjat almashinuvi tizimini yaratish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">mahallalarda jinoyatlarni muhokama qilish jarayonlarini masofadan turib nazorat qilish boʻyicha elektron modulni tatbiq etish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">“E-hisobot” axborot tizimini yaratish orqali profilaktika xizmatida hisobotlarni unifikatsiya qilish va uni boshqa tashkilotlarning hisobot yuritish hamda idoraviy axborot tizimlari bilan oʻzaro integratsiya qilish.</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(Chora-tadbirlarni amalga oshirishning dastlabki muddati 2021-2022 yy. Moliyalashtirish manbai — Ichki ishlar vazirligining budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Tashkiliy-texnik tadbirlar kompleksi</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-2022 yy.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oliy sud (Kamilov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Sogʻliqni saqlash vazirligi (Xodjibayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bosh prokuratura (Yuldashev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">DSQ (Kudbiyev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Mahalla va oilani qoʻllab-quvvatlash vazirligi (Mamatov)</span></span></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">27.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalarini joriy etish orqali ichki ishlar organlarining kuch va vositalarini boshqarishning sifat jihatdan yangicha amaliyotini (situatsion boshqaruv tizimi) bosqichma-bosqich tatbiq etish. Jumladan:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">kuzatib boriladigan obyektlar, hodisalar va jarayonlarni kompleks monitoring qilish asosida boshqaruv qarorlarini oʻz vaqtida qabul qilish imkonini beruvchi vazirlikning Situatsion markazining markazlashgan boshqaruvini amalga oshirishda yagona axborot makonida ishlaydigan ichki ishlar organlari situatsion markazlarining toʻlaqonli taqsimlangan tizimini;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">jamoat xavfsizligini taʼminlash sohasidagi umumiy manfaatlarni inobatga olgan holda huquq-tartibot organlari oʻrtasidagi uygʻunlashgan axborot hamkorligini taʼminlash imkonini beruvchi yagona maxsus axborotlar kichik tizimini tashkil etish. </span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><em><span style="font-family: times new roman,serif"><span style="font-size: 12pt">(chora-tadbirlarni amalga oshirishning dastlabki muddati: 2021 — 2024 yy., moliyalashtirish manbai: IIVning budjetdan tashqari mablagʻlari)</span></span></em></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarori loyihasi </span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 10-iyul</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Axborot texnologiyalari va kommunikatsiyalarini rivojlantirish vazirligi (Sadikov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">boshqa huquq-tartibot idoralari</span></span></p>			</td>		</tr>		<tr>			<td colspan="5" style="border-top: medium none;border-right: windowtext 1pt solid;width: 100%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><strong><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IV. Ichki ishlar organlari xodimlari va oila aʼzolarining ijtimoiy-huquqiy himoyasini hamda uy-joy va maishiy sharoitlarini yanada yaxshilash</span></span></strong></p>			</td>		</tr>		<tr>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 2.16%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: windowtext 1pt solid;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">28.</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 59.76%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Quyidagi yoʻnalishlar boʻyicha huquq-tartibot organlari xodimlarining huquqiy himoyasini kuchaytirishga doir takliflarni kiritish:</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">xizmat vazifasini bajarayotgan huquq-tartibot organlari xodimlarining shaʼni va qadr-qimmatini kamsitish, sogʻligʻiga shikast yetkazish, shuningdek, qonuniy talablariga boʻysunmaslik va faol qarshilik koʻrsatganlik uchun maʼmuriy va jinoiy javobgarlik choralarini kuchaytirish;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">huquq-tartibot organlari xodimlari va oila aʼzolarining shaxsiy hayoti toʻgʻrisidagi maʼlumotlarni tarqatganlik uchun javobgarlik belgilash;</span></span></p>			<p style="margin-bottom: 0pt;text-align: justify;line-height: normal;text-indent: 8.8pt"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">ichki ishlar organlari xodimlari va ularning oila aʼzolarini davlat tomonidan ijtimoiy-huquqiy himoya qilishning yagona huquqiy asosini, ushbu yoʻnalishdagi kafolatlar va aniq mexanizmlarni nazarda tutgan holda yaratish. </span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 14.14%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Qonunchilik hujjatlari loyihalari</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 8.82%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">2021-yil 20-iyun</span></span></p>			</td>			<td style="border-top: medium none;border-right: windowtext 1pt solid;width: 15.12%;vertical-align: top;border-bottom: windowtext 1pt solid;padding-bottom: 0cm;padding-top: 0cm;padding-left: 2.85pt;border-left: medium none;padding-right: 2.85pt">			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Bosh prokuratura (Yuldashev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Adliya vazirligi (Davletov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Oliy sud (Kamilov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">IIV (Bobojonov), </span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Milliy gvardiya (Joʻrayev),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">DXX (Azizov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">Mudofaa vazirligi (Kurbanov),</span></span></p>			<p align="center" style="margin-bottom: 0pt;text-align: center;line-height: normal"><span style="font-family: times new roman,serif"><span style="font-size: 12pt">DBQ (Azimov)</span></span></p>			</td>		</tr>	</tbody></table></div></div><div class="FOOTNOTE"><div name="-5344988" id="-5344988"><strong>Izoh</strong>:</div></div><div class="FOOTNOTE"><div name="-5344990" id="-5344990">1. Normativ-huquqiy va idoraviy hujjatlar huquqiy munosabatlarni tartibga solish predmeti va sohasiga qarab qayta koʻrib chiqilishi yoki yagona hujjatga birlashtirilishi mumkin.</div></div><div class="FOOTNOTE"><div name="-5344992" id="-5344992">2. Ikki va undan ortiq bandlar birlashtirilganda ularni ijro etish uchun belgilangan eng kech muddat ijro muddati etib belgilanadi.</div></div><div class="BY_DEFAULT"><div name="-5344926" id="-5344926"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5344927" id="-5344927">Oʻzbekiston Respublikasi Prezidentining 2021-yil 26-martdagi PF-6196-son <a href="https://lex.uz/uz/docs/-5344118">Farmoniga</a><br />2-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-5344928" id="-5344928"><strong>Oʻzbekiston Respublikasi Prezidentining ayrim farmonlariga kiritilayotgan oʻzgartirishlar</strong></div></div><div class="ACT_FORM"><div name="-5344934" id="-5344934"></div></div><div class="BY_DEFAULT"><div name="-5344935" id="-5344935"></div></div><div class="ACT_TEXT"><div name="-5344936" id="-5344936">1. Oʻzbekiston Respublikasi Prezidentining 2017-yil 10-apreldagi “Ichki ishlar organlarining faoliyati samaradorligini tubdan oshirish, jamoat tartibini, fuqarolar huquqlari, erkinliklari va qonuniy manfaatlarini ishonchli himoya qilishni taʼminlashda ularning masʼuliyatini kuchaytirish chora-tadbirlari toʻgʻrisida”gi PF-5005-son Farmonining <a href="https://lex.uz/uz/docs/-3159827?ONDATE=10.04.2017 00#-3159953">3 — 5-bandlari</a> oʻz kuchini yoʻqotgan deb hisoblansin.</div></div><div class="ACT_TEXT"><div name="-5344937" id="-5344937">2. Oʻzbekiston Respublikasi Prezidentining 2018-yil 31-oktabrdagi “Jinoiy-huquqiy statistika tizimini tubdan takomillashtirish va jinoyatlarni tizimli tahlil qilish samaradorligini oshirish chora-tadbirlari toʻgʻrisida”gi PF-5566-son <a href="https://lex.uz/uz/docs/-4034449">Farmonida</a>:</div></div><div class="ACT_TEXT"><div name="-5344938" id="-5344938"><a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036953">1-band</a>, 7-bandning <a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036976">“a” kichik bandi</a>, <a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036986">9</a> va <a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036987">10-bandlar</a> oʻz kuchini yoʻqotgan deb hisoblansin;</div></div><div class="ACT_TEXT"><div name="-5344939" id="-5344939">6-bandning <a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036974">uchinchi xatboshisida</a> “Bosh prokuratura” soʻzlari “Ichki ishlar vazirligi” soʻzlari bilan almashtirilsin;</div></div><div class="ACT_TEXT"><div name="-5344940" id="-5344940">11-bandning <a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036994">ikkinchi xatboshisidan</a> “Boshqarma bilan birgalikda” soʻzlari chiqarib tashlansin;</div></div><div class="ACT_TEXT"><div name="-5344941" id="-5344941">12-bandning <a href="https://lex.uz/uz/docs/-4034449?ONDATE=02.11.2018 00#-4036999">uchinchi xatboshisidagi</a> “Tezkor-maʼlumotlar boshqarmasi” soʻzlari “Ichki ishlar vazirligining Huquqiy statistika va tezkor-hisob maʼlumotlar markazi” soʻzlari bilan almashtirilsin.</div></div><div class="ACT_TEXT"><div name="-5344944" id="-5344944">3. Oʻzbekiston Respublikasi Prezidentining 2017-yil 18-apreldagi “Ijtimoiy-iqtisodiy islohotlarni amalga oshirish, mamlakatni modernizatsiya qilish, inson huquq va erkinliklarining ishonchli himoyasini taʼminlashda prokuratura organlarining rolini kuchaytirish toʻgʻrisida”gi PF-5019-son Farmoni 4-bandining <a href="https://lex.uz/uz/docs/-3177796?ONDATE=16.03.2019 00#-4251348">beshinchi xatboshisidagi</a> “4 165 va “1 071” raqamlari tegishincha “4 195” va “1 031” raqamlari bilan almashtirilsin.</div></div></div>
</div></body></html>