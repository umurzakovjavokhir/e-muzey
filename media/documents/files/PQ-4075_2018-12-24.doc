<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-4125429" id="-4125429">Oʻzbekiston Respublikasi Prezidentining</div></div><div class="ACT_FORM"><div name="-4125430" id="-4125430">Qarori</div></div><div class="ACT_TITLE"><div name="-4125433" id="-4125433">Jamoat xavfsizligini taʼminlash samaradorligini oshirish boʻyicha qoʻshimcha chora-tadbirlar toʻgʻrisida</div></div><div class="EXTRACT"><div name="-4125777" id="-4125777">[Koʻchirma]</div></div><div class="BY_DEFAULT"><div name="-4125437" id="-4125437"></div></div><div class="ACT_TEXT"><div name="-4125443" id="-4125443">Oʻtgan davr mobaynida mamlakatda tinchlik va osoyishtalikni taʼminlash, jamoat tartibini saqlashning mutlaqo yangi mexanizmlarini joriy etish hamda aholida shaxsiy xavfsizlik hissini shakllantirish borasida tizimli va samarali chora-tadbirlar amalga oshirildi, shuningdek, mazkur faoliyatni tartibga soluvchi normativ-huquqiy baza “Xalq manfaatlariga xizmat qilish” oliyjanob gʻoyasi asosida tubdan qayta koʻrib chiqildi.</div></div><div class="ACT_TEXT"><div name="-4125444" id="-4125444">Shu bilan birga, jamoat xavfsizligini taʼminlash tizimida huquq-tartibotni taʼminlash va ushbu yoʻnalishda oʻzaro maqsadli hamkorlikni tashkil etishda joylardagi davlat hokimiyati va boshqaruvi organlari hamda jamoatchilik tuzilmalari ishtirokining samarasi pastligida, huquqbuzarliklarning, birinchi navbatda, ijtimoiy-maishiy tusdagi jinoyatlarning oldini olish, ularga chek qoʻyish, sodir etilganlarini fosh etishda fuqarolik pozitsiyasining sustligida namoyon boʻlayotgan qator kamchiliklar mavjud.</div></div><div class="ACT_TEXT"><div name="-4125447" id="-4125447">Mamlakatda jamoat xavfsizligini taʼminlash borasida oʻrnatilgan mexanizmlarning samarali amalga oshirilishini taʼminlashda joylardagi davlat hokimiyati va boshqaruvi organlari hamda jamoatchilik tuzilmalarining kuch va vositalarini muvofiqlashtirgan holda safarbar qilish, shuningdek huquqbuzarliklar profilaktikasi va jinoyatchilikka qarshi kurash sohasida ularning masʼuliyatini oshirish maqsadida:</div></div><div class="ACT_TEXT"><div name="-4125448" id="-4125448">1. Shunday tartib oʻrnatilsinki, unga koʻra:</div></div><div class="ACT_TEXT"><div name="-4125451" id="-4125451">a) Qoraqalpogʻiston Respublikasi Vazirlar Kengashi raisi, viloyatlar va Toshkent shahar, tumanlar (shaharlar) hokimlari har kuni: </div></div><div class="ACT_TEXT"><div name="-4125452" id="-4125452">tegishli hududning sutka davomidagi kriminogen vaziyati bilan shaxsan tanishadi va bunda ijtimoiy-maishiy tusdagi jinoyatlarga alohida eʼtibor qaratadi;</div></div><div class="ACT_TEXT"><div name="-4125453" id="-4125453">tegishli hududda sodir etilgan, birinchi navbatda ijtimoiy-maishiy tusdagi jinoyatlarning sabablari va sharoitlarini oʻrganib, huquqqa xilof harakatlarni keltirib chiqargan omillarni aniqlashtiradi hamda masʼul tashkilotlar va ularning mansabdor shaxslarning harakatsizligiga nisbatan choralar koʻradi;</div></div><div class="ACT_TEXT"><div name="-4125454" id="-4125454">huquqqa xilof holatlar boʻyicha oʻz vaqtida taʼsir choralarini koʻrish va ularning salbiy oqibatlariga barham berish maqsadida huquqbuzarliklar profilaktikasida bevosita ishtirok etuvchi organlar va muassasalarni jalb qilish hamda ularning hamkorligini tashkil etish borasida taʼsirchan chora-tadbirlarni koʻrib, mazkur yoʻnalishda shaxsiy nazorat oʻrnatadi; </div></div><div class="BY_DEFAULT"><div name="-4125455" id="-4125455"></div></div><div class="BY_DEFAULT"><div name="-7219046" id="-7219046"></div></div><div class="ACT_TEXT"><div name="-7219049" id="-7219049">b) har chorakda xalq deputatlari tuman (shahar) Kengashlarining majlislarida hisobot davri yakuniga koʻra, jamoat xavfsizligini taʼminlash natijalarining tahlili asosida quyidagilar tanqidiy muhokama qilinadi:</div></div><div class="ACT_TEXT"><div name="-4125456" id="-4125456">tegishli hududda sodir etilgan ogʻir va oʻta ogʻir turdagi jinoiy holatlar;</div></div><div class="ACT_TEXT"><div name="-4125458" id="-4125458">jamoat xavfsizligini taʼminlash samaradorligini oshirish boʻyicha manzilli takliflarni ishlab chiqish hamda ularni hududlarda jinoyatchilikning barvaqt oldini olish va huquqbuzarlikka qarshi kurashish Respublika komissiyasiga kiritishni belgilangan holda huquqbuzarliklar profilaktikasida bevosita ishtirok etuvchi organlar va muassasalar tomonidan koʻrilayotgan chora-tadbirlarning ahvoli.</div></div><div class="ACT_TEXT"><div name="-4125460" id="-4125460">2. Oʻzbekiston Respublikasi Moliya vazirligi, Bosh prokuraturasi, Ichki ishlar vazirligi va Fuqarolarning oʻzini oʻzi boshqarish organlari faoliyatini muvofiqlashtirish boʻyicha respublika kengashining quyidagi takliflari maʼqullansin: </div></div><div class="BY_DEFAULT"><div name="-7339717" id="-7339717"></div></div><div class="ACT_TEXT"><div name="-7339721" id="-7339721">biriktirilgan hududda jinoyatlar darajasi pasaygan, ularni oldini olish va bartaraf etish chora-tadbirlari oʻz vaqtida koʻrilgan hollarda bir vaqtning oʻzida fuqarolar yigʻinlari raislari va faollari, profilaktika (katta) inspektorlariga mehnatga haq toʻlash fondining (pul taʼminotining) 100 foizigacha boʻlgan miqdorda (oʻrnatilgan va toʻlanayotgan qoʻshimcha haq va ustamalardan qatʼi nazar) va boshqa pul mukofotlari bilan taqdirlash tartibini joriy etish.</div></div><div class="ACT_TEXT"><div name="-4125474" id="-4125474">4. Har bir mahallada “Fidokor yoshlar” jamoatchilik patrul guruhlarini shakllantirish va ularning faoliyatini tashkil etish sohasidagi Toshkent shahrining ijobiy tajribasi respublikaning barcha hududlariga tatbiq etilsin.</div></div><div class="BY_DEFAULT"><div name="-5349638" id="-5349638"></div></div><div class="ACT_TEXT"><div name="-5349639" id="-5349639">5. Profilaktika (katta) inspektorlariga “Fidokor yoshlar” jamoatchilik patrul guruhlari faoliyatini kunlik nazorat qilish va muvofiqlashtirish vazifasi yuklatilsin.</div></div><div class="BY_DEFAULT"><div name="-5761150" id="-5761150"></div></div><div class="ACT_TEXT"><div name="-5761151" id="-5761151">6. Oʻzbekiston Respublikasi Ichki ishlar vazirligi Jamoat xavfsizligi departamenti, Transport va turizm obyektlarida xavfsizlikni taʼminlash departamenti, Qoraqalpogʻiston Respublikasi Ichki ishlar vazirligi, Toshkent shahar va Toshkent viloyati ichki ishlar bosh boshqarmalari va viloyatlar ichki ishlar boshqarmalarida yuridik shaxs tashkil etmagan holda tegishlicha huquqbuzarliklar profilaktikasi tizimini rivojlantirish jamgʻarmalari (bundan buyon — jamgʻarmalar) tashkil etilsin.</div></div><div class="ACT_TEXT"><div name="-5761152" id="-5761152">Belgilansinki:</div></div><div class="ACT_TEXT"><div name="-5761153" id="-5761153">a) jamgʻarmalarni shakllantirish manbalari quyidagilar hisoblanadi:</div></div><div class="ACT_TEXT"><div name="-5761154" id="-5761154">ichki ishlar organlarining huquqbuzarliklar profilaktikasi boʻlinmalari tomonidan tegishliligiga koʻra ularga taalluqli maʼmuriy huquqbuzarliklarga doir ishlar boʻyicha undirilgan (qaysi organ tomonidan undirilishidan qatʼi nazar) maʼmuriy jarimalar mablagʻlari;</div></div><div class="BY_DEFAULT"><div name="-7024105" id="-7024105"></div></div><div class="ACT_TEXT"><div name="-7024107" id="-7024107">ichki ishlar organlari profilaktika inspektorlari tomonidan ekologiya va atrof-muhitni muhofaza qilish sohasidagi huquqbuzarliklar uchun maʼmuriy javobgarlikka tortish choralari koʻrilishi natijasida jarima sifatida undirilgan mablagʻlarning 10 foizi miqdordagi pul mablagʻlari;</div></div><div class="ACT_TEXT"><div name="-5761155" id="-5761155">jamgʻarmalarning vaqtincha boʻsh turgan mablagʻlarini tijorat banklari depozit hisoblariga joylashtirishdan tushadigan daromadlar;</div></div><div class="ACT_TEXT"><div name="-5761156" id="-5761156">xalqaro moliya institutlari va boshqa xorijiy donorlarning grantlari hamda qonunchilik bilan taqiqlanmagan boshqa manbalar;</div></div><div class="ACT_TEXT"><div name="-5761157" id="-5761157">b) Oʻzbekiston Respublikasi Ichki ishlar vazirligi Jamoat xavfsizligi departamentining huquqbuzarliklar profilaktikasi tizimini rivojlantirish jamgʻarmasi hududiy ichki ishlar organlari jamgʻarmalariga tushadigan maʼmuriy jarimalar mablagʻlarining 10 foizi hisobidan shakllantiriladi;</div></div><div class="ACT_TEXT"><div name="-5761158" id="-5761158">v) jamgʻarmalarning mablagʻlari Oʻzbekiston Respublikasi Ichki ishlar vazirligi Jamoat xavfsizligi departamenti, Transport va turizm obyektlarida xavfsizlikni taʼminlash departamenti boshliqlari, Qoraqalpogʻiston Respublikasi ichki ishlar vaziri, Toshkent shahar va Toshkent viloyati ichki ishlar bosh boshqarmalari va viloyatlar ichki ishlar boshqarmalari boshliqlari tomonidan tegishlicha ularning oʻrinbosarlari — jamoat xavfsizligi xizmati (huquqbuzarliklar profilaktikasi xizmati, boshqarmasi) boshliqlari takliflari asosida qabul qilinadigan qarorlariga muvofiq faqat quyidagilar uchun sarflanadi:</div></div><div class="BY_DEFAULT"><div name="-7339733" id="-7339733"></div></div><div class="ACT_TEXT"><div name="-7339734" id="-7339734">ichki ishlar organlari huquqbuzarliklar profilaktikasi boʻlinmalari xodimlarini ragʻbatlantirish va ijtimoiy himoya qilish, ularga belgilangan tartibda ustamalarni belgilash, shuningdek, qoʻshimcha shtat birliklarini kiritish va moliyalashtirish, shartnoma asosida kadrlarni jalb etish;</div></div><div class="ACT_TEXT"><div name="-5761160" id="-5761160">jamoat tartibini saqlash, huquqbuzarliklar profilaktikasi va jinoyatchilikka qarshi kurashda amaliy yordam koʻrsatgan fuqarolarni bir martalik pul mukofoti bilan taqdirlash yoki qimmatbaho sovgʻalar bilan mukofotlash;</div></div><div class="BY_DEFAULT"><div name="-7024112" id="-7024112"></div></div><div class="ACT_TEXT"><div name="-7024114" id="-7024114">ekologiya va atrof-muhitni muhofaza qilish sohasidagi huquqbuzarliklar uchun maʼmuriy javobgarlikka tortish choralarini koʻrgan ichki ishlar organlari profilaktika inspektorlarini jarima sifatida undirilgan mablagʻlarning 10 foizi miqdordagi pul mukofoti bilan ragʻbatlantirish;</div></div><div class="ACT_TEXT"><div name="-5761161" id="-5761161">huquqbuzarliklar profilaktikasi boʻlinmalarining moddiy-texnika bazasini mustahkamlash;</div></div><div class="BY_DEFAULT"><div name="-7890843" id="-7890843"></div></div><div class="ACT_TEXT"><div name="-7890844" id="-7890844">profilaktika inspektorlariga ajratilgan xizmat uy-joylarini kapital taʼmirlash.</div></div><div class="ACT_TEXT"><div name="-4125491" id="-4125491">7. Shunday tartib oʻrnatilsinki, unga muvofiq:</div></div><div class="BY_DEFAULT"><div name="-8476879" id="-8476879"></div></div><div class="ACT_TEXT"><div name="-8476880" id="-8476880">tuman va shahar ichki ishlar organi boshligʻini hamda undan yuqori darajadagi rahbar xodimlarni qayta tayyorlash va malakasini oshirish Oʻzbekiston Respublikasi Ichki ishlar vazirligi Akademiyasida, boshqa rahbar xodimlarni hamda profilaktika (kichik, katta, bosh) inspektorlarini qayta tayyorlash va ularning malakasini oshirish Ichki ishlar vazirligining Malaka oshirish instituti va uning filiallarida uzluksiz asosda amalga oshiriladi;</div></div><div class="BY_DEFAULT"><div name="-4365180" id="-4365180"></div></div><div class="ACT_TEXT"><div name="-4365181" id="-4365181">Oʻzbekiston Respublikasi Ichki ishlar vazirligining akademik litseylari (bundan buyon — idoraviy akademik litseylar) direktorlariga tegishliligicha Qoraqalpogʻiston Respublikasi ichki ishlar vazirining, Toshkent shahar va Toshkent viloyati ichki ishlar bosh boshqarmalari va viloyatlar ichki ishlar boshqarmalari boshliqlarining oʻrinbosarlari vakolatlari beriladi;</div></div><div class="BY_DEFAULT"><div name="-8476884" id="-8476884"></div></div><div class="ACT_TEXT"><div name="-8476885" id="-8476885">Qoraqalpogʻiston Respublikasi ichki ishlar vaziri, Toshkent shahar va Toshkent viloyati ichki ishlar bosh boshqarmalari va viloyatlar ichki ishlar boshqarmalari boshliqlari idoraviy akademik litseylarga rahbarlik qiladilar hamda ularning moddiy-texnik bazasini rivojlantirish, jumladan, zarur oʻquv-laboratoriya jihozlari bilan taʼminlash va moddiy-texnik taʼminoti uchun shaxsan javobgar hisoblanadilar;</div></div><div class="BY_DEFAULT"><div name="-8476887" id="-8476887"></div></div><div class="ACT_TEXT"><div name="-8476888" id="-8476888">profilaktika (kichik, katta, bosh) inspektorlari lavozimlari, qoida tariqasida, yurisprudensiya sohasida bilim va kasbiy malakaga ega shaxslar orasidan jamlanadi;</div></div><div class="BY_DEFAULT"><div name="-8476890" id="-8476890"></div></div><div class="ACT_TEXT"><div name="-8476891" id="-8476891">profilaktika (kichik, katta, bosh) inspektorlari uchun har yili Oʻzbekiston Respublikasi Ichki ishlar vazirligi Akademiyasida masofaviy taʼlim olishga qabul qilinadigan xodimlar (harbiy xizmatchilar) umumiy sonining kamida yigirma besh foizi miqdorida qabul kvotasi ajratiladi.</div></div><div class="ACT_TEXT"><div name="-4125508" id="-4125508">8. 2019-yil 1-yanvardan shunday tartib oʻrnatilsinki, unga koʻra Oʻzbekiston Respublikasi hududlari jamoat xavfsizligini taʼminlash sohasida davlat organlari, tashkilotlar va jamoatchilik tuzilmalarining faoliyati tashkil etilishi va muvofiqlashtirilishini taʼminlash uchun quyidagilarga biriktiriladi:</div></div><div class="ACT_TEXT"><div name="-4125511" id="-4125511">Oʻzbekiston Respublikasi Bosh prokuroriga — Qoraqalpogʻiston Respublikasi, Buxoro, Navoiy va Xorazm viloyatlari, shuningdek, Toshkent shahrining Chilonzor tumani;</div></div><div class="ACT_TEXT"><div name="-4125514" id="-4125514">Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoniga — Andijon, Namangan, Toshkent va Fargʻona viloyatlari, shuningdek, Toshkent shahrining Olmazor tumani;</div></div><div class="ACT_TEXT"><div name="-4125515" id="-4125515">Oʻzbekiston Respublikasi ichki ishlar vaziriga — Jizzax, Samarqand, Sirdaryo, Surxondaryo va Qashqadaryo viloyatlari.</div></div><div class="BY_DEFAULT"><div name="-4125516" id="-4125516"></div></div><div class="BY_DEFAULT"><div name="-5617688" id="-5617688"></div></div><div class="ACT_TEXT"><div name="-5617695" id="-5617695">9. Oʻzbekiston Respublikasi Bosh prokuraturasi va Milliy gvardiyasi 2020-yil 1-yanvarga qadar Bosh prokuraturaning Akademiyasi va Oʻzbekiston Respublikasi Jamoat xavfsizligi universiteti tegishlicha Toshkent shahrining Chilonzor va Olmazor tumanlarida jinoyatlarning sodir etilish sabablarini aniqlash boʻyicha oʻrganishlar oʻtkazish va diagnostika qilishga jalb qilinishini taʼminlasin hamda faoliyatining asosiy yoʻnalishlari etib quyidagilarni belgilasin:</div></div><div class="ACT_TEXT"><div name="-4125517" id="-4125517">jinoyatchilik ahvoli oʻzgarilishini kriminologik prognozlash hamda huquqbuzarliklar profilaktikasiga uslubiy koʻmaklashish;</div></div><div class="ACT_TEXT"><div name="-4125518" id="-4125518">jamoat xavfsizligini taʼminlash samaradorligini oshirish boʻyicha ilmiy asoslantirilgan taklif va tavsiyalar ishlab chiqish.</div></div><div class="ACT_TEXT"><div name="-4125519" id="-4125519">10. Hududlarda jinoyatchilikning barvaqt oldini olish va huquqbuzarlikka qarshi kurashish Respublika komissiyasi zimmasiga respublika hududlariga biriktirilgan davlat organlari rahbarlarining ish natijalarini tizimli monitoring qilish va xolisona baholash hamda ular tomonidan amalga oshirilgan ishlar toʻgʻrisidagi maʼlumotni har chorakda Oʻzbekiston Respublikasi Prezidenti Administratsiyasiga kiritib borish vazifasi yuklatilsin. </div></div><div class="ACT_TEXT"><div name="-4125520" id="-4125520">11. Respublikaning barcha hududlarida quyidagi amaliyot bosqichma-bosqich joriy etilsin:</div></div><div class="ACT_TEXT"><div name="-4125522" id="-4125522">prokuratura organlari tomonidan ichki ishlar organlari bilan birgalikda tegishli hududda jinoyatchilikni oʻrganish, uning sabab va sharoitlarini aniqlash hamda ahvolining oʻzgarishini kriminologik prognozlash maqsadida mahallalar kesimida jinoyatlar aks ettirilgan tuman (shahar)larning elektron geoinformatsion xaritalari tuzilishi va tizimli yuritilishi; </div></div><div class="ACT_TEXT"><div name="-4125524" id="-4125524">har bir davlat organi va tashkiloti faoliyatining oʻziga xos jihatlaridan kelib chiqqan holda, xavflarni hamda jinoyatlarning sodir etish sabablari va sharoitlarini aniqlash va ularning oldini olish boʻyicha oʻz strategiyalarini ishlab chiqishi. </div></div><div class="ACT_TEXT"><div name="-4125525" id="-4125525">12. 2019-yilda Oʻzbekiston Respublikasida jamoat xavfsizligini taʼminlash samaradorligini oshirish boʻyicha “Yoʻl xaritasi” <a href="https://lex.uz/uz/docs/-4124831#-4125548">ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-4125526" id="-4125526">15. Oʻzbekiston Respublikasi Ichki ishlar vazirligi:</div></div><div class="ACT_TEXT"><div name="-4125528" id="-4125528">Oʻzbekiston Respublikasi Bosh prokuraturasi va Davlat xavfsizlik xizmati bilan birgalikda oʻn kun muddatda nodavlat tashkilotlarga jismoniy va yuridik shaxslarga tegishli obyektlarda xavfsizlikni taʼminlash boʻyicha xizmatlar koʻrsatish va qoʻriqlash faoliyati bilan shugʻullanishga ruxsat berish toʻgʻrisida takliflar kiritsin;</div></div><div class="ACT_TEXT"><div name="-4125530" id="-4125530">Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari bilan birgalikda bir oy muddatda tuman (shahar) hokimlariga ommaviy tadbirlar davomida va jamoat joylarida jamoat xavfsizligini taʼminlash uchun ichki ishlar organlari xodimlarini mahalliy budjet mablagʻlari hisobidan jalb qilish toʻgʻrisida shartnomalar tuzish vakolatini berish yuzasidan Oʻzbekiston Respublikasi Vazirlar Mahkamasiga asoslantirilgan takliflar kiritsin; </div></div><div class="ACT_TEXT"><div name="-4125533" id="-4125533">Moliya vazirligi, Bosh prokuratura va Fuqarolarning oʻzini oʻzi boshqarish organlari faoliyatini muvofiqlashtirish boʻyicha Respublika kengashi bilan birgalikda bir oy muddatda qoʻshma qaror bilan fuqarolar yigʻinlari raislari va faollari, profilaktika (katta) inspektorlari va ularning yordamchilari hamda “Mahalla posboni” jamoatchilik tuzilmasining alohida namuna koʻrsatgan aʼzolarini moddiy ragʻbatlantirish mezonlari va tartibini mazkur qaror talablariga muvofiq belgilasin;</div></div><div class="ACT_TEXT"><div name="-4125535" id="-4125535">Mudofaa vazirligi, Oʻzbekiston yoshlar ittifoqi va Fuqarolarning oʻzini oʻzi boshqarish organlari faoliyatini muvofiqlashtirish boʻyicha Respublika kengashi bilan birgalikda bir oy muddatda respublikaning har bir hududida Toshkent shahri tajribasi asosida “Fidokor yoshlar” jamoatchilik patrul guruhlarini shakllantirish va ularning faoliyatini yoʻlga qoʻyish boʻyicha tashkiliy chora-tadbirlarni amalga oshirsin;</div></div><div class="ACT_TEXT"><div name="-4125536" id="-4125536">Oʻzbekiston Respublikasi Jismoniy tarbiya va sport vazirligi, Moliya vazirligi, Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari bilan birgalikda uch oy muddatda respublikaning har bir hududida, shu jumladan davlat-xususiy sheriklik shartlari asosida shaxsiy tarkibning kundalik kasbiy, jangovar va jismoniy tayyorgarligini samarali tashkil etish imkonini beruvchi ichki ishlar organlarining sport bazalarini shakllantirish boʻyicha takliflar kiritsin; </div></div><div class="ACT_TEXT"><div name="-4125537" id="-4125537">manfaatdor vazirlik va idoralar bilan birgalikda ikki oy muddatda qonun hujjatlariga ushbu qarordan kelib chiqadigan oʻzgartirish va qoʻshimchalar toʻgʻrisidagi takliflarni Oʻzbekiston Respublikasi Vazirlar Mahkamasiga kiritsin. </div></div><div class="ACT_TEXT"><div name="-4125538" id="-4125538">16. Oʻzbekiston Respublikasi Mudofaa sanoati davlat qoʻmitasi 2019-yil 1-aprelga qadar Oʻzbekiston Respublikasi Ichki ishlar vazirligining buyurtma va talablari asosida ichki ishlar organlarining yoʻl-patrul boʻlinmalari xodimlari, keyingi navbatda patrul-post xizmati uchun mobil videokameralar hamda maʼmuriy huquqbuzarliklarga oid ishlarni rasmiylashtirish va koʻrib chiqish elektron tizimi planshetlari xarid qilinishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-4125539" id="-4125539">17. Mazkur qarorning ijrosini nazorat qilish Oʻzbekiston Respublikasining Bosh vaziri A.N. Aripov, Oʻzbekiston Respublikasi Prezidenti Administratsiyasi rahbari Z.Sh. Nizomiddinov, Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibi V.V. Maxmudov va Oʻzbekiston Respublikasi Prezidenti maslahatchisining birinchi oʻrinbosari B.M. Mavlonov zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-4125541" id="-4125541">Oʻzbekiston Respublikasi Prezidenti Sh. MIRZIYOYEV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4125543" id="-4125543">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-4125544" id="-4125544">2018-yil 24-dekabr,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-4125545" id="-4125545">PQ-4075-son</div></div><div class="BY_DEFAULT"><div name="-4125548" id="-4125548"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-4125549" id="-4125549">Oʻzbekiston Respublikasi Prezidentining 2018-yil 24-dekabrdagi PQ-4075-son <a href="https://lex.uz/uz/docs/-4124831">qaroriga </a><br />ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-4125550" id="-4125550">2019-yilda Oʻzbekiston Respublikasida jamoat xavfsizligini taʼminlash samaradorligini oshirish boʻyicha </div></div><div class="ACT_FORM"><div name="-4125552" id="-4125552"><strong>“Yoʻl xaritasi”</strong></div></div><div class="BY_DEFAULT"><div name="-4125564" id="-4125564"></div></div><div class="BY_DEFAULT"><div name="-4127263" id="-4127263"><table style="BORDER-COLLAPSE: collapse" border="0" cellspacing="0" cellpadding="0" width="100%">
<tbody>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="5%">
<p style="MARGIN: 2pt 0cm" align="center"><a name="-4125578"><b>T/r</b></a></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="48%">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>Tadbir nomi</b></span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="16%">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>Amalga oshirish shakli</b></span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="10%">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>Amalga oshirish muddati</b></span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="19%">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>Masʼul ijrochilar</b></span></p></td></tr>
<tr style="HEIGHT: 18.05pt">
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 18.05pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="100%" colspan="5">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>I. Jamoat tartibini saqlash tizimini takomillashtirish</b></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>1.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Quyidagilarni nazarda tutuvchi jamoat xavfsizligini taʼminlash sohasida davlat organlari, tashkilotlar va jamoat tuzilmalari faoliyatini tashkil etish va muvofiqlashtirish tartibini belgilash:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>jamoat xavfsizligini taʼminlashni muvofiqlashtirish uchun respublika hududlariga biriktirilgan rahbarlarning faoliyati natijalarini tizimli monitoring qilish va baholash mexanizmi;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>har oy xalq deputatlari tuman (shahar) Kengashlarining majlislarida tegishli hududda sodir etilgan ogʻir va oʻta ogʻir jinoiy holatlarni tanqidiy muhokama qilish boʻyicha choralar koʻrish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Respublika komissiyasi qarori</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>Respublika komissiyasi <i>(Yoʻldoshev)</i>,</span></p>
<p align="center"><span>Bosh prokuratura <i>(Murodov)</i>,</span></p>
<p align="center"><span>Milliy gvardiya <i>(Tashmatov)</i>,</span></p>
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Bobojonov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>2.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Respublikaning har bir mahallasida “Fidokor yoshlar” jamoatchilik patrul guruhlarini tashkil etish choralarini koʻrish va unda quyidagi tartibni belgilash:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>harbiy xizmatga chaqiriluvchilar, oliy harbiy bilim yurtlari va ichki ishlar organlariga nomzodlar orasidan shakllantirish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>guruhlarga tuman mudofaa ishlari boʻyicha boʻlimlari yoki ichki ishlar organlari tomonidan beriladigan yoʻllanmalar asosida qabul qilish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>guruhlar faoliyatini samarali tashkil etishni tuman ichki ishlar organlari boshliqlarining yoshlar masalalari boʻyicha oʻrinbosarlari va profilaktika inspektorlari zimmasiga yuklash;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>guruh aʼzolarini kechki va tungi vaqtlarda belgilangan patrullik yoʻnalishlariga umumiy hisobda 100 soatdan kam boʻlmagan muddatga jalb qilib, buni xizmatga (oʻqishga) hujjatlarni yakuniy qabul qilishning asosi sifatida belgilash.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>qoʻshma qaror</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p style="MARGIN: 2pt 0cm 0pt" align="center"><span>IIV </span></p>
<p style="MARGIN: 2pt 0cm 0pt" align="center"><span><i>(Xatamov)</i>,</span></p>
<p style="MARGIN: 2pt 0cm 0pt" align="center"><span>Mudofaa vazirligi</span></p>
<p align="center"><span><i>(Ikramov),</i></span></p>
<p style="MARGIN: 2pt 0cm 0pt" align="center"><span>Yoshlar ittifoqi <i>(Kuranbayev),</i></span></p>
<p style="MARGIN: 2pt 0cm 0pt" align="center"><span>“Mahalla” jamgʻarmasi<i> (Javlonov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>3.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Quyidagilarni inobatga olgan holda Oʻzbekiston Respublikasida qoʻriqlash faoliyati bilan shugʻullanishni yanada takomillashtirish boʻyicha choralarni koʻrish:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>nodavlat tashkilotlarga jismoniy va yuridik shaxslarga tegishli obyektlarda xavfsizlikni taʼminlash boʻyicha qoʻriqlash faoliyatiga va xizmatlar koʻrsatishga ruxsat berish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>qoʻriqlanadigan obyektlarda jamoat tartibini taʼminlashda huquqni muhofaza qiluvchi organlar bilan yaqindan hamkorlik qilish zaruratini inobatga olgan holda, nodavlat tashkilotlarning qoʻriqlash faoliyati bilan shugʻullanishini litsenziyalash shartlari va talablarini oʻrnatish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>nodavlat tashkilotlarning qoʻriqlash faoliyati bilan shugʻullanish tartibini belgilash;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span><span style="LETTER-SPACING: -0.2pt">nodavlat qoʻriqlash tashkilotlarini xodimlar bilan toʻldirish, ularning kasbiy tayyorgarligi va malakasini oshirish mexanizmlarini ishlab chiqish.</span></span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Oʻzbekiston Respublikasi Prezidenti Farmoni loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV <i>(Nazarmuxamedov),</i></span></p>
<p align="center"><span>Bosh prokuratura</span></p>
<p align="center"><span><i>(Tadjiyev)</i>,</span></p>
<p align="center"><span>DXX,</span></p>
<p align="center"><span>Moliya vazirligi</span></p>
<p align="center"><span><i>(Kuchkarov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>4.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Oʻzbekiston Respublikasi Ichki ishlar vazirligining buyurtma va talablari asosida ichki ishlar organlarining yoʻl-patrul boʻlinmalari xodimlari uchun mobil videokameralar hamda maʼmuriy huquqbuzarliklarga oid ishlarni rasmiylashtirish va koʻrib chiqishning elektron tizimi planshetlarini xarid qilish choralarini koʻrish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>tashkiliy tadbirlar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>yanvar — mart</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>Mudofaa sanoati davlat qoʻmitasi</span></p>
<p align="center"><span><i>(Ibadullayev),</i></span></p>
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Ergashev)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>5.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt"><span>Jamoatchilik faolligini oshirish, fuqarolarni jinoyatlarni fosh etishda hamda uni sodir etgan shaxslarning qidiruvida ichki ishlar organlariga koʻmaklashishga jalb qilish va bunda faol ishtirok etgan fuqarolarni ragʻbatlantirish tartibi va mexanizmlarini tanqidiy jihatdan qayta koʻrib chiqish, shuningdek, takomillashtirish boʻyicha asoslantirilgan takliflarni tayyorlash.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>normativ-huquqiy hujjat loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>fevral</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV <i>(Nazarmuxamedov),</i></span></p>
<p align="center"><span>Bosh prokuratura</span></p>
<p align="center"><span><i>(Tadjiyev)</i>,</span></p>
<p align="center"><span>DXX,</span></p>
<p align="center"><span>DBQ <i>(Aripov),</i></span></p>
<p align="center"><span>Moliya vazirligi</span></p>
<p align="center"><span><i>(Kuchkarov)</i></span></p></td></tr>
<tr style="HEIGHT: 5.65pt">
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 5.65pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>6.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 5.65pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt"><span>Alkogoldan oʻtkir mastlik holatida boʻlib, oʻzining harakatlari bilan huquq-tartibotga xavf tugʻdiruvchi shaxslarni vaqtincha izolyatsiyalash va reabilitatsiya qilish uchun qoʻshimcha sharoitlar yaratib, har bir tuman (shahar) sogʻliqni saqlash muassasalarida alohida xonalar ajratish, ularni zarur anjomlar bilan jihozlash va dori vositalari bilan taʼminlash.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 5.65pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>normativ-huquqiy hujjat loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 5.65pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>may</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 5.65pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>SSV</span></p>
<p align="center"><span><i>(Shadmanov),</i></span></p>
<p align="center"><span>Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari</span></p></td></tr>
<tr style="HEIGHT: 22.7pt">
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 22.7pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="100%" colspan="5">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>II. Huquqbuzarliklarning barvaqt profilaktikasi samaradorligini oshirish</b></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>7.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>Fuqarolar yigʻinlarining raislari va faollarini, profilaktika (katta) inspektorlari va ularning yordamchilarini, shuningdek, “Mahalla posboni” jamoatchilik tuzilmalarining alohida oʻrnak koʻrsatgan aʼzolarini moddiy ragʻbatlantirish tartibini quyidagilarni nazarda tutgan holda:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>biriktirilgan hududda jinoyatlar darajasining pasayishi, ularning oʻz vaqtida oldini olish va chek qoʻyishda ijobiy natijalarga erishganligi uchun har oylik ustama haqi toʻlash mezonlarini;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span><span style="LETTER-SPACING: -0.2pt">Qoraqalpogʻiston Respublikasi IIV, Toshkent shahar IIBB va viloyatlar IIBlarining jamoat xavfsizligini taʼminlashni ragʻbatlantirish fondlari mablagʻlarini shakllantirish va maqsadli foydalanish mexanizmlarini</span> belgilash<span style="LETTER-SPACING: -0.2pt">;</span></span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span><span style="LETTER-SPACING: -0.3pt">biriktirilgan hududda jamoat xavfsizligini taʼminlashda yuqori natijalarga erishgan fuqarolar yigʻinlari faoliyatini muntazam yoritib borish.</span></span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>qoʻshma qaror</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV </span></p>
<p align="center"><span><i>(Ergashev, Ismailov),</i></span></p>
<p align="center"><span>Bosh prokuratura</span></p>
<p align="center"><span><i>(Tadjiyev)</i>, <br />Moliya vazirligi</span></p>
<p align="center"><span><i>(Xaydarov),</i></span></p>
<p align="center"><span>“Mahalla”</span></p>
<p align="center"><span>jamgʻarmasi</span></p>
<p align="center"><span><i>(Javlonov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>8.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="LINE-HEIGHT: 96%;TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>Tuman (shahar) hokimlariga quyidagi vakolatlarni berish boʻyicha choralar koʻrish:</span></p>
<p style="LINE-HEIGHT: 96%;TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>jamoat joylari va ommaviy tadbirlarda jamoat xavfsizligini taʼminlash, shuningdek, qishloq xoʻjaligi ishlarini amalga oshirish davrida ichki ishlar organlari xodimlarini jalb qilish boʻyicha mahalliy budjet hisobidan shartnomalar tuzish;</span></p>
<p style="LINE-HEIGHT: 96%;TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>yirik bozorlar, savdo majmualari va boshqa shu kabi obyektlarning huquqbuzarliklar profilaktikasi va jamoat tartibini saqlash sohasida ichki ishlar organlarining xizmatlaridan shartnoma asosida foydalanish boʻyicha faoliyatini nazorat qilish va tartibga solish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Vazirlar Mahkamasi qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Bobojonov),</i></span></p>
<p align="center"><span>Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari</span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>9.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>“Mahalla posboni” jamoatchilik tuzilmalarini profilaktika inspektorlariga koʻmaklashuvchi professional faoliyat sifatida shakllantirish maqsadida:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>“Mahalla posboni” jamoatchilik tuzilmasi rahbari lavozimini tugatish hisobiga joriy etiladigan profilaktika inspektorlarining jamoat tartibini saqlash boʻyicha yordamchilari faoliyatini tashkil etish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>profilaktika inspektorlarining jamoat tartibini saqlash boʻyicha yordamchilari mehnatiga haq toʻlash mexanizmi hamda ularning vazifa va vakolatlarini belgilash;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>profilaktika inspektorlarining jamoat tartibini saqlash boʻyicha yordamchilarini tayinlash va ichki ishlar organlari xizmatiga hamda oliy oʻquv yurtlariga oʻqishga qabul qilishda belgilanadigan imtiyozlarning mezonlarini tanqidiy jihatdan qayta koʻrib chiqish va belgilash.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Vazirlar Mahkamasi qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>fevral</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV <i>(Xatamov, Ismailov),</i></span></p>
<p align="center"><span>“Mahalla” jamgʻarmasi</span></p>
<p align="center"><span><i>(Javlonov),</i> Boshprokuratura</span></p>
<p align="center"><span><i>(Tadjiyev)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>10.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Tegishli hududda jinoyatchilikni oʻrganish, uning sabab va sharoitlarini aniqlash hamda ahvolining oʻzgarishini kriminologik prognozlash mexanizmlarini quyidagilarni nazarda tutgan holda takomillashtirish:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>prokuratura organlarining ichki ishlar organlari bilan hamkorlikda tuman (shahar)larning mahallalar kesimida jinoyatchilik holati aks ettirilgan elektron geoinformatsion xaritalarini bosqichma-bosqich tuzish va tizimli ravishda yuritish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>har bir davlat organi va tashkiloti tomonidan faoliyatining oʻziga xos jihatlaridan kelib chiqqan holda, xavflarni hamda jinoyatlarni sodir etish sabab va sharoitlarini aniqlash va ularning oldini olish boʻyicha oʻz strategiyasini (komplayens-kontrol) ishlab chiqish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>qoʻshma qaror</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>fevral</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>Bosh prokuratura</span></p>
<p align="center"><span><i>(Tadjiyev, Kolenko),</i></span></p>
<p align="center"><span>IIV <i>(Nazarmuxamedov, Norgitov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>11.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>Oʻzbekiston Respublikasi Ichki ishlar vazirligi Akademiyasi Ilmiy-amaliy tadqiqotlar markazining ish natijalarini tanqidiy jihatdan oʻrganish asosida, hududiy ichki ishlar organlarining huquqbuzarliklar profilaktikasi va jinoyatchilikka qarshi kurashish boʻyicha faoliyatini tashkil etishda Markazning uslubiy rolini inobatga olgan holda:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>respublikadagi har bir tuman (shahar)ning kriminologik prognozini <span style="LETTER-SPACING: -0.2pt">tuzish maqsadida markaz mutaxassislarining joylarga chiqish amaliyotini;</span></span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>Oʻzbekiston Respublikasi Bosh prokuraturasi Akademiyasi hamda Jinoyatlarning sodir etilish sabablarini tizimli tahlil qilish va oʻrganish markazi oʻrtasida hamkorlik mexanizmini oshirish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>2019-yil uchun hamkorlikdagi chora-tadbirlar rejasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Matlyubov),</i></span></p>
<p align="center"><span>Bosh prokuratura <i>(Kolenko)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>12.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Respublikaning barcha oʻquv muassasalarida tushuntirish-profilaktik tadbirlarni oʻtkazish bilan bir qatorda, voyaga yetmaganlar tomonidan jinoyat sodir etishning oqibatlari aks ettirilgan qisqa metrajli hujjatli filmlar va roliklar (shu jumladan tarbiya koloniyalarida olingan lavhalar) tayyorlash hamda namoyish etish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>2019-yil uchun hamkorlikdagi chora-tadbirlar rejasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar </span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Adilov, Ismailov),</i></span></p>
<p align="center"><span>Milliy gvardiya <i>(Shakirov)</i>, </span></p>
<p align="center"><span>XTV <i>(Shermatov),</i></span></p>
<p align="center"><span>OTV <i>(Majidov),</i><br />“Mahalla”</span></p>
<p align="center"><span>jamgʻarmasi <i>(Javlonov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>13.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>Ijtimoiy-maishiy tusdagi jinoyatlar sodir etilishining sabab va sharoitlarini batafsil oʻrganish boʻyicha hamkorlikdagi manzilli choralarni koʻrib:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>aholi barcha qatlamlarining ijtimoiy-maishiy muammolarini barvaqt aniqlash va hal etishni inobatga olgan holda ularning oldini olish boʻyicha asoslantirilgan takliflar va uslubiy tavsiyalarni;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 2pt"><span>shaxslar, birinchi navbatda voyaga yetmaganlar (uyushmagan yoshlar), ishsizlar va ichkilikka ruju qoʻyganlar, shuningdek, notinch oilalar bilan yakka tartibda ishlashning bosqichli rejalarini ishlab chiqish va amalga oshirish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>2019-yil uchun hamkorlikdagi chora-tadbirlar rejasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>fevral</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>Xotin-qizlar qoʻmitasi <i>(Narbayeva),</i></span></p>
<p align="center"><span>Yoshlar ittifoqi</span></p>
<p align="center"><span><i>(Kuranbayev),</i></span></p>
<p align="center"><span>“Mahalla” <i>(Javlonov),</i></span></p>
<p align="center"><span>“Nuroniy” <i>(Jalilov),</i></span></p>
<p align="center"><span>“Oila”</span></p>
<p align="center"><span><i>(Tashmuxamedova) </i>jamgʻarmalari</span></p></td></tr>
<tr style="HEIGHT: 22.7pt">
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 22.7pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="100%" colspan="5">
<p style="MARGIN: 2pt 0cm" align="center"><span><b>III. Ichki ishlar organlarining kadrlar salohiyatini va ijtimoiy-huquqiy taʼminotini oshirish</b></span></p></td></tr>
<tr style="HEIGHT: 36.35pt">
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 36.35pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>14.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 36.35pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Hududiy ichki ishlar organlarining rahbar xodimlari va ularning oʻrinbosarlarining kundalik xizmat faoliyatidan ajralmagan holda malakasini oshirish tizimini nazarda tutgan holda:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>barcha darajadagi hududiy ichki ishlar organlarining barcha toifadagi rahbar xodimlari hamda profilaktika (katta) inspektorlarini qayta tayyorlash va ularning malakasini oshirish faqat Oʻzbekiston Respublikasi Ichki ishlar vazirligining Malaka oshirish instituti filiallarida (auditoriyalarida) uzluksiz asosda boʻlishi tartibini;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Oʻzbekiston Respublikasi Ichki ishlar vazirligining akademik litseylari direktorlariga tegishligicha Qoraqalpogʻiston Respublikasi Ichki ishlar vaziri hamda Toshkent shahar IIBB va viloyatlar IIBlari boshliqlarining oʻrinbosarlari vakolatlarini berishni;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Oʻzbekiston Respublikasi Ichki ishlar vazirligi akademik litseylarining shtat birliklari hisobidan ularda xodimlar malakasini oshirish boʻyicha direktor oʻrinbosari shahodatlangan lavozimlarini joriy etishni;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>joylarda qayta tayyorlash va malaka oshirish kurslarini samarali tashkillashtirishda Qoraqalpogʻiston Respublikasi Ichki ishlar vaziri hamda Toshkent shahar IIBB va viloyatlar IIBlari boshliqlarining masʼuliyatini kuchaytirishni;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Qoraqalpogʻiston Respublikasi, Toshkent shahar va viloyatlar prokurorlarining ichki ishlar organlari xodimlarini tayyorlash, qayta tayyorlash va malakasini oshirishni sifatli tashkil etishda amaliy va uslubiy yordam koʻrsatishdagi rolini oshirishni takomillashtirish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 36.35pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>ichki ishlar vazirining buyrugʻi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 36.35pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;HEIGHT: 36.35pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Xatamov),</i></span></p>
<p align="center"><span>Bosh prokuratura <i>(Tadjiyev)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>15.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Quyidagilarni inobatga olgan holda ichki ishlar organlari xodimlarini ijtimoiy-huquqiy jihatdan qoʻllab-quvvatlash tizimini takomillashtirish:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span><span style="LETTER-SPACING: -0.2pt">terrorizm va jinoyatchilikka qarshi kurashish hamda jamoat xavfsizligini taʼminlash jarayonida halok boʻlgan yoki jarohat olib nogiron boʻlib qolgan xodimlarning farzandlarini respublikadagi oliy oʻquv yurtlariga kirish imtihonlarisiz qabul qilish tartibini joriy etish;</span></span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>respublikadagi oliy oʻquv yurtlariga kirishda huquqbuzarliklar profilaktikasi va jinoyatchilikka qarshi kurashishga munosib hissa qoʻshgan, xizmat yoki ilmiy faoliyatda yuqori natijalarga erishgan xodimlarning farzandlariga imtiyozlar (qabul kvotalari) berish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span><span style="LETTER-SPACING: -0.2pt">ichki ishlar organlarining qonuniy talablarini bajarmaslik yoki xizmat burchini bajarishga toʻsqinlik qilganligi uchun javobgarlikni kuchaytirish.</span></span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Oʻzbekiston Respublikasi Prezidenti qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Xatamov),</i></span></p>
<p align="center"><span>OTV</span></p>
<p align="center"><span><i>(Madjidov)</i>,</span></p>
<p align="center"><span>Moliya vazirligi <i>(Xaydarov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>16.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 1.5pt"><span>Quyidagilarni nazarda tutgan holda ichki ishlar organlari faoliyatini maʼnaviy-psixologik taʼminlashning sifat jihatdan yangi tizimini joriy etish:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 1.5pt"><span>Oʻzbekiston Respublikasi IIV tizimida maʼnaviy-psixologik taʼminot boshqarmasi va uning hududiy boʻlinmalarini tashkil qilish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 1.5pt"><span>ichki ishlar organlari tizimida shartnoma asosida mutaxassis-psixologlarni jalb etish va aholiga pullik xizmat koʻrsatish imkoniyatiga ega boʻlgan psixologik xizmatlar markazlarini tashkil qilish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 1.5pt"><span>xizmatning oʻziga xos xususiyatlarini inobatga olgan holda, ichki ishlar organlari xodimlari orasida suitsidal holatlar va tushkun kayfiyatning oldini olishga qaratilgan yakka tartibdagi maʼnaviy-psixologik tadbirlarning zamonaviy usullarini tatbiq etish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 1.5pt"><span>xodimlarning psixologik portreti hisobini majburiy yuritish tartibini joriy etgan holda, ichki ishlar organlarining qabul va attestatsiya komissiyalari faoliyatida mutaxassis-psixologlarning rolini oshirish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Oʻzbekiston Respublikasi Prezidenti qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil</span></p>
<p align="center"><span>fevral</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Xatamov),</i></span></p>
<p align="center"><span>SSV</span></p>
<p align="center"><span><i>(Shadmanov)</i>,</span></p>
<p align="center"><span>Moliya vazirligi <i>(Xaydarov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>17.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Joylardagi ichki ishlar organlari xodimlarining kunlik kasbiy, jangovar va jismoniy tayyorgarlik tizimini inobatga olgan holda:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>hududiy ichki ishlar organlari xodimlarining kunlik tayyorgarligini tashkillashtirish mexanizmi va tartibini tanqidiy jihatdan qayta koʻrib chiqish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>respublikaning har bir hududida, shu jumladan davlat-xususiy sheriklik shartlari asosida shaxsiy tarkibning kunlik jangovar va jismoniy tayyorgarligini samarali tashkil etish imkonini beruvchi ichki ishlar organlarining sport bazalarini shakllantirishni takomillashtirish choralarini koʻrish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Vazirlar Mahkamasi qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>aprel</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Xatamov, Ergashev),</i></span></p>
<p align="center"><span>Jismoniy tarbiya va sport vazirligi<i> (Nabiyev),</i></span></p>
<p align="center"><span>Moliya vazirligi<br /><i>(Xaydarov),</i></span></p>
<p align="center"><span>Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari</span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>18.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Respublika IIV harbiy qismlari va ichki ishlar organlarining shaxsiy tarkibi hamda oliy taʼlim muassasalarining kursantlarini autsorsing shartlarida ovqatlanishini tashkil etish sohasida davlat-xususiy sheriklik mexanizmlarini joriy etish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Vazirlar Mahkamasi qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>iyun</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Ergashev),</i></span></p>
<p align="center"><span>Moliya vazirligi<br /><i>(Xaydarov),</i></span></p>
<p align="center"><span>Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari</span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>19.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Jamoat xavfsizligini taʼminlash sohasiga jalb qilingan ichki ishlar organlarining erkin yollangan ishchi va xizmatchilarining ish faoliyatini amalga oshirishni nazarda tutgan holda:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Davlat yongʻin xavfsizligi xizmatining kasbiylashtirilgan qismlaridagi alohida lavozimlar uchun umumiy oʻrnatilgan pensiya yoshini qisqartirish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>ish faoliyatida yuqori natijalarga erishgan ichki ishlar organlarining ishchi va xizmatchilarini moddiy ragʻbatlantirish boʻyicha qoʻshimcha choralar koʻrish.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Vazirlar Mahkamasi qarori loyihasi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>sentabr</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Xatamov),</i></span></p>
<p align="center"><span>Moliya vazirligi<br /><i>(Xaydarov)</i></span></p></td></tr>
<tr>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="5%">
<p style="MARGIN: 0cm 0cm 2pt" align="center"><span>20.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="48%">
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>Respublikada jamoat xavfsizligini taʼminlash jarayonini ommaviy axborot vositalarida yoritishga yoʻnaltirilgan quyidagilarni qamrab oluvchi kampaniyalarni uyushtirish:</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>mamlakatda jamoat xavfsizligini taʼminlash jarayonini yorituvchi bosma axborotlar, Internet tarmogʻida maqolalar hamda tele- va radiokoʻrsatuvlar siklini tayyorlash va tashkil etish;</span></p>
<p style="TEXT-INDENT: 8.8pt;MARGIN: 0cm 0cm 3pt"><span>jamoat tartibini taʼminlashda joriy etilgan mexanizmlarni ommalashtirishni taʼminlash.</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="16%">
<p align="center"><span>Chora-tadbirlar dasturi</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="10%">
<p align="center"><span>2019-yil </span></p>
<p align="center"><span>yanvar</span></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #ece9d8;PADDING-BOTTOM: 0cm;PADDING-LEFT: 5.4pt;PADDING-RIGHT: 5.4pt;BORDER-TOP: #ece9d8;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" valign="top" width="19%">
<p align="center"><span>OʻzA </span></p>
<p align="center"><span><i>(Koʻchimov)</i>,</span></p>
<p align="center"><span>MTRK</span></p>
<p align="center"><span><i>(Xadjayev)</i>,</span></p>
<p align="center"><span>IIV</span></p>
<p align="center"><span><i>(Xatamov),</i></span></p>
<p align="center"><span>Milliy gvardiya <i>(Shakirov)</i>, <br />“Mahalla” jamgʻarmasi</span></p>
<p align="center"><span><i>(Javlonov)</i></span></p></td></tr></tbody></table></div></div><div class="FOOTNOTE"><div name="-4125602" id="-4125602">Izoh:</div></div><div class="FOOTNOTE"><div name="-4125604" id="-4125604">1. Huquqiy munosabatlar predmeti va tartibga solish sohasidan kelib chiqqan holda, chora-tadbirlarni amalga oshirish shakli oʻzgarishi, ishlab chiqiladigan normativ-huquqiy va boshqa hujjatlar esa birlashtirilishi mumkin.</div></div><div class="FOOTNOTE"><div name="-4125607" id="-4125607">2. Ikki va undan ortiq bandlar birlashtirilganda, mazkur bandlar ijrosi uchun koʻrsatib oʻtilgan eng oxirgi muddat belgilanadi.</div></div></div>
</div></body></html>