<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-5301530" id="-5301530">Oʻzbekiston Respublikasi Prezidentining</div></div><div class="ACT_FORM"><div name="-5301532" id="-5301532">Qarori</div></div><div class="ACT_TITLE"><div name="-5301537" id="-5301537">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasining faoliyatini sifat jihatidan yangi bosqichga koʻtarish chora-tadbirlari toʻgʻrisida</div></div><div class="EXTRACT"><div name="-5306550" id="-5306550">[Koʻchirma]</div></div><div class="BY_DEFAULT"><div name="-5301539" id="-5301539"></div></div><div class="ACT_TEXT"><div name="-5301579" id="-5301579">Soʻnggi yillarda respublikada davlat obyektlari, oʻta muhim, toifalangan va boshqa obyektlarni samarali qoʻriqlashni tashkil etish, jismoniy va yuridik shaxslarning mol-mulkini ishonchli himoya qilish yuzasidan qator chora-tadbirlar amalga oshirildi.</div></div><div class="ACT_TEXT"><div name="-5301602" id="-5301602">Ilgʻor xorijiy tajriba asosida qoʻriqlash faoliyatiga zamonaviy axborot-kommunikatsiya tizimlari joriy qilinishi natijasida Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻriqlash xizmati tomonidan jismoniy va yuridik shaxslarning qoʻriqlashga olingan obyektlari soni soʻnggi ikki yilda 15 foizga oshdi. </div></div><div class="ACT_TEXT"><div name="-5301614" id="-5301614">Shu bilan birga, qoʻriqlash faoliyatiga zamonaviy qoʻriqlash texnologiyalarini keng joriy etish orqali qoʻriqlash xizmatining qamrovini yanada kengaytirish, xodimlarning kasbiy mahorati, bilim va koʻnikmalarini oshirish, shuningdek, sohada boshqaruv faoliyati samaradorligini taʼminlash bilan bogʻlik tizimli muammolar saqlanib qolmoqda.</div></div><div class="ACT_TEXT"><div name="-5301620" id="-5301620">Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻriqlash boʻlinmalarining yaxlit tizimini shakllantirish, qoʻriqlash xizmatlarini koʻrsatish sohasida samarali boshqaruvni amalga oshirish xamda bu boradagi faoliyatni sifat jihatidan yangi bosqichga koʻtarish maqsadida:</div></div><div class="ACT_TEXT"><div name="-5301629" id="-5301629">1. Oʻzbekiston Respublikasi Milliy gvardiyasining Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻriqlash xizmatini Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasi (keyingi oʻrinlarda — Qoʻriqlash bosh boshqarmasi) etib qayta tashkil etish toʻgʻrisidagi taklifiga rozilik berilsin.</div></div><div class="ACT_TEXT"><div name="-5301636" id="-5301636">2. Quyidagilar Qoʻriqlash bosh boshqarmasining asosiy vazifalari etib belgilansin:</div></div><div class="ACT_TEXT"><div name="-5301641" id="-5301641">shartnoma asosida davlat obyektlari, oʻta muhim, toifalangan va boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini, shuningdek, xorijiy davlatlar va xalqaro tashkilotlarning diplomatik, konsullik va boshqa vakolatxonalarini qoʻriqlash;</div></div><div class="ACT_TEXT"><div name="-5301645" id="-5301645">qoʻriqlanayotgan obyektlarda ichki, ruxsat berish rejimlarini xamda jamoat tartibini taʼminlash, huquqbuzarliklarning oldini olish va bartaraf etish;</div></div><div class="ACT_TEXT"><div name="-5301649" id="-5301649">qoʻriqlash vositalari va tizimlarini koʻllash sohasida yagona texnik siyosatni va ulardan foydalanish ustidan samarali nazoratni taʼminlash, shuningdek, qoʻriqlash faoliyatiga zamonaviy axborot-kommunikatsiya texnologiyalarini keng miqyosda joriy etish;</div></div><div class="BY_DEFAULT"><div name="-6371112" id="-6371112"></div></div><div class="ACT_TEXT"><div name="-6371113" id="-6371113">shartnoma asosida qoʻriqlashning texnik vositalarini oʻrnatish (sozlash), ularga texnik xizmat koʻrsatish va ekspluatatsiya qilish;</div></div><div class="ACT_TEXT"><div name="-5301656" id="-5301656">davlat tashkilotlari, shuningdek, ustav fondida (kapitalida) davlat ulushi 50 foiz va undan ortiq boʻlgan yuridik shaxslarga tegishli qoʻriqlash boʻlinmalarida inspektorlik nazorat tekshiruvlarini oʻtkazish (huquq-tartibot organlari va harbiylashtirilgan tuzilmalardan tashqari), obyektlarda ichki, ruxsat berish rejimlariga rioya etilishiga doir tadbirlarni nazorat qilish va muvofiqlashtirish;</div></div><div class="ACT_TEXT"><div name="-5301658" id="-5301658">ommaviy tadbirlarda jamoat xavfsizligini taʼminlashda ishtirok etish, aholi gavjum joylarda jamoat tartibini saqlashda huquq-tartibot organlariga koʻmaklashish.</div></div><div class="ACT_TEXT"><div name="-5301690" id="-5301690">3. Belgilansinki, Qoʻriqlash bosh boshqarmasi mustaqil tarkibiy boʻlinma hisoblanadi hamda oʻz vakolatlari doirasida davlat obyektlari, oʻta muhim, toifalangan va boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini qoʻriqlash boʻyicha vazifalar va funksiyalarni koʻrsatilayotgan qoʻriqlash xizmatlari uchun tushadigan mablagʻlar hisobiga, oʻzini oʻzi mablagʻ bilan taʼminlash, xarajatlarni qoplash va mustaqil xoʻjalik yuritish tamoyili asosida amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-5301700" id="-5301700">4. Quyidagilar:</div></div><div class="ACT_TEXT"><div name="-5301707" id="-5301707">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasining tashkiliy tuzilmasi <a href="https://lex.uz/uz/docs/-5300150#-5302240">1-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-5301710" id="-5301710">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasi toʻgʻrisidagi nizom <a href="https://lex.uz/uz/docs/-5300150#-5302257">2-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-5301711" id="-5301711">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasining Qoraqalpogʻiston Respublikasi, viloyatlar va Toshkent shahar qoʻriqlash boshqarmalarining namunaviy tashkiliy tuzilmasi <a href="https://lex.uz/uz/docs/-5300150#-5304236">3-ilovaga</a> muvofiq;</div></div><div class="ACT_TEXT"><div name="-5302002" id="-5302002">Tuman (shahar) qoʻriqlash boʻlimlarining namunaviy tashkiliy tuzilmasi <a href="https://lex.uz/uz/docs/-5300150#-5304389">4-ilovaga</a> muvofiq tasdiqlansin;</div></div><div class="ACT_TEXT"><div name="-5302003" id="-5302003">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasi ishchi va xizmatchilari mehnatiga haq toʻlash boʻyicha lavozim tarif razryadlarining roʻyxati <a href="https://lex.uz/uz/docs/-5300150#-5304428">6-ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-5302006" id="-5302006">5. Shunday tartib belgilansinki, unga koʻra:</div></div><div class="ACT_TEXT"><div name="-5302027" id="-5302027">a) Qoʻriqlash bosh boshqarmasining shahodatlangan tarkibi Oʻzbekiston Respublikasi Milliy gvardiyasining xodimlari hisoblanadi, huquqiy maqomi boʻyicha ichki ishlar organlari xodimlariga tenglashtiriladi;</div></div><div class="ACT_TEXT"><div name="-5302032" id="-5302032">b) 2021-yil 1-iyuldan boshlab:</div></div><div class="ACT_TEXT"><div name="-5302047" id="-5302047">Yagona tarif setkasi boʻyicha mehnatga haq toʻlashning tasdiqlangan razryadlariga koʻra Qoʻriqlash bosh boshqarmasi ishchi va xizmatchilarining lavozim maoshlarini belgilashda tarif koeffitsiyentlari oʻrtacha ikki baravargacha oshirilgan miqdorda qoʻllaniladi.</div></div><div class="ACT_TEXT"><div name="-5302053" id="-5302053">6. Belgilansinki, 2021-yil 1-maydan boshlab: </div></div><div class="ACT_TEXT"><div name="-5302057" id="-5302057">a) obyektlarni qoʻriqlash tizimi “Yuqori sifat va qulay narx” tamoyili asosida quyidagi chora-tadbirlarni amalga oshirish orqali bosqichma-bosqich takomillashtiriladi:</div></div><div class="BY_DEFAULT"><div name="-6371117" id="-6371117"></div></div><div class="ACT_TEXT"><div name="-6371118" id="-6371118">shahodatlangan tarkib tomonidan qoʻriqlanadigan obyektlarni bosqichma-bosqich idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalariga oʻtkazish;</div></div><div class="ACT_TEXT"><div name="-5302063" id="-5302063">maqbullashtirilgan aralash qoʻriqlash turlarini joriy qilish;</div></div><div class="BY_DEFAULT"><div name="-6371120" id="-6371120"></div></div><div class="ACT_TEXT"><div name="-6371123" id="-6371123">zamonaviy qoʻriqlashning texnik vositalarini joriy etish orqali jismoniy qoʻriqlashni uzluksiz qisqartirib borish.</div></div><div class="ACT_TEXT"><div name="-5302069" id="-5302069">Bunda ushbu chora-tadbirlar uch bosqichda, kuyidagi obyektlarga nisbatan amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-5302094" id="-5302094">2022-yil 1-yanvarga qadar — vazirliklar, davlat qoʻmitalari, idoralar, hokimliklarning maʼmuriy binolari, oʻquv va madaniy muassasalar, chakana amaliyot kassalari, bank xizmatlari markazlari; </div></div><div class="ACT_TEXT"><div name="-5302095" id="-5302095">2022-yil 1-iyulga qadar — ishlab chiqarish obyektlari, bozorlar, savdo markazlari, teleradiouzatuv obyektlari, suv inshootlari; </div></div><div class="ACT_TEXT"><div name="-5302096" id="-5302096">2023-yil 1-yanvarga qadar — bank binolari va boshqa obyektlar;</div></div><div class="ACT_TEXT"><div name="-5302097" id="-5302097">b) Qoʻriqlash bosh boshqarmasi kuch va vositalarini boshqarish tizimi quyidagi chora-tadbirlarni amalga oshirish orqali takomillashtiriladi:</div></div><div class="ACT_TEXT"><div name="-5302098" id="-5302098">ortiqcha xarajatlarni qisqartirish hamda kuch va vositalarni boshqarish samaradorligini oshirish uchun hududiy boʻlinmalar sonini maqbullashtirish;</div></div><div class="ACT_TEXT"><div name="-5302103" id="-5302103">saf boʻlinmalarini tuman (shahar) qoʻriqlash boʻlimlari sifatida qayta tashkil etish;</div></div><div class="ACT_TEXT"><div name="-5302106" id="-5302106">qoʻriqlash xizmati koʻrsatilayotgan obyektlar joylashishi va shaxsiy tarkib sonini inobatga olgan holda tumanlararo qoʻriqlash boʻlimlarini tashkil etish;</div></div><div class="BY_DEFAULT"><div name="-6371280" id="-6371280"></div></div><div class="ACT_TEXT"><div name="-6371281" id="-6371281">v) Oʻzbekiston Respublikasi Milliy gvardiyasi harbiy xizmatchi va xodimlari lavozimlarini (bundan tor doiradagi mutaxassislikka ega boʻlgan nomzodlar mustasno) jamlash ustuvor tarzda Qoʻriqlash bosh boshqarmasining idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalarining tegishli kasbiy tayyorgarlikka ega, tayyorgarlik mashgʻulotlari va tanlov bosqichlaridan oʻtgan ishchi va xizmatchilari orasidan tanlab olish orqali amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-5302112" id="-5302112">7. Oʻzbekiston Respublikasi Milliy gvardiyasi qoʻmondoniga:</div></div><div class="ACT_TEXT"><div name="-5302113" id="-5302113">jismoniy va yuridik shaxslar bilan qoʻriqlash xizmati koʻrsatish borasida tuzilgan shartnomalar asosida Qoʻriqlash bosh boshqarmasining tashkiliy-shtat tuzilmasiga qoʻshimcha va oʻzgartirishlar kiritish;</div></div><div class="ACT_TEXT"><div name="-5302114" id="-5302114">Milliy gvardiya tomonidan koʻrsatiladigan qoʻriqlash xizmatlarining tariflarini (narxlarini) Oʻzbekiston Respublikasining Davlat budjeti hisobidan moliyalashtiriladigan budjet tashkilotlari uchun Oʻzbekiston Respublikasi Moliya vazirligi bilan kelishgan holda, boshqa yuridik va jismoniy shaxslar uchun — mustaqil belgilash huquqi berilsin. </div></div><div class="ACT_TEXT"><div name="-5302115" id="-5302115">8. Oʻzbekiston Respublikasi Milliy gvardiyasi:</div></div><div class="ACT_TEXT"><div name="-5302116" id="-5302116">a) 2021-yil 1-mayga qadar obyektlar xavfsizligini taʼminlash tizimiga zamonaviy qoʻriqlash vositalarini joriy etish va xalqaro tajribani inobatga olgan holda uni modernizatsiya qilishga qaratilgan chora-tadbirlar dasturini ishlab chiqsin va tasdiqlasin;</div></div><div class="ACT_TEXT"><div name="-5302117" id="-5302117">b) 2021-yil 1-iyunga qadar:</div></div><div class="ACT_TEXT"><div name="-5302118" id="-5302118">Oʻzbekiston Respublikasi Moliya vazirligi bilan birgalikda Qoʻriqlash bosh boshqarmasi tomonidan koʻrsatilayotgan xizmatlarning tariflarini qayta koʻrib chiqsin va tasdiqlasin;</div></div><div class="ACT_TEXT"><div name="-5302119" id="-5302119">Qoʻriqlash bosh boshqarmasining harbiylashtirilgan soqchilik va qorovullik boʻlinmalari toʻgʻrisidagi nizomni tasdiqlash uchun Oʻzbekiston Respublikasi Vazirlar Mahkamasiga kiritsin.</div></div><div class="ACT_TEXT"><div name="-5302120" id="-5302120">v) qoʻriqlash boʻlinmalarini texnika, qurol-aslaha, maxsus vositalar va boshqa zarur mol-mulkning yangi namunalari bilan taʼminlash choralarini koʻrsin;</div></div><div class="BY_DEFAULT"><div name="-6371336" id="-6371336"></div></div><div class="ACT_TEXT"><div name="-6371339" id="-6371339">g) Oʻzbekiston Respublikasi Jamoat xavfsizligi universiteti, Milliy gvardiya, Ixtisoslashtirilgan oʻquv markazi, Qoraqalpogʻiston Respublikasi, Jizzax va Fargʻona viloyatlari mintaqaviy oʻquv markazlari bazasida Qoʻriqlash bosh boshqarmasining idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash boʻlinmalari ishchi va xizmatchilarini boshlangʻich tayyorlash, qayta tayyorlash va malakasini oshirishni tashkil etsin;</div></div><div class="ACT_TEXT"><div name="-5302122" id="-5302122">d) Qoʻriqlash bosh boshqarmasi mablagʻlari hisobidan Milliy gvardiyaning Qoraqalpogʻiston Respublikasi, Jizzax va Fargʻona viloyatlari mintaqaviy oʻquv markazlarini rekonstruksiya qilish, joriy taʼmirlash va moddiy taʼminlashni amalga oshirsin.</div></div><div class="ACT_TEXT"><div name="-5302124" id="-5302124">9. Oʻzbekiston Respublikasi Moliya vazirligi koʻrsatilayotgan qoʻriqlash xizmatlari takomillashtirilishini inobatga olib, tegishli vazirliklar, idoralar va boshqa budjet tashkilotlarining hisob-kitoblariga asosan ularning xarajatlar smetasiga oʻzgartirishlar kiritsin.</div></div><div class="ACT_TEXT"><div name="-5302125" id="-5302125">10. Tasarrufida Qoʻriqlash bosh boshqarmasi boʻlinmalari tomonidan qoʻriqlanayotgan obyektlari boʻlgan vazirliklar va idoralar rahbarlari qoʻriqlashning yangi mexanizmini joriy etish bosqichlaridan kelib chiqqan holda:</div></div><div class="ACT_TEXT"><div name="-5302126" id="-5302126">zamonaviy axborot-kommunikatsiya texnologiyalarini joriy etish va jismoniy qoʻriqlashni qisqartirish hisobiga tasarrufidagi obyektlarning qoʻriqlash tizimlari qaytadan koʻrib chiqilishini;</div></div><div class="ACT_TEXT"><div name="-5302127" id="-5302127">Oʻzbekiston Respublikasi Milliy gvardiyasi bilan birga yangidan tasdiqlangan tariflar asosida qoʻriqlash xizmati koʻrsatish borasidagi shartnomalarning qaytadan tuzilishini taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-5302188" id="-5302188">11. Qoraqalpogʻiston Respublikasi Vazirlar Kengashi Raisi, viloyatlar va Toshkent shahar hokimlari, hududlardagi krimenogen vaziyatni eʼtiborga olgan holda, texnik qoʻriqlash markazlarini ochish, ularning tezkor harakatlanuvchi guruhlarini tashkil etish, bino va inshootlar bilan taʼminlash, aholi va mulkdorlar oʻrtasida qoʻriqlash xizmatini targʻib etishda Qoʻriqlash bosh boshqarmasiga har tomonlama koʻmaklashsin.</div></div><div class="ACT_TEXT"><div name="-5302189" id="-5302189">12. Oʻzbekiston Respublikasi Milliy gvardiyasi manfaatdor vazirliklar va idoralar bilan birgalikda:</div></div><div class="ACT_TEXT"><div name="-5302193" id="-5302193">2021-yil 1-mayga qadar manfaatdor vazirliklar va idoralar bilan birgalikda qonun hujjatlariga ushbu qarordan kelib chiqadigan oʻzgartirish va qoʻshimchalar kiritilishini taʼminlasin;</div></div><div class="ACT_TEXT"><div name="-5302198" id="-5302198">2021-yil 1-iyunga qadar mamlakat hududida integrallashgan texnik qoʻriqlash vositalarini ishlab chiqilishini (mahalliylashtirishni) nazarda tutuvchi Oʻzbekiston Respublikasi Vazirlar Mahkamasi qarori loyihasi tayyorlansin va taqdim etilsin.</div></div><div class="ACT_TEXT"><div name="-5302200" id="-5302200">13. Oʻzbekiston Milliy teleradiokompaniyasi, Oʻzbekiston Milliy axborot agentligi Oʻzbekiston Respublikasi Milliy gvardiyasi bilan birgalikda jismoniy va yuridik shaxslarning Qoʻriqlash bosh boshqarmasi xizmatlaridan foydalanishga boʻlgan qiziqishlarini oshirishga qaratilgan axborot-tushuntirish tadbirlarini muntazam ravishda amalga oshirib borsin.</div></div><div class="ACT_TEXT"><div name="-5302202" id="-5302202">14. Ushbu qarorning ijrosini nazorat qilish Oʻzbekiston Respublikasining Bosh vaziri A.N. Aripov va Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibi V.V. Maxmudov zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-5302204" id="-5302204">Oʻzbekiston Respublikasi Prezidenti Sh. MIRZIYOYEV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-5302209" id="-5302209">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-5302212" id="-5302212">2021-yil 20-fevral,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-5302214" id="-5302214">PQ-4997-son</div></div><div class="BY_DEFAULT"><div name="-5302240" id="-5302240"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5302251" id="-5302251">Oʻzbekiston Respublikasi Prezidentining 2021-yil 20-fevraldagi PQ-4997-son<a href="https://lex.uz/uz/docs/-5300150"> qaroriga <br /></a>1-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-5302253" id="-5302253">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasining tashkiliy tuzilmasi</div></div><div class="BY_DEFAULT"><div name="-6371347" id="-6371347"></div></div><div class="BY_DEFAULT"><div name="-6371349" id="-6371349"><img src="https://lex.uz/uz/files/6372358" /></div></div><div class="FOOTNOTE"><div name="-6371351" id="-6371351">Izoh: * — generallar tarkibi lavozimi davlat budjeti mablagʻlari hisobidan moliyalashtiriladi.</div></div><div class="BY_DEFAULT"><div name="-5302257" id="-5302257"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5302259" id="-5302259">Oʻzbekiston Respublikasi Prezidentining 2021-yil 20-fevraldagi PQ-4997-son<a href="https://lex.uz/uz/docs/5300150"> qaroriga <br /></a>2-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-5302261" id="-5302261">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasi toʻgʻrisida</div></div><div class="ACT_FORM"><div name="-5302263" id="-5302263">NIZOM</div></div><div class="BY_DEFAULT"><div name="-5302265" id="-5302265"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5302266" id="-5302266">1-bob. Umumiy qoidalar</div></div><div class="ACT_TEXT"><div name="-5302267" id="-5302267">1. Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasi (keyingi oʻrinlarda — Qoʻriqlash bosh boshqarmasi) oʻz vakolati doirasida davlat obyektlarini, oʻta muhim, toifalangan va boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini shartnoma asosida qoʻriqlashga doir Oʻzbekiston Respublikasi Milliy gvardiyasining (keyingi oʻrinlarda — Milliy gvardiya) vazifalari va funksiyalarini, shuningdek, davlat organlari, idoraviy qoʻriqlash tashkilotlari tomonidan qoʻriqlash faoliyatini tashkil etish va amalga oshirishda Oʻzbekiston Respublikasi qonun hujjatlari talablariga rioya etilishi yuzasidan davlat nazoratini amalga oshiradigan Milliy gvardiyaning mustaqil tarkibiy boʻlinmasi hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-5302268" id="-5302268">2. Qoʻriqlash bosh boshqarmasi davlat obyektlarini, oʻta muhim, toifalangan va boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini shartnoma asosida qoʻriqlash boʻyicha oʻz vakolatlari doirasidagi vazifalar va funksiyalarni koʻrsatilayotgan qoʻriqlash xizmatlari uchun tushadigan mablagʻlar hisobiga oʻzini oʻzi mablagʻ bilan taʼminlash, xarajatlarni qoplash va mustaqil xoʻjalik yuritish tamoyili asosida amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-5302269" id="-5302269">Qoʻriqlash bosh boshqarmasi tarkibida davlat budjetidan moliyalashtiriladigan boʻlinmalar ham faoliyat koʻrsatadi.</div></div><div class="ACT_TEXT"><div name="-5302270" id="-5302270">3. Qoʻriqlash bosh boshqarmasi oʻz faoliyatida Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-20596">Konstitutsiyasi</a> va qonunlariga, Oʻzbekiston Respublikasi Oliy Majlisi palatalarining qarorlariga, Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlariga, Vazirlar Mahkamasining qarorlari va farmoyishlariga, Milliy gvardiya qoʻmondonining buyruqlari va farmoyishlari, shuningdek, ushbu Nizomga va boshqa qonun hujjatlariga amal qiladi.</div></div><div class="ACT_TEXT"><div name="-5302271" id="-5302271">4. Qoʻriqlash bosh boshqarmasi tarkibiga quyidagilar kiradi:</div></div><div class="ACT_TEXT"><div name="-5302272" id="-5302272">Boshqaruv apparati, Qoraqalpogʻiston Respublikasi, viloyatlar va Toshkent shahar qoʻriqlash boshqarmalari, tuman (shahar) qoʻriqlash boʻlimlari;</div></div><div class="ACT_TEXT"><div name="-5302273" id="-5302273">Davlat organlari obyektlarini qoʻriqlash boʻyicha boshqarma;</div></div><div class="ACT_TEXT"><div name="-5302274" id="-5302274">Xorijiy davlatlarning diplomatik vakolatxonalarini qoʻriqlash boʻyicha alohida batalyon;</div></div><div class="ACT_TEXT"><div name="-5302275" id="-5302275">“Qoʻriqlash Servis” davlat unitar korxonasi.</div></div><div class="ACT_TEXT"><div name="-5302276" id="-5302276">5. Koʻrsatilgan xizmat uchun tushadigan mablagʻlar hisobiga Qoʻriqlash bosh boshqarmasida boshqarma, boʻlim, boʻlinma va guruhlar, shuningdek, qoʻriqlash faoliyati sohasida koʻp tarmoqli rejalashtirish va tadqiqotlar boʻyicha ilmiy markazlar, kengashlar va laboratoriyalar tashkil etilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5302277" id="-5302277">6. Qoʻriqlash bosh boshqarmasi va uning tarkibiga kiruvchi qoʻriqlash boʻlinmalari shaxsiy tarkibi:</div></div><div class="ACT_TEXT"><div name="-5302278" id="-5302278">xizmatni oʻtash tartibi va huquqiy maqomiga koʻra ichki ishlar organlari xodimlariga tenglashtiriladigan (maxsus unvon beriladigan) xodimlardan;</div></div><div class="ACT_TEXT"><div name="-5302279" id="-5302279">mehnat munosabatlari mehnat toʻgʻrisidagi qonun hujjatlari bilan tartibga solinadigan ishchi va xizmatchilardan iborat boʻladi.</div></div><div class="ACT_TEXT"><div name="-5302280" id="-5302280">Qoʻriqlash boʻlinmalarida xizmatni oʻtash masalalarining maxsus normativ-huquqiy hujjatlarda tartibga solinmagan qismiga mehnat qonunchiligi normalari tatbiq etiladi.</div></div><div class="ACT_TEXT"><div name="-5302281" id="-5302281">7. Qoʻriqlash bosh boshqarmasi yuridik shaxs hisoblanadi, oʻz nomi yozilgan va Oʻzbekiston Respublikasi Davlat gerbi tasviri tushirilgan muhr va blankalarga, oʻzining mustaqil balansiga (smetasiga) ega boʻlib, Oʻzbekiston Respublikasi tijorat banklarida milliy va xorijiy valyutadagi bank hisob varaqalari ochish, shuningdek, boʻsh pul mablagʻlarini tijorat banklari depozitlariga joylashtirish va ulardan daromad olish huquqiga egadir.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5302331" id="-5302331">2-bob. Qoʻriqlash bosh boshqarmasining asosiy vazifalari va funksiyalari</div></div><div class="ACT_TEXT"><div name="-5302631" id="-5302631">8. Quyidagilar Qoʻriqlash bosh boshqarmasining asosiy vazifalari hisoblanadi: </div></div><div class="ACT_TEXT"><div name="-5302639" id="-5302639">shartnoma asosida davlat obyektlarini, oʻta muhim, toifalangan va boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini, shuningdek, xorijiy davlatlar va xalqaro tashkilotlarning diplomatik, konsullik va boshqa vakolatxonalari obyektlarini qoʻriqlash;</div></div><div class="ACT_TEXT"><div name="-5302736" id="-5302736">qoʻriqlanayotgan obyektlarda ichki, ruxsat berish rejimlarini hamda jamoat tartibini taʼminlash, huquqbuzarliklarning oldini olish va bartaraf etish;</div></div><div class="ACT_TEXT"><div name="-5302747" id="-5302747">qoʻriqlash vositalari va tizimlarini qoʻllash sohasida yagona texnik siyosatni va ulardan foydalanish ustidan samarali nazoratni taʼminlash, shuningdek, qoʻriqlash faoliyatiga zamonaviy axborot-kommunikatsiya texnologiyalarini keng miqyosda joriy etish;</div></div><div class="BY_DEFAULT"><div name="-6371381" id="-6371381"></div></div><div class="ACT_TEXT"><div name="-6371388" id="-6371388">shartnoma asosida qoʻriqlashning texnik vositalarini oʻrnatish (sozlash), ularga texnik xizmat koʻrsatish va ekspluatatsiya qilish;</div></div><div class="ACT_TEXT"><div name="-5302805" id="-5302805">davlat tashkilotlari, shuningdek, ustav fondida (kapitalida) davlat ulushi 50 foiz va undan ortiq boʻlgan yuridik shaxslarga tegishli qoʻriqlash boʻlinmalarida nazorat tekshiruvlarini oʻtkazish (huquq-tartibot organlari va harbiylashtirilgan tuzilmalardan tashqari), obyektlarda ichki, ruxsat berish rejimlariga rioya etilishiga doir tadbirlarni nazorat qilish va muvofiqlashtirish;</div></div><div class="ACT_TEXT"><div name="-5302815" id="-5302815">ommaviy tadbirlarda jamoat xavfsizligini taʼminlashda ishtirok etish, aholi gavjum joylarda jamoat tartibini saqlashda huquq-tartibot organlariga koʻmaklashish.</div></div><div class="ACT_TEXT"><div name="-5302829" id="-5302829">9. Yuklangan vazifalariga muvofiq Qoʻriqlash bosh boshqarmasi quyidagi funksiyalarni amalga oshiradi: </div></div><div class="ACT_TEXT"><div name="-5302839" id="-5302839">a) shartnoma asosida davlat, oʻta muhim, toifalangan va boshqa obyektlarni, jismoniy va yuridik shaxslarning mol-mulkini, shuningdek, xorijiy davlatlar va xalqaro tashkilotlarning diplomatik, konsullik va boshqa vakolatxonalari obyektlarini qoʻriqlash sohasida:</div></div><div class="ACT_TEXT"><div name="-5302871" id="-5302871">yuridik va jismoniy shaxslarning obyektlari, mol-mulki, moddiy va boshqa boyliklarini samarali qoʻriqlash-kuzatish borasidagi faoliyatning shakl va usullarini shakllantiradi va amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5302879" id="-5302879">oʻta muhim, toifalangan obyektlar, xorijiy davlatlarning diplomatik vakolatxonalari, shuningdek, kuchaytirilgan tartibda qoʻriqlanishi talab etiladigan davlat ahamiyatiga molik boshqa obyektlarning qoʻriqlanishi va mudofaasini tashkil etadi va taʼminlaydi;</div></div><div class="BY_DEFAULT"><div name="-6371396" id="-6371396"></div></div><div class="ACT_TEXT"><div name="-6371399" id="-6371399">yuridik va jismoniy shaxslarning murojaatlariga asosan mol-mulk, moddiy va boshqa boyliklarni qoʻriqlash boʻyicha xizmat koʻrsatadi, shuningdek, ularning obyektlarini qoʻriqlashning texnik vositalari bilan jihozlash boʻyicha takliflar tayyorlaydi va kiritadi;</div></div><div class="BY_DEFAULT"><div name="-6371403" id="-6371403"></div></div><div class="ACT_TEXT"><div name="-6371404" id="-6371404">obyektlarni qoʻriqlashga jalb etilgan harbiy, idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash va idoraviy jihatdan tegishli boʻlmagan qorovullik boʻlinmalarining faoliyatini takomillashtirish boʻyicha kompleks choralar koʻradi;</div></div><div class="ACT_TEXT"><div name="-5302910" id="-5302910">jismoniy va yuridik shaxslarning murojaatlariga asosan, agar qonun hujjatlarida boshqacha holat nazarda tutilmagan boʻlsa, transportda tashish jarayonida qoʻriqlanishi belgilangan yuklar, tovar-moddiy boyliklar, xavfli yuklarni qoʻriqlash (kuzatish)ni amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5302916" id="-5302916">shaxsiy tarkib bilan reallikka yaqinlashtirilgan sharoitlarda hamkorlikdagi harakatlarni ishlab chiqish, shuningdek, har tomonlama taʼminlash va boshqarish boʻyicha qoʻmondonlik-shtab, maxsus-taktik va tezkor-taktik oʻquv mashgʻulotlarini tashkil etadi hamda oʻtkazadi;</div></div><div class="ACT_TEXT"><div name="-5302924" id="-5302924">aholining Qoʻriqlash bosh boshqarmasi xizmatlaridan foydalanishga boʻlgan qiziqishini oshirishga qaratilgan axborot-tushuntirish mazmunidagi chora-tadbirlarni amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5302935" id="-5302935">Oʻzbekiston Respublikasi hududida qoʻriqlash faoliyatining yagona tartib-qoidalari va meʼyorlarini joriy etish yuzasidan takliflar ishlab chiqadi;</div></div><div class="ACT_TEXT"><div name="-5302949" id="-5302949">b) qoʻriqlanayotgan obyektlarda ichki, ruxsat berish rejimlarini hamda jamoat tartibini taʼminlash, huquqbuzarliklarning oldini olish va bartaraf etish sohasida:</div></div><div class="ACT_TEXT"><div name="-5302980" id="-5302980">qoʻriqlanayotgan obyektlarda ichki, ruxsat berish rejimlariga rioya etilishi boʻyicha ishlarni nazorat qiladi va muvofiqlashtiradi;</div></div><div class="BY_DEFAULT"><div name="-6371419" id="-6371419"></div></div><div class="ACT_TEXT"><div name="-6371421" id="-6371421">obyektlarni qoʻriqlash tizimiga va qoʻriqlash boʻlinmalari faoliyatiga qoʻriqlashning zamonaviy muhandislik va texnik vositalarini joriy etadi;</div></div><div class="ACT_TEXT"><div name="-5303007" id="-5303007">ichki ishlar organlari va Milliy gvardiyaning boshqa boʻlinmalari bilan birgalikda oʻz vakolatlari doirasida qoʻriqlanayotgan obyektlarda gʻayriqonuniy tajovuzlarni profilaktika qilish, oldini olish, bartaraf etish samaradorligini oshirish choralarini ishlab chiqadi va amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5303017" id="-5303017">qoʻriqlanayotgan obyekt va unga tutash hududlarda jamoat tartibini saqlash va huquqbuzarliklarni aniqlash, bartaraf etish choralarini koʻradi;</div></div><div class="ACT_TEXT"><div name="-5303022" id="-5303022">v) qoʻriqlash vositalari va tizimlarini qoʻllash sohasida yagona texnik siyosatni va ulardan foydalanish ustidan samarali nazoratni taʼminlash, shuningdek, qoʻriqlash faoliyatiga zamonaviy axborot-kommunikatsiya texnologiyalarini keng miqyosda joriy etish sohasida:</div></div><div class="ACT_TEXT"><div name="-5303025" id="-5303025">xorijiy davlatlarning ilgʻor ish tajribasini oʻrganadi va tahlil qiladi, qoʻriqlash xizmatlari roʻyxatini kengaytirish imkonini beruvchi axborot-kommunikatsiya texnologiyalari joriy etilishini tashkil etadi;</div></div><div class="BY_DEFAULT"><div name="-6371425" id="-6371425"></div></div><div class="ACT_TEXT"><div name="-6371427" id="-6371427">qoʻriqlashning texnik vositalaridan foydalangan holda obyektlar xavfsizligini taʼminlashning samarali tizimlarini ishlab chiqadi va Qoʻriqlash bosh boshqarmasi faoliyatiga joriy etadi;</div></div><div class="BY_DEFAULT"><div name="-6371429" id="-6371429"></div></div><div class="ACT_TEXT"><div name="-6371430" id="-6371430">qoʻriqlash faoliyatiga zamonaviy qoʻriqlashning texnik vositalarini keng joriy etish masalalari boʻyicha maslahat-texnik kengashlar, amaliy uchrashuvlar, ilmiy-amaliy konferensiyalar, seminarlar tashkil etadi;</div></div><div class="BY_DEFAULT"><div name="-6371432" id="-6371432"></div></div><div class="ACT_TEXT"><div name="-6371433" id="-6371433">qoʻriqlanayotgan obyektlarda foydalanishga tavsiya etiladigan qoʻriqlashning texnik vositalari roʻyxatini shakllantiradi;</div></div><div class="BY_DEFAULT"><div name="-6371435" id="-6371435"></div></div><div class="ACT_TEXT"><div name="-6371436" id="-6371436">qoʻriqlashning texnik vositalarining ishlash holati va ehtimol tutilgan gʻayriqonuniy tajovuzlardan ishonchli himoyasi taʼminlanganligi ustidan monitoring olib boradi;</div></div><div class="ACT_TEXT"><div name="-5303070" id="-5303070">Oʻzbekiston Respublikasining oʻta muhim, toifalangan obyektlarida qoʻriqlashning texnik vositalarini loyihalashtirish, montaj qilish, sozlash, taʼmirlashga va texnik xizmat koʻrsatish ishlarini bajarishga ruxsatnomalar beradi;</div></div><div class="ACT_TEXT"><div name="-5303076" id="-5303076">qoʻriqlashning texnik vositalari va tizimlarini loyihalashtirish, montaj qilish, sozlash, taʼmirlash va ularga texnik xizmat koʻrsatish faoliyatini amalga oshirish uchun Milliy gvardiyani xabardor qilgan yuridik shaxslarning hisobini yuritish va ular tomonidan qonun hujjatlari va texnik jihatdan tartibga solish sohasidagi hujjatlar talablari va shartlariga rioya etilishini nazorat qiladi;</div></div><div class="BY_DEFAULT"><div name="-6371439" id="-6371439"></div></div><div class="ACT_TEXT"><div name="-6371440" id="-6371440">g) shartnoma asosida qoʻriqlashning texnik vositalarini oʻrnatish (sozlash), ularga texnik xizmat koʻrsatish va ekspluatatsiya qilish sohasida: </div></div><div class="ACT_TEXT"><div name="-6371441" id="-6371441">jismoniy va yuridik shaxslarning murojaatlariga asosan obyektlarga qoʻriqlashning texnik vositalarini oʻrnatish (sozlash), ulardan foydalanish borasida xizmatlar koʻrsatadi; </div></div><div class="ACT_TEXT"><div name="-6371442" id="-6371442">qoʻriqlanayotgan obyektlarda oʻrnatilgan qoʻriqlashning texnik vositalarini profilaktika qilish borasidagi texnik reglament ishlarini bajaradi;</div></div><div class="ACT_TEXT"><div name="-5303118" id="-5303118">d) davlat tashkilotlari, shuningdek, ustav fondida (kapitalida) davlat ulushi 50 foiz va undan ortiq boʻlgan yuridik shaxslarga tegishli qoʻriqlash boʻlinmalarida nazorat tekshiruvlarini oʻtkazish (huquq-tartibot organlari va harbiylashtirilgan tuzilmalardan tashqari), obyektlarda ichki, ruxsat berish rejimlariga rioya etilishiga doir tadbirlarni nazorat qilish va muvofiqlashtirish sohasida:</div></div><div class="BY_DEFAULT"><div name="-6371444" id="-6371444"></div></div><div class="ACT_TEXT"><div name="-6371445" id="-6371445">idoraviy qoʻriqlash boʻlinmalarida nazorat tekshiruvlarini oʻtkazadi, qoʻriqlashning tashkil etilishi, xodimlarning xizmatni oʻtashi, ularning kasbiy tayyorgarligi, obyektlarning texnik mustahkamligi va qoʻriqlashning texnik vositalari bilan jihozlanishini oʻrganadi;</div></div><div class="ACT_TEXT"><div name="-5303135" id="-5303135">idoraviy qoʻriqlash boʻlinmalari tomonidan qoʻriqlovidagi obyektlarning ichki va ruxsat berish rejimiga rioya etilishiga doir ishlarni nazorat qiladi va muvofiqlashtiradi; </div></div><div class="ACT_TEXT"><div name="-5303142" id="-5303142">idoraviy qoʻriqlash boʻlinmalari faoliyatini takomillashtirish va aniqlangan kamchiliklarni bartaraf etish boʻyicha takliflar kiritadi; </div></div><div class="ACT_TEXT"><div name="-5303145" id="-5303145">davlat tashkilotlari, shuningdek, ustav fondida (kapitalida) davlat ulushi 50 foiz va undan ortiq boʻlgan yuridik shaxslarga qoʻriqlash faoliyatini tashkil etish va amalga oshirish yuzasidan tavsiyalar beradi;</div></div><div class="ACT_TEXT"><div name="-5303153" id="-5303153">e) ommaviy tadbirlarda jamoat xavfsizligini taʼminlashda ishtirok etish, aholi gavjum joylarida jamoat tartibini saqlashda huquq-tartibot organlariga koʻmaklashish sohasida:</div></div><div class="ACT_TEXT"><div name="-5303155" id="-5303155">shartnoma asosida dam olish va jamoat ovqatlanish joylari, turizm obyektlari va savdo-koʻngilochar muassasalarda jamoat tartibini saqlash, huquqbuzarliklarning oldini olish tadbirlarida ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-5303157" id="-5303157">fuqarolarning ommaviy toʻplanish joylarida jamoat tartibini saqlash ishlarida huquq-tartibot organlariga koʻmaklashadi, shuningdek, ommaviy tadbirlar jarayonida jamoat xavfsizligini taʼminlashda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-5303160" id="-5303160">Qoʻriqlash bosh boshqarmasi tomonidan qoʻriqlanadigan obyektlarda xavfsizlikni taʼminlash va ularga tutash hududlarda jamoat tartibini saqlashda Milliy gvardiya va boshqa huquq-tartibot organlari bilan hamkorlik qiladi.</div></div><div class="BY_DEFAULT"><div name="-7219460" id="-7219460"></div></div><div class="ACT_TEXT"><div name="-7219461" id="-7219461">10. Qoʻriqlash bosh boshqarmasi zimmasiga yuklatilgan vazifalar va funksiyalarni bajarishda boshqa vazirliklar  va idoralar bilan, shuningdek, Milliy gvardiyaning tarkibiy boʻlinmalari bilan hamkorlik qiladi.</div></div><div class="ACT_TEXT"><div name="-5303169" id="-5303169">11. Qoʻriqlash bosh boshqarmasi qonun hujjatlarida nazarda tutilgan boshqa funksiyalarni ham amalga oshiradi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5303176" id="-5303176">3-bob. Qoʻriqlash bosh boshqarmasining huquqlari, majburiyatlari va javobgarligi</div></div><div class="ACT_TEXT"><div name="-5303180" id="-5303180">12. Qoʻriqlash bosh boshqarmasi oʻz vakolati doirasida quyidagi huquqlarga ega: </div></div><div class="ACT_TEXT"><div name="-5303186" id="-5303186">qoʻriqlanayotgan obyektlar mansabdor shaxslari, ishchi-xizmatchilari va obyekt hududidagi boshqa shaxslardan ichki, ruxsat berish rejimlariga rioya qilishni hamda jamoat tartibini saqlashni talab qilish;</div></div><div class="BY_DEFAULT"><div name="-6371449" id="-6371449"></div></div><div class="ACT_TEXT"><div name="-6371450" id="-6371450">qoʻriqlanayotgan obyektlardagi mol-mulkni saqlash shart-sharoitlari, qoʻriqlashning muhandislik va texnik vositalari holatini tekshirish;</div></div><div class="BY_DEFAULT"><div name="-6371457" id="-6371457"></div></div><div class="ACT_TEXT"><div name="-6371458" id="-6371458">qoʻriqlanayotgan obyekt maʼmuriyatiga, mansabdor shaxsiga, shartnoma shartlariga muvofiq obyektni muhandislik va texnik mustahkamligini taʼminlash, signalizatsiya tizimlari va videokuzatuv bilan jihozlash boʻyicha taqdimnoma kiritish; </div></div><div class="BY_DEFAULT"><div name="-6371460" id="-6371460"></div></div><div class="ACT_TEXT"><div name="-6371461" id="-6371461">davlat organlari, boshqa tashkilotlar hamda ularning mansabdor shaxslariga tuzilgan shartnomaga muvofiq bajarilishi majburiy boʻlgan, qoʻriqlash faoliyatini tashkil etish, muhandislik va texnik mustahkamlik, shuningdek, obyektlarning ichki, ruxsat berish rejimlaridagi kamchiliklar va xatolarni bartaraf etish borasida taqdimnomalar kiritish;</div></div><div class="ACT_TEXT"><div name="-5303216" id="-5303216">qoʻriqlanayotgan obyektdan mol-mulk, moddiy boyliklar va turli yuklarni noqonuniy olib chiqishga yoki olib kirishga urinayotgan shaxslarni ushlash;</div></div><div class="ACT_TEXT"><div name="-5303220" id="-5303220">qoʻriqlanayotgan obyektlarga noqonuniy kirganlar yoki huquqbuzarlik qilganlarning shaxsini aniqlash va maʼmuriy bayonnoma tuzish maqsadida ushlash va qoʻriqlash xizmati xonalariga olib kelish, ushlab turish, zarur hollarda esa — tegishli qaror qabul qilish uchun ularni hududiy ichki ishlar organlariga topshirish;</div></div><div class="ACT_TEXT"><div name="-5303222" id="-5303222">qonun hujjatlari talablariga muvofiq qoʻriqlash posti hududida fuqarolarning shaxsini tasdiqlaydigan hujjatlarini tekshirish, agar ularda qurol hamda uning oʻq-dorilari, qurolning asosiy qismlari, portlovchi, radioaktiv yoki zaharli moddalar, portlatish qurilmalari, pirotexnika buyumlari, giyohvandlik vositalari, ularning analoglari, psixotrop moddalar, ularning prekursorlari yoxud muomalada boʻlishi taqiqlangan yoki cheklangan boshqa narsalar, qoʻriqlanayotgan obyekt hududiga olib kirilishi va undan olib chiqib ketilishi taqiqlangan ashyolar, buyumlar, vositalar bor deb hisoblashga asoslar mavjud boʻlsa, fuqarolarni shaxsiy koʻrikdan oʻtkazish, ularning ashyolarini, qoʻl yukini, bagajini koʻrikdan oʻtkazish hamda mazkur narsalar, vositalarni va moddalarni olib yurish hamda saqlash uchun qonuniy asoslar mavjud boʻlmagan taqdirda, ularni olib qoʻyish, transport vositalarini koʻzdan kechirish va tashib oʻtilayotgan yuklarning tovar-transport hujjatlarga muvofiqligini aniqlash;</div></div><div class="ACT_TEXT"><div name="-5303225" id="-5303225">sodir etilayotgan jinoyatlarni toʻxtatish, shuningdek, ularni sodir etgan shaxslarni taʼqib etish va ushlash, bir vaqtning oʻzida bir necha obyektda “tashvish” signalizatsiyasi ishlab ketgan hollarda ichki ishlar organlari va Milliy gvardiya patrul guruhlarini chaqirish; </div></div><div class="ACT_TEXT"><div name="-5303227" id="-5303227">oʻz vakolati doirasida mansabdor shaxslardan tushuntirishlar, maʼlumotlar va hujjatlar olish; </div></div><div class="ACT_TEXT"><div name="-5303230" id="-5303230">fuqarolar va mansabdor shaxslardan xizmat vazifalari bajarilishiga toʻsqinlik qiluvchi huquqbuzarliklar va xatti-harakatlarni toʻxtatishni talab qilish, ushbu talablar bajarilmagan taqdirda, qonun hujjatlarida nazarda tutilgan tegishli choralarni qoʻllash;</div></div><div class="ACT_TEXT"><div name="-5303232" id="-5303232">qoʻriqlanayotgan obyektlar nazorat-oʻtkazish joylari va hududlarida noqonuniy olib chiqilayotgan (olib kirilayotgan) mol-mulkni aniqlash va olib qoʻyish, shuningdek, gʻayriqonuniy harakatlarni aniqlash uchun fuqarolarning hayoti va sogʻligiga, tekshirilayotgan mol-mulk va atrof muhitga ziyon yetkazmaydigan zamonaviy texnik vositalardan foydalanish; </div></div><div class="ACT_TEXT"><div name="-5303234" id="-5303234">qoʻriqlanadigan obyektlarga gʻayriqonuniy ravishda kirgan yoki kirishga uringan shaxslarni aniqlash, bunday xatti-harakatlarning oldini olishda xizmat itlaridan foydalanish;</div></div><div class="ACT_TEXT"><div name="-5303237" id="-5303237">qonun hujjatlariga muvofiq qoʻriqlanayotgan obyektlarda huquqbuzarliklarning oldini olish va bartaraf etishga koʻmaklashish; </div></div><div class="ACT_TEXT"><div name="-5303240" id="-5303240">qonun hujjatlarida nazarda tutilgan holatlarda va belgilangan tartibga muvofiq jismoniy kuch ishlatish, oʻqotar qurol va maxsus vositalarni olib yurish va ulardan foydalanish;</div></div><div class="ACT_TEXT"><div name="-5303243" id="-5303243">oʻz vakolati doirasida maʼmuriy huquqbuzarliklar toʻgʻrisidagi ishlar boʻyicha bayonnomalar tuzish; </div></div><div class="ACT_TEXT"><div name="-5303246" id="-5303246">yuridik shaxslardan oʻz vakolati doirasida idoraviy qoʻriqlash faoliyatini tashkil qilish yuzasidan yozma va ogʻzaki maʼlumotlarni soʻrab olish;</div></div><div class="ACT_TEXT"><div name="-5303247" id="-5303247">jamoat xavfsizligini, jismoniy va yuridik shaxslarning mulkini qoʻriqlashni toʻlaqonli taʼminlash uchun hududlarda patrullikni tashkil etish bilan bogʻliq holda texnik vositalarning butun kompleksidan foydalanish;</div></div><div class="ACT_TEXT"><div name="-5303248" id="-5303248">maxsus yorugʻlik signallariga va tovushli signallarga, boʻyoqli rangli grafika sxemasiga ega maxsus avtotransport vositalariga ega boʻlish.</div></div><div class="ACT_TEXT"><div name="-5303250" id="-5303250">Qoʻriqlash bosh boshqarmasi qonun hujjatlariga muvofiq boshqa huquqlarga ham ega boʻlishi mumkin. </div></div><div class="ACT_TEXT"><div name="-5303270" id="-5303270">13. Qoʻriqlash bosh boshqarmasi quyidagi majburiyatlarni oʻz zimmasiga oladi:</div></div><div class="ACT_TEXT"><div name="-5303277" id="-5303277">jismoniy va yuridik shaxslarning mol-mulkini, shaxs, jamiyat va davlat xavfsizligini oʻz vakolatlari doirasida himoya qilish uchun barcha zarur choralarni koʻrish;</div></div><div class="ACT_TEXT"><div name="-5303282" id="-5303282">obyekt maʼmuriyati tomonidan Qoʻriqlash bosh boshqarmasi boʻlinmasi rahbarlari bilan kelishgan holda tasdiqlagan kirib-chiqish yoʻriqnomasiga asosan obyektda ichki va ruxsat berish rejimiga rioya etilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-5303286" id="-5303286">qoʻriqlanayotgan mol-mulkning oʻgʻirlanishi yoki buzilishiga olib kelishi mumkin boʻlgan xoʻjasizlik va beparvolikning har qanday koʻrinishiga oʻz vaqtida munosabat bildirish;</div></div><div class="ACT_TEXT"><div name="-5303290" id="-5303290">xizmatni oʻtash joylarida huquqbuzarliklarning oldini olish va ularni bartaraf etish boʻyicha tadbirlarni amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-5303297" id="-5303297">qoʻriqlanayotgan obyektda jinoyat, maʼmuriy huquqbuzarlik izlarining saqlanishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-5303304" id="-5303304">qoʻriqlanayotgan obyektda huquqbuzarliklarni profilaktika qilish, ularni sodir etishga olib keluvchi sabab va shart-sharoitlarni aniqlash hamda ularni bartaraf etish choralarini koʻrish;</div></div><div class="ACT_TEXT"><div name="-5303310" id="-5303310">qoʻriqlanayotgan obyektda huquqbuzarliklar sodir etilgan joyda jabrlangan, shuningdek, nochor holatdagi fuqarolarga birinchi tibbiy va boshqa yordam koʻrsatish borasidagi choralarni koʻrish;</div></div><div class="ACT_TEXT"><div name="-5303317" id="-5303317">qoʻriqlanadigan obyektlarda tabiiy va texnogen xususiyatga ega favqulodda hodisa va holatlarning oldini olish, ularni bartaraf etishda ishtirok etish;</div></div><div class="ACT_TEXT"><div name="-5303328" id="-5303328">ishonib topshirilgan tabel qurollar, maxsus va texnik vositalar, shaxsiy himoya vositalari, xizmat kiyim-boshlari, mol-mulkni ehtiyot qilish va ularning soz holda saqlanishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-5303336" id="-5303336">boʻlinmalarning jangovar tayyorgarligini taʼminlash, shuningdek, xizmat-jangovar, ijtimoiy-huquqiy, maʼnaviy-psixologik va jismoniy tayyorgarlik boʻyicha tegishli dasturlarda belgilangan mashgʻulotlarning shaxsiy tarkib bilan oʻz vaqtida va sifatli oʻtkazilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-5303341" id="-5303341">boʻlinmalarda belgilangan tartibda safarbarlik tayyorgarligini tashkil etish va taʼminlash.</div></div><div class="ACT_TEXT"><div name="-5303348" id="-5303348">Qoʻriqlash bosh boshqarmasiga qonun hujjatlariga muvofiq boshqa majburiyatlar ham yuklanishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5303359" id="-5303359">14. Qoʻriqlash bosh boshqarmasi oʻz zimmasiga yuklatilgan vazifalar va funksiyalarning samarali bajarilishi uchun javobgardir.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5303367" id="-5303367">4-bob. Qoʻriqlash bosh boshqarmasi faoliyatini tashkil etish</div></div><div class="ACT_TEXT"><div name="-5303374" id="-5303374">15. Qoʻriqlash bosh boshqarmasi bevosita Milliy gvardiya qoʻmondoniga boʻysunadi.</div></div><div class="ACT_TEXT"><div name="-5303379" id="-5303379">Qoʻriqlash bosh boshqarmasini Milliy gvardiya qoʻmondoni tavsiyasiga binoan Oʻzbekiston Respublikasi Prezidenti tomonidan lavozimga tayinlanadigan va lavozimdan ozod etiladigan Milliy gvardiya qoʻmondonining oʻrinbosari — Qoʻriqlash bosh boshqarmasi boshligʻi (keyingi oʻrinlarda — Qoʻriqlash bosh boshqarmasi boshligʻi) boshqaradi.</div></div><div class="ACT_TEXT"><div name="-5303384" id="-5303384">16. Qoʻriqlash bosh boshqarmasi boshligʻi:</div></div><div class="ACT_TEXT"><div name="-5303435" id="-5303435">Qoʻriqlash bosh boshqarmasi faoliyatini va bevosita boshqaruvini tashkil etadi va yuklatilgan vazifalar, majburiyatlarni samarali va sifatli amalga oshirish uchun shaxsan javob beradi;</div></div><div class="ACT_TEXT"><div name="-5303441" id="-5303441">Qoʻriqlash bosh boshqarmasi vakolatlari doirasiga kiruvchi masalalar boʻyicha davlat hokimiyati va boshqaruvi organlari, jamoat birlashmalari va tashkilotlarda Milliy gvardiya nomidan vakillik qiladi;</div></div><div class="ACT_TEXT"><div name="-5303444" id="-5303444">oʻz vakolatlari doirasida belgilangan tartibda Milliy gvardiya harbiy xizmatchilari va Qoʻriqlash bosh boshqarmasi barcha xodimlari tomonidan bajarilishi majburiy boʻlgan buyruqlar, farmoyishlar chiqaradi va koʻrsatmalar beradi;</div></div><div class="ACT_TEXT"><div name="-5303469" id="-5303469">tinchlik va favqulodda holat davri, tabiiy va texnogen xususiyatli favqulodda vaziyatlar yuzasidan maxsus rejalashtirish va harbiy safarbarlik masalalarini tashkil etadi va nazorat qiladi; </div></div><div class="ACT_TEXT"><div name="-5303477" id="-5303477">tasdiqlangan smeta doirasida pul mablagʻlari sarflanishini boshqaradi, belgilangan tartibda banklarda va ularning filiallarida joriy va boshqa hisob varaqlari ochadi; </div></div><div class="ACT_TEXT"><div name="-5303481" id="-5303481">Qoʻriqlash bosh boshqarmasi depozit hisob varaqlarini ochadi va boʻsh pul mablagʻlarini tijorat banklariga joylashtiradi;</div></div><div class="ACT_TEXT"><div name="-5303484" id="-5303484">kamomaddan, rastratadan, oʻgʻirlikdan koʻrilgan va sud tomonidan undirib olish rad etilgan zararlarni, qaytarib olishning iloji yoʻq deb hisoblangan boshqa qarzlarni, aniq aybdorlarni aniqlash mumkin boʻlmagan holatlarda boyliklarning meʼyordan ortiqcha miqdorda tabiiy buzilishi tufayli koʻrilgan zarar va yoʻqotishlar tufayli yetishmagan boyliklarni, shuningdek, asosiy fondlar hisobida boʻlgan maʼnaviy eskirgan va kelgusida foydalanishga yaroqsiz asbob-uskunalarni qonun hujjatlariga muvofiq hisobdan chiqarishni amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5303486" id="-5303486">ishlab chiqilayotgan qoʻriqlash signalizatsiyasi asbob-uskunalari, texnik qoʻriqlash markaz (punkt)lari qurilishining namunaviy loyihalari texnik shartlarini kelishadi, texnik topshiriqlarni belgilangan tartibda tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-5303489" id="-5303489">Qoʻriqlash bosh boshqarmasi faoliyatining barcha masalalari boʻyicha jismoniy va yuridik shaxslarning murojaatlarini qoʻrib chiqadi, aniqlangan kamchiliklarni bartaraf qilish choralarini koʻradi, ushbu ishlar tashkil etilishini nazorat qiladi;</div></div><div class="ACT_TEXT"><div name="-5303492" id="-5303492">shaxsiy tarkibni tanlash, tanlov asosida saralash, joy-joyiga quyish, oʻqitish va tarbiyalash boʻyicha ishlarni tashkil etadi, Qoʻriqlash bosh boshqarmasi va uning joylardagi boʻlinmalarida shtat-moliya intizomiga rioya qilinishi yuzasidan nazoratni amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5303495" id="-5303495">Qoʻriqlash bosh boshqarmasi va uning boʻlinmalari xizmatiga nomzodlarni tanlov asosida saralab olish boʻyicha komissiyani belgilangan tartibda tuzadi;</div></div><div class="BY_DEFAULT"><div name="-6371469" id="-6371469"></div></div><div class="ACT_TEXT"><div name="-6371472" id="-6371472">Qoʻriqlash bosh boshqarmasining idoraviy jihatdan tegishli boʻlmagan harbiylashtirilgan qoʻriqlash, idoraviy jihatdan tegishli boʻlmagan qorovullik boʻlinmalari shtatlarini kiritish (qisqartirish) va qayta tashkil etish boʻyicha buyruqlar chiqaradi, ishchi, xizmatchilar, xususan “Qoʻriqlash Servis” davlat unitar korxonasi va uning hududiy boʻlinmalari shtatlarini tasdiqlaydi va oʻzgartirishlar, qoʻshimchalar kiritadi;</div></div><div class="ACT_TEXT"><div name="-5303515" id="-5303515">Qoʻriqlash bosh boshqarmasi boʻlinmalari xodimlari, ishchi-xizmatchilarini belgilangan tartibda ragʻbatlantiradi va ularga intizomiy jazo beradi;</div></div><div class="ACT_TEXT"><div name="-5303523" id="-5303523">lavozimlar nomenklaturasiga muvofiq Qoʻriqlash bosh boshqarmasi boʻlinmalari xodimlarini attestatsiyadan oʻtkazadi;</div></div><div class="ACT_TEXT"><div name="-5303533" id="-5303533">oʻz vakolati doirasida Qoʻriqlash bosh boshqarmasi boʻlinmalarida yoʻl qoʻyilgan qonun, xizmat va mehnat intizomi buzilishi holatlari boʻyicha xizmat tekshiruvi oʻtkazilishini tayinlaydi;</div></div><div class="ACT_TEXT"><div name="-5303541" id="-5303541">Qoʻriqlash bosh boshqarmasi xodimlari, ishchi va xizmatchilarini belgilangan tartibda xizmat safarlariga yuboradi;</div></div><div class="ACT_TEXT"><div name="-5303551" id="-5303551">ofitserlar, serjantlar va safdorlar tarkibi xodimlarini xizmatga qabul qiladi;</div></div><div class="ACT_TEXT"><div name="-5303569" id="-5303569">lavozimlar nomenklaturasiga muvofiq safdor, serjant va ofitserlar tarkibi xodimlarining xizmatni oʻtash chegara yoshi muddatini uzaytiradi;</div></div><div class="ACT_TEXT"><div name="-5303579" id="-5303579">Qoʻriqlash bosh boshqarmasi boshqarmalarining nizomlarini, boshqaruv apparati rejalarini va mansabdor shaxslarining funksional vazifalarini tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-5303643" id="-5303643">Qoʻriqlash bosh boshqarmasi boʻlinmalari tashkiliy tuzilmasi va shtatlarini oʻzgartirish boʻyicha takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-5303670" id="-5303670">Qoʻriqlash bosh boshqarmasi boshligʻi oʻrinbosarlari, boshqaruv apparati boshqarma, boʻlim boshliqlari, Qoraqalpogʻiston Respublikasi, viloyatlar va Toshkent shahri qoʻriqlash boshqarmalari boshliqlari, ularning oʻrinbosarlari, Davlat organlari obyektlarini qoʻriqlash boʻyicha boshqarma boshligʻi va uning oʻrinbosarlarini, Xorijiy davlatlarning diplomatik vakolatxonalarini qoʻriqlash boʻyicha alohida batalyon komandiri, uning oʻrinbosarlarini, Oʻz xavfsizligi xizmati va Nazorat-taftish boʻlimi rahbarlari va xodimlarini lavozimga tayinlash va egallab turgan lavozimidan ozod etish boʻyicha Milliy gvardiya qoʻmondoniga taqdimnoma kiritadi;</div></div><div class="ACT_TEXT"><div name="-5303694" id="-5303694">Qoʻriqlash bosh boshqarmasi ofitserlar tarkibiga birinchi va “podpolkovnik”, “polkovnik” maxsus unvonlari berish boʻyicha Milliy gvardiya qoʻmondoniga taqdimnoma kiritadi;</div></div><div class="ACT_TEXT"><div name="-5303698" id="-5303698">Qoʻriqlash bosh boshqarmasida xizmat qilayotgan “polkovnik” unvonidagi xodimlarni xizmatdan boʻshatish boʻyicha Milliy gvardiya qoʻmondoniga taqdimnoma kiritadi;</div></div><div class="ACT_TEXT"><div name="-5303720" id="-5303720">Qoʻriqlash bosh boshqarmasi xodimlarini davlat mukofotiga tavsiya etish va idoraviy mukofotlar bilan taqdirlash boʻyicha belgilangan tartibda taklif kiritadi;</div></div><div class="ACT_TEXT"><div name="-5303722" id="-5303722">Qoʻriqlash bosh boshqarmasi safdor va serjantlar tarkibiga — maxsus unvonlar, shuningdek, yangidan xizmatga qabul qilinayotgan, ofitserlik lavozimiga tayinlanayotgan xodimlarga “katta serjant” maxsus unvonini, ofitserlar tarkibiga “mayor” va ungacha boʻlgan maxsus unvonlarni beradi;</div></div><div class="ACT_TEXT"><div name="-5303723" id="-5303723">boshqaruv apparati, Davlat organlari obyektlarini qoʻriqlash boʻyicha boshqarma, Xorijiy davlatlarning diplomatik vakolatxonalarini qoʻriqlash boʻyicha alohida batalyon xodimlariga va Qoʻriqlash bosh boshqarmasining ofitserlar tarkibiga mutaxassislik toifalarini, safdor va serjantlar tarkibiga — “birinchi toifali mutaxassis” va “usta” mutaxassislik toifalarini beradi;</div></div><div class="ACT_TEXT"><div name="-5303724" id="-5303724">boshqaruv apparati, Davlat organlari obyektlarini qoʻriqlash boʻyicha boshqarma va Xorijiy davlatlarning diplomatik vakolatxonalarini qoʻriqlash boʻyicha alohida batalyonning safdorlar, serjantlar va ofitserlar tarkibini, ishchi va xizmatchilarini (Milliy gvardiya qoʻmondoni nomenklaturasiga kiruvchi lavozimlardan tashqari) lavozimga tayinlaydi, lavozimidan ozod etadi, ixtiyoriga oladi va xizmatdan boʻshatadi;</div></div><div class="ACT_TEXT"><div name="-5303728" id="-5303728">Qoraqalpogʻiston Respublikasi, viloyatlar va Toshkent shahri qoʻriqlash boshqarmalari boʻlim boshliqlari, ularning oʻrinbosarlari, boʻlinma boshliqlari, harbiy safarbarlik guruhi mutaxassislarini, alohida batalyonlar komandirlari, shahar-tuman qoʻriqlash boʻlimlari boshliqlari, ularning oʻrinbosarlarini, “Qoʻriqlash Servis” davlat unitar korxonasi direktori va uning oʻrinbosarlarini lavozimga tayinlaydi, lavozimidan ozod etadi, ixtiyoriga oladi va xizmatdan boʻshatadi;</div></div><div class="ACT_TEXT"><div name="-5307917" id="-5307917">qonun hujjatlari va Milliy gvardiya qoʻmondonining buyruqlariga muvofiq Qoʻriqlash bosh boshqarmasi vakolatiga tegishli boʻlgan boshqa vakolatlarni amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-5303730" id="-5303730">17. Qoʻriqlash bosh boshqarmasi boshligʻi oʻz tavsiyasiga muvofiq Milliy gvardiya qoʻmondoni tomonidan tayinlanadigan va lavozimidan ozod etiladigan oʻrinbosarlariga ega boʻladi.</div></div><div class="ACT_TEXT"><div name="-5303733" id="-5303733">Qoʻriqlash bosh boshqarmasi boshligʻi boʻlmagan paytlarda, uning vazifalarini Milliy gvardiya qoʻmondonining buyrugʻiga asosan Qoʻriqlash bosh boshqarmasi boshligʻining birinchi oʻrinbosari amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-5303734" id="-5303734">18. Boshqaruv apparati:</div></div><div class="ACT_TEXT"><div name="-5303736" id="-5303736">Qoʻriqlash bosh boshqarmasi boʻlinmalari faoliyatini tashkil etadi, boshqaradi va muvofiqlashtiradi;</div></div><div class="ACT_TEXT"><div name="-5303738" id="-5303738">oʻz vakolatlari doirasida fuqarolarning huquqlari, erkinliklari, qonuniy manfaatlarini, jismoniy va yuridik shaxslarning mol-mulkini, shaxs, jamiyat va davlatning xavfsizligini himoya qilish choralarini koʻradi; </div></div><div class="ACT_TEXT"><div name="-5303740" id="-5303740">Qoʻriqlash bosh boshqarmasi boʻlinmalari faoliyati boʻyicha statistik maʼlumotlarni, axborot va boshqa materiallarni umumlashtiradi, tahlil qiladi, qoʻriqlash xizmati boʻlinmalarining xizmat faoliyati masalalari boʻyicha maʼlumotlar bankini yaratadi;</div></div><div class="ACT_TEXT"><div name="-5303742" id="-5303742">boʻysunuvchi boʻlinmalarining faoliyatini tashkil etish, monitoring, nazorat qilishni, boshqarishni, joriy va istiqbolli rejalashtirishni amalga oshiradi, ularga yuklatilgan vazifalarni hal etishda amaliy yordam koʻrsatadi;</div></div><div class="ACT_TEXT"><div name="-5303748" id="-5303748">Qoʻriqlash bosh boshqarmasi boʻlinmalarining yagona axborot va kommunikatsiya tizimini joriy etadi va tezkor axborot almashinuvini taʼminlash borasida kompleks chora-tadbirlarni ishlab chiqadi;</div></div><div class="ACT_TEXT"><div name="-5303750" id="-5303750">Qoʻriqlash bosh boshqarmasi vakolatlari doirasidagi masalalar yuzasidan Milliy gvardiyaga takliflarni, jumladan, normativ-huquqiy hujjatlar loyihalarini koʻrib chiqish uchun kiritadi;</div></div><div class="BY_DEFAULT"><div name="-6371476" id="-6371476"></div></div><div class="ACT_TEXT"><div name="-6371478" id="-6371478">davlat tomonidan majburiy qoʻriqlanishi lozim boʻlgan obyektlar roʻyxati hamda idoraviy harbiylashtirilgan qoʻriqlashni tashkil etish huquqiga ega boʻlgan respublika davlat va xoʻjalik boshqaruvi organlari, mahalliy davlat hokimiyati organlari va boshqa tashkilotlar roʻyxatini shakllantirish boʻyicha takliflarni ishlab chiqishda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-5303753" id="-5303753">Qoʻriqlash bosh boshqarmasi boʻlinmalari tomonidan qoʻriqlanadigan obyektlar roʻyxatlarini ishlab chiqadi;</div></div><div class="ACT_TEXT"><div name="-5303755" id="-5303755">qonun hujjatlariga muvofiq xalqaro hamkorlikni amalga oshiradi;</div></div><div class="BY_DEFAULT"><div name="-6371490" id="-6371490"></div></div><div class="ACT_TEXT"><div name="-6371492" id="-6371492">obyektlarni signalizatsiya vositalari bilan jihozlash boʻyicha montaj-sozlash ishlari, qoʻriqlashning texnik vositalari boʻyicha tadqiqotlarni va ishlab chiqarishga ixtisoslashgan korxonalarini tashkil qiladi hamda mulkdorlarga boshqa xizmatlar koʻrsatadi; </div></div><div class="ACT_TEXT"><div name="-5303757" id="-5303757">Qoʻriqlash bosh boshqarmasining moliya-xoʻjalik faoliyatini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-5303758" id="-5303758">Qoʻriqlash bosh boshqarmasining tashkiliy-shtatlar va kadrlar ishlarini amalga oshiradi;</div></div><div class="ACT_TEXT"><div name="-5303760" id="-5303760">Qoʻriqlash bosh boshqarmasi vakolati doirasiga kiruvchi masalalarda turli tashkilotlar bilan hamkorlik qiladi;</div></div><div class="ACT_TEXT"><div name="-5303761" id="-5303761">belgilangan tartibda qoʻriqlash-yongʻindan ogohlantirish signalizatsiyasi apparatlari, boshqa texnik vositalar va materiallarni realizatsiya qiladi;</div></div><div class="ACT_TEXT"><div name="-5303762" id="-5303762">qoʻriqlash faoliyati sohasida qaror qabul qilish uchun zarur boʻlgan axborot va boshqa materiallarni vazirliklar va idoralardan belgilangan tartibda soʻrab oladi;</div></div><div class="ACT_TEXT"><div name="-5303763" id="-5303763">tegishli vazirliklar va idoralarning maxsus taʼlim muassasalari maʼlumotlar bazalaridan belgilangan tartibda foydalanadi;</div></div><div class="ACT_TEXT"><div name="-5303765" id="-5303765">komissiyalar, kengashlar va boshqa maslahat organlarini, shu jumladan manfaatdor vazirliklar, idoralar va tashkilotlarning tegishli tuzilmalari vakillari ishtirokida tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-5303768" id="-5303768">byulleten, normativ-huquqiy hujjatlar toʻplamlari, konferensiyalar materiallarini nashr etadi;</div></div><div class="ACT_TEXT"><div name="-5303771" id="-5303771">qoʻriqlash sohasi faoliyatidagi muammolarni oʻrganadi va konsultatsiyalar oladi, shu sohada normativ-huquqiy hujjatlarni tayyorlash uchun shartnoma asosida tashkilotlar va mutaxassislarni jalb etadi;</div></div><div class="ACT_TEXT"><div name="-5303772" id="-5303772">qonun hujjatlariga muvofiq boshqa vakolatlarni ham amalga oshiradi. </div></div><div class="ACT_TEXT"><div name="-5303773" id="-5303773">19. Qoraqalpogʻiston Respublikasi, viloyatlar va Toshkent shahar qoʻriqlash boshqarmalari Qoʻriqlash bosh boshqarmasining hududiy boʻlinmalari hisoblanib, vakolatlari doirasida Qoʻriqlash bosh boshqarmasiga yuklatilgan vazifalar va majburiyatlarni amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-5303774" id="-5303774">20. Davlat organlari obyektlarini qoʻriqlash boʻyicha boshqarma Qoʻriqlash bosh boshqarmasining tashkiliy boʻlinmasi hisoblanadi, vakolatlari doirasida Toshkent shahri va Toshkent viloyatida joylashgan davlat ahamiyatidagi obyektlarni qoʻriqlashni amalga oshiradi, shuningdek, tutash hududlarda jamoat tartibini taʼminlaydi. </div></div><div class="ACT_TEXT"><div name="-5303775" id="-5303775">21. Xorijiy davlatlarning diplomatik vakolatxonalarini qoʻriqlash boʻyicha alohida batalyon Qoʻriqlash bosh boshqarmasining tashkiliy boʻlinmasi hisoblanadi, vakolatlari doirasida xorijiy davlatlar va xalqaro tashkilotlarning diplomatik, konsullik va boshqa vakolatxonalari obyektlarini qoʻriqlashni amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-5303776" id="-5303776">22. Qoʻriqlash boʻlinmalari boshqaruv apparatlari shtatlari soni qoʻriqlash xizmati koʻrsatish uchun tuzilgan shartnomalarga muvofiq kiritilgan shtat birliklari umumiy sonining toʻrt foizigacha miqdorda belgilanadi.</div></div><div class="ACT_TEXT"><div name="-5303777" id="-5303777">Qoʻriqlash xizmati saf boʻlinmalarida qoʻmondonlik tarkibi va taʼminot xizmati shtat birliklari soni qoʻriqlash xizmati koʻrsatish uchun tuzilgan shartnomalarga muvofiq kiritilgan shtat birliklari umumiy sonining yigirma foizidan oshmasligi kerak.</div></div><div class="ACT_TEXT"><div name="-5303778" id="-5303778">Qoʻriqlash xizmati koʻrsatishni taʼminlash uchun qoʻriqlash boʻlinmalariga shtat birliklarini kiritish meʼyori shartnomalarda koʻrsatilgan qoʻriqlash vaqti va postlar (yoʻnalish) sonini hisobga olgan holda Milliy gvardiya qoʻmondoni tomonidan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-5303781" id="-5303781">23. Qoʻriqlash xizmatini koʻrsatish faoliyatidan tushadigan mablagʻlar maqsadli ravishda — faqat Qoʻriqlash bosh boshqarmasini taʼminlash va rivojlantirish, shuningdek, Milliy gvardiya boʻlinmalarining moddiy-texnik taʼminotini yaxshilash uchun sarflanadi.</div></div><div class="ACT_TEXT"><div name="-5303784" id="-5303784">Koʻrsatilayotgan qoʻriqlash xizmati uchun tushadigan mablagʻlar hisobidan qoʻriqlash xizmatining tashkiliy tuzilmasiga kirmaydigan shtatlarni joriy etishga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-5303789" id="-5303789">24. Qoʻriqlash bosh boshqarmasi boʻlinmalari tomonidan koʻrsatiladigan xizmatlarning tariflari (narxi) Qoʻriqlash bosh boshqarmasi tomonidan ishlab chiqiladi va Oʻzbekiston Respublikasining Davlat budjeti hisobidan moliyalashtiriladigan budjet tashkilotlari uchun — Oʻzbekiston Respublikasi Moliya vazirligi bilan kelishgan holda, boshqa tashkilotlar uchun — Milliy gvardiya qoʻmondoni tomonidan mustaqil tarzda tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-5303791" id="-5303791">25. Milliy gvardiya Qoʻriqlash bosh boshqarmasi boʻlinmalarida xizmatni oʻtash tartibi va xodimlarining formali kiyim-boshi namunalari Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-5303794" id="-5303794">26. Qoʻriqlash bosh boshqarmasi xodimiga Milliy gvardiya qoʻmondoni tomonidan tasdiqlangan namunadagi xizmat guvohnomasi va jeton beriladi.</div></div><div class="ACT_TEXT"><div name="-5303795" id="-5303795">27. Qoʻriqlash bosh boshqarmasi va uning tarkibiy boʻlinmalarida buxgalteriya hisobini tashkil etish, yuritish, xoʻjalik operatsiyalarini hisobga olish (buxgalteriya axborotini yigʻish, qayd etish va umumlashtirish), shuningdek, uning asosida moliyaviy va boshqa hisobotni tuzish qonun hujjatlarida belgilangan tartibda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-5303798" id="-5303798">28. Qoʻriqlash bosh boshqarmasi va uning tarkibiy boʻlinmalari shtatlari, xarajatlar smetalari moliya organlarida qayd etilmaydi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5303939" id="-5303939">5-bob. Obyektlarni qoʻriqlash faoliyatini tashkil etish</div></div><div class="ACT_TEXT"><div name="-5303940" id="-5303940">29. Qoʻriqlash bosh boshqarmasi boʻlinmalari tomonidan normativ-huquqiy hujjatlarda belgilangan obyektlarni hamda jismoniy va yuridik shaxslarning murojaatlariga koʻra mol-mulkni shartnoma asosida qoʻriqlashni amalga oshiriladi.</div></div><div class="BY_DEFAULT"><div name="-6371497" id="-6371497"></div></div><div class="ACT_TEXT"><div name="-6371500" id="-6371500">30. Qoʻriqlash xizmati koʻrsatilishi qoʻriqlash naryadlari faoliyatini tashkil etish hamda qoʻriqlashning texnik vositalari orqali amalga oshiriladi.</div></div><div class="BY_DEFAULT"><div name="-5303942" id="-5303942"></div></div><div class="BY_DEFAULT"><div name="-6371528" id="-6371528"></div></div><div class="ACT_TEXT"><div name="-6371529" id="-6371529">31. Obyektni qoʻriqlashni tashkil etishda uning joylashuvi va xususiyati, qoʻriqlashning muhandislik va texnik vositalari bilan jihozlanganlik darajasi, nazorat-oʻtkazish punktlarining turlari, soni, hududdagi kriminogen vaziyat va boshqa holatlar eʼtiborga olinadi. </div></div><div class="BY_DEFAULT"><div name="-6371531" id="-6371531"></div></div><div class="ACT_TEXT"><div name="-6371532" id="-6371532">Oʻrganish natijalariga koʻra qoʻriqlash usullari, postlar (yoʻnalishlar) soni, ularning joylashuvi, qoʻriqlash vaqti, shuningdek, qoʻriqlashning texnik vositalarini koʻllash orqali qoʻriqlash tizimini takomillashtirish koʻzda tutiladi.</div></div><div class="ACT_TEXT"><div name="-5303947" id="-5303947">Obyektning qoʻriqlash tizimi obyektlar maʼmuriyati va qoʻriqlash xizmati vakillarining hamkorligida belgilanadi.</div></div><div class="BY_DEFAULT"><div name="-7219463" id="-7219463"></div></div><div class="ACT_TEXT"><div name="-7219464" id="-7219464">32. Obyektlarni qoʻriqlash uchun postlar, yoʻnalishlarni qoʻyish hamda qoʻriqlash naryadlari faoliyati ustidan nazoratni amalga oshirishning qoidalari va shartlari, tartibi, usul va uslublari Milliy gvardiya tomonidan, shuningdek, tegishli vazirliklar va idoralar bilan hamkorlikda belgilanadi.</div></div><div class="ACT_TEXT"><div name="-5303949" id="-5303949">33. Oʻta muhim va toifalangan obyektlarni qoʻriqlash Oʻzbekiston Respublikasi Prezidenti va Vazirlar Mahkamasining qarorlariga muvofiq tashkil etiladi.</div></div><div class="ACT_TEXT"><div name="-5303956" id="-5303956">34. Texnik qoʻriqlash tomonidan koʻrsatilayotgan xizmatning hammabopligini taʼminlash maqsadida Qoʻriqlash bosh boshqarmasiga amaldagi tariflarni foiz hisobida kamaytirgan holda xizmat koʻrsatishga ruxsat etiladi. Bunda obyektlar alohida guruhlarga (ijtimoiy ahamiyati, saqlanayotgan moddiy-tovar boyliklar miqdori, soni va boshqalarga asosan) tasniflanadi. Obyektlarni guruhlarga tasniflash tartibi Qoʻriqlash bosh boshqarmasi boshligʻi tomonidan belgilanadi. </div></div><div class="ACT_TEXT"><div name="-5303967" id="-5303967">35. Qoʻriqlash bosh boshqarmasi boʻlinmalarining faoliyati quyidagi asosiy normativlar va mezonlar bilan baholanadi:</div></div><div class="ACT_TEXT"><div name="-5303973" id="-5303973">obyektlarni qoʻriqlash boʻyicha faoliyatning samaradorligi, jismoniy va yuridik shaxslarga koʻrsatilayotgan xizmatlarning sifati, shartnomaviy majburiyatlarga rioya etilishi; </div></div><div class="ACT_TEXT"><div name="-5303974" id="-5303974">zamonaviy qoʻriqlash axborot-kommunikatsiya texnologiyalarini (vositalarini) joriy etish va koʻrsatilayotgan texnik xizmatning sifati;</div></div><div class="ACT_TEXT"><div name="-5303978" id="-5303978">koʻrsatilayotgan xizmat turlarini kengaytirish, qoʻriqlanayotgan obyekt va fuqarolar xonadonlari sonining oshishi; </div></div><div class="ACT_TEXT"><div name="-5303983" id="-5303983">idoraviy qoʻriqlash boʻlinmalarining nazorat tekshiruvini oʻz vaqtida va sifatli oʻtkazish; </div></div><div class="ACT_TEXT"><div name="-5303987" id="-5303987">boʻlinmalarning jangovar tayyorgarlik holati, oʻquv mashqlari va mashgʻulotlarining sifati; </div></div><div class="ACT_TEXT"><div name="-5303988" id="-5303988">shaxsiy tarkibning kasbiy tayyorgarligi sifati va axloqiy-ruhiy holati, Qoʻriqlash bosh boshqarmasi boʻlinmalarida intizom va qonun hujjatlariga rioya etilishining darajasi.</div></div><div class="ACT_TEXT"><div name="-5303993" id="-5303993">36. Qoʻriqlash bosh boshqarmasi xodimi, ishchi va xizmatchisi davlat organi vakili hisoblanadi va davlatning himoyasi ostida boʻladi.</div></div><div class="ACT_TEXT"><div name="-5304000" id="-5304000">Qoʻriqlash bosh boshqarmasi xodimi, ishchi va xizmatchisi xizmat vazifasini bajarish jarayonida faqat bevosita yoki toʻgʻridan-toʻgʻri boshligʻiga (komandiriga) boʻysunadi. Faqat ushbu shaxslar uni naryaddan ozod qilish yoki almashtirish huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-5304005" id="-5304005">Qonunda toʻgʻridan-toʻgʻri vakolat berilgan shaxslardan tashqari hech kim Qoʻriqlash bosh boshqarmasi xodimining (xizmatchisining) qonuniy faoliyatiga aralashish, qonun hujjatlariga asosan Qoʻriqlash bosh boshqarmasi zimmasiga yuklatilmagan vazifalarni bajarishga majburlash huquqiga ega emas.</div></div><div class="ACT_TEXT"><div name="-5304028" id="-5304028">37. Xizmatni oʻtayotgan xodim (xizmatchi) qonunga zid boʻlgan buyruq yoki farmoyish olganda, uni bajarishni rad etish huquqiga ega va belgilangan tartibda bu haqda boshligʻiga (komandiriga) axborot berishi shart.</div></div><div class="ACT_TEXT"><div name="-5304081" id="-5304081">38. Qoʻriqlash bosh boshqarmasi shaxsiy tarkibidan faqat qoʻriqlash faoliyati bilan bogʻliq vazifalarni bajarishda (shartnoma asosida) foydalaniladi. Milliy gvardiya qoʻmondonining buyrugʻiga muvofiq Qoʻriqlash bosh boshqarmasi shaxsiy tarkibi jamoat xavfsizligini taʼminlash va jamoat tartibini saqlashga jalb etilishi mumkin. </div></div><div class="ACT_TEXT"><div name="-5304095" id="-5304095">39. Qoʻriqlash bosh boshqarmasi shaxsiy tarkibi maxsus tayyorgarlikdan, shuningdek, jismoniy kuch ishlatilishi, maxsus vositalar va oʻqotar qurol qoʻllanilishi bilan bogʻliq sharoitlardagi harakatlarga kasbiy yaroqliligini tekshirish uchun yiliga bir marotaba tekshiruvdan oʻtadilar.</div></div><div class="BY_DEFAULT"><div name="-6371534" id="-6371534"></div></div><div class="ACT_TEXT"><div name="-6371535" id="-6371535">40. Qoʻriqlash bosh boshqarmasi mansabdor shaxslarga obyektlarning muhandislik va texnik mustahkamligidagi kamchiliklarni bartaraf etish va fuqarolar xavfsizligini taʼminlashga, shartnomaviy majburiyatlarni bajarishga, moddiy boyliklar saqlanishini taʼminlashga va qoʻriqlash xizmati xodimlari, ishchi-xizmatchilarining mehnat xavfsizligini taʼminlashga qaratilgan taqdimnomalar kiritish huquqiga ega. Belgilangan tartibda rasmiy ogohlantirish, shuningdek, huquqbuzarlik sodir etishga moyil boʻlgan shaxslarga ogohlantirish xati kiritadi.</div></div><div class="ACT_TEXT"><div name="-5304110" id="-5304110">41. Qoʻriqlash bosh boshqarmasi xodimlari, ishchi va xizmatchilari gʻayriqonuniy harakat yoki harakatsizlik, shuningdek, oʻz xizmat vazifasini lozim darajada bajarmaganlik uchun Qoʻriqlash bosh boshqarmasi xodimlari, ishchi va xizmatchilari qonun hujjatlariga muvofiq javobgar boʻladi.</div></div><div class="ACT_TEXT"><div name="-5304114" id="-5304114">42. Qoʻriqlash bosh boshqarmasi xoʻjalik yuritishda (operativ boshqaruvda) oʻz majburiyatlari boʻyicha oʻziga qarashli butun mol-mulk bilan javob beradi, majburiyatlarni bajarish yuzasidan sudda daʼvogar va javobgar boʻladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5304120" id="-5304120">6-bob. Yuridik shaxslarning idoraviy qoʻriqlash boʻlinmalarida inspektorlik nazorat tekshiruvlarini oʻtkazish va muvofiqlashtirish</div></div><div class="ACT_TEXT"><div name="-5304129" id="-5304129">43. Inspektorlik nazorat tekshiruvlari yuridik va jismoniy shaxslarning mol-mulkini himoya qilish va daxlsizligini taʼminlashda yagona siyosat yuritilishini taʼminlash hamda idoraviy qoʻriqlash boʻlinmalari tomonidan qoʻriqlanayotgan obyektlarda huquqbuzarliklarning oldini olish maqsadida oʻtkaziladi.</div></div><div class="BY_DEFAULT"><div name="-5304131" id="-5304131"></div></div><div class="BY_DEFAULT"><div name="-7219467" id="-7219467"></div></div><div class="ACT_TEXT"><div name="-7219468" id="-7219468">44. Vazirliklar,  idoralar va tashkilotlar obyektlarining (Oʻzbekiston Respublikasi Prezidenti davlat xavfsizlik xizmati, Milliy gvardiya, Mudofaa vazirligi, Davlat xavfsizlik xizmati, Ichki ishlar vazirligi, Bosh prokuratura, Favqulodda vaziyatlar vazirligi va ularga boʻysunuvchi yuridik shaxslar va ular tomonidan qoʻriqlanadigan obyektlar bundan mustasno) inspektorlik nazorat tekshiruvlari reja asosida, har ikki yilda bir marta oʻtkaziladi.</div></div><div class="ACT_TEXT"><div name="-5304135" id="-5304135">Jismoniy va yuridik shaxslarning tashabbusi bilan ularga tegishli obyektlarda ham shartnoma asosida inspektorlik nazorat tekshiruvlari oʻtkazilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5304136" id="-5304136">45. Inspektorlik nazorat tekshiruvlari obyektni qoʻriqlash boʻlinmasi rahbarlari va obyekt maʼmuriyati vakillari ishtirokida, Favqulodda vaziyatlar vazirligi hamda ichki ishlar organlarining vakillari va boshqa mutaxassislar jalb qilingan holda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-5304137" id="-5304137">46. Inspektorlik nazorat tekshiruvi jarayonida idoraviy qoʻriqlashning tashkil etilganlik holati, idoraviy qoʻriqlash xodimlari uchun yaratilgan shart-sharoitlar, obyektning qoʻriqlash-yongin signalizatsiyasi va videokuzatuv tizimlari holati oʻrganiladi.</div></div><div class="ACT_TEXT"><div name="-5304138" id="-5304138">Idoraviy qoʻriqlash boʻlinmalari faoliyatining nazorat tekshiruvi va muvofiqlashtirish jarayonida obyektning qoʻriqlanishini tashkil etish, xavfsizligini taʼminlashga doir boshqa masalalar ham oʻrganiladi.</div></div><div class="ACT_TEXT"><div name="-5304140" id="-5304140">47. Inspektorlik nazorat tekshiruvi natijalari boʻyicha dalolatnoma tuziladi va u ishtirok etgan vakillar tomonidan imzolanadi. Dalolatnoma obyekt maʼmuriyati va Qoʻriqlash bosh boshqarmasi vakili tomonidan tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-5304141" id="-5304141">48. Qoʻriqlash bosh boshqarmasi belgilangan vaqtda nazorat tariqasida inspektorlik tekshiruvini tashkil etadi.</div></div><div class="BY_DEFAULT"><div name="-7219470" id="-7219470"></div></div><div class="ACT_TEXT"><div name="-7219471" id="-7219471">Oʻtkazilgan inspektorlik nazorat tekshiruvlari natijalari boʻyicha umumlashtirilgan maʼlumotlar tegishli tavsiyalar bilan birgalikda tekshiruv oʻtkazilgan vazirliklar  va idoralarga taqdim etiladi.</div></div><div class="ACT_TEXT"><div name="-5304147" id="-5304147">49. Inspektorlik nazorat tekshiruvini rejalashtirish, oʻtkazish tartibi Milliy gvardiya qoʻmondonining buyrugʻi bilan belgilanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5304148" id="-5304148">7-bob. Qoʻriqlash bosh boshqarmasining moliyaviy, moddiy-texnik taʼminoti, xodimlarning ijtimoiy himoyasi</div></div><div class="ACT_TEXT"><div name="-5304149" id="-5304149">50. Qoʻriqlash bosh boshqarmasi xodimlariga, ularning oila aʼzolariga va zaxiraga yoki isteʼfoga boʻshatilganlarga ichki ishlar organlarining tibbiy muassasalari, shuningdek, qoʻriqlanayotgan obyektlarning poliklinikalari, kasalxonalari, sanatoriylari, dam olish uylari, maktabgacha taʼlim muassasalari tomonidan xizmat koʻrsatiladi.</div></div><div class="ACT_TEXT"><div name="-5304150" id="-5304150">51. Uy-joy olish va uy-joy sharoitlarini yaxshilashga muhtoj deb topilgan Qoʻriqlash bosh boshqarmasi xodimlari qonun hujjatlarida belgilangan tartibda uy-joy maydonini olish huquqiga ega.</div></div><div class="ACT_TEXT"><div name="-5304153" id="-5304153">Qoʻriqlash bosh boshqarmasi oʻzining uy-joy fondiga ega boʻlishiga haqli.</div></div><div class="ACT_TEXT"><div name="-5304156" id="-5304156">52. Qoʻriqlash bosh boshqarmasi xodimlariga xizmatni oʻtash davri davomida uy-joy quyidagilar hisobidan berilishi mumkin:</div></div><div class="ACT_TEXT"><div name="-5304159" id="-5304159">mahalliy davlat hokimiyati organlari hisobidan;</div></div><div class="ACT_TEXT"><div name="-5304160" id="-5304160">obyektlari va mol-mulki qoʻriqlanayotgan tashkilotlar tomonidan ularning xodimlari va xizmatchilari bilan umumiy asoslarda;</div></div><div class="ACT_TEXT"><div name="-5304173" id="-5304173">Milliy gvardiya hisobidan;</div></div><div class="ACT_TEXT"><div name="-5304176" id="-5304176">Qoʻriqlash bosh boshqarmasining oʻz mablagʻlariga qurilgan uy-joy fondi hisobidan.</div></div><div class="ACT_TEXT"><div name="-5304178" id="-5304178">Yotoqxonaga ega boʻlgan tashkilotlar shartnoma asosida ulardan Qoʻriqlash bosh boshqarmasi boʻlinmalari xodimlariga turar-joy beradilar. </div></div><div class="ACT_TEXT"><div name="-5304183" id="-5304183">53. Qoʻriqlash bosh boshqarmasi oʻz mablagʻlari hisobiga xizmat binolarini loyihalashtirishi va qurishi hamda xizmat binolarini qurishda ulush hisobida ishtirok etishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5304190" id="-5304190">54. Qoʻriqlanayotgan obyektlar maʼmuriyatlari tomonidan obyektning bevosita koʻrigini taʼminlash uchun moddiy-texnika vositalari, qurollar va xizmat xonalari ajratiladi.</div></div><div class="ACT_TEXT"><div name="-5304191" id="-5304191">55. Mehnat sharoitlari sogʻliq uchun zararli boʻlgan obyektlarda xizmat qiluvchi Qoʻriqlash bosh boshqarmasi xodimlari, ishchi va xizmatchilari shu obyektlarning ishchi va xizmatchilari uchun nazarda tutilgan barcha imtiyoz va qulayliklardan foydalanadilar.</div></div><div class="ACT_TEXT"><div name="-5304196" id="-5304196">Qoʻriqlanayotgan obyektlar maʼmuriyati oʻz xizmat vazifasini vijdonan bajarayotgan Qoʻriqlash bosh boshqarmasi xodimlari, ishchi va xizmatchilarini taqdirlashi, shuningdek, qoʻriqlash boʻlinmalarining bino va inshootlari, avtotransport vositalarini taʼmirlashi va boshqa moddiy xarajatlarni amalga oshirishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5304197" id="-5304197">56. Qoʻriqlash bosh boshqarmasi xodimlari, ishchi va xizmatchilari bepul formali kiyim-bosh bilan taʼminlanadi. Ashyoviy taʼminot normalari, shuningdek, formali kiyim-boshni kiyish qoidalari Milliy gvardiya qoʻmondoni tomonidan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-5304199" id="-5304199">57. Qoʻriqlash bosh boshqarmasi xodimlari oziq-ovqat, pul, kiyim-kechak, pensiya va tibbiy taʼminot bilan taʼminlanadilar, Oʻzbekiston Respublikasi qonun hujjatlarida belgilangan boshqa ijtimoiy kafolat va imtiyozlardan foydalanadilar.</div></div><div class="ACT_TEXT"><div name="-5304200" id="-5304200">Qoʻriqlash bosh boshqarmasining xodimlari va ularning oila aʼzolarini sanatoriylardagi sanatoriy-kurort davolanishini taʼminlash tartibi qonun hujjatlariga muvofiq belgilanadi.</div></div><div class="ACT_TEXT"><div name="-5304201" id="-5304201">58. Qoʻriqlash bosh boshqarmasining shakllanadigan pul taʼminoti jamgʻarmasi doirasida:</div></div><div class="ACT_TEXT"><div name="-5304202" id="-5304202">Qoʻriqlash bosh boshqarmasi xodimlari lavozim va maxsus unvon maoshidan hisoblangan ikki oylik maoshi miqdoridagi mablagʻlarni, ishchi va xizmatchilar ikki oylik lavozim maoshi miqdoridagi mablagʻlarni yoʻnaltirgan holda ragʻbatlantiriladi;</div></div><div class="ACT_TEXT"><div name="-5304203" id="-5304203">Qoʻriqlash bosh boshqarmasining xodimlariga lavozim va maxsus unvon maoshidan hisoblangan bir oylik maoshi miqdoridagi, ishchi va xizmatchilariga bir oylik lavozim maoshi miqdoridagi mablagʻlar yoʻnaltirilgan holda moddiy yordam koʻrsatiladi.</div></div><div class="ACT_TEXT"><div name="-5304204" id="-5304204">59. Qoʻriqlash bosh boshqarmasining xodimlari hamda ishchi va xizmatchilariga budjet hisobidan taʼminlanuvchi muassasa va tashkilotlar xodimlariga belgilangan moddiy ragʻbatlantirish (shaxsiy ustama oʻrnatish va mukofotlashni amalga oshirish) maxsus jamgʻarmasini shakllantirish va sarflash tartibi joriy etiladi. </div></div><div class="ACT_TEXT"><div name="-5304205" id="-5304205">60. Qoʻriqlash bosh boshqarmasining axborot xizmati xodimlariga, boshqa toʻlovlardan qatʼi nazar mehnatga haq toʻlash fondining 50 foizidan kam boʻlmagan miqdorda oylik ustama toʻlanishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5304207" id="-5304207">Qoʻriqlash bosh boshqarmasining zamonaviy axborot-kommunikatsiya texnologiyalarini joriy qilish va rivojlantirish uchun masʼul boʻlgan ixtisoslashtirilgan tarkibiy boʻlinmalari xodimlariga, yil yakunlari boʻyicha zamonaviy axborot texnologiyalarini joriy etish borasida amalga oshirgan ish natijalari belgilangan mezonlar orqali baholangan holda lavozim maoshining kamida 100 foizi miqdorida oylik ustama toʻlanadi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-5304208" id="-5304208">8-bob. Yakunlovchi qoidalar</div></div><div class="ACT_TEXT"><div name="-5304209" id="-5304209">61. Qoʻriqlash bosh boshqarmasi faoliyatini tashkil etishning ushbu Nizom bilan tartibga solinmagan qismi boshqa qonun hujjatlari bilan tartibga solinishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5304210" id="-5304210">62. Ushbu Nizom talablari buzilishida aybdor boʻlgan shaxslar qonun hujjatlarida belgilangan tartibda javob beradilar.</div></div><div class="BY_DEFAULT"><div name="-5304236" id="-5304236"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5304242" id="-5304242">Oʻzbekiston Respublikasi Prezidentining 2021-yil 20-fevraldagi PQ-4997-son<a href="https://lex.uz/uz/docs/5300150"> qaroriga <br /></a>3-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-5304280" id="-5304280">Oʻzbekiston Respublikasi Milliy gvardiyasi Qoʻriqlash bosh boshqarmasining Qoraqolpogʻiston Respublikasi, viloyatlar va Toshkent shahar qoʻriqlash boshqarmalarining namunaviy tashkiliy tuzilmasi</div></div><div class="BY_DEFAULT"><div name="-6371587" id="-6371587"></div></div><div class="BY_DEFAULT"><div name="-6371589" id="-6371589"><img src="https://lex.uz/uz/files/6371618" /></div></div><div class="BY_DEFAULT"><div name="-5304389" id="-5304389"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5304392" id="-5304392">Oʻzbekiston Respublikasi Prezidentining 2021-yil 20-fevraldagi PQ-4997-son<a href="https://lex.uz/uz/docs/5300150"> qaroriga <br /></a>4-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-5304407" id="-5304407">Tuman(shahar) qoʻriqlash boʻlimlarining namunaviy tashkiliy tuzilmasi</div></div><div class="BY_DEFAULT"><div name="-6371633" id="-6371633"></div></div><div class="BY_DEFAULT"><div name="-6371636" id="-6371636"><img src="https://lex.uz/uz/files/6371673" /></div></div><div class="FOOTNOTE"><div name="-6371638" id="-6371638">Izoh: * — shtat lavozimlari kelgusida qoʻriqlash xizmatini rivojlanishi, iqtisodiy samaradorligi, qoʻriqlash vositalarining foydalanilayotgan sigʻimlari va umumiy shtat birliklarining soni hisobga olinib kiritiladi; </div></div><div class="FOOTNOTE"><div name="-6371639" id="-6371639">** — tuman (shahar) qoʻriqlash boʻlimi binosida qurol va maxsus vositalarni saqlash tashkil etilganda navbatchilik qismi shtatlari kiritiladi. </div></div><div class="FOOTNOTE"><div name="-6371640" id="-6371640">*** — yirik ishlab chiqarish korxonalari mavjud boʻlgan tuman (shahar)larga kiritiladi.</div></div><div class="BY_DEFAULT"><div name="-5304428" id="-5304428"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-5304442" id="-5304442">Oʻzbekiston Respublikasi Prezidentining 2021-yil 20-fevraldagi PQ-4997-son