<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-5379376" id="-5379376">Oʻzbekiston Respublikasi Prezidentining</div></div><div class="ACT_FORM"><div name="-5379377" id="-5379377">Qarori</div></div><div class="ACT_TITLE"><div name="-5379378" id="-5379378">Jamoat xavfsizligini taʼminlash sohasida professional kadrlarni tayyorlash tizimini yanada takomillashtirish chora-tadbirlari toʻgʻrisida</div></div><div class="BY_DEFAULT"><div name="-5379380" id="-5379380"></div></div><div class="ACT_TEXT"><div name="-5379381" id="-5379381">Mamlakatimizning tinchligi va osoyishtaligiga boʻlgan har qanday tahdidlarning oldini olish va jinoyatchilikka qarshi kurashish sohasida yuqori malakali mutaxassislarni tayyorlash tizimini ilgʻor xalqaro standartlar asosida takomillashtirish, shuningdek, zamon talablaridan kelib chiqib, huquqni muhofaza qiluvchi organlar va Qurolli Kuchlarning kadrlar salohiyatini oshirish maqsadida:</div></div><div class="ACT_TEXT"><div name="-5379382" id="-5379382">1. Milliy gvardiya Harbiy-texnik instituti Oʻzbekiston Respublikasi Jamoat xavfsizligi universiteti etib (keyingi oʻrinlarda — Universitet) qayta tashkil etilsin.</div></div><div class="ACT_TEXT"><div name="-5379383" id="-5379383">Universitet quyidagi sohalar uchun malakali kadrlarni maqsadli tayyorlashni amalga oshiruvchi bazaviy oliy harbiy taʼlim va ilmiy-tadqiqot muassasasi etib belgilansin:</div></div><div class="ACT_TEXT"><div name="-5379384" id="-5379384">Ichki ishlar vazirligi va Milliy gvardiya uchun — jamoat xavfsizligini taʼminlash sohasining tegishincha jamoat tartibini saqlash, yoʻl harakati xavfsizligi va pasport tizimi talablarini amalga oshirish yoʻnalishlarida;</div></div><div class="ACT_TEXT"><div name="-5379385" id="-5379385">Qurolli Kuchlar va boshqa huquqni muhofaza qiluvchi organlar uchun — harbiy diplomatiya, yurisprudensiya va iqtisodiyot hamda muhandislik-texnik, tarbiyaviy-psixologik va qoʻmondonlik-taktik faoliyat sohasida;</div></div><div class="ACT_TEXT"><div name="-5379386" id="-5379386">oʻz qoʻriqlash tuzilmalariga ega boʻlgan davlat va xoʻjalik boshqaruvi organlari uchun — qoʻriqlash faoliyatini tashkil etish va amalga oshirish sohasining barcha yoʻnalishlarida.</div></div><div class="ACT_TEXT"><div name="-5379387" id="-5379387">2. Quyidagilar Universitetning asosiy vazifalari va faoliyat yoʻnalishlari etib belgilansin:</div></div><div class="ACT_TEXT"><div name="-5379388" id="-5379388">jamoat xavfsizligini taʼminlash boʻyicha faoliyatni samarali tashkil etishga qodir boʻlgan malakali mutaxassislarni tegishli ixtisoslik va huquqshunoslik yoʻnalishlari boʻyicha chuqurlashtirilgan holda oʻqitish hamda ularni jangovar va jismoniy tayyorgarlikdan oʻtkazish orqali maqsadli tayyorlash;</div></div><div class="ACT_TEXT"><div name="-5379389" id="-5379389">Qurolli Kuchlar va huquqni muhofaza qiluvchi organlar uchun kadrlarni maʼnaviy-axloqiy tarbiyalashning samarali tizimini joriy etish, ularda huquqiy madaniyatni shakllantirish hamda vatanparvarlik va yuksak odob-axloq sifatlarini kamol toptirish orqali chuqurlashtirilgan holda tayyorlash;</div></div><div class="BY_DEFAULT"><div name="-6026329" id="-6026329"></div></div><div class="ACT_TEXT"><div name="-6026332" id="-6026332">harbiy vatanparvarlik, maʼnaviy-maʼrifiy tarbiya va yoshlar bilan ijtimoiy ishlash yoʻnalishida oʻquv-tarbiya muassasalari tarbiyachilarini qayta tayyorlash va malakasini oshirish;</div></div><div class="ACT_TEXT"><div name="-5379390" id="-5379390">oʻquv jarayonini oʻqitishning zamonaviy shakl va uslublari, pedagogik va axborot texnologiyalarini qoʻllagan holda nazariya va amaliyot uzviyligini taʼminlash orqali tashkil etish;</div></div><div class="ACT_TEXT"><div name="-5379391" id="-5379391">oliy malakali ilmiy-pedagogik kadrlarni tayyorlash, jamoat xavfsizligini taʼminlashning eng dolzarb muammolari boʻyicha kompleks ilmiy tadqiqotlarni, shu jumladan mahalliy va xalqaro grantlarni jalb etgan holda, oʻtkazish;</div></div><div class="ACT_TEXT"><div name="-5379392" id="-5379392">oʻquv jarayoniga xorijiy mamlakatlarning nufuzli taʼlim va ilmiy-tadqiqot muassasalarining malakali mutaxassislarini jalb etish, shuningdek, qoʻshma ilmiy tadqiqotlarni oʻtkazish va pedagogik tajriba almashish sohasida doimiy xalqaro hamkorlikni amalga oshirish.</div></div><div class="ACT_TEXT"><div name="-5379393" id="-5379393">3. 2021/2022 oʻquv yilidan boshlab, Universitetda professional kadrlarni tayyorlash jarayoniga bakalavriat va magistraturani oʻz ichiga oluvchi ikki bosqichli oliy taʼlim tizimi joriy etilsin.</div></div><div class="ACT_TEXT"><div name="-5379394" id="-5379394">Belgilab qoʻyilsinki:</div></div><div class="BY_DEFAULT"><div name="-8458390" id="-8458390"></div></div><div class="ACT_TEXT"><div name="-8458392" id="-8458392">Universitetda bakalavriat dasturi boʻyicha oʻqitish jarayoni taʼlimning kunduzgi, masofaviy va kechki shakllarida tashkil etilib, bitiruvchilarga oliy taʼlimning birinchi bosqichini tamomlaganligini tasdiqlovchi diplom beriladi;</div></div><div class="BY_DEFAULT"><div name="-8458394" id="-8458394"></div></div><div class="ACT_TEXT"><div name="-8458395" id="-8458395">Universitetda magistratura dasturi boʻyicha Milliy gvardiya va ichki ishlar organlarining jamoat xavfsizligini taʼminlash sohasida kamida besh yillik amaliy stajga ega boʻlgan xodimlari (harbiy xizmatchilari)ni oʻqitish davlat granti asosida kunduzgi taʼlim shaklida bir yilni, kadrlarni umumfuqaroviy asosda tayyorlash toʻlov-kontrakt boʻyicha kunduzgi taʼlim shaklida bir yilni, kechki va masofaviy taʼlim shakllarida bir yarim yilni tashkil etadi hamda bitiruvchilarga magistr akademik darajasini tasdiqlovchi oliy taʼlim toʻgʻrisida davlat namunasidagi hujjat (diplom) beriladi;</div></div><div class="BY_DEFAULT"><div name="-8458409" id="-8458409"></div></div><div class="ACT_TEXT"><div name="-8458410" id="-8458410">Universitetning masofaviy taʼlim shakli kamida uch yillik harbiy xizmat (xizmat) stajiga ega boʻlgan Qurolli Kuchlar va boshqa huquqni muhofaza qiluvchi organlarning amaldagi harbiy xizmatchilari (xodimlari) uchun nazarda tutilib, unda oʻqish muddati oliy maʼlumotga ega boʻlmagan shaxslar uchun toʻrt yilni, oliy maʼlumotga ega boʻlgan shaxslar uchun toʻlov-kontrakt asosida uch yilni tashkil etadi;</div></div><div class="BY_DEFAULT"><div name="-8459162" id="-8459162"></div></div><div class="ACT_TEXT"><div name="-8459232" id="-8459232">Universitetning sirtqi taʼlim shakliga Milliy gvardiya hisobidan qabul qilinib, tahsil olayotgan Ichki ishlar vazirligi huzuridagi Qoʻriqlash departamentining oliy maʼlumotga ega boʻlmagan amaldagi xodimlarining oʻqishni tugatguniga qadar bepul taʼlim olish huquqlari saqlab qolinadi;</div></div><div class="BY_DEFAULT"><div name="-8458414" id="-8458414"></div></div><div class="ACT_TEXT"><div name="-8458417" id="-8458417">Universitetning yillik qabul kvotasi bakalavriatning kunduzgi taʼlim shakliga 600 nafargacha kursantlarni, masofaviy taʼlim shakliga 300 nafargacha tinglovchilarni tashkil etadi;</div></div><div class="BY_DEFAULT"><div name="-8055977" id="-8055977"></div></div><div class="ACT_TEXT"><div name="-8055978" id="-8055978">Universitet magistraturasini tamomlaganlik toʻgʻrisidagi diplom harbiy xizmat (xizmat)ni oʻtashda Oʻzbekiston Respublikasi Harbiy xavfsizlik va mudofaa universitetining ikki yillik magistratura dasturini, Ichki ishlar vazirligi Akademiyasining ikkinchi darajadagi magistraturasini, shuningdek, xorijiy mamlakatlar harbiy akademiyalarini tamomlaganlik toʻgʻrisidagi diplomlarga tenglashtiriladi;</div></div><div class="BY_DEFAULT"><div name="-8458425" id="-8458425"></div></div><div class="ACT_TEXT"><div name="-8458427" id="-8458427">Universitetning masofaviy taʼlim shakliga Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibiyati tomonidan har yili belgilanadigan qoʻshimcha kvota boʻyicha boshqa huquqni muhofaza qiluvchi organlar va Qurolli Kuchlarda kamida uch yillik harbiy xizmat (xizmat) stajiga ega boʻlgan harbiy xizmatchilar (xodimlar) toʻlov-kontrakt asosida oʻqishga qabul qilinishi mumkin.</div></div><div class="ACT_TEXT"><div name="-5379401" id="-5379401">Quyidagilarga:</div></div><div class="ACT_TEXT"><div name="-5379402" id="-5379402">Milliy gvardiya qoʻmondoni R.M. Joʻrayevga — Universitetda ikki bosqichli oliy taʼlim tizimini sifatli joriy etish, shu jumladan oʻquv jarayonini eng zamonaviy pedagogik va axborot texnologiyalari asosida tashkil qilish, professor-oʻqituvchilar tarkibining ilmiy-pedagogik salohiyatini tubdan oshirish;</div></div><div class="ACT_TEXT"><div name="-5379403" id="-5379403">ichki ishlar vazirining oʻrinbosari A.I. Ikramovga — ichki ishlar organlari jamoat xavfsizligini taʼminlovchi boʻlinmalari bilan Universitet oʻrtasida oʻzaro hamkorlikning uygʻun mexanizmlarini joriy etish, taʼlim oluvchilarning faoliyat sohasi boʻyicha samarali stajirovka oʻtashini taʼminlash yuzasidan shaxsiy masʼuliyat yuklansin.</div></div><div class="ACT_TEXT"><div name="-5379404" id="-5379404">Milliy gvardiya (R.M. Joʻrayev) Oliy va oʻrta maxsus taʼlim vazirligi (A.X. Toshkulov) bilan birgalikda:</div></div><div class="ACT_TEXT"><div name="-5379405" id="-5379405">bir oy muddatda mazkur qaror talablarini inobatga olgan holda Universitetga oʻqishga qabul qilish tartibini hamda ochiq va xolisona tanlov mezonlarini nazarda tutuvchi Hukumat qarori loyihasini Vazirlar Mahkamasiga kiritsin;</div></div><div class="ACT_TEXT"><div name="-5379406" id="-5379406">2021/2022 oʻquv yilidan boshlab Universitetda joriy etilayotgan taʼlim tizimiga muvofiq oʻqitishni yoʻlga qoʻyish boʻyicha kompleks tashkiliy choralarni koʻrsin. </div></div><div class="ACT_TEXT"><div name="-5379407" id="-5379407">4. Universitetning Vasiylik kengashi <a href="https://lex.uz/uz/docs/-5377545#-5379558">1-ilovaga </a>muvofiq tarkibda tashkil etilsin.</div></div><div class="ACT_TEXT"><div name="-5379408" id="-5379408">Belgilansinki, Vasiylik kengashi Universitetning quyidagi ustuvor yoʻnalishlar boʻyicha rivojlanishiga koʻmaklashadi:</div></div><div class="ACT_TEXT"><div name="-5379410" id="-5379410">taʼlim oluvchilarning amaliyot oʻtashini tashkil etish hamda bitiruvchilarni ishga joylashtirish boʻyicha Qurolli Kuchlar va huquqni muhofaza qiluvchi organlar bilan samarali hamkorlikni amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-5379411" id="-5379411">oliy taʼlimning rivojlanishiga koʻmaklashadigan dasturlar va istiqbolli tashabbuslarni qoʻllab-quvvatlash, ilmiy ishlanmalarni amaliyotga samarali tatbiq etish;</div></div><div class="ACT_TEXT"><div name="-5379412" id="-5379412">taʼlim va ilm-fan sohasida oliy harbiy va ixtisoslashtirilgan, shu jumladan xorijiy taʼlim muassasalari bilan maqsadli uzviy hamkorlikni yoʻlga qoʻyish va rivojlantirish;</div></div><div class="ACT_TEXT"><div name="-5379413" id="-5379413">Universitetga moliyaviy va tashkiliy yordam berish, uning faoliyatini taʼminlash va rivojlantirish uchun budjetdan tashqari mablagʻlarni, mahalliy va xalqaro grantlarni jalb qilish.</div></div><div class="ACT_TEXT"><div name="-5379414" id="-5379414">Vasiylik kengashining barcha aʼzolariga oʻz vakolatlari doirasida Universitetni rivojlantirish va samarali faoliyat koʻrsatishi uchun koʻmaklashish boʻyicha shaxsiy masʼuliyat yuklansin.</div></div><div class="ACT_TEXT"><div name="-5379416" id="-5379416">5. Shunday tartib oʻrnatilsinki, unga muvofiq:</div></div><div class="ACT_TEXT"><div name="-5379417" id="-5379417">Universitetga oʻqishga qabul qilish tanlov asosida, Qurolli Kuchlar va huquqni muhofaza qiluvchi organlarning ehtiyojini hisobga olgan holda har yili belgilanadigan kvotalar doirasida amalga oshirilib, taʼlim oluvchilarga oʻrnatilgan tartibda stipendiya (pul taʼminoti) toʻlanadi va moddiy taʼminot belgilanadi;</div></div><div class="ACT_TEXT"><div name="-5379419" id="-5379419">Universitet kursantlarini kelgusida harbiy xizmat (xizmat) oʻtash uchun idoralararo taqsimlash taʼlim yoʻnalishlariga muvofiq bitiruv bosqichida amalga oshiriladi;</div></div><div class="ACT_TEXT"><div name="-5379420" id="-5379420">Universitet bitiruv bosqichidagi kursantlarning faoliyat sohasi boʻyicha stajirovkasi oʻqishni tamomlagandan soʻng harbiy xizmat (xizmat) oʻtash uchun yuborilishi nazarda tutilgan boʻlinmalarda tashkil etiladi;</div></div><div class="ACT_TEXT"><div name="-5379421" id="-5379421">Qurolli Kuchlar va huquqni muhofaza qiluvchi organlarning harbiy xizmatchilari (xodimlari) mehnatga soatbay haq toʻlash shartlari asosida mutaxassislik fanlari boʻyicha Universitetda oʻquv mashgʻulotlarini oʻtkazish huquqiga ega;</div></div><div class="ACT_TEXT"><div name="-5379422" id="-5379422">Universitet tomonidan Milliy gvardiya akademik litseylarining oʻquv-metodik jarayoni muvofiqlashtiriladi hamda ularga tizimli amaliy va axborot-resurs yordami koʻrsatiladi;</div></div><div class="ACT_TEXT"><div name="-5379424" id="-5379424">Universitetga oʻqishga kiruvchi abituriyentlarning antropometrik parametrlari Qurolli Kuchlar va huquqni muhofaza qiluvchi organlarga harbiy xizmat (xizmat)ga qabul qilish talablariga muvofiq tartibda tanlangan mutaxassislikka qarab belgilanadi;</div></div><div class="ACT_TEXT"><div name="-5379425" id="-5379425">Universitetning ilmiy va professor-oʻqituvchilar tarkibi lavozimlariga tegishli sohada kamida besh yillik ilmiy, pedagogik yoki amaliy ish tajribasiga ega shaxslar harbiy xizmatchilar lavozimlari hisobidan tayinlanishi mumkin;</div></div><div class="ACT_TEXT"><div name="-5379427" id="-5379427">Universitetning xizmatchilar uchun belgilangan professor-oʻqituvchilar tarkibi lavozimlariga tayinlanadigan pedagog xodimlar bilan shartnomalar bir yil muddatga tuziladi.</div></div><div class="ACT_TEXT"><div name="-5379428" id="-5379428">6. Milliy gvardiya va Ichki ishlar vazirligining quyidagi takliflari maʼqullansin:</div></div><div class="BY_DEFAULT"><div name="-8458429" id="-8458429"></div></div><div class="ACT_TEXT"><div name="-8458430" id="-8458430">Universitetga kunduzgi, masofaviy va kechki taʼlim shaklining bakalavriat hamda kunduzgi taʼlim shaklining magistratura dasturlari boʻyicha umumiy asoslarda yurisprudensiya, psixologiya va iqtisodiyot sohalarida kadrlarni talabalar tarkibiga kiritgan holda tayyorlash huquqini berish;</div></div><div class="ACT_TEXT"><div name="-5379433" id="-5379433">umumiy asoslarda kadrlar tayyorlashni toʻlov-kontrakt asosida amalga oshirish va bitiruvchilarga “zaxiradagi ofitser” harbiy unvoni va tegishli mutaxassislik boʻyicha diplom berish.</div></div><div class="ACT_TEXT"><div name="-5379434" id="-5379434">7. Oʻzbekiston Respublikasi Jamoat xavfsizligi universitetida taʼlim yoʻnalishlari (mutaxassisliklari) roʻyxati<a href="https://lex.uz/uz/docs/-5377545#-5379630"> 2-ilovaga </a>muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-5379435" id="-5379435">Belgilansinki, mazkur taʼlim yoʻnalishlari (mutaxassisliklari) 2021/2022 oʻquv yilidan boshlab joriy etiladi.</div></div><div class="ACT_TEXT"><div name="-5379436" id="-5379436">8. Quyidagi huquqlar berilsin:</div></div><div class="ACT_TEXT"><div name="-5379438" id="-5379438">a) Milliy gvardiya qoʻmondoniga:</div></div><div class="ACT_TEXT"><div name="-5379440" id="-5379440">Universitet kursantlari (talabalari) va tinglovchilarini oʻqishdan chetlashtirish va ularni oʻqishga tiklash tartibini belgilash;</div></div><div class="ACT_TEXT"><div name="-5379442" id="-5379442">Vasiylik kengashi bilan kelishilgan holda Universitetda taʼlim yoʻnalishlari (mutaxassisliklari) roʻyxatiga oʻzgartirishlar kiritish, shuningdek, kadrlarga boʻlgan ehtiyojdan kelib chiqib, yangi istiqbolli yoʻnalishlar (mutaxassisliklar)ni kiritish;</div></div><div class="ACT_TEXT"><div name="-5379444" id="-5379444">b) Universitet boshligʻiga:</div></div><div class="ACT_TEXT"><div name="-5379445" id="-5379445">toʻlov-kontrakt asosidagi oʻqitish mablagʻlari hisobidan Universitetning iqtidorli kursant va talabalariga qoʻshimcha individual stipendiyalar tayinlash;</div></div><div class="ACT_TEXT"><div name="-5379447" id="-5379447">oʻquv jarayoniga yuqori ilmiy-pedagogik mahoratga ega boʻlgan, birinchi navbatda, ilgʻor xorijiy taʼlim muassasalarining mutaxassislarini soatbay va uzoq muddatli ishlash shartlarida shartnoma asosida jalb etish va mehnat bozori konyunkturasini inobatga olgan holda ularning mehnatiga haq toʻlash miqdorini belgilash;</div></div><div class="ACT_TEXT"><div name="-5379448" id="-5379448">yetakchi xorijiy taʼlim va ilmiy-tadqiqot muassasalari bilan qoʻshma taʼlim dasturlarini amalga oshirish, shuningdek, kadrlarni tayyorlash va ularning malakasini oshirish sohasida oʻzaro hamkorlik boʻyicha toʻgʻridan-toʻgʻri memorandum va bitimlarni tuzish;</div></div><div class="ACT_TEXT"><div name="-5379449" id="-5379449">xalqaro hamkorlik va ikki tomonlama shartnomalar doirasida xorijiy davlatlarning harbiy xizmatchilarini tayyorlash, qayta tayyorlash va ularning malakasini oshirishni belgilangan tartibda tashkil etish;</div></div><div class="ACT_TEXT"><div name="-5379450" id="-5379450">professor-oʻqituvchilar tarkibining amaliy stajirovka oʻtash joyi va idorasini mustaqil belgilash.</div></div><div class="BY_DEFAULT"><div name="-8458435" id="-8458435"></div></div><div class="ACT_TEXT"><div name="-8458436" id="-8458436">v) Universitetga:</div></div><div class="ACT_TEXT"><div name="-8458437" id="-8458437">ilmiy-tadqiqot faoliyatini olib borish uchun zarur boʻlgan statistik va boshqa axborotlarni davlat organlari, vazirlik hamda idoralardan begʻaraz asosda soʻrab olish;</div></div><div class="ACT_TEXT"><div name="-8458438" id="-8458438">ilmiy-tadqiqot va tajriba konstruktorlik ishlari doirasida Qurolli Kuchlar, huquqni muhofaza qiluvchi organlar, Mudofaa vazirligi huzuridagi Mudofaa sanoati agentligi hamda uning tasarrufidagi korxonalarning moddiy-texnik vositalari va laboratoriya uskunalaridan begʻaraz foydalanish, shuningdek, hamkorlikda tajriba-sinov ishlarini amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-8458441" id="-8458441">jamoat xavfsizligini taʼminlash sohasida shartnoma asosida ekspertlik, ilmiy-tadqiqot va qonunchilikda taqiqlanmagan boshqa pullik xizmatlar koʻrsatish;</div></div><div class="ACT_TEXT"><div name="-8458442" id="-8458442">ilmiy-ishlab chiqarish laboratoriyasida ilmiy tadqiqot natijalari asosida jamoat xavfsizligini taʼminlash sohasida maxsus vositalar, uchuvchisiz uchish apparatlari (dronlar), robototexnika majmualari, dasturiy taʼminotlar, texnika vositalari namunalarini va qonunchilikda taqiqlanmagan boshqa mahsulotlarni ishlab chiqarish va sotish;</div></div><div class="ACT_TEXT"><div name="-8458443" id="-8458443">Universitetning Jamoat xavfsizligi masalalari boʻyicha ilmiy-amaliy tadqiqotlar instituti xodimlariga xizmat faoliyati samaradorligi koʻrsatkichi (KPI) asosida har oylik individual ustamalarni Universitetning budjetdan tashqari mablagʻlari hisobidan toʻlab borish.</div></div><div class="ACT_TEXT"><div name="-8458444" id="-8458444">Universitetning Jamoat xavfsizligi masalalari boʻyicha ilmiy-amaliy tadqiqotlar instituti boshligʻi va oʻrinbosariga Universitet boshligʻi oʻrinbosarlariga, institutning markaz boshliqlariga Ilmiy-amaliy-tadqiqotlar markazi boshligʻiga, institut katta ilmiy xodimlariga kafedra oʻqituvchilariga belgilangan moddiy-moliyaviy taʼminot meʼyorlari hamda qoʻshimcha koeffitsiyent miqdorlari qoʻllaniladi.</div></div><div class="ACT_TEXT"><div name="-5379453" id="-5379453">9. Belgilab qoʻyilsinki:</div></div><div class="ACT_TEXT"><div name="-5379458" id="-5379458">Universitetda amaldagi oʻquv dasturlari boʻyicha oʻqitish ular muqaddam oʻrnatilgan tartibda yakunlanguniga qadar saqlanib qoladi;</div></div><div class="ACT_TEXT"><div name="-5379460" id="-5379460">Universitetda toʻlov-kontrakt asosida oʻqitish qiymati har yili Vasiylik kengashi tomonidan belgilanadi;</div></div><div class="BY_DEFAULT"><div name="-8458451" id="-8458451"></div></div><div class="ACT_TEXT"><div name="-8458453" id="-8458453">Toʻlov kontrakt asosidagi taʼlim, mol-mulkni ijaraga berish, pullik kurslarni tashkil etish va boshqa xizmat koʻrsatishdan tushadigan mablagʻlar Universitetning budjetdan tashqari hisob raqamiga yoʻnaltiriladi. Bunda mazkur mablagʻlarning kamida 50 foizi oʻquv jarayoniga shartnoma asosida malakali mutaxassislarni jalb qilish, xalqaro va respublika darajasidagi tadbirlarni tashkil etish (shu jumladan, xakatonlar, startaplar oʻtkazish va gʻolib loyihalarni moliyalashtirishga), shaxsiy tarkibni har oylik moddiy ragʻbatlantirish va ustama toʻlashga, qolgan qismi oʻquv moddiy-texnik bazani rivojlantirishga va saqlab turishga, raqamli infratuzilmani rivojlantirishga hamda qonunchilikda taqiqlanmagan boshqa maqsadlarga yoʻnaltiriladi;</div></div><div class="ACT_TEXT"><div name="-5379464" id="-5379464">Universitetning xizmatchilar hisoblangan boshqaruv va professor-oʻqituvchilar tarkibidagi xodimlariga avvalgi ish joyi boʻyicha berilgan martaba darajalari uchun belgilangan ustama haqlari (mavjud boʻlsa) saqlanib qoladi;</div></div><div class="ACT_TEXT"><div name="-5379490" id="-5379490">Universitetning xizmatchilar hisoblangan boshqaruv, ilmiy va professor-oʻqituvchilar tarkibidagi lavozimlariga tegishincha Vazirlar Mahkamasining 2008-yil 1-avgustdagi “<a href="https://lex.uz/uz/docs/-1379834">Respublika oliy taʼlim muassasalari xodimlari mehnatiga haq toʻlashning takomillashtirilgan tizimini tasdiqlash toʻgʻrisida</a>”gi 164-son va 2009-yil 18-avgustdagi “<a href="https://lex.uz/uz/docs/-1507950">Ilmiy xodimlar mehnatini yanada ragʻbatlantirish chora-tadbirlari toʻgʻrisida</a>”gi 233-son qarorlari bilan belgilangan mehnatga haq toʻlashning bazaviy lavozim maoshlari qoʻllaniladi.</div></div><div class="ACT_TEXT"><div name="-5379500" id="-5379500">10. Tashqi ishlar vazirligi (A.X. Kamilov), Mutaxassislarni xorijda tayyorlash va vatandoshlar bilan muloqot qilish boʻyicha “El-yurt umidi” jamgʻarmasi (A.Sh. Bekmurodov), Universitetga: </div></div><div class="ACT_TEXT"><div name="-5379503" id="-5379503">muntazam ravishda ilmiy va professor-oʻqituvchilar tarkibining yetakchi xorijiy taʼlim muassasalarida malaka oshirishini, shu jumladan iqtidorli harbiy xizmatchilarni magistratura va doktoranturaga oʻqishga yuborishni tashkil etish, shuningdek, oʻquv jarayoniga ularning yuqori malakali mutaxassislarini keng jalb etish;</div></div><div class="ACT_TEXT"><div name="-5379506" id="-5379506">yetakchi xorijiy taʼlim, ilmiy-tadqiqot va axborot-tahliliy muassasalar bilan oʻzaro xalqaro hamkorlik toʻgʻrisidagi memorandum va bitimlarni tayyorlash hamda tuzish;</div></div><div class="ACT_TEXT"><div name="-5379510" id="-5379510">Universitetning buyurtmalariga koʻra, mazkur qaror doirasida jalb etiladigan Universitet professor-oʻqituvchilar tarkibidagi xorijiy fuqarolarga, shuningdek, ularning oila aʼzolariga konsullik va boshqa yigʻimlarni undirmasdan kirish vizalarini rasmiylashtirishga koʻmaklashsin.</div></div><div class="ACT_TEXT"><div name="-5379513" id="-5379513">11. Bandlik va mehnat munosabatlari vazirligi (N.B. Xusanov) Universitetning buyurtmalariga koʻra, Oʻzbekiston Respublikasiga xorijiy mutaxassislarni jalb etishga ruxsatnomani berish (uzaytirish)ni, shuningdek, mazkur qarorni amalga oshirish doirasida jalb etiladigan xorijiy fuqarolarga Oʻzbekiston Respublikasi hududida mehnat faoliyati bilan shugʻullanish huquqini beruvchi tasdiqnomalar berish (uzaytirish)ni taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-5379516" id="-5379516">Ichki ishlar vazirligi (N.S. Turaxodjayev) Universitetning buyurtmalariga koʻra, mazkur qaror doirasida jalb etiladigan xorijiy fuqarolarga koʻp martalik vizalar berilishini va muddati uzaytirilishini, shuningdek, ularning yashash joyi boʻyicha vaqtincha roʻyxatga olinishini va muddati uzaytirilishini oʻrnatilgan tartibda taʼminlasin.</div></div><div class="ACT_TEXT"><div name="-5379520" id="-5379520">12. Milliy gvardiya (R.M. Joʻrayev) Oliy va oʻrta maxsus taʼlim vazirligi (A.X. Toshkulov) hamda boshqa manfaatdor vazirlik va idoralar bilan birgalikda:</div></div><div class="ACT_TEXT"><div name="-5379525" id="-5379525">bir oy muddatda Universitetda maqsadli situatsion-immitatsion poligonlarni tashkil etishni nazarda tutuvchi Hukumat qarori loyihasini Vazirlar Mahkamasiga kiritsin; </div></div><div class="ACT_TEXT"><div name="-5379526" id="-5379526">uch oy muddatda qonunchilik hujjatlariga ushbu qarordan kelib chiqadigan oʻzgartirish va qoʻshimchalar toʻgʻrisida Vazirlar Mahkamasiga takliflar kiritsin.</div></div><div class="ACT_TEXT"><div name="-5379529" id="-5379529">13. Moliya vazirligi (T.A. Ishmetov) Milliy gvardiyaning asoslantirilgan buyurtmalariga asosan 2022-yil 1-yanvardan boshlab:</div></div><div class="ACT_TEXT"><div name="-5379532" id="-5379532">mazkur qarorni inobatga olgan holda Davlat budjeti xarajatlari parametrida Universitetni saqlab turish uchun zarur ajratmalar;</div></div><div class="ACT_TEXT"><div name="-5379534" id="-5379534">tuziladigan shartnomalar asosida Universitetning oʻquv jarayoniga malakali xorijiy mutaxassislarni jalb etish uchun pul mablagʻlari ajratilishini nazarda tutsin.</div></div><div class="ACT_TEXT"><div name="-5379540" id="-5379540">14. Mazkur qaror ijrosini samarali tashkil etishga masʼul va shaxsiy javobgar etib Milliy gvardiya qoʻmondoni R.M. Joʻrayev belgilansin.</div></div><div class="ACT_TEXT"><div name="-5379544" id="-5379544">Mazkur qaror ijrosini muhokama qilib borish, ijro uchun masʼul idoralar faoliyatini muvofiqlashtirish va nazorat qilish Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibi V.V. Maxmudov zimmasiga yuklansin.</div></div><div class="ACT_TEXT"><div name="-5379550" id="-5379550">Amalga oshirilayotgan chora-tadbirlar natijadorligi yuzasidan 2021-yil 1-iyul va 2022-yil 1-yanvargacha Oʻzbekiston Respublikasi Prezidentiga axborot berilsin.</div></div><div class="SIGNATURE"><div name="-5379551" id="-5379551">Oʻzbekiston Respublikasi Prezidenti Sh. MIRZIYOYEV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-5379553" id="-5379553">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-5379555" id="-5379555">2021-yil 15-aprel,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-5379900" id="-5379900">PQ-5077-son</div></div><div class="BY_DEFAULT"><div name="-8458467" id="-8458467"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8458469" id="-8458469">Oʻzbekiston Respublikasi Prezidentining 2021-yil 15-apreldagi PQ-5077-son <a href="https://lex.uz/uz/docs/-5377545">qaroriga</a><br />1-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8458470" id="-8458470"><strong>Oʻzbekiston Respublikasi Jamoat xavfsizligi universitetining Vasiylik kengashi</strong></div></div><div class="ACT_FORM"><div name="-8458471" id="-8458471">TARKIBI</div></div><div class="BY_DEFAULT"><div name="-8458472" id="-8458472"></div></div><div class="BY_DEFAULT"><div name="-8458473" id="-8458473"><table border="0" cellpadding="0" cellspacing="0" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>V.V. Maxmudov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p style="text-align:justify">Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibi, <i>Vasiylik kengashi raisi</i></p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>D.B. Kadirov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p style="text-align:justify">Oʻzbekiston Respublikasi Prezidenti Administratsiyasi Jamoat xavfsizligi va qonun ustuvorligi boʻyicha departamenti boshligʻi, <i>Vasiylik kengashi raisi oʻrinbosari</i></p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>B.X. Tashmatov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>Milliy gvardiya qoʻmondoni</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>A.A. Tashpulatov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>ichki ishlar vaziri</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>N.T. Yoʻldoshev</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>Bosh prokuror</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>B.N. Kurbanov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>Davlat xavfsizlik xizmati raisi</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>Sh.G. Xalmuxamedov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>mudofaa vaziri</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>A.D. Tashkulov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>adliya vaziri</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>K.A. Sharipov</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>oliy taʼlim, fan va innovatsiyalar vaziri</p></td></tr><tr><td style="width:20.46%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="20%"><p>Lavozimi boʻyicha</p></td><td style="width:4.32%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="4%"><p align="center" style="text-align:center">—</p></td><td style="width:75.24%;padding:0in 2.85pt 0in 2.85pt" valign="top" width="75%"><p>Jamoat xavfsizligi universiteti boshligʻi</p></td></tr></tbody></table></div></div><div class="FOOTNOTE"><div name="-8458474" id="-8458474">Izoh: Vasiylik kengashi aʼzolari boshqa ishga oʻtganda uning tarkibiga mazkur lavozimlarga yangidan tayinlangan yoki zimmasiga tegishli vazifalarni bajarish yuklangan shaxslar kiritiladi.</div></div><div class="BY_DEFAULT"><div name="-8458490" id="-8458490"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-8458491" id="-8458491">Oʻzbekiston Respublikasi Prezidentining 2021-yil 15-apreldagi PQ-5077-son <a href="https://lex.uz/uz/docs/-5377545">qaroriga</a><br />2-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-8458492" id="-8458492"><strong>Oʻzbekiston Respublikasi Jamoat xavfsizligi universitetidagi taʼlim mutaxassisliklari (yoʻnalishlari)</strong></div></div><div class="ACT_FORM"><div name="-8458493" id="-8458493">ROʻYXATI</div></div><div class="BY_DEFAULT"><div name="-8458494" id="-8458494"></div></div><div class="BY_DEFAULT"><div name="-8458495" id="-8458495"><table border="1" cellpadding="0" cellspacing="0" style="width:100.0%;border-collapse:collapse;border:none" width="100%"><tbody><tr><td style="width:5.06%;border:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center"><b>T/r</b></p></td><td style="width:49.3%;border:solid windowtext 1.0pt;border-left:  none;padding:0in 2.85pt 0in 2.85pt" width="49%"><p align="center" style="text-align:center"><b>Mutaxassislik (yoʻnalish) nomi</b></p></td><td style="width:16.62%;border:solid windowtext 1.0pt;border-left:  none;padding:0in 2.85pt 0in 2.85pt" width="16%"><p align="center" style="text-align:center"><b>Beriladigan malaka</b></p></td><td style="width:15.0%;border:solid windowtext 1.0pt;border-left:  none;padding:0in 2.85pt 0in 2.85pt" width="15%"><p align="center" style="text-align:center"><b>Taʼlim shakli</b></p></td><td style="width:14.04%;border:solid windowtext 1.0pt;border-left:  none;padding:0in 2.85pt 0in 2.85pt" width="14%"><p align="center" style="text-align:center"><b>Oʻqish muddati</b></p></td></tr><tr><td colspan="5" style="width:100.0%;border:solid windowtext 1.0pt;border-top:none;padding:0in 2.85pt 0in 2.85pt" width="100%"><p align="center" style="text-align:center"><b>I. Bakalavriat</b></p></td></tr><tr><td style="width:5.06%;border:solid windowtext 1.0pt;border-top:  none;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center">1.</p></td><td style="width:49.3%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="49%"><p align="center" style="text-align:center;text-indent:1.75pt">Jamoat xavfsizligini taʼminlash faoliyati</p></td><td style="width:16.62%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="16%"><p align="center" style="text-align:center">sohalar boʻyicha menejer</p></td><td style="width:15.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="15%"><p align="center" style="text-align:center">kunduzgi</p></td><td style="width:14.04%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="14%"><p align="center" style="text-align:center">4 yil</p></td></tr><tr><td style="width:5.06%;border:solid windowtext 1.0pt;border-top:  none;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center">2.</p></td><td style="width:49.3%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="49%"><p align="center" style="text-align:center;text-indent:6.7pt">Psixologiya:</p><p style="text-indent:1.7pt">“Xizmat faoliyatini psixologik taʼminlash”</p></td><td style="width:16.62%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="16%"><p align="center" style="text-align:center">psixolog</p></td><td style="width:15.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="15%"><p align="center" style="text-align:center">kunduzgi,</p><p align="center" style="text-align:center">masofaviy</p></td><td style="width:14.04%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="14%"><p align="center" style="text-align:center">4 yil,</p><p align="center" style="text-align:center">4/5 yil<a href="https://lex.uz/uz/docs/-5377545#-8458497">*</a></p></td></tr><tr><td style="width:5.06%;border:solid windowtext 1.0pt;border-top:  none;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center">3.</p></td><td style="width:49.3%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="49%"><p align="center" style="text-align:center;text-indent:6.7pt">Yurisprudensiya:</p><p style="text-indent:1.7pt">“Huquqbuzarliklar profilaktikasi faoliyati”</p><p style="text-indent:1.7pt">“Jamoat tartibini saqlash faoliyati”</p><p style="text-indent:1.7pt">“Yoʻl harakati xavfsizligi faoliyati”</p><p style="text-indent:1.7pt">“Qoʻriqlash faoliyati”</p><p style="margin-right:-3.0pt;text-indent:1.7pt">“Jamoat tartibini huquqiy taʼminlash faoliyati”</p></td><td style="width:16.62%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="16%"><p align="center" style="text-align:center">yurist</p></td><td style="width:15.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="15%"><p align="center" style="text-align:center">kunduzgi</p></td><td style="width:14.04%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="14%"><p align="center" style="text-align:center">3 yil</p></td></tr><tr><td style="width:5.06%;border:solid windowtext 1.0pt;border-top:  none;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center">4.</p></td><td style="width:49.3%;border-top:none;border-left:  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="49%"><p align="center" style="text-align:center;text-indent:6.7pt">Yurisprudensiya:</p><p style="margin-right:-3.0pt;text-align:justify;text-indent:  1.75pt">“Jamoat xavfsizligini huquqiy taʼminlash”</p></td><td style="width:16.62%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="16%"><p align="center" style="text-align:center">yurist</p></td><td style="width:15.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="15%"><p align="center" style="text-align:center">masofaviy</p></td><td style="width:14.04%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="14%"><p align="center" style="text-align:center">4/5 yil<a href="https://lex.uz/uz/docs/-5377545#-8458497">*</a></p></td></tr><tr><td style="width:5.06%;border:solid windowtext 1.0pt;border-top:  none;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center">5.</p></td><td style="width:49.3%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="49%"><p align="center" style="text-align:center;text-indent:6.7pt">Iqtisodiyot:</p><p>“Iqtisodiy xavfsizlik”</p></td><td style="width:16.62%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="16%"><p align="center" style="text-align:center">iqtisodchi</p></td><td style="width:15.0%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="15%"><p align="center" style="text-align:center">kunduzgi</p></td><td style="width:14.04%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="14%"><p align="center" style="text-align:center">4 yil</p></td></tr><tr><td style="width:5.06%;border:solid windowtext 1.0pt;border-top:  none;padding:0in 2.85pt 0in 2.85pt" width="5%"><p align="center" style="text-align:center">6.</p></td